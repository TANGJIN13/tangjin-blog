---
import '../styles/global.css';
import { site } from '../site';
import Icon from '../components/Icon.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  narrow?: boolean;
  /** 页面顶部是否有壁纸横幅（有则内容下沉，导航悬浮其上） */
  banner?: boolean;
  /** 页面级结构化数据（如 BlogPosting），注入到 <head> */
  jsonLd?: Record<string, unknown> | null;
}

const {
  title,
  description = site.description,
  image = `${site.url}/images/wallpapers/wallpaper-01.svg`,
  narrow = false,
  banner = false,
  jsonLd = null,
} = Astro.props;

// 全站统一的 WebSite 结构化数据（帮助搜索引擎理解站点）
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.title,
  url: site.url,
  description: site.description,
  author: { '@type': 'Person', name: site.author },
  inLanguage: site.lang,
};

const navItems = [
  { label: '首页', href: '/', icon: 'home' },
  { label: '归档', href: '/archive/', icon: 'archive' },
  { label: '分类', href: '/categories/', icon: 'folder' },
  { label: '相册', href: '/album/', icon: 'photo' },
  { label: '说说', href: '/says/', icon: 'comment' },
  { label: '友链', href: '/friends/', icon: 'link' },
  { label: '留言', href: '/guestbook/', icon: 'mail' },
  { label: '关于', href: '/about/', icon: 'person' },
];

const fullTitle = title ? `${title} - ${site.tabTitle}` : site.tabTitle;
const canonical = Astro.url.pathname === '/' ? site.url : new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- 站点图标：文件名带版本号，换图标时改版本号可强制浏览器刷新缓存 -->
    <link rel="icon" href="/icon-3.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-3-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-3-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- 搜索引擎站长平台站点验证（验证串填在 src/site.ts 的 verify 里，留空则不输出） -->
    {site.verify.google && <meta name="google-site-verification" content={site.verify.google} />}
    {site.verify.baidu && <meta name="baidu-site-verification" content={site.verify.baidu} />}
    {site.verify.bing && <meta name="msvalidate.01" content={site.verify.bing} />}

    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />

    <!-- 结构化数据：全站 WebSite + 页面级（如文章 BlogPosting） -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- 毛笔书法字体（马善政楷书 + 站酷小薇），用于横幅座右铭 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Ma+Shan+Zheng&family=ZCOOL+XiaoWei&display=swap" rel="stylesheet" />
    <!-- 客户端路由：页面切换不整页刷新，音乐持续播放 -->
    <ClientRouter />
  </head>
  <body class:list={[{ 'has-banner': banner }]}>
    <!-- 阅读进度条 -->
    <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

    <!-- 导航栏 —— 悬浮在壁纸之上 -->
    <header class="top-row" id="top-row">
      <div class="nav-grid container-fluid">
        <a class="brand" href="/">
          <img class="brand-avatar" src={site.avatar} alt="" width="28" height="28" />
          <span class="brand-name">{site.title}</span>
        </a>
        <nav class="nav" aria-label="主导航">
          {navItems.map((it) => (
            <a class="nav-item" href={it.href} aria-current={Astro.url.pathname === it.href ? 'page' : undefined}>
              <Icon name={it.icon} size="1.1rem" />
              <span>{it.label}</span>
            </a>
          ))}
        </nav>
        <div class="nav-actions">
          <a class="nav-btn" href="/search/" title="搜索" aria-label="搜索">
            <Icon name="search" size="1.15rem" />
          </a>
          <button class="nav-btn" id="nav-theme" title="切换主题" aria-label="切换主题">
            <Icon name="palette" size="1.15rem" />
          </button>
          <button class="nav-btn menu-btn" id="menu-btn" title="菜单" aria-label="打开菜单">
            <svg width="1.15rem" height="1.15rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- 手机端菜单 -->
    <div class="mobile-menu" id="mobile-menu">
      <nav class="mobile-nav">
        {navItems.map((it) => (
          <a class="mobile-nav-item" href={it.href} aria-current={Astro.url.pathname === it.href ? 'page' : undefined}>
            <Icon name={it.icon} size="1.1rem" />
            <span>{it.label}</span>
          </a>
        ))}
      </nav>
    </div>

    <!-- 主内容 -->
    <main class="main-layout">
      <slot />

      <!-- 浮动控制 -->
    <div class="floating-controls" id="floating-controls">
      <button class="floating-btn" id="btn-top" title="回到顶部" aria-label="回到顶部">
        <Icon name="arrow_up" size="1.05rem" />
      </button>
      <button class="floating-btn" id="btn-reading" title="沉浸阅读" aria-label="沉浸阅读">
        <Icon name="book" size="1.05rem" />
      </button>
      <button class="floating-btn" id="btn-wallpaper" title="切换壁纸" aria-label="切换壁纸">
        <Icon name="image" size="1.05rem" />
      </button>
    </div>

    <!-- 浮动音乐播放器 —— 左下角常驻，切页不中断 -->
    <div class="music-float expanded" id="music-float" transition:persist>
      <div class="music-float-panel">
        <div class="music-float-head">
          <span class="music-float-title"><Icon name="music" size="0.95rem" /> 音乐</span>
          <button class="music-float-close" id="music-float-toggle" title="收起播放器" aria-label="收起播放器">
            <Icon name="arrow_down" size="0.9rem" />
          </button>
        </div>
        <MusicPlayer />
      </div>
      <!-- 收起后的小按钮 -->
      <button class="music-float-mini" id="music-float-mini" title="展开播放器" aria-label="展开播放器">
        <Icon name="music" size="1.05rem" />
        <span class="mini-eq" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>

      <!-- 首次进入提示：告诉访客左下角可以听歌（点一下展开播放器） -->
      <div class="music-hint" id="music-hint" hidden>
        <span class="mh-emoji" aria-hidden="true">🎵</span>
        <span class="mh-text">左下角可以听歌</span>
        <button class="mh-close" id="mh-close" type="button" aria-label="不再提示">×</button>
      </div>
    </div>

    </main>

    <!-- 页脚 -->
    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© {site.footer.since}–{new Date().getFullYear()} {site.author}</p>
        {site.icp && <p><a href="https://beian.miit.gov.cn/" rel="nofollow" target="_blank">{site.icp}</a></p>}
        <p class="footer-note">由 Astro 构建 · 静态托管 · 关注安全</p>
        <p class="footer-visits" data-vc-wrap style="display:none">
          总访问量 <span data-vc="site_pv">--</span> 次
        </p>
      </div>
    </footer>

    <script>
      // 访问量统计（Vercount 公共服务，静态站免后端）
      // 指标：site_pv 总访问量 / page_pv 单页阅读量
      // 每次 astro:page-load（首屏 + SPA 导航）上报一次当前 URL = 一次页面浏览
      const VC_API = 'https://events.vercount.one/api/v2/log';
      const VC_UV_KEY = 'vercount_uv_tangjin_xyz';
      const VC_CACHE = 'visitorCountData';

      function vcIsNewUv() {
        const has = document.cookie.split('; ').some((c) => c.startsWith(VC_UV_KEY + '='));
        if (!has) document.cookie = VC_UV_KEY + '=1; path=/; max-age=31536000; samesite=lax';
        return !has;
      }

      function vcRender(data) {
        if (!data) return;
        const fmt = (n) => Number(n || 0).toLocaleString('zh-CN');
        document.querySelectorAll('[data-vc="site_pv"]').forEach((el) => { el.textContent = fmt(data.site_pv); });
        document.querySelectorAll('[data-vc="page_pv"]').forEach((el) => { el.textContent = fmt(data.page_pv); });
        document.querySelectorAll('[data-vc-wrap]').forEach((el) => { el.style.display = ''; });
      }

      async function vcLog() {
        try {
          const ctrl = new AbortController();
          const timer = setTimeout(() => ctrl.abort(), 5000);
          const res = await fetch(VC_API, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url: location.href, isNewUv: vcIsNewUv() }),
            signal: ctrl.signal,
          });
          clearTimeout(timer);
          if (!res.ok) throw new Error('HTTP ' + res.status);
          const json = await res.json();
          const data = (json && json.data) || json;
          if (data && typeof data === 'object') {
            try { localStorage.setItem(VC_CACHE, JSON.stringify(data)); } catch (e) {}
            vcRender(data);
            return;
          }
        } catch (e) {}
        // 接口失败时回退到本地缓存的上次数据（仅展示，不重复计数）
        try {
          const cached = localStorage.getItem(VC_CACHE);
          if (cached) vcRender(JSON.parse(cached));
        } catch (e) {}
      }

      let vcFired = false;
      document.addEventListener('astro:page-load', () => { vcFired = true; vcLog(); });
      // 兜底：万一没有 ClientRouter，400ms 后直接执行一次
      setTimeout(() => { if (!vcFired) vcLog(); }, 400);
    </script>

    <script>
      // ============ 全局交互脚本（兼容 ClientRouter 客户端路由） ============
      // 模块脚本只执行一次；客户端路由切页会替换 DOM 元素，旧的事件绑定随元素一起消失。
      // 因此所有「绑定到元素」的初始化都放进 initPage()，在每次 astro:page-load 重新执行；
      // 统一用 onclick= 赋值（而非 addEventListener）保证幂等，重复初始化不会叠加事件。

      const root = document.documentElement;
      const THEME_KEY = 'theme'; // 与侧栏主题卡共用同一个键

      const getSavedTheme = () => {
        try { return localStorage.getItem(THEME_KEY) || 'system'; } catch { return 'system'; }
      };
      const systemTheme = () =>
        window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

      function applyTheme(t) {
        root.setAttribute('data-theme', t === 'system' ? systemTheme() : t);
        try { localStorage.setItem(THEME_KEY, t); } catch {}
      }

      // 首屏恢复主题
      applyTheme(getSavedTheme());

      // 客户端路由换页后 <html> 属性会被新文档覆盖，立即恢复主题，避免闪回亮色
      document.addEventListener('astro:after-swap', () => {
        const t = getSavedTheme();
        root.setAttribute('data-theme', t === 'system' ? systemTheme() : t);
      });

      // 跟随系统时，系统主题变化要实时响应
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (getSavedTheme() === 'system') applyTheme('system');
      });

      // ---- 轻提示：给"点了看不出变化"的按钮一个可见反馈 ----
      let toastTimer = 0;
      function showToast(text) {
        let el = document.getElementById('app-toast');
        if (!el) {
          el = document.createElement('div');
          el.id = 'app-toast';
          document.body.appendChild(el);
        }
        el.textContent = text;
        el.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => el.classList.remove('show'), 1600);
      }

      // ---- 滚动相关：window 上的监听只需挂一次，但内部动态获取元素（切页后元素会换新） ----
      function onScroll() {
        const h = document.documentElement;
        const st = h.scrollTop || document.body.scrollTop;
        const sh = h.scrollHeight - h.clientHeight;
        const bar = document.getElementById('reading-progress');
        if (bar) bar.style.width = (sh > 0 ? (st / sh) * 100 : 0) + '%';
        document.getElementById('top-row')?.classList.toggle('scrolled', window.scrollY > 40);
        const show = window.scrollY > 300;
        document.querySelectorAll('.floating-btn').forEach(b => b.classList.toggle('visible', show));
      }
      window.addEventListener('scroll', onScroll, { passive: true });

      // ---- 手机端菜单（幂等，可在每次换页后重复调用） ----
      function initMobileMenu() {
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        if (!menuBtn || !mobileMenu) return;
        menuBtn.onclick = () => {
          mobileMenu.classList.toggle('open');
          menuBtn.classList.toggle('active');
        };
        mobileMenu.querySelectorAll('.mobile-nav-item').forEach(a => {
          a.onclick = () => {
            mobileMenu.classList.remove('open');
            menuBtn.classList.remove('active');
          };
        });
      }

      // ---- 每次换页都需要重新绑定的交互 ----
      function initPage() {
        onScroll();

        // 沉浸阅读状态：body 会被换页替换，从 localStorage 恢复
        const savedImmersive = (() => { try { return localStorage.getItem('immersive-reading'); } catch { return null; }})();
        document.body.classList.toggle('immersive-reading', savedImmersive === '1');

        // 回到顶部
        const btnTop = document.getElementById('btn-top');
        if (btnTop) btnTop.onclick = () => window.scrollTo({ top: 0, behavior: 'smooth' });

        // 沉浸阅读
        const readingBtn = document.getElementById('btn-reading');
        if (readingBtn) {
          readingBtn.classList.toggle('active', savedImmersive === '1');
          readingBtn.onclick = () => {
            document.body.classList.toggle('immersive-reading');
            readingBtn.classList.toggle('active');
            try {
              localStorage.setItem('immersive-reading',
                document.body.classList.contains('immersive-reading') ? '1' : '0');
            } catch {}
          };
        }

        // 切换壁纸
        const wpBtn = document.getElementById('btn-wallpaper');
        if (wpBtn) {
          wpBtn.onclick = () => {
            const slides = document.querySelectorAll('.wp-slide');
            if (!slides.length) return;
            const active = [...slides].findIndex(s => s.classList.contains('active'));
            slides[active]?.classList.remove('active');
            slides[(active + 1) % slides.length]?.classList.add('active');
          };
        }

        // 导航栏主题按钮：循环 浅色 → 深色 → 跟随系统
        const themeBtn = document.getElementById('nav-theme');
        if (themeBtn) {
          themeBtn.onclick = () => {
            const order = ['light', 'dark', 'system'];
            const cur = getSavedTheme();
            const next = order[(order.indexOf(cur) + 1) % order.length];
            applyTheme(next);
            showToast({ light: '☀ 浅色模式', dark: '🌙 深色模式', system: '🖥 跟随系统' }[next]);
          };
        }

        // 浮动播放器展开/收起（transition:persist 元素不随换页替换，绑定一次即可）
        const mfWrap = document.getElementById('music-float');
        if (mfWrap && !mfWrap.dataset.bound) {
          mfWrap.dataset.bound = '1';
          if (localStorage.getItem('music-float-expanded') === '0') {
            mfWrap.classList.remove('expanded');
          }
          const setExpanded = (open) => {
            mfWrap.classList.toggle('expanded', open);
            try { localStorage.setItem('music-float-expanded', open ? '1' : '0'); } catch {}
          };
          const mfToggle = document.getElementById('music-float-toggle');
          const mfMini = document.getElementById('music-float-mini');
          if (mfToggle) mfToggle.onclick = () => setExpanded(false);
          if (mfMini) mfMini.onclick = () => setExpanded(true);
          const audioEl = document.getElementById('audio-el');
          const syncMf = () => { if (audioEl) mfWrap.classList.toggle('playing', !audioEl.paused); };
          audioEl?.addEventListener('play', syncMf);
          audioEl?.addEventListener('pause', syncMf);
          syncMf();
        }

        initMobileMenu();
      }

      initPage();
      // 客户端路由每次换页完成后重新初始化（首次加载也会触发一次，幂等无副作用）
      document.addEventListener('astro:page-load', initPage);

      // ---- 首次进入提示：左下角可以听歌 ----
      // 每个浏览会话只提示一次（sessionStorage）：点气泡 = 展开播放器，点 × 或 7 秒后自动消失
      (function musicHint() {
        const HINT_KEY = 'music-hint-seen';
        const hint = document.getElementById('music-hint');
        const mfWrap = document.getElementById('music-float');
        if (!hint || !mfWrap) return;
        let seen = false;
        try { seen = sessionStorage.getItem(HINT_KEY) === '1'; } catch (e) {}
        if (seen) return;

        let timer = 0;
        function dismiss() {
          clearTimeout(timer);
          mfWrap.classList.remove('hinting');
          hint.classList.add('hide');
          setTimeout(() => { hint.hidden = true; }, 300);
          try { sessionStorage.setItem(HINT_KEY, '1'); } catch (e) {}
        }
        function show() {
          hint.hidden = false;
          mfWrap.classList.add('hinting');
          timer = setTimeout(dismiss, 7000);
          const closeBtn = document.getElementById('mh-close');
          if (closeBtn) closeBtn.onclick = (e) => { e.stopPropagation(); dismiss(); };
          hint.onclick = (e) => {
            if (e.target === closeBtn) return;
            mfWrap.classList.add('expanded');
            try { localStorage.setItem('music-float-expanded', '1'); } catch (e) {}
            dismiss();
          };
        }
        setTimeout(show, 1200);
      })();
    </script>

    <!-- 百度「自动推送」：页面被访问时自动把该 URL 提交给百度（官方代码，无需 token） -->
    <script is:inline>
      (function () {
        var bp = document.createElement('script');
        var curProtocol = window.location.protocol.split(':')[0];
        if (curProtocol === 'https') {
          bp.src = 'https://zz.bdstatic.com/linksubmit/push.js';
        } else {
          bp.src = 'http://push.zhanzhang.baidu.com/push.js';
        }
        var s = document.getElementsByTagName('script')[0];
        s.parentNode.insertBefore(bp, s);
      })();
    </script>
  </body>
</html>

<style>
  /* ============ 顶部导航 ============ */
  .top-row {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--navbar-height);
    z-index: 80;
    transition: background-color 0.35s ease, backdrop-filter 0.35s ease, border-color 0.35s ease;
    border-bottom: 1px solid transparent;
  }

  /* 滚动后变玻璃 */
  .top-row.scrolled {
    background: oklch(100% 0 0 / 0.72);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    border-bottom-color: var(--border);
  }
  [data-theme='dark'] .top-row.scrolled {
    background: oklch(14% 0.015 250 / 0.75);
  }

  /* 横幅页面：导航栏始终是毛玻璃，悬浮在壁纸之上（参照 c1everf0x.cn） */
  body.has-banner .top-row:not(.scrolled) {
    background: oklch(100% 0 0 / 0.14);
    backdrop-filter: blur(10px) saturate(150%);
    -webkit-backdrop-filter: blur(10px) saturate(150%);
    border-bottom: 1px solid oklch(100% 0 0 / 0.12);
  }
  [data-theme='dark'] body.has-banner .top-row:not(.scrolled) {
    background: oklch(0% 0 0 / 0.22);
    border-bottom-color: oklch(100% 0 0 / 0.08);
  }

  .container-fluid {
    width: 92%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .nav-grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    height: var(--navbar-height);
    gap: 1rem;
  }

  /* 品牌 —— 头像 + 站名（贴最左） */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none !important;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease;
  }
  .brand-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface);
  }
  .brand-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text);
    white-space: nowrap;
  }

  /* 壁纸页面上方文字为白色 */
  body.has-banner .top-row:not(.scrolled) .brand-name { color: #fff; }
  body.has-banner .top-row:not(.scrolled) .brand { text-shadow: 0 1px 10px oklch(0% 0 0 / 0.4); }
  body.has-banner .top-row:not(.scrolled) .brand:hover { background: oklch(100% 0 0 / 0.14); }

  /* 居中导航 */
  .nav {
    display: flex;
    gap: 0.15rem;
    justify-content: center;
  }
  .nav-item {
