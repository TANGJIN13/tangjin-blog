---
import '../styles/global.css';
// 皮肤（配色气质）覆盖层，必须在 global.css 之后 —— 它靠源码顺序 + 属性选择器
// 提升特异性来压过 :root / [data-theme='dark'] 的默认值
import '../styles/skins.css';
import { site } from '../site';
import Icon from '../components/Icon.astro';
import StaggerReveal from '../components/StaggerReveal.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import ImageZoom from '../components/ImageZoom.astro';
import SakuraEffect from '../components/SakuraEffect.astro';
import WallpaperBanner from '../components/WallpaperBanner.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  narrow?: boolean;
  /** 页面顶部是否有壁纸横幅（有则内容下沉，导航悬浮其上） */
  banner?: boolean;
  /**
   * 内页统一横幅：由 Base 直接渲染「同一套轮播壁纸 + 页面标题」
   * （首页大图，内页同一套轮播壁纸压到 35vh，电脑端才显示）
   */
  pageBanner?: boolean;
  bannerTitle?: string;
  bannerDesc?: string;
  bannerIcon?: string;
  /** 页面级结构化数据（如 BlogPosting），注入到 <head> */
  jsonLd?: Record<string, unknown> | null;
}

const {
  title,
  description = site.description,
  image = `${site.url}/images/wallpapers/wallpaper-01.svg`,
  narrow = false,
  banner = false,
  pageBanner = false,
  bannerTitle,
  bannerDesc,
  bannerIcon,
  jsonLd = null,
} = Astro.props;

// 只有真实媒体横幅才启用覆盖导航；普通页面使用编辑式标题区。
// ⚠️ 内页（pageBanner）现在也渲染 WallpaperBanner，所以同样要让导航"悬浮其上"，
//    否则会在壁纸上多留一条导航高度的白边。两种横幅都算 hasBanner。
const hasBanner = banner || pageBanner;

// 全站统一的 WebSite 结构化数据（帮助搜索引擎理解站点）
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.title,
  url: site.url,
  description: site.description,
  author: { '@type': 'Person', name: site.author },
  inLanguage: site.lang,
};

const navItems = [
  { label: '首页', href: '/', icon: 'home' },
  { label: '归档', href: '/archive/', icon: 'archive' },
  { label: '搜索', href: '/search/', icon: 'search' },
  { label: '相册', href: '/album/', icon: 'photo' },
  { label: '说说', href: '/says/', icon: 'comment' },
  { label: '资源库', href: '/downloads/', icon: 'folder' },
  { label: '友链', href: '/friends/', icon: 'link' },
  { label: '留言', href: '/guestbook/', icon: 'mail' },
  { label: '关于', href: '/about/', icon: 'person' },
];

const fullTitle = title ? `${title} - ${site.tabTitle}` : site.tabTitle;
const canonical = Astro.url.pathname === '/' ? site.url : new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- 主题恢复 + 首屏入场标记 —— 都必须在首屏绘制前同步执行。
         ⚠️ 主题为什么挪到这里：原来主题恢复在 body 末尾的模块脚本里（会 defer），
         而 body 里读主题的脚本是**立即执行**的，那时 data-theme 还没设，
         暗色用户会先看到浅色的一帧。顺带这也修掉了站点本身的「暗色用户首帧闪白」。
         ⚠️ 入场标记同理：第一帧就必须把导航藏好，否则会先闪一帧完整的导航条再从头播。
         sessionStorage 里已有标记（软导航 / 本会话看过）时立刻放过，不做任何遮挡。 -->
    <script is:inline>
      (function () {
        // ① 主题：与 Base 末尾的 applyTheme 共用同一个 'theme' 键
        try {
          var pref = localStorage.getItem('theme') || 'system';
          var resolved = pref === 'system'
            ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
            : pref;
          document.documentElement.setAttribute('data-theme', resolved);
        } catch (e) {}
        // ①b 皮肤：和主题同一条理由 —— 必须在首帧前写好，
        //     否则海洋用户会先闪一帧雾紫配色。默认皮肤不写属性，
        //     让 :root 的原始配色生效（老用户零变化）。
        try {
          var skin = localStorage.getItem('skin');
          if (skin && skin !== 'default') {
            document.documentElement.setAttribute('data-skin', skin);
          }
        } catch (e) {}
        // ② 首屏入场：**每次硬加载都播一次**（用户明确要求）。
        //    这里只排除"用户偏好减少动态"这一种情况 —— 不再读 sessionStorage，
        //    否则同一个标签页刷新几次之后入场就再也不播了（这正是"看不到入场特效"的根因）。
        //    站内软导航换页不重播，由 StaggerReveal 的 softNav 标志位负责。
        try {
          if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.documentElement.classList.add('intro-done');
            return;
          }
        } catch (e) {}
        document.documentElement.classList.add('intro-pending');
      })();
    </script>
    <!-- 分层揭幕的「首帧隐藏」样式：必须内联在 <head>，原因同上。
         只藏最关键的几层（导航 / 壁纸 / 内容主体），且只藏 1 帧 —— 解析到 body 的
         StaggerReveal 脚本就把 reveal-run 挂上，动画随即开始。

         ⚠️⚠️ 这里有两套动画，用哪个取决于**该元素里有没有 position:fixed 的后代**：
            `filter` 和 `transform` 都会让元素成为 fixed 后代的**包含块**。
            `.main-layout` 里装着浮动按钮和左下角音乐播放器（都是 fixed），
            一旦给它挂带 filter/transform 的动画，这些固定元素就会以 main 的盒子为参照
            —— 表现是揭幕过程中按钮从屏幕上"飘走"。这个坑在本项目撞过不止一次。
         所以本文件里所有入场动画严格分两类：
            · 绝不含 fixed 后代的层（top-row / 页脚 / 壁纸）→ hero-rise（位移 + 模糊）
            · 含 fixed 后代的层（main-layout / 其内所有区块）→ 一律**只动不透明度** -->
    <style is:inline>
      /* ============ 首屏入场的「首帧隐藏」==========
         必须在 <head> 内联输出：Astro 的 <style> 会打包成外链 CSS，
         而抢首帧脚本走同步路径 —— 那一刻外链还没解析，会先画一帧完整页面再从头播。

         只藏两样东西：
           · 导航栏 —— 它要"轻微下移后淡入"（时间轴的中段）
           · 内容主体（内页限定）—— 内页没有壁纸分镜，让内容自己淡入就够
         首页的壁纸/标题/副标题**不在这里藏**，它们的入场由 WallpaperBanner 自己管
         （intro-run 下的 wp-depth-in / wp-bg-in / wp-glow-in / wp-line-up / wp-sub-in），
         这样职责不交叉。 */
      html.intro-pending .top-row { opacity: 0; }
      html.intro-pending .main-layout:not(:has([data-reveal])) { opacity: 0; }

      /* ============ 统一入场时间轴 ============
         所有元素共用一条时间线，按**视觉重要性**排：背景 → 主标题 → 副标题 →
         导航 → 侧栏 → 内容。每条都用品牌级缓动 cubic-bezier(0.16, 1, 0.3, 1)。
         位移量按重要性递减（主标题上百 px，辅助元素十几 px），
         越不重要的元素动得越少 —— 这是"克制"的关键，不是所有元素都弹一样的距离。 */

      /* ---- 导航栏：轻微下移 → 淡入 ----
         位移只给 12px（比内容的 26px 更克制）：导航是"始终在那儿的框架"，
         动得比内容还多就会喧宾夺主。1700ms 起（主标题落定之后），持续 0.85s。 */
      html.intro-run .top-row {
        animation: nav-in 0.85s cubic-bezier(0.16, 1, 0.3, 1) 1700ms both;
      }
      @keyframes nav-in {
        from { opacity: 0; transform: translateY(-12px); }
        to   { opacity: 1; transform: none; }
      }

      /* ---- 内容主体（内页）：只淡入，绝不动 transform / filter ----
         ⚠️ .main-layout 里装着浮动按钮和左下角音乐播放器，它们都是 position:fixed。
            `transform` / `filter` / `perspective` 都会让元素成为 fixed 后代的**包含块**，
            一旦给它挂带位移或模糊的动画，那些固定元素就会以 main 的盒子为参照
            —— 表现是入场过程中按钮从屏幕上"飘走"。这个坑在本项目撞过不止一次。
         首页的 main 内部有自己的分镜层（[data-reveal] 与侧栏卡片），
         容器再淡入会变成 opacity 相乘（0.5×0.5=0.25）内容发灰，
         所以用 :not(:has([data-reveal])) 把它排除掉，只让内页走这条。 */
      html.intro-run .main-layout:not(:has([data-reveal])) {
        animation: rv-fade 0.95s cubic-bezier(0.16, 1, 0.3, 1) 700ms both;
      }
      @keyframes rv-fade {
        from { opacity: 0; }
        to   { opacity: 1; }
      }

      /* ---- 首页：侧栏卡片 / 内容区块的错峰 ----
         全部只动 opacity。理由有两条（都很实在，不是保守）：
           · 这些卡片在布局上与 .floating-controls 有重叠层级关系，
             保险起见不与 fixed 元素共处一个包含块；
           · 卡片本身有 hover 的 box-shadow / border 过渡，
             一旦父层带 transform，子元素的 hover 阴影在部分浏览器上会被裁。
         每个卡片用自己的 --rv 延迟（由 SidebarLeft / SidebarRight / index 的模板给出）。

         ⚠️ 这里**只认 [data-reveal]**，不认旧的 `.onload-animation`。
            原因：`.onload-animation` 是全局遗留类，还散落在文章卡片（PostCard）、
            归档时间线、相册、资源库、关于页的时间轴上，那些地方靠 inline
            `animation-delay: i*0.05s` 做逐项错峰。若把它也纳入这条规则，
            `animation:` 简写会**连 delay 一起覆盖**成 var(--rv, 0ms)，
            于是所有列表项同时出现、逐项错峰全废。所以两者严格分开：
              · [data-reveal]      → 首页首屏，走本条统一时间轴
              · .onload-animation  → 列表/次级页面，保持各自的 inline delay 不动

         ⚠️ 选择器**必须带上 html.intro-run**。
            这条规则原本写成裸的 `[data-reveal]`（0,0,1,0），
            而 global.css 里 `.onload-animation` 也是 (0,0,1,0) —— 同特异性下
            **后加载的外链 CSS 赢**，于是 `animation: rv-fade` 会被
            `animation: fade-in-up` 整条顶掉。实测：入场期间卡片的
            animation-name 是 `fade-in-up`、duration 0.62s（不是 rv-fade 的 0.85s），
            逐项 delay 0/0.06s 照旧生效 → 卡片在主标题（0.7s 起）之前就逐张冒出来，
            视觉焦点被抢走，正是需求书点名要避免的"所有元素各自为政"。
            加上 `html.intro-run` 后特异性升到 (0,0,2,1)，稳定压过 global.css。 */
      html.intro-run [data-reveal] {
        animation: rv-fade 0.85s cubic-bezier(0.16, 1, 0.3, 1) var(--rv, 0ms) both;
      }

      /* ---- 抑制首页首屏内的"逐项小动画" ----
         PostCard 自带 `.onload-animation` + inline `animation-delay: i*0.06s`
         （服务的是列表页/归档页那种"卡片逐张浮现"）。
         但在首页首屏，这些卡片的父级 [data-reveal] 区块已经做了一次淡入，
         两层叠加会 opacity 相乘（区块 0.5 × 卡片 0.5 = 0.25）→ 内容明显发灰；
         而且卡片的 delay 只有 0~0.5s，比主标题（0.7s 起）还早，会抢走视觉焦点。
         所以：**父级是 [data-reveal] 的卡片，在入场期间不做自己的动画**。
         同样必须带 `html.intro-run`（理由见上一条），否则会被 global.css 的
         `.onload-animation { animation: fade-in-up ... }` 覆盖，抑制失效。
         特异性 (0,0,2,2) —— 高于 `.onload-animation` (0,0,1,0)，
         也高于上一条的 (0,0,2,1)，但两者选择器不重叠，不存在互相顶掉。 */
      html.intro-run :where([data-reveal]) .onload-animation {
        animation: none;
      }

      /* ---- 左栏的头像卡：整条时间轴里"最靠近主标题"的一块 ----
         给它一个轻微的右向位移（从左侧滑入一点点），因为它在主标题正下方，
         是视觉动线从标题延伸到内容的第一个落点。位移只 14px，且**只作用在卡片自身**
         （卡片内部没有 fixed 后代，安全）。 */
      html.intro-run .ref-sidebar-left > [data-reveal]:first-child,
      html.intro-run .ref-sidebar-left .profile-card {
        animation: aside-left-in 0.95s cubic-bezier(0.16, 1, 0.3, 1) var(--rv, 0ms) both;
      }
      @keyframes aside-left-in {
        from { opacity: 0; transform: translateX(-14px); }
        to   { opacity: 1; transform: none; }
      }

      /* ---- 右栏的第一张卡（搜索）：与左栏对称，从右侧轻滑入 ----
         只给第一张，避免右栏整列一起"横移"显得闹。 */
      html.intro-run .ref-sidebar-right > [data-reveal]:first-child {
        animation: aside-right-in 0.95s cubic-bezier(0.16, 1, 0.3, 1) var(--rv, 0ms) both;
      }
      @keyframes aside-right-in {
        from { opacity: 0; transform: translateX(14px); }
        to   { opacity: 1; transform: none; }
      }

      @media (prefers-reduced-motion: reduce) {
        html.intro-pending .top-row,
        html.intro-pending .main-layout:not(:has([data-reveal])) { opacity: 1; }
      }
    </style>
    <!-- 首屏壁纸预加载：让首页大图在解析 body 之前就开始下载，做到「秒出」。
         注意：这里的第一张要和 WallpaperBanner 默认 images 数组的第一张保持一致。 -->
    <link rel="preload" as="image" type="image/avif" href="/images/wallpapers/banner-pastel-01.avif" fetchpriority="high" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- 站点图标：文件名带版本号，换图标时改版本号可强制浏览器刷新缓存 -->
    <link rel="icon" href="/icon-3.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-3-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-3-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- 搜索引擎站长平台站点验证（验证串填在 src/site.ts 的 verify 里，留空则不输出） -->
    {site.verify.google && <meta name="google-site-verification" content={site.verify.google} />}
    {site.verify.baidu && <meta name="baidu-site-verification" content={site.verify.baidu} />}
    {site.verify.bing && <meta name="msvalidate.01" content={site.verify.bing} />}

    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />

    <!-- 结构化数据：全站 WebSite + 页面级（如文章 BlogPosting） -->
    <script type="application/ld+json" set:html={JSON.stringify(websiteLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- 横幅座右铭使用系统楷体，不依赖外部字体服务，加载稳定 -->
    <!-- 客户端路由：页面切换不整页刷新，音乐持续播放 -->
    <ClientRouter />
  </head>
  <body class:list={[{ 'has-banner': hasBanner }]}>
    <!-- 分层揭幕的播放器：只负责「挂标记 / 记会话 / 软导航清理」，
         真正的动画是纯 CSS（见 <head> 里的内联样式），组件本体不渲染任何 DOM。
         必须在 body 最前面，才能赶在第一帧渲染前把 reveal-run 挂上。 -->
    <StaggerReveal />

    <!-- 阅读进度条 -->
    <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

    <!-- 导航栏 —— 悬浮在壁纸之上 -->
    <header class="top-row" id="top-row">
      <div class="nav-grid container-fluid">
        <a class="brand" href="/">
          <img class="brand-avatar" src={site.avatar} alt="" width="28" height="28" />
          <span class="brand-name">{site.title}</span>
        </a>
        <nav class="nav" aria-label="主导航">
          {navItems.map((it) => (
            <a class="nav-item" href={it.href} aria-current={Astro.url.pathname === it.href ? 'page' : undefined}>
              <Icon name={it.icon} size="1.1rem" />
              <span>{it.label}</span>
            </a>
          ))}
        </nav>
        <div class="nav-actions">
          <a class="nav-btn" href="/search/" title="搜索" aria-label="搜索">
            <Icon name="search" size="1.15rem" />
          </a>
          <button class="nav-btn" id="nav-theme" title="切换主题" aria-label="切换主题">
            <Icon name="palette" size="1.15rem" />
          </button>
          <button class="nav-btn menu-btn" id="menu-btn" title="菜单" aria-label="打开菜单">
            <svg width="1.15rem" height="1.15rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- 手机端菜单 -->
    <div class="mobile-menu" id="mobile-menu">
      <nav class="mobile-nav">
        {navItems.map((it) => (
          <a class="mobile-nav-item" href={it.href} aria-current={Astro.url.pathname === it.href ? 'page' : undefined}>
            <Icon name={it.icon} size="1.1rem" />
            <span>{it.label}</span>
          </a>
        ))}
      </nav>
    </div>

    <!-- 主内容 —— 容器本身**不参与**揭幕，让页面内部的区块自己错峰（见 index.astro）。
         两个理由：
           ① 容器里有浮动按钮和音乐播放器（都是 position:fixed），
              给它挂带 transform/filter 的动画会让那些固定元素的包含块变成它自己
              —— 表现是揭幕过程中按钮"飘走"。这个坑本项目撞过不止一次。
           ② 容器 + 内部区块都淡入会造成 opacity 相乘（0.5 × 0.5 = 0.25），
              内容会暗一段再亮回来，观感是"发灰"。让错峰只发生在**一层**里，才不会打架。
         内页（没有独立区块错峰的）由 .main-layout 兜底淡入，见 <head> 里的 CSS。 -->
    <main class="main-layout">
      <!-- 内页横幅：与首页**同一套**水彩轮播壁纸 + 底部波浪。
           用户要求"其他页面也要和首页一样有壁纸"，所以这里不再用纯文字的 .page-intro，
           而是直接复用 WallpaperBanner（slot 模式，放本页的图标 + 标题 + 描述）。
           复用同一个组件的好处：轮播 / 波浪 / 渐变 / 星光(非 slot 模式才开) / 关掉冲突动画
           这些逻辑只有一份，内页自动跟首页保持一致。
           高度比首页矮（不抢内容），且手机端也保留（用户希望所有页面都有）。 -->
      {pageBanner && (
        <WallpaperBanner
          height="clamp(300px, 42vh, 460px)"
          mobileHeight="clamp(230px, 34vh, 340px)"
          mobile
        >
          <div class="wp-page-head">
            <span class="page-intro-kicker">TJ'S BLOG <span aria-hidden="true">/</span> EXPLORE</span>
            <div class="page-intro-title-row">
              {bannerIcon && <span class="page-intro-icon"><Icon name={bannerIcon} size="1.2rem" /></span>}
              <h1 class="page-intro-title">{bannerTitle ?? title ?? site.title}</h1>
            </div>
            {bannerDesc && <p class="page-intro-desc">{bannerDesc}</p>}
          </div>
        </WallpaperBanner>
      )}
      <slot />

      <!-- 浮动控制 -->
    <div class="floating-controls" id="floating-controls">
      <button class="floating-btn" id="btn-top" title="回到顶部" aria-label="回到顶部">
        <Icon name="arrow_up" size="1.05rem" />
      </button>
      <button class="floating-btn" id="btn-reading" title="沉浸阅读" aria-label="沉浸阅读">
        <Icon name="book" size="1.05rem" />
      </button>
      <button class="floating-btn" id="btn-wallpaper" title="切换壁纸" aria-label="切换壁纸">
        <Icon name="image" size="1.05rem" />
      </button>
      <!-- 樱花开关。放在这一列的**最下面**：这一列是靠底对齐的（bottom 定位 + 内容撑高），
           所以最下面那个按钮的位置永远不动，上面三个出现/消失都不会把它顶走。
           和另外三个一样常显（.visible 在 CSS 里其实没有对应规则，是个历史遗留的空类）。
           行为逻辑在 SakuraEffect.astro 里，这里只放按钮本体。 -->
      <button class="floating-btn" id="btn-sakura" title="一直飘樱花" aria-label="切换樱花特效" aria-pressed="false">
        <Icon name="sparkle" size="1.05rem" />
      </button>
    </div>

    <!-- 浮动音乐播放器 —— 左下角常驻，切页不中断 -->
    <div class="music-float expanded" id="music-float" transition:persist>
      <div class="music-float-panel">
        <div class="music-float-head">
          <span class="music-float-title"><Icon name="music" size="0.95rem" /> 音乐</span>
          <button class="music-float-close" id="music-float-toggle" title="收起播放器" aria-label="收起播放器">
            <Icon name="arrow_down" size="0.9rem" />
          </button>
        </div>
        <MusicPlayer />
      </div>
      <!-- 收起后的小按钮 -->
      <button class="music-float-mini" id="music-float-mini" title="展开播放器" aria-label="展开播放器">
        <Icon name="music" size="1.05rem" />
        <span class="mini-eq" aria-hidden="true"><i></i><i></i><i></i></span>
      </button>

      <!-- 首次进入提示：告诉访客左下角可以听歌（点一下展开播放器） -->
      <div class="music-hint" id="music-hint" hidden>
        <span class="mh-emoji" aria-hidden="true">🎵</span>
        <span class="mh-text">左下角可以听歌</span>
        <button class="mh-close" id="mh-close" type="button" aria-label="不再提示">×</button>
      </div>
    </div>

    </main>

    <!-- 图片放大查看层：正文里的图点击后全屏观看 -->
    <ImageZoom />

    <!-- 樱花飘落特效：全站生效，右下角有开关（开站飘一阵子 / 常开 / 关闭） -->
    <SakuraEffect />

    <!-- 页脚 -->
    <footer class="site-footer" data-reveal style="--rv: 2800ms">
      <div class="container footer-inner">
        <p>© {site.footer.since}–{new Date().getFullYear()} {site.author}</p>
        {site.icp && <p><a href="https://beian.miit.gov.cn/" rel="nofollow" target="_blank">{site.icp}</a></p>}
        <p class="footer-note">由 Astro 构建 · 静态托管 · 关注安全</p>
        <p class="footer-visits" data-vc-wrap style="display:none">
          总访问量 <span data-vc="site_pv">--</span> 次
        </p>
      </div>
    </footer>

    <script>
      // 访问量统计（Vercount 公共服务，静态站免后端）
      // 指标：site_pv 总访问量 / page_pv 单页阅读量
      // 每次 astro:page-load（首屏 + SPA 导航）上报一次当前 URL = 一次页面浏览
      const VC_API = 'https://events.vercount.one/api/v2/log';
      const VC_UV_KEY = 'vercount_uv_tangjin_xyz';
      const VC_CACHE = 'visitorCountData';

      function vcIsNewUv() {
        const has = document.cookie.split('; ').some((c) => c.startsWith(VC_UV_KEY + '='));
        if (!has) document.cookie = VC_UV_KEY + '=1; path=/; max-age=31536000; samesite=lax';
        return !has;
      }

      function vcRender(data) {
        if (!data) return;
        const fmt = (n) => Number(n || 0).toLocaleString('zh-CN');
        document.querySelectorAll('[data-vc="site_pv"]').forEach((el) => { el.textContent = fmt(data.site_pv); });
        document.querySelectorAll('[data-vc="page_pv"]').forEach((el) => { el.textContent = fmt(data.page_pv); });
        document.querySelectorAll('[data-vc-wrap]').forEach((el) => { el.style.display = ''; });
      }

      async function vcLog() {
        try {
          const ctrl = new AbortController();
          const timer = setTimeout(() => ctrl.abort(), 5000);
          const res = await fetch(VC_API, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url: location.href, isNewUv: vcIsNewUv() }),
            signal: ctrl.signal,
          });
          clearTimeout(timer);
          if (!res.ok) throw new Error('HTTP ' + res.status);
          const json = await res.json();
          const data = (json && json.data) || json;
          if (data && typeof data === 'object') {
            try { localStorage.setItem(VC_CACHE, JSON.stringify(data)); } catch (e) {}
            vcRender(data);
            return;
          }
        } catch (e) {}
        // 接口失败时回退到本地缓存的上次数据（仅展示，不重复计数）
        try {
          const cached = localStorage.getItem(VC_CACHE);
          if (cached) vcRender(JSON.parse(cached));
        } catch (e) {}
      }

      let vcFired = false;
      document.addEventListener('astro:page-load', () => { vcFired = true; vcLog(); });
      // 兜底：万一没有 ClientRouter，400ms 后直接执行一次
      setTimeout(() => { if (!vcFired) vcLog(); }, 400);
    </script>

    <script>
      // ============ 全局交互脚本（兼容 ClientRouter 客户端路由） ============
      // 模块脚本只执行一次；客户端路由切页会替换 DOM 元素，旧的事件绑定随元素一起消失。
      // 因此所有「绑定到元素」的初始化都放进 initPage()，在每次 astro:page-load 重新执行；
      // 统一用 onclick= 赋值（而非 addEventListener）保证幂等，重复初始化不会叠加事件。

      const root = document.documentElement;
      const THEME_KEY = 'theme'; // 与侧栏主题卡共用同一个键

      const getSavedTheme = () => {
        try { return localStorage.getItem(THEME_KEY) || 'system'; } catch { return 'system'; }
      };
      const systemTheme = () =>
        window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

      function applyTheme(t) {
        root.setAttribute('data-theme', t === 'system' ? systemTheme() : t);
        try { localStorage.setItem(THEME_KEY, t); } catch {}
      }

      // 首屏恢复主题
      applyTheme(getSavedTheme());

      // 客户端路由换页后 <html> 属性会被新文档覆盖，立即恢复主题，避免闪回亮色
      document.addEventListener('astro:after-swap', () => {
        const t = getSavedTheme();
        root.setAttribute('data-theme', t === 'system' ? systemTheme() : t);
      });

      // 跟随系统时，系统主题变化要实时响应
      window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
        if (getSavedTheme() === 'system') applyTheme('system');
      });

      // ---- 轻提示：给"点了看不出变化"的按钮一个可见反馈 ----
      let toastTimer = 0;
      function showToast(text) {
        let el = document.getElementById('app-toast');
        if (!el) {
          el = document.createElement('div');
          el.id = 'app-toast';
          document.body.appendChild(el);
        }
        el.textContent = text;
        el.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => el.classList.remove('show'), 1600);
      }

      // ---- 滚动相关：window 上的监听只需挂一次，但内部动态获取元素（切页后元素会换新） ----
      function onScroll() {
        const h = document.documentElement;
        const st = h.scrollTop || document.body.scrollTop;
        const sh = h.scrollHeight - h.clientHeight;
        const bar = document.getElementById('reading-progress');
        if (bar) bar.style.width = (sh > 0 ? (st / sh) * 100 : 0) + '%';
        document.getElementById('top-row')?.classList.toggle('scrolled', window.scrollY > 40);
        const show = window.scrollY > 300;
        document.querySelectorAll('.floating-btn').forEach(b => b.classList.toggle('visible', show));
      }
      window.addEventListener('scroll', onScroll, { passive: true });

      // ---- 手机端菜单（幂等，可在每次换页后重复调用） ----
      function initMobileMenu() {
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        if (!menuBtn || !mobileMenu) return;
        menuBtn.onclick = () => {
          mobileMenu.classList.toggle('open');
          menuBtn.classList.toggle('active');
        };
        mobileMenu.querySelectorAll('.mobile-nav-item').forEach(a => {
          a.onclick = () => {
            mobileMenu.classList.remove('open');
            menuBtn.classList.remove('active');
          };
        });
      }

      // ---- 每次换页都需要重新绑定的交互 ----
      function initPage() {
        onScroll();

        // 沉浸阅读状态：body 会被换页替换，从 localStorage 恢复
        const savedImmersive = (() => { try { return localStorage.getItem('immersive-reading'); } catch { return null; }})();
        document.body.classList.toggle('immersive-reading', savedImmersive === '1');

        // 回到顶部
        const btnTop = document.getElementById('btn-top');
        if (btnTop) btnTop.onclick = () => window.scrollTo({ top: 0, behavior: 'smooth' });

        // 沉浸阅读
        const readingBtn = document.getElementById('btn-reading');
        if (readingBtn) {
          readingBtn.classList.toggle('active', savedImmersive === '1');
          readingBtn.onclick = () => {
            document.body.classList.toggle('immersive-reading');
            readingBtn.classList.toggle('active');
            try {
              localStorage.setItem('immersive-reading',
                document.body.classList.contains('immersive-reading') ? '1' : '0');
            } catch {}
          };
        }

        // 切换壁纸
        const wpBtn = document.getElementById('btn-wallpaper');
        if (wpBtn) {
          wpBtn.onclick = () => {
            const slides = document.querySelectorAll('.wp-slide');
            if (!slides.length) return;
            const active = [...slides].findIndex(s => s.classList.contains('active'));
            slides[active]?.classList.remove('active');
            slides[(active + 1) % slides.length]?.classList.add('active');
          };
        }

        // 导航栏主题按钮：循环 浅色 → 深色 → 跟随系统
        const themeBtn = document.getElementById('nav-theme');
        if (themeBtn) {
          themeBtn.onclick = () => {
            const order = ['light', 'dark', 'system'];
            const cur = getSavedTheme();
            const next = order[(order.indexOf(cur) + 1) % order.length];
            applyTheme(next);
            showToast({ light: '☀ 浅色模式', dark: '🌙 深色模式', system: '🖥 跟随系统' }[next]);
          };
        }

        // 浮动播放器展开/收起（transition:persist 元素不随换页替换，绑定一次即可）
        const mfWrap = document.getElementById('music-float');
        if (mfWrap && !mfWrap.dataset.bound) {
          mfWrap.dataset.bound = '1';
          // 起始状态：宽屏上左侧栏是常驻的，展开的播放器卡片会盖住左侧栏底部的组件，
          // 所以「宽屏且页面有左侧栏」时默认收起（提示气泡仍会告诉访客左下角有播放器）；
          // 窄屏没有左侧栏，维持默认展开。一旦用户手动展开/收起，就以其存储的偏好为准。
          let mfPref = null;
          try { mfPref = localStorage.getItem('music-float-expanded'); } catch (e) {}
          const mfWideHasSidebar =
            window.matchMedia('(min-width: 1024px)').matches && !!document.querySelector('.ref-sidebar-left');
          if (mfPref === '0' || (mfPref === null && mfWideHasSidebar)) {
            mfWrap.classList.remove('expanded');
          }
          const setExpanded = (open) => {
            mfWrap.classList.toggle('expanded', open);
            try { localStorage.setItem('music-float-expanded', open ? '1' : '0'); } catch {}
          };
          const mfToggle = document.getElementById('music-float-toggle');
          const mfMini = document.getElementById('music-float-mini');
          if (mfToggle) mfToggle.onclick = () => setExpanded(false);
          if (mfMini) mfMini.onclick = () => setExpanded(true);
          const audioEl = document.getElementById('audio-el');
          const syncMf = () => { if (audioEl) mfWrap.classList.toggle('playing', !audioEl.paused); };
          audioEl?.addEventListener('play', syncMf);
          audioEl?.addEventListener('pause', syncMf);
          syncMf();
        }

        initMobileMenu();
      }

      initPage();
      // 客户端路由每次换页完成后重新初始化（首次加载也会触发一次，幂等无副作用）
      document.addEventListener('astro:page-load', initPage);

      // ---- 首次进入提示：左下角可以听歌 ----
      // 每个浏览会话只提示一次（sessionStorage）：点气泡 = 展开播放器，点 × 或 7 秒后自动消失
      (function musicHint() {
        const HINT_KEY = 'music-hint-seen';
        const hint = document.getElementById('music-hint');
        const mfWrap = document.getElementById('music-float');
        if (!hint || !mfWrap) return;
        let seen = false;
        try { seen = sessionStorage.getItem(HINT_KEY) === '1'; } catch (e) {}
        if (seen) return;

        let timer = 0;
        function dismiss() {
          clearTimeout(timer);
          mfWrap.classList.remove('hinting');
          hint.classList.add('hide');
          setTimeout(() => { hint.hidden = true; }, 300);
          try { sessionStorage.setItem(HINT_KEY, '1'); } catch (e) {}
        }
        function show() {
          hint.hidden = false;
          mfWrap.classList.add('hinting');
          timer = setTimeout(dismiss, 7000);
          const closeBtn = document.getElementById('mh-close');
          if (closeBtn) closeBtn.onclick = (e) => { e.stopPropagation(); dismiss(); };
          hint.onclick = (e) => {
            if (e.target === closeBtn) return;
            mfWrap.classList.add('expanded');
            try { localStorage.setItem('music-float-expanded', '1'); } catch (e) {}
            dismiss();
          };
        }
        setTimeout(show, 1200);
      })();
    </script>

    <!-- 百度「自动推送」：页面被访问时自动把该 URL 提交给百度（官方代码，无需 token） -->
    <script is:inline>
      (function () {
        var bp = document.createElement('script');
        var curProtocol = window.location.protocol.split(':')[0];
        if (curProtocol === 'https') {
          bp.src = 'https://zz.bdstatic.com/linksubmit/push.js';
        } else {
          bp.src = 'http://push.zhanzhang.baidu.com/push.js';
        }
        var s = document.getElementsByTagName('script')[0];
        s.parentNode.insertBefore(bp, s);
      })();
    </script>
  </body>
</html>

<style>
  /* ============ 顶部导航 ============ */
  .top-row {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--navbar-height);
    z-index: 80;
    transition: background-color 0.35s ease, backdrop-filter 0.35s ease, border-color 0.35s ease;
    border-bottom: 1px solid transparent;
  }

  /* 滚动后变玻璃 */
  .top-row.scrolled {
    background: oklch(100% 0 0 / 0.72);
    backdrop-filter: blur(14px) saturate(160%);
    border-bottom-color: var(--border);
  }
  :global([data-theme='dark'] .top-row.scrolled) {
    background: oklch(14% 0.015 282 / 0.75);
  }

  /* 横幅页面：导航栏始终是毛玻璃，悬浮在壁纸之上。
     这层白玻璃的透明度 = 白字的对比度预算：它越白，底下的浅色壁纸就被抬得越亮，白字越糊。
     壁纸遮罩改轻之后（见 WallpaperBanner.astro）底色整体更亮，所以这里同步收一档：
     桌面 14% → 10%、小屏 6% → 4.5%。
     既把对比度补回来，也让导航条少一层白雾、多透出一点壁纸本身的颜色。 */
  body.has-banner .top-row:not(.scrolled) {
    background: oklch(100% 0 0 / 0.10);
    backdrop-filter: blur(10px) saturate(150%);
    border-bottom: 1px solid oklch(100% 0 0 / 0.12);
  }
  :global([data-theme='dark'] body.has-banner .top-row:not(.scrolled)) {
    background: oklch(0% 0 0 / 0.22);
    border-bottom-color: oklch(100% 0 0 / 0.08);
  }
  @media (max-width: 1023px) {
    body.has-banner .top-row:not(.scrolled) { background: oklch(100% 0 0 / 0.045); }
  }

  .container-fluid {
    width: 92%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .nav-grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    height: var(--navbar-height);
    gap: 1rem;
  }

  /* 品牌 —— 头像 + 站名（贴最左） */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none !important;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease;
  }
  .brand-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface);
  }
  .brand-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text);
    white-space: nowrap;
  }

  /* 壁纸页面上方文字为白色 */
  body.has-banner .top-row:not(.scrolled) .brand-name { color: #fff; }
  body.has-banner .top-row:not(.scrolled) .brand { text-shadow: 0 1px 10px oklch(0% 0 0 / 0.4); }
  body.has-banner .top-row:not(.scrolled) .brand:hover { background: oklch(100% 0 0 / 0.14); }

  /* 居中导航 */
  .nav {
    display: flex;
    gap: 0.15rem;
    justify-content: center;
  }
  .nav-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-soft);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none !important;
    white-space: nowrap;
    transition: color 0.18s ease, background-color 0.18s ease;
  }
  .nav-item :global(.icon) { opacity: 0.85; transition: transform 0.18s ease; }
  .nav-item:hover { color: var(--text); background: oklch(0% 0 0 / 0.05); }
  .nav-item:hover :global(.icon) { transform: translateY(-1px); }

  /* 悬停/激活时从中间展开的下划线 */
  .nav-item::after {
    content: '';
    position: absolute;
    left: 0.7rem; right: 0.7rem; bottom: 0.14rem;
    height: 2px;
    border-radius: 2px;
    background: var(--primary);
    transform: scaleX(0);
    transform-origin: center;
    transition: transform 0.24s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .nav-item:hover::after,
  .nav-item[aria-current='page']::after { transform: scaleX(1); }

  .nav-item[aria-current='page'] {
    color: var(--primary-strong);
    background: var(--primary-soft);
    font-weight: 600;
  }
  :global([data-theme='dark'] .nav-item[aria-current='page']) { color: var(--primary-light); }

  /* 中等宽度 1024–1279px：导航项缩进一点，保证 9 个入口也不会挤出去 */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .nav { gap: 0; }
    .nav-item { padding: 0.4rem 0.45rem 0.5rem; font-size: 0.85rem; gap: 0.25rem; }
    .nav-item::after { left: 0.45rem; right: 0.45rem; }
  }

  /* 壁纸页面上方导航为白色 */
  body.has-banner .top-row:not(.scrolled) .nav-item { color: oklch(100% 0 0 / 0.88); }
  body.has-banner .top-row:not(.scrolled) .nav-item::after { background: #fff; }
  body.has-banner .top-row:not(.scrolled) .nav-item:hover {
    color: #fff;
    background: oklch(100% 0 0 / 0.16);
  }
  body.has-banner .top-row:not(.scrolled) .nav-item[aria-current='page'] {
    color: #fff;
    background: oklch(100% 0 0 / 0.22);
  }

  .nav-actions { display: flex; justify-content: flex-end; gap: 0.25rem; }
  .nav-btn {
    width: 38px; height: 38px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-soft);
    font-size: 1rem;
    cursor: pointer;
    display: grid;
    place-items: center;
    text-decoration: none !important;
    transition: all 0.18s ease;
  }
  .nav-btn:hover { background: oklch(0% 0 0 / 0.05); border-color: var(--border); color: var(--primary); }
  body.has-banner .top-row:not(.scrolled) .nav-btn { color: #fff; }
  body.has-banner .top-row:not(.scrolled) .nav-btn:hover { background: oklch(100% 0 0 / 0.16); }

  /* ============ 主内容 ============ */
  /* 导航栏固定，无壁纸时内容需下沉让出导航高度 */
  .main-layout { padding-block: 1.5rem; padding-top: calc(var(--navbar-height) + 1.5rem); }
  body.has-banner .main-layout { padding-top: 0; }

  /* ===== 内页题签：像一本研究刊物的章节扉页 ===== */
  .page-intro {
    position: relative;
    overflow: hidden;
    padding: clamp(2.1rem, 4vw, 3.7rem) 0 clamp(1.45rem, 2.6vw, 2.2rem);
    border-bottom: 1px solid var(--border);
    background:
      linear-gradient(90deg, color-mix(in srgb, var(--primary) 4%, transparent) 1px, transparent 1px),
      linear-gradient(180deg, color-mix(in srgb, var(--surface) 75%, transparent), transparent);
    background-size: 52px 100%, auto;
  }
  .page-intro-inner { position: relative; }
  .page-intro-kicker {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    color: var(--text-faint);
    font: 600 0.61rem/1.4 var(--font-mono);
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .page-intro-kicker i { width: 1.5rem; height: 1px; background: var(--accent); }
  .page-intro-title-row { display: flex; align-items: center; gap: 0.9rem; margin-top: 0.7rem; }
  .page-intro-title {
    margin: 0;
    color: var(--text);
    font-family: var(--font-display);
    font-size: clamp(2.15rem, 5vw, 4.2rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.12;
  }
  .page-intro-icon { display: grid; width: 2.45rem; height: 2.45rem; place-items: center; color: var(--primary); border: 1px solid var(--border); border-radius: 50%; }
  .page-intro-desc { margin: 0.65rem 0 0; color: var(--text-soft); font-size: 0.87rem; letter-spacing: 0.015em; }
  .page-intro-index { position: absolute; right: 0; bottom: 0.3rem; color: var(--text-faint); font: 0.62rem var(--font-mono); letter-spacing: 0.15em; }
  .wp-page-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-align: center;
    animation: wp-page-reveal 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }
  @keyframes wp-page-reveal {
    from { opacity: 0; transform: translateY(22px); filter: blur(8px); }
    to   { opacity: 1; transform: translateY(0); filter: blur(0); }
  }
  .wp-page-icon {
    display: inline-grid;
    place-items: center;
    width: 44px; height: 44px;
    border-radius: 14px;
    color: #fff;
    background: oklch(100% 0 0 / 0.16);
    border: 1px solid oklch(100% 0 0 / 0.28);
    backdrop-filter: blur(10px);
    margin-bottom: 0.15rem;
  }
  .wp-page-title {
    margin: 0;
    font-size: clamp(1.9rem, 4.2vw, 3.4rem);
    font-weight: 800;
    letter-spacing: 0.01em;
    color: #fff;
    line-height: 1.2;
    text-shadow: 0 4px 26px oklch(0% 0 0 / 0.55);
  }
  .wp-page-desc {
    margin: 0;
    max-width: 34rem;
    font-size: clamp(0.86rem, 1.3vw, 1rem);
    color: oklch(100% 0 0 / 0.9);
    text-shadow: 0 1px 12px oklch(0% 0 0 / 0.5);
    line-height: 1.6;
  }

  /* 内页横幅里的文字：.page-intro-* 原本是**深色纸面**上的排版（浅底深字），
     现在被放进壁纸里，必须整体翻成"浅底白字 + 描边影"，否则在深色水彩上看不清。
     注意 kicker / desc 的 --text-faint / --text-soft 在浅色主题是深灰，
     压在壁纸上几乎不可读，所以这里逐条覆盖（不是改原规则，避免影响别处）。
     ⚠️ 锚点必须是 `.wp-page-head`（Base 自己模板里的节点，带 Base 的 scope），
     不能写 `.wallpaper-wrapper` —— 那是 WallpaperBanner 子组件渲染的节点，
     带的是**子组件的** data-astro-cid，父组件 scope 命中不了，
     整条规则会被编译成 `.wallpaper-wrapper[data-astro-cid-父] ...` 而永远失配（本坑已踩过一次）。 */
  .wp-page-head .page-intro-kicker {
    justify-content: center;
    color: oklch(100% 0 0 / 0.72);
    text-shadow: 0 1px 8px oklch(0% 0 0 / 0.45);
  }
  .wp-page-head .page-intro-kicker i,
  .wp-page-head .page-intro-kicker span { color: inherit; }
  .wp-page-head .page-intro-title-row { gap: 0.75rem; margin-top: 0.55rem; }
  .wp-page-head .page-intro-title {
    color: #fff;
    font-size: clamp(1.9rem, 4.2vw, 3.4rem);
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55), 0 4px 26px rgba(0, 0, 0, 0.5);
  }
  .wp-page-head .page-intro-icon {
    color: #fff;
    border-color: oklch(100% 0 0 / 0.35);
    background: oklch(100% 0 0 / 0.14);
    backdrop-filter: blur(8px);
  }
  .wp-page-head .page-intro-desc {
    color: oklch(100% 0 0 / 0.88);
    text-shadow: 0 1px 10px oklch(0% 0 0 / 0.5);
  }
  /* 内页横幅也走首屏分镜：标题从下方升起，和首页一致的手感。
     ⚠️ 只在内页横幅（.wp-page-head）上挂，首页的书法标题有自己的揭幕逻辑，不冲突。 */
  html.intro-run .wp-page-head {
    animation: wp-page-reveal 1.1s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }

  /* ============ 页脚 ============ */
  .site-footer {
    margin-top: 3rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-soft);
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: center;
    font-size: 0.88rem;
  }
  .footer-inner p { margin: 0; }
  .footer-note { color: var(--text-faint); font-size: 0.78rem; }
  .footer-visits { color: var(--text-faint); font-size: 0.78rem; }
  .footer-visits span[data-vc] { color: var(--primary-strong); font-weight: 600; font-variant-numeric: tabular-nums; }

  /* ============ 浮动音乐播放器 —— 左下角常驻 ============ */
  .music-float {
    position: fixed;
    left: 1.25rem;
    bottom: 1.5rem;
    z-index: 75;
  }
  .music-float-panel {
    width: 300px;
    max-width: calc(100vw - 2.5rem);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 32px oklch(0% 0 0 / 0.14);
    overflow: hidden;
  }
  .music-float-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.85rem;
    background: linear-gradient(145deg,
      oklch(97% 0.02 282) 0%,
      oklch(95% 0.03 15) 100%);
    border-bottom: 1px solid var(--border);
  }
  :global([data-theme='dark'] .music-float-head) {
    background: linear-gradient(145deg,
      oklch(21% 0.03 282) 0%,
      oklch(18% 0.04 15) 100%);
  }
  .music-float-title {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text);
  }
  .music-float-title :global(.icon) { color: var(--primary); }
  .music-float-close {
    width: 26px; height: 26px;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--text-faint);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: all 0.18s ease;
  }
  .music-float-close:hover { background: oklch(0% 0 0 / 0.06); color: var(--text); }
  .music-float-panel :global(.music-player) {
    border: none;
    border-radius: 0;
    background: transparent;
  }

  /* 收起后的小按钮（默认隐藏） */
  .music-float-mini {
    display: none;
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: oklch(100% 0 0 / 0.88);
    backdrop-filter: blur(10px);
    color: var(--primary);
    cursor: pointer;
    place-items: center;
    box-shadow: 0 4px 16px oklch(0% 0 0 / 0.14);
    transition: all 0.2s ease;
  }
  :global([data-theme='dark'] .music-float-mini) { background: oklch(20% 0.02 282 / 0.88); }
  .music-float-mini:hover { transform: scale(1.08); box-shadow: 0 6px 22px oklch(0% 0 0 / 0.18); }

  /* 播放时收起按钮显示动态均衡器（替代静态音符图标） */
  .music-float-mini .mini-eq { display: none; align-items: flex-end; gap: 2px; height: 16px; }
  .music-float-mini .mini-eq i {
    width: 3px; height: 5px; border-radius: 2px;
    background: var(--primary); transform-origin: bottom;
    animation: mini-eq 0.9s ease-in-out infinite;
  }
  .music-float-mini .mini-eq i:nth-child(2) { animation-delay: 0.2s; }
  .music-float-mini .mini-eq i:nth-child(3) { animation-delay: 0.4s; }
  @keyframes mini-eq { 0%, 100% { height: 5px; } 50% { height: 15px; } }
  .music-float.playing:not(.expanded) .music-float-mini .icon { display: none; }
  .music-float.playing:not(.expanded) .music-float-mini .mini-eq { display: inline-flex; }

  /* ===== 首次进入的「可以听歌」提示气泡（浮在播放器上方，小三角指向左下角） ===== */
  .music-hint {
    position: absolute;
    left: 0;
    bottom: calc(100% + 0.65rem);
    z-index: 90;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.45rem 0.45rem 0.45rem 0.8rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 10px 30px oklch(0% 0 0 / 0.18);
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text);
    white-space: nowrap;
    animation: hint-pop 0.45s cubic-bezier(0.16, 1, 0.3, 1) both, hint-bob 2.2s ease-in-out 1s infinite;
  }
  .music-hint[hidden] { display: none; }
  /* 指向下方播放器的小三角 */
  .music-hint::after {
    content: '';
    position: absolute;
    left: 1.15rem;
    top: 100%;
    border: 6px solid transparent;
    border-top-color: var(--surface);
  }
  .music-hint::before {
    content: '';
    position: absolute;
    left: 1.1rem;
    top: calc(100% + 1px);
    border: 7px solid transparent;
    border-top-color: var(--border);
    z-index: -1;
  }
  .mh-emoji { font-size: 0.95rem; line-height: 1; }
  .mh-text { letter-spacing: 0.01em; }
  .mh-close {
    width: 22px; height: 22px;
    border: none; border-radius: 50%;
    background: var(--surface-2);
    color: var(--text-faint);
    font-size: 0.95rem; line-height: 1;
    cursor: pointer;
    display: grid; place-items: center;
    transition: all 0.16s ease;
  }
  .mh-close:hover { background: var(--primary-soft); color: var(--primary-strong); }

  .music-hint.hide { animation: hint-out 0.28s ease both; }
  @keyframes hint-pop { from { opacity: 0; transform: translateY(8px) scale(0.96); } to { opacity: 1; transform: none; } }
  @keyframes hint-bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
  @keyframes hint-out { to { opacity: 0; transform: translateY(6px) scale(0.98); } }

  /* 提示期间给播放器本体一圈主色光晕，视线更容易被引导过去 */
  .music-float.hinting .music-float-mini,
  .music-float.hinting .music-float-panel {
    box-shadow: 0 0 0 3px oklch(70% 0.14 282 / 0.35), 0 8px 28px oklch(0% 0 0 / 0.16);
  }

  /* 展开态：显示面板，隐藏小按钮 */
  .music-float.expanded .music-float-panel { display: block; }
  .music-float.expanded .music-float-mini { display: none; }

  /* 收起态：隐藏面板，显示小按钮 */
  .music-float:not(.expanded) .music-float-panel { display: none; }
  .music-float:not(.expanded) .music-float-mini { display: grid; }

  /* 正在播放时小按钮脉冲 */
  .music-float.playing:not(.expanded) .music-float-mini {
    animation: music-pulse 2.4s ease-in-out infinite;
  }
  @keyframes music-pulse {
    0%, 100% { box-shadow: 0 4px 16px oklch(70% 0.14 282 / 0.25); }
    50%      { box-shadow: 0 4px 26px oklch(70% 0.14 282 / 0.5); }
  }

  @media (max-width: 640px) {
    .music-float { left: 0.75rem; bottom: 0.75rem; }
    .music-float-panel { width: 260px; }
  }

  /* 手机端汉堡菜单按钮 */
  .menu-btn { display: none; }
  @media (max-width: 1023px) {
    .menu-btn { display: grid; }
  }

  /* 手机端菜单面板 —— 参照站风格：圆角卡片浮层 */
  .mobile-menu {
    display: none;
    position: fixed;
    top: calc(var(--navbar-height) + 0.4rem);
    right: 0.75rem;
    width: max-content;
    min-width: 13rem;
    z-index: 99;
    background: oklch(100% 0 0 / 0.82);
    backdrop-filter: blur(16px) saturate(150%);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 10px 40px oklch(0% 0 0 / 0.16), 0 2px 8px oklch(0% 0 0 / 0.06);
    max-height: calc(100vh - var(--navbar-height) - 3rem);
    overflow-y: auto;
    padding: 0.4rem;
    transform: translateY(-8px) scale(0.97);
    opacity: 0;
    transform-origin: top right;
    transition: transform 0.28s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.2s ease;
  }
  .mobile-menu.open {
    display: block;
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  :global([data-theme='dark'] .mobile-menu) {
    background: oklch(22% 0.02 282 / 0.88);
    border-color: oklch(100% 0 0 / 0.08);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
  }
  .mobile-nav-item {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.75rem;
    border-radius: var(--radius-md);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--text-soft);
    text-decoration: none !important;
    transition: all 0.18s ease;
  }
  .mobile-nav-item:hover {
    background: oklch(95% 0.03 282);
    color: var(--text);
  }
  .mobile-nav-item[aria-current='page'] {
    color: var(--primary-strong);
    background: var(--primary-soft);
    font-weight: 600;
  }
  :global([data-theme='dark'] .mobile-nav-item:hover) { background: oklch(28% 0.03 282); }
  .mobile-nav-item :global(.icon) { opacity: 0.85; }

  @media (max-width: 1023px) {
    .nav { display: none; }
    .nav-grid { grid-template-columns: auto 1fr; }
  }

  /* ============ 轻提示 toast ============ */
  #app-toast {
    position: fixed;
    left: 50%;
    bottom: 6.5rem;
    transform: translate(-50%, 12px);
    z-index: 300;
    padding: 0.5rem 1.1rem;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text);
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 8px 28px oklch(0% 0 0 / 0.18);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  #app-toast.show {
    opacity: 1;
    transform: translate(-50%, 0);
  }
</style>

<style is:global>
  @media (max-width: 768px) {
    /* 手机端保留侧栏模块（个人卡/搜索/日历/统计），上下堆叠展示 */
    .ref-layout { grid-template-columns: 1fr !important; gap: 0.75rem; }
    .container,
    .post-layout { width: 100% !important; max-width: 100% !important; padding-inline: 0.75rem; }
    .wallpaper-wrapper { height: clamp(280px, 50vh, 400px) !important; }
    .post-card { flex-direction: column; }
    .post-card .cover { width: 100% !important; aspect-ratio: 16/9; }
    .music-float { left: 0.5rem; bottom: 1rem; }
    .floating-controls { right: 0.5rem; bottom: 5rem; }
    .floating-btn { width: 32px; height: 32px; }
  }
</style>
