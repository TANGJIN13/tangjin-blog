---
import '../styles/global.css';
import { site } from '../site';
import Icon from '../components/Icon.astro';
import MusicPlayer from '../components/MusicPlayer.astro';
import SakuraEffect from '../components/SakuraEffect.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  narrow?: boolean;
  /** 页面顶部是否有壁纸横幅（有则内容下沉，导航悬浮其上） */
  banner?: boolean;
}

const {
  title,
  description = site.description,
  image = `${site.url}/images/wallpapers/wallpaper-01.svg`,
  narrow = false,
  banner = false,
} = Astro.props;

const navItems = [
  { label: '首页', href: '/', icon: 'home' },
  { label: '归档', href: '/archive/', icon: 'archive' },
  { label: '分类', href: '/categories/', icon: 'folder' },
  { label: '友链', href: '/friends/', icon: 'link' },
  { label: '留言', href: '/guestbook/', icon: 'mail' },
  { label: '关于', href: '/about/', icon: 'person' },
];

const fullTitle = title ? `${title} - ${site.tabTitle}` : site.tabTitle;
const canonical = Astro.url.pathname === '/' ? site.url : new URL(Astro.url.pathname, site.url).href;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- 站点图标：文件名带版本号，换图标时改版本号可强制浏览器刷新缓存 -->
    <link rel="icon" href="/icon-2.ico" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icon-2-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/icon-2-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />

    <!-- 客户端路由：页面切换不整页刷新，音乐持续播放 -->
    <ClientRouter />
  </head>
  <body class:list={[{ 'has-banner': banner }]}>
    <!-- 阅读进度条 -->
    <div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

    <!-- 导航栏 —— 悬浮在壁纸之上 -->
    <header class="top-row" id="top-row">
      <div class="nav-grid container-fluid">
        <a class="brand" href="/">
          <img class="brand-avatar" src={site.avatar} alt="" width="28" height="28" />
          <span class="brand-name">{site.title}</span>
        </a>
        <nav class="nav" aria-label="主导航">
          {navItems.map((it) => (
            <a class="nav-item" href={it.href} aria-current={Astro.url.pathname === it.href ? 'page' : undefined}>
              <Icon name={it.icon} size="1.1rem" />
              <span>{it.label}</span>
            </a>
          ))}
        </nav>
        <div class="nav-actions">
          <a class="nav-btn" href="/search/" title="搜索" aria-label="搜索">
            <Icon name="search" size="1.15rem" />
          </a>
          <button class="nav-btn" id="nav-theme" title="切换主题" aria-label="切换主题">
            <Icon name="palette" size="1.15rem" />
          </button>
          <button class="nav-btn menu-btn" id="menu-btn" title="菜单" aria-label="打开菜单">
            <svg width="1.15rem" height="1.15rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
          </button>
        </div>
      </div>
    </header>

    <!-- 手机端菜单 -->
    <div class="mobile-menu" id="mobile-menu">
      <nav class="mobile-nav">
        {navItems.map((it) => (
          <a class="mobile-nav-item" href={it.href} aria-current={Astro.url.pathname === it.href ? 'page' : undefined}>
            <Icon name={it.icon} size="1.1rem" />
            <span>{it.label}</span>
          </a>
        ))}
      </nav>
    </div>

    <!-- 主内容 -->
    <main class="main-layout">
      <slot />

      <!-- 浮动控制 -->
    <div class="floating-controls" id="floating-controls">
      <button class="floating-btn" id="btn-top" title="回到顶部" aria-label="回到顶部">
        <Icon name="arrow_up" size="1.05rem" />
      </button>
      <button class="floating-btn" id="btn-reading" title="沉浸阅读" aria-label="沉浸阅读">
        <Icon name="book" size="1.05rem" />
      </button>
      <button class="floating-btn" id="btn-wallpaper" title="切换壁纸" aria-label="切换壁纸">
        <Icon name="image" size="1.05rem" />
      </button>
    </div>

    <!-- 浮动音乐播放器 —— 左下角常驻，切页不中断 -->
    <div class="music-float expanded" id="music-float" transition:persist>
      <div class="music-float-panel">
        <div class="music-float-head">
          <span class="music-float-title"><Icon name="music" size="0.95rem" /> 音乐</span>
          <button class="music-float-close" id="music-float-toggle" title="收起播放器" aria-label="收起播放器">
            <Icon name="arrow_down" size="0.9rem" />
          </button>
        </div>
        <MusicPlayer />
      </div>
      <!-- 收起后的小按钮 -->
      <button class="music-float-mini" id="music-float-mini" title="展开播放器" aria-label="展开播放器">
        <Icon name="music" size="1.05rem" />
      </button>
    </div>

    <!-- 樱花特效（全屏 canvas + 开关按钮） -->
    <SakuraEffect />

    </main>

    <!-- 页脚 -->
    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© {site.footer.since}–{new Date().getFullYear()} {site.author}</p>
        {site.icp && <p><a href="https://beian.miit.gov.cn/" rel="nofollow" target="_blank">{site.icp}</a></p>}
        <p class="footer-note">由 Astro 构建 · 静态托管 · 关注安全</p>
        <p class="footer-visits" data-vc-wrap style="display:none">
          总访问量 <span data-vc="site_pv">--</span> 次 · 访客 <span data-vc="site_uv">--</span> 人
        </p>
      </div>
    </footer>

    <script>
      // 访问量统计（Vercount 公共服务，静态站免后端）
      // 指标：site_pv 总访问量 / site_uv 访客数 / page_pv 单页阅读量
      // 每次 astro:page-load（首屏 + SPA 导航）上报一次当前 URL = 一次页面浏览
      const VC_API = 'https://events.vercount.one/api/v2/log';
      const VC_UV_KEY = 'vercount_uv_tangjin_xyz';
      const VC_CACHE = 'visitorCountData';

      function vcIsNewUv() {
        const has = document.cookie.split('; ').some((c) => c.startsWith(VC_UV_KEY + '='));
        if (!has) document.cookie = VC_UV_KEY + '=1; path=/; max-age=31536000; samesite=lax';
        return !has;
      }

      function vcRender(data) {
        if (!data) return;
        const fmt = (n) => Number(n || 0).toLocaleString('zh-CN');
        document.querySelectorAll('[data-vc="site_pv"]').forEach((el) => { el.textContent = fmt(data.site_pv); });
        document.querySelectorAll('[data-vc="site_uv"]').forEach((el) => { el.textContent = fmt(data.site_uv); });
        document.querySelectorAll('[data-vc="page_pv"]').forEach((el) => { el.textContent = fmt(data.page_pv); });
        document.querySelectorAll('[data-vc-wrap]').forEach((el) => { el.style.display = ''; });
      }

      async function vcLog() {
        try {
          const ctrl = new AbortController();
          const timer = setTimeout(() => ctrl.abort(), 5000);
          const res = await fetch(VC_API, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ url: location.href, isNewUv: vcIsNewUv() }),
            signal: ctrl.signal,
          });
          clearTimeout(timer);
          if (!res.ok) throw new Error('HTTP ' + res.status);
          const json = await res.json();
          const data = (json && json.data) || json;
          if (data && typeof data === 'object') {
            try { localStorage.setItem(VC_CACHE, JSON.stringify(data)); } catch (e) {}
            vcRender(data);
            return;
          }
        } catch (e) {}
        // 接口失败时回退到本地缓存的上次数据（仅展示，不重复计数）
        try {
          const cached = localStorage.getItem(VC_CACHE);
          if (cached) vcRender(JSON.parse(cached));
        } catch (e) {}
      }

      let vcFired = false;
      document.addEventListener('astro:page-load', () => { vcFired = true; vcLog(); });
      // 兜底：万一没有 ClientRouter，400ms 后直接执行一次
      setTimeout(() => { if (!vcFired) vcLog(); }, 400);
    </script>

    <script>
      // 阅读进度
      const bar = document.getElementById('reading-progress');
      if (bar) {
        window.addEventListener('scroll', () => {
          const h = document.documentElement;
          const st = h.scrollTop || document.body.scrollTop;
          const sh = h.scrollHeight - h.clientHeight;
          bar.style.width = (sh > 0 ? (st / sh) * 100 : 0) + '%';
        }, { passive: true });
      }

      // 导航栏滚动变玻璃
      const topRow = document.getElementById('top-row');
      const onScroll = () => {
        topRow?.classList.toggle('scrolled', window.scrollY > 40);
        const show = window.scrollY > 300;
        document.querySelectorAll('.floating-btn').forEach(b => b.classList.toggle('visible', show));
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // 回到顶部
      document.getElementById('btn-top')?.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });

      // 沉浸阅读
      const readingBtn = document.getElementById('btn-reading');
      if (readingBtn) {
        readingBtn.addEventListener('click', () => {
          document.body.classList.toggle('immersive-reading');
          readingBtn.classList.toggle('active');
          try {
            localStorage.setItem('immersive-reading',
              document.body.classList.contains('immersive-reading') ? '1' : '0');
          } catch {}
        });
        if (localStorage.getItem('immersive-reading') === '1') {
          document.body.classList.add('immersive-reading');
          readingBtn.classList.add('active');
        }
      }

      // 壁纸切换
      const wpBtn = document.getElementById('btn-wallpaper');
      wpBtn?.addEventListener('click', () => {
        const slides = document.querySelectorAll('.wp-slide');
        if (!slides.length) return;
        const active = [...slides].findIndex(s => s.classList.contains('active'));
        slides[active].classList.remove('active');
        slides[(active + 1) % slides.length].classList.add('active');
      });

      // 主题切换
      const root = document.documentElement;
      const themeBtn = document.getElementById('nav-theme');
      const apply = (t) => {
        const eff = t === 'system'
          ? (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light')
          : t;
        root.setAttribute('data-theme', eff);
        try { localStorage.setItem('theme', t); } catch {}
      };
      // 首屏恢复
      (() => {
        const saved = localStorage.getItem('theme') || 'system';
        apply(saved);
      })();
      themeBtn?.addEventListener('click', () => {
        const order = ['light', 'dark', 'system'];
        const cur = localStorage.getItem('theme') || 'system';
        apply(order[(order.indexOf(cur) + 1) % order.length]);
      });

      // 浮动播放器展开/收起（默认展开，记忆状态）+ 播放中按钮脉冲
      const mfWrap = document.getElementById('music-float');
      const mfToggle = document.getElementById('music-float-toggle');
      const mfMini = document.getElementById('music-float-mini');
      if (mfWrap) {
        // 默认展开，除非用户之前主动收起了
        if (localStorage.getItem('music-float-expanded') === '0') {
          mfWrap.classList.remove('expanded');
        }
        const setExpanded = (open) => {
          mfWrap.classList.toggle('expanded', open);
          try { localStorage.setItem('music-float-expanded', open ? '1' : '0'); } catch {}
        };
        mfToggle?.addEventListener('click', () => setExpanded(false));
        mfMini?.addEventListener('click', () => setExpanded(true));
        const audioEl = document.getElementById('audio-el');
        const syncMf = () => { if (audioEl) mfWrap.classList.toggle('playing', !audioEl.paused); };
        audioEl?.addEventListener('play', syncMf);
        audioEl?.addEventListener('pause', syncMf);
        syncMf();
      }

      // 手机端菜单 —— 用 onclick 保证幂等，客户端路由切页后通过 astro:page-load 重新初始化
      function initMobileMenu() {
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        if (!menuBtn || !mobileMenu) return;
        menuBtn.onclick = () => {
          mobileMenu.classList.toggle('open');
          menuBtn.classList.toggle('active');
        };
        mobileMenu.querySelectorAll('.mobile-nav-item').forEach(a => {
          a.onclick = () => {
            mobileMenu.classList.remove('open');
            menuBtn.classList.remove('active');
          };
        });
      }
      initMobileMenu();
      document.addEventListener('astro:page-load', () => {
        const menuBtn = document.getElementById('menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        mobileMenu?.classList.remove('open');
        menuBtn?.classList.remove('active');
        initMobileMenu();
      });
    </script>
  </body>
</html>

<style>
  /* ============ 顶部导航 ============ */
  .top-row {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--navbar-height);
    z-index: 80;
    transition: background-color 0.35s ease, backdrop-filter 0.35s ease, border-color 0.35s ease;
    border-bottom: 1px solid transparent;
  }

  /* 滚动后变玻璃 */
  .top-row.scrolled {
    background: oklch(100% 0 0 / 0.72);
    backdrop-filter: blur(14px) saturate(160%);
    -webkit-backdrop-filter: blur(14px) saturate(160%);
    border-bottom-color: var(--border);
  }
  [data-theme='dark'] .top-row.scrolled {
    background: oklch(14% 0.015 250 / 0.75);
  }

  .container-fluid {
    width: 92%;
    max-width: var(--page-width);
    margin-inline: auto;
    padding-inline: 1rem;
  }

  .nav-grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    height: var(--navbar-height);
    gap: 1rem;
  }

  /* 品牌 —— 头像 + 站名（贴最左） */
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    text-decoration: none !important;
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius-sm);
    transition: background-color 0.2s ease;
  }
  .brand-avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--surface);
  }
  .brand-name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--text);
    white-space: nowrap;
  }

  /* 壁纸页面上方文字为白色 */
  body.has-banner .top-row:not(.scrolled) .brand-name { color: #fff; }
  body.has-banner .top-row:not(.scrolled) .brand { text-shadow: 0 1px 10px oklch(0% 0 0 / 0.4); }
  body.has-banner .top-row:not(.scrolled) .brand:hover { background: oklch(100% 0 0 / 0.14); }

  /* 居中导航 */
  .nav {
    display: flex;
    gap: 0.15rem;
    justify-content: center;
  }
  .nav-item {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--text-soft);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none !important;
    white-space: nowrap;
    transition: color 0.18s ease, background-color 0.18s ease;
  }
  .nav-item :global(.icon) { opacity: 0.85; }
  .nav-item:hover { color: var(--text); background: oklch(0% 0 0 / 0.05); }
  .nav-item:hover :global(.icon) { transform: translateY(-1px); }
  .nav-item[aria-current='page'] { color: var(--primary); background: var(--primary-soft); }

  /* 壁纸页面上方导航为白色 */
  body.has-banner .top-row:not(.scrolled) .nav-item { color: oklch(100% 0 0 / 0.88); }
  body.has-banner .top-row:not(.scrolled) .nav-item:hover {
    color: #fff;
    background: oklch(100% 0 0 / 0.16);
  }
  body.has-banner .top-row:not(.scrolled) .nav-item[aria-current='page'] {
    color: #fff;
    background: oklch(100% 0 0 / 0.22);
  }

  .nav-actions { display: flex; justify-content: flex-end; gap: 0.25rem; }
  .nav-btn {
    width: 38px; height: 38px;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: transparent;
    color: var(--text-soft);
    font-size: 1rem;
    cursor: pointer;
    display: grid;
    place-items: center;
    text-decoration: none !important;
    transition: all 0.18s ease;
  }
  .nav-btn:hover { background: oklch(0% 0 0 / 0.05); border-color: var(--border); color: var(--primary); }
  body.has-banner .top-row:not(.scrolled) .nav-btn { color: #fff; }
  body.has-banner .top-row:not(.scrolled) .nav-btn:hover { background: oklch(100% 0 0 / 0.16); }

  /* ============ 主内容 ============ */
  /* 导航栏固定，无壁纸时内容需下沉让出导航高度 */
  .main-layout { padding-block: 1.5rem; padding-top: calc(var(--navbar-height) + 1.5rem); }
  body.has-banner .main-layout { padding-top: 0; }

  /* ============ 页脚 ============ */
  .site-footer {
    margin-top: 3rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
    color: var(--text-soft);
  }
  .footer-inner {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    text-align: center;
    font-size: 0.88rem;
  }
  .footer-inner p { margin: 0; }
  .footer-note { color: var(--text-faint); font-size: 0.78rem; }
  .footer-visits { color: var(--text-faint); font-size: 0.78rem; }
  .footer-visits span[data-vc] { color: var(--primary-strong); font-weight: 600; font-variant-numeric: tabular-nums; }

  /* ============ 浮动音乐播放器 —— 左下角常驻 ============ */
  .music-float {
    position: fixed;
    left: 1.25rem;
    bottom: 1.5rem;
    z-index: 75;
  }
  .music-float-panel {
    width: 300px;
    max-width: calc(100vw - 2.5rem);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 8px 32px oklch(0% 0 0 / 0.14);
    overflow: hidden;
  }
  .music-float-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.55rem 0.85rem;
    background: linear-gradient(145deg,
      oklch(97% 0.02 250) 0%,
      oklch(95% 0.03 265) 100%);
    border-bottom: 1px solid var(--border);
  }
  [data-theme='dark'] .music-float-head {
    background: linear-gradient(145deg,
      oklch(21% 0.03 250) 0%,
      oklch(18% 0.04 265) 100%);
  }
  .music-float-title {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text);
  }
  .music-float-title :global(.icon) { color: var(--primary); }
  .music-float-close {
    width: 26px; height: 26px;
    border-radius: var(--radius-sm);
    border: none;
    background: transparent;
    color: var(--text-faint);
    cursor: pointer;
    display: grid;
    place-items: center;
    transition: all 0.18s ease;
  }
  .music-float-close:hover { background: oklch(0% 0 0 / 0.06); color: var(--text); }
  .music-float-panel :global(.music-player) {
    border: none;
    border-radius: 0;
    background: transparent;
  }

  /* 收起后的小按钮（默认隐藏） */
  .music-float-mini {
    display: none;
    width: 44px; height: 44px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: oklch(100% 0 0 / 0.88);
    backdrop-filter: blur(10px);
    color: var(--primary);
    cursor: pointer;
    place-items: center;
    box-shadow: 0 4px 16px oklch(0% 0 0 / 0.14);
    transition: all 0.2s ease;
  }
  [data-theme='dark'] .music-float-mini { background: oklch(20% 0.02 250 / 0.88); }
  .music-float-mini:hover { transform: scale(1.08); box-shadow: 0 6px 22px oklch(0% 0 0 / 0.18); }

  /* 展开态：显示面板，隐藏小按钮 */
  .music-float.expanded .music-float-panel { display: block; }
  .music-float.expanded .music-float-mini { display: none; }

  /* 收起态：隐藏面板，显示小按钮 */
  .music-float:not(.expanded) .music-float-panel { display: none; }
  .music-float:not(.expanded) .music-float-mini { display: grid; }

  /* 正在播放时小按钮脉冲 */
  .music-float.playing:not(.expanded) .music-float-mini {
    animation: music-pulse 2.4s ease-in-out infinite;
  }
  @keyframes music-pulse {
    0%, 100% { box-shadow: 0 4px 16px oklch(70% 0.14 250 / 0.25); }
    50%      { box-shadow: 0 4px 26px oklch(70% 0.14 250 / 0.5); }
  }

  @media (max-width: 640px) {
    .music-float { left: 0.75rem; bottom: 0.75rem; }
    .music-float-panel { width: 260px; }
  }

  /* 手机端汉堡菜单按钮 */
  .menu-btn { display: none; }
  @media (max-width: 1023px) {
    .menu-btn { display: grid; }
  }

