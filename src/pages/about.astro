---
import Base from '../layouts/Base.astro';
import GiscusComments from '../components/GiscusComments.astro';
import Icon from '../components/Icon.astro';
import SkillCloud from '../components/SkillCloud.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getPublishedPosts } from '../lib/posts';
import { site } from '../site';

const allPosts = await getPublishedPosts();
const totalPosts = allPosts.length;
const totalWords = allPosts.reduce((sum, p) => sum + (p.body?.replace(/\s/g, '').length || 0), 0);
const startDate = new Date(site.startDate);
const daysSince = Math.max(1, Math.floor((Date.now() - startDate.getTime()) / 86400000));
---

<Base title="关于我">
  <div class="post-layout">
    <article class="post-main">
      <header class="post-head">
        <div class="cover">
          <div class="cover-placeholder about-cover">
            <img class="about-cover-img" src="/images/wallpapers/about-cover.svg" alt="" aria-hidden="true" />
            <div class="about-cover-dim" aria-hidden="true"></div>
            <div class="about-cover-content">
              <h1 class="post-title">关于我</h1>
              <p class="post-desc">桂林电子科技大学 · 25级网安 · Web 安全</p>
            </div>
          </div>
        </div>
      </header>

      <div class="post-body custom-md">
        <div class="deco-card glass">
          <div class="deco-card-header">
            <img class="deco-avatar" src={site.avatar} alt="头像" width="80" height="80" />
            <div>
              <h3>{site.title}</h3>
              <p class="deco-subtitle">桂林电子科技大学 · 25级网安 · Web 安全</p>
            </div>
          </div>
          <p>你好，我是 <strong>tj</strong>。桂林电子科技大学25级网安学生，正在向web安全方向探索。</p>
        </div>

        <h2><Icon name="code" size="1.3rem" /> 技术栈</h2>
        <SkillCloud />

        <h2><Icon name="calendar" size="1.3rem" /> 时间线</h2>
        <div class="timeline">
          <div class="timeline-item onload-animation" style="animation-delay: 0.1s">
            <div class="timeline-dot"></div>
            <div class="timeline-content card-base">
              <span class="timeline-date">2026</span>
              <h4>开始写博客</h4>
              <p>用 Astro 搭建了这个博客，记录安全学习之路。</p>
            </div>
          </div>
          <div class="timeline-item onload-animation" style="animation-delay: 0.2s">
            <div class="timeline-dot"></div>
            <div class="timeline-content card-base">
              <span class="timeline-date">2026</span>
              <h4>成为 CTF 选手</h4>
              <p>开始参加各种 CTF 比赛，刷题复现。</p>
            </div>
          </div>
        </div>

        <h2><Icon name="mail" size="1.3rem" /> 联系</h2>
        <div class="contact-grid">
          {site.links.map((l) => (
            <a class="contact-card glass" href={l.href} target="_blank" rel="noopener">
              <Icon name={l.label.toLowerCase().includes('github') ? 'github' : 'link'} size="1.05rem" />
              <span>{l.label}</span>
            </a>
          ))}
        </div>

        <h2><Icon name="person" size="1.3rem" /> 社交</h2>
        <SocialLinks />

        <!-- 站点统计 -->
        <h2><Icon name="chart" size="1.3rem" /> 站点统计</h2>
        <div class="about-stats">
          <div class="stat-box">
            <span class="stat-num">{totalPosts}</span>
            <span class="stat-label">文章</span>
          </div>
          <div class="stat-box">
            <span class="stat-num">{daysSince}</span>
            <span class="stat-label">天</span>
          </div>
          <div class="stat-box">
            <span class="stat-num">{totalWords}</span>
            <span class="stat-label">字</span>
          </div>
        </div>

        <blockquote class="deco-quote"><p>"安全是一场没有终点的旅程。"</p></blockquote>
      </div>

      <GiscusComments />
    </article>

    <aside class="post-toc">
      <div class="card-base toc-card" id="toc-card">
        <h3 class="widget-title"><Icon name="article" size="1.05rem" /> 目录</h3>
        <nav class="toc-nav" id="toc-nav"></nav>
      </div>
    </aside>
  </div>
</Base>

<style>
  .post-layout { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 1.5rem; }
  .post-head { margin-bottom: 2rem; }
  .cover img, .cover-placeholder { width: 100%; aspect-ratio: 2 / 1; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); }
  .cover-placeholder { display: grid; place-items: center; background: var(--gradient-primary); }
  .cover-icon { font-size: 2.5rem; opacity: 0.8; }
  .post-title { font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 1rem 0 0.5rem; background: var(--gradient-primary); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .post-desc { color: var(--text-soft); font-size: 1.05rem; }
  .post-body { font-size: 1.02rem; }
  .deco-card { border-radius: var(--radius-lg); padding: 1.5rem; margin-bottom: 2rem; background: var(--gradient-card); }
  .deco-card-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .deco-avatar { width: 56px; height: 56px; border-radius: 50%; border: 3px solid var(--surface); box-shadow: var(--shadow); }
  .deco-card h3 { margin: 0; font-size: 1.1rem; }
  .deco-subtitle { margin: 0; font-size: 0.82rem; color: var(--text-faint); }
  .custom-md :global(h2) { font-size: 1.5rem; margin-top: 2.5rem; margin-bottom: 1rem; padding-bottom: 0.4rem; border-bottom: 2px solid; border-image: var(--gradient-primary) 1; }
  .tech-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.8rem; margin-bottom: 2rem; }
  .tech-card { border-radius: var(--radius-lg); padding: 1.2rem; text-align: center; transition: all 0.25s ease; }
  .tech-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .tech-icon { font-size: 1.8rem; display: block; margin-bottom: 0.5rem; }
  .tech-card h4 { margin: 0 0 0.3rem; font-size: 0.95rem; }
  .tech-card p { margin: 0; font-size: 0.8rem; color: var(--text-faint); }
  .timeline { position: relative; padding-left: 1.5rem; margin-bottom: 2rem; }
  .timeline::before { content: ''; position: absolute; left: 6px; top: 0; bottom: 0; width: 2px; background: var(--gradient-primary); border-radius: 999px; }
  .timeline-item { position: relative; margin-bottom: 1.2rem; }
  .timeline-dot { position: absolute; left: -1.5rem; top: 0.5rem; width: 12px; height: 12px; border-radius: 50%; background: var(--primary); border: 3px solid var(--surface); box-shadow: var(--shadow-sm); }
  .timeline-content { padding: 0.8rem 1rem; }
  .timeline-date { font-size: 0.75rem; color: var(--text-faint); font-weight: 600; }
  .timeline-content h4 { margin: 0.2rem 0; font-size: 1rem; }
  .timeline-content p { margin: 0; font-size: 0.88rem; color: var(--text-soft); }
  .contact-grid { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 2rem; }
  .contact-card { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.2rem; border-radius: 999px; font-size: 0.9rem; font-weight: 500; transition: all 0.2s ease; }
  .contact-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .contact-icon { font-size: 1rem; }
  .deco-quote { margin: 2rem 0; padding: 1.2rem 1.5rem; border-left: 4px solid; border-image: var(--gradient-primary) 1; background: var(--primary-soft); border-radius: 0 var(--radius) var(--radius) 0; font-style: italic; color: var(--text-soft); }
  .deco-quote p { margin: 0; font-size: 1.05rem; }

  /* 站点统计 */
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
    margin-bottom: 2rem;
  }
  .stat-box {
    text-align: center;
    padding: 1rem 0.5rem;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }
  .stat-num {
    display: block;
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1.2;
  }
  .stat-label {
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  /* 关于这个站 */
  .about-site {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    margin-bottom: 2rem;
  }
  .about-site p {
    margin: 0 0 0.8rem;
    line-height: 1.8;
    color: var(--text-soft);
  }
  .about-site p:last-child { margin-bottom: 0; }
  .about-site strong { color: var(--text); }

  /* 推荐 */
  .about-recommend {
    padding: 1.2rem 1.5rem;
    border-radius: var(--radius-lg);
    margin-bottom: 2rem;
  }
  .rec-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    flex-wrap: wrap;
  }
  .rec-item :global(.icon) { color: var(--primary); flex-shrink: 0; }
  .rec-item a {
    color: var(--primary-strong);
    text-decoration: none !important;
    font-weight: 500;
  }
  .rec-item a:hover { text-decoration: underline !important; }
  .rec-desc { color: var(--text-faint); font-size: 0.82rem; }

  /* 学习中的技能 */
  .learn-cloud {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.7rem;
    margin-bottom: 2rem;
  }
  .learn-item {
    padding: 0.8rem 1rem;
    border-radius: var(--radius-lg);
    transition: all 0.2s ease;
  /* 站点统计 */
  .about-cover {
    position: relative;
    overflow: hidden;
    min-height: 280px;
    display: flex;
    align-items: flex-end;
    justify-content: flex-start;
  }
  .about-cover-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 8s ease;
  }
  .about-cover:hover .about-cover-img { transform: scale(1.05); }
  .about-cover-dim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, oklch(0% 0 0 / 0.3) 0%, oklch(0% 0 0 / 0.6) 100%);
  }
  .about-cover-content {
    position: relative;
    z-index: 1;
    padding: 2rem 2rem 1.5rem;
    color: #fff;
  }
  .about-cover-content .post-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    margin: 0 0 0.4rem;
    text-shadow: 0 2px 12px oklch(0% 0 0 / 0.5);
    background: none;
    -webkit-text-fill-color: #fff;
  }
  .about-cover-content .post-desc {
    margin: 0;
    font-size: 0.95rem;
    opacity: 0.9;
    text-shadow: 0 1px 8px oklch(0% 0 0 / 0.5);
  }

  /* 正在学习标签 */
  .learn-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .learn-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 500;
    transition: all 0.15s ease;
  }
  .learn-tag:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .learn-tag :global(.icon) { color: var(--primary); opacity: 0.8; }

  @media (max-width: 860px) {
    .post-layout { grid-template-columns: 1fr; }
    .post-toc { display: none; }
    .about-cover { min-height: 220px; }
    .about-cover-content { padding: 1.5rem 1.2rem 1.2rem; }
  }
</style>
