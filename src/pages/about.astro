---
import Base from '../layouts/Base.astro';
import GiscusComments from '../components/GiscusComments.astro';
import Icon from '../components/Icon.astro';
import { getPublishedPosts } from '../lib/posts';
import { profile } from '../data/profile';
import { site } from '../site';

const allPosts = await getPublishedPosts();
const totalPosts = allPosts.length;
const totalWords = allPosts.reduce((sum, p) => sum + (p.body?.replace(/\s/g, '').length || 0), 0);
const startDate = new Date(site.startDate);
const daysSince = Math.max(1, Math.floor((Date.now() - startDate.getTime()) / 86400000));

const stats = [
  { num: totalPosts, label: '篇文章', icon: 'article' },
  { num: daysSince, label: '天', icon: 'calendar' },
  { num: totalWords, label: '字', icon: 'text' },
];
---

<Base title="关于我">
  <div class="post-layout">
    <article class="post-main">
      <!-- 顶部封面 -->
      <header class="post-head">
        <div class="cover">
          <div class="cover-placeholder about-cover">
            <img class="about-cover-img" src="/images/wallpapers/about-cover.jpg" alt="" aria-hidden="true" />
            <div class="about-cover-dim" aria-hidden="true"></div>
            <div class="about-cover-content">
              <h1 class="post-title">关于我</h1>
              <p class="post-desc">{profile.headline}</p>
            </div>
          </div>
        </div>
      </header>

      <div class="post-body custom-md">
        <!-- 名片 -->
        <div class="id-card">
          <div class="id-avatar-ring">
            <img class="id-avatar" src={site.avatar} alt="头像" width="96" height="96" />
          </div>
          <div class="id-main">
            <h2 class="id-name">{site.title}</h2>
            <p class="id-headline">{profile.headline}</p>
            <div class="id-links">
              {site.links.map((l) => (
                <a class="id-link" href={l.href} target="_blank" rel="noopener">
                  <Icon name={l.label.toLowerCase().includes('github') ? 'github' : 'link'} size="0.9rem" />
                  <span>{l.label}</span>
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- 我是谁 -->
        <h2><Icon name="person" size="1.3rem" /> 我是谁</h2>
        {profile.intro.map((para) => <p class="intro-p" set:html={para} />)}

        <!-- 数字 -->
        <div class="stat-row">
          {stats.map((s) => (
            <div class="stat-box">
              <span class="stat-icon"><Icon name={s.icon} size="1rem" /></span>
              <span class="stat-num">{s.num}</span>
              <span class="stat-label">{s.label}</span>
            </div>
          ))}
        </div>

        <!-- 技能 -->
        <h2><Icon name="code" size="1.3rem" /> 能上手</h2>
        <div class="skill-grid">
          {profile.skills.map((s) => (
            <div class="skill-card" title={s.note || ''}>
              <span class="skill-icon"><Icon name={s.icon} size="1.15rem" /></span>
              <span class="skill-name">{s.name}</span>
              {s.note && <span class="skill-note">{s.note}</span>}
            </div>
          ))}
        </div>

        <h2><Icon name="sparkle" size="1.3rem" /> 正在学</h2>
        <div class="skill-grid">
          {profile.learning.map((s) => (
            <div class="skill-card is-learning" title={s.note || ''}>
              <span class="skill-icon"><Icon name={s.icon} size="1.15rem" /></span>
              <span class="skill-name">{s.name}</span>
              {s.note && <span class="skill-note">{s.note}</span>}
            </div>
          ))}
        </div>

        <!-- 时间线 -->
        <h2><Icon name="calendar" size="1.3rem" /> 时间线</h2>
        <div class="timeline">
          {profile.timeline.map((t, i) => (
            <div class="timeline-item onload-animation" style={`animation-delay: ${i * 0.08}s`}>
              <span class="timeline-dot"><Icon name={t.icon || 'flag'} size="0.55rem" /></span>
              <div class="timeline-content card-base">
                <span class="timeline-date">{t.date}</span>
                <h4>{t.title}</h4>
                <p>{t.desc}</p>
              </div>
            </div>
          ))}
        </div>

        <!-- 联系 -->
        <h2><Icon name="mail" size="1.3rem" /> 联系</h2>
        <div class="contact-grid">
          {site.links.map((l) => (
            <a class="contact-card" href={l.href} target="_blank" rel="noopener">
              <Icon name={l.label.toLowerCase().includes('github') ? 'github' : 'link'} size="1.05rem" />
              <span>{l.label}</span>
            </a>
          ))}
        </div>

        <blockquote class="deco-quote"><p>"{profile.quote}"</p></blockquote>
      </div>

      <GiscusComments />
    </article>

    <aside class="post-toc">
      <div class="card-base toc-card" id="toc-card">
        <h3 class="widget-title"><Icon name="article" size="1.05rem" /> 目录</h3>
        <nav class="toc-nav" id="toc-nav"></nav>
      </div>
    </aside>
  </div>
</Base>

<style>
  .post-layout { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 1.5rem; }
  .post-head { margin-bottom: 1.75rem; }
  .cover img, .cover-placeholder { width: 100%; aspect-ratio: 2 / 1; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); }
  .cover-placeholder { display: grid; place-items: center; background: var(--gradient-primary); }

  /* ===== 封面 ===== */
  .about-cover { position: relative; overflow: hidden; min-height: 280px; display: flex; align-items: flex-end; justify-content: flex-start; }
  .about-cover-img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform 8s ease; }
  .about-cover:hover .about-cover-img { transform: scale(1.05); }
  .about-cover-dim { position: absolute; inset: 0; background: linear-gradient(to bottom, oklch(0% 0 0 / 0.28) 0%, oklch(0% 0 0 / 0.62) 100%); }
  .about-cover-content { position: relative; z-index: 1; padding: 2rem 2rem 1.5rem; color: #fff; }
  .post-title {
    font-size: clamp(1.5rem, 4vw, 2.1rem);
    font-weight: 800;
    margin: 0 0 0.4rem;
    text-shadow: 0 2px 14px oklch(0% 0 0 / 0.5);
  }
  .post-desc { margin: 0; font-size: 0.95rem; opacity: 0.92; text-shadow: 0 1px 8px oklch(0% 0 0 / 0.5); }

  .post-body { font-size: 1.02rem; }
  .custom-md :global(h2) {
    font-size: 1.4rem;
    margin-top: 2.25rem;
    margin-bottom: 1rem;
    padding-bottom: 0.4rem;
    border-bottom: 2px solid;
    border-image: var(--gradient-primary) 1;
  }

  /* ===== 名片 ===== */
  .id-card {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    padding: 1.25rem 1.4rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: 0 1px 2px oklch(0% 0 0 / 0.04), 0 8px 24px oklch(0% 0 0 / 0.06);
    position: relative;
    overflow: hidden;
    flex-wrap: wrap;
  }
  [data-theme='dark'] .id-card { box-shadow: 0 1px 2px oklch(0% 0 0 / 0.25), 0 8px 24px oklch(0% 0 0 / 0.35); }
  .id-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--gradient-primary);
  }
  .id-avatar-ring {
    flex-shrink: 0;
    padding: 3px;
    border-radius: 50%;
    background: var(--gradient-primary);
    box-shadow: 0 6px 20px oklch(62% 0.14 250 / 0.32);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .id-card:hover .id-avatar-ring { transform: rotate(8deg) scale(1.05); }
  .id-avatar {
    width: 88px; height: 88px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--surface);
    display: block;
  }
  .id-main { flex: 1; min-width: 200px; }
  .id-name {
    margin: 0 0 0.15rem;
    font-size: 1.35rem;
    font-weight: 800;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .id-headline { margin: 0 0 0.55rem; font-size: 0.85rem; color: var(--text-faint); }
  .id-links { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .id-link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.28rem 0.75rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border: 1px solid oklch(70% 0.14 250 / 0.28);
    text-decoration: none !important;
    transition: all 0.18s ease;
  }
  [data-theme='dark'] .id-link { color: var(--primary-light); }
  .id-link:hover {
    background: var(--gradient-primary);
    color: var(--text-on-primary);
    border-color: transparent;
    transform: translateY(-2px);
  }

  .intro-p { line-height: 1.85; color: var(--text-soft); }
  .intro-p :global(strong) { color: var(--text); font-weight: 700; }

  /* ===== 数字条 ===== */
  .stat-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    margin: 1.5rem 0 0;
  }
  .stat-box {
    position: relative;
    text-align: center;
    padding: 1rem 0.5rem 0.85rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    overflow: hidden;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .stat-box:hover {
    transform: translateY(-3px);
    border-color: oklch(70% 0.14 250 / 0.5);
    box-shadow: 0 2px 6px oklch(0% 0 0 / 0.05), 0 14px 30px oklch(62% 0.13 250 / 0.16);
  }
  [data-theme='dark'] .stat-box:hover { box-shadow: 0 2px 6px oklch(0% 0 0 / 0.3), 0 14px 30px oklch(0% 0 0 / 0.45); }
  .stat-icon {
    display: inline-grid;
    place-items: center;
    width: 30px; height: 30px;
    margin-bottom: 0.35rem;
    border-radius: 10px;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border: 1px solid oklch(70% 0.14 250 / 0.25);
  }
  [data-theme='dark'] .stat-icon { color: var(--primary-light); }
  .stat-num {
    display: block;
    font-size: 1.55rem;
    font-weight: 800;
    line-height: 1.2;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    font-variant-numeric: tabular-nums;
  }
  .stat-label { font-size: 0.76rem; color: var(--text-faint); }

  /* ===== 技能卡 ===== */
  .skill-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.6rem;
  }
  .skill-card {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    padding: 0.85rem 0.95rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .skill-card:hover {
    transform: translateY(-3px);
    border-color: oklch(70% 0.14 250 / 0.5);
    box-shadow: 0 2px 6px oklch(0% 0 0 / 0.05), 0 14px 28px oklch(62% 0.13 250 / 0.15);
  }
  [data-theme='dark'] .skill-card:hover { box-shadow: 0 2px 6px oklch(0% 0 0 / 0.3), 0 14px 28px oklch(0% 0 0 / 0.45); }
  .skill-icon {
    display: inline-grid;
    place-items: center;
    width: 34px; height: 34px;
    margin-bottom: 0.25rem;
    border-radius: 10px;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border: 1px solid oklch(70% 0.14 250 / 0.25);
    transition: transform 0.25s ease;
  }
  [data-theme='dark'] .skill-icon { color: var(--primary-light); }
  .skill-card:hover .skill-icon { transform: scale(1.08) rotate(-6deg); }
  .skill-name { font-size: 0.9rem; font-weight: 700; color: var(--text); }
  .skill-note { font-size: 0.72rem; color: var(--text-faint); line-height: 1.45; }
  /* 正在学：左侧一条虚线，和上手的区分开 */
  .skill-card.is-learning { border-style: dashed; }
  .skill-card.is-learning .skill-icon {
    color: var(--text-faint);
    background: var(--surface-2);
    border-color: var(--border);
  }
  .skill-card.is-learning:hover .skill-icon { color: var(--primary-strong); background: var(--primary-soft); }

  /* ===== 时间线 ===== */
  .timeline { position: relative; padding-left: 1.6rem; }
  .timeline::before {
    content: '';
    position: absolute;
    left: 7px; top: 0; bottom: 0;
    width: 2px;
    background: linear-gradient(180deg, var(--primary), oklch(70% 0.14 250 / 0.15));
    border-radius: 999px;
  }
  .timeline-item { position: relative; margin-bottom: 1rem; }
  .timeline-dot {
    position: absolute;
    left: -1.6rem; top: 0.75rem;
    width: 16px; height: 16px;
    border-radius: 50%;
    display: grid; place-items: center;
    background: var(--gradient-primary);
    color: var(--text-on-primary);
    border: 3px solid var(--surface);
    box-shadow: 0 2px 8px oklch(62% 0.14 250 / 0.35);
  }
  .timeline-content {
    padding: 0.85rem 1.05rem;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }
  .timeline-content:hover {
    transform: translateX(4px);
    border-color: oklch(70% 0.14 250 / 0.45);
    box-shadow: 0 2px 6px oklch(0% 0 0 / 0.05), 0 12px 26px oklch(60% 0.13 250 / 0.14);
  }
  .timeline-date {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--primary-strong);
    background: var(--primary-soft);
    padding: 0.08rem 0.5rem;
    border-radius: 999px;
    font-variant-numeric: tabular-nums;
  }
  [data-theme='dark'] .timeline-date { color: var(--primary-light); }
  .timeline-content h4 { margin: 0.35rem 0 0.2rem; font-size: 1rem; font-weight: 700; }
  .timeline-content p { margin: 0; font-size: 0.88rem; color: var(--text-soft); line-height: 1.65; }

  /* ===== 联系 ===== */
  .contact-grid { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .contact-card {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1.15rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none !important;
    transition: all 0.2s ease;
  }
  .contact-card:hover {
    color: var(--text-on-primary);
    background: var(--gradient-primary);
    border-color: transparent;
    transform: translateY(-2px);
    box-shadow: 0 5px 16px oklch(62% 0.14 250 / 0.3);
  }

  .deco-quote {
    margin: 2rem 0 0;
    padding: 1.1rem 1.4rem;
    border-left: 4px solid;
    border-image: var(--gradient-primary) 1;
    background: var(--primary-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
    font-style: italic;
    color: var(--text-soft);
  }
  .deco-quote p { margin: 0; font-size: 1.02rem; }

  @media (max-width: 860px) {
    .post-layout { grid-template-columns: minmax(0, 1fr); }
    .post-main { min-width: 0; }
    .post-toc { display: none; }
    .about-cover { min-height: 220px; }
    .about-cover-content { padding: 1.5rem 1.2rem 1.2rem; }
    .id-card { padding: 1.1rem; }
    .id-avatar { width: 72px; height: 72px; }
    .stat-row { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0.45rem; }
    .skill-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
