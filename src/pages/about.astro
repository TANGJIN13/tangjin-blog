---
import Base from '../layouts/Base.astro';
import GiscusComments from '../components/GiscusComments.astro';
import Icon from '../components/Icon.astro';
import SkillCloud from '../components/SkillCloud.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { getPublishedPosts } from '../lib/posts';
import { site } from '../site';

const allPosts = await getPublishedPosts();
const totalPosts = allPosts.length;
const totalWords = allPosts.reduce((sum, p) => sum + (p.body?.replace(/\s/g, '').length || 0), 0);
const startDate = new Date(site.startDate);
const daysSince = Math.max(1, Math.floor((Date.now() - startDate.getTime()) / 86400000));
---

<Base title="关于我">
  <div class="post-layout">
    <article class="post-main">
      <header class="post-head">
        <div class="cover">
          <div class="cover-placeholder"><Icon name="person" size="2.5rem" /></div>
        </div>
        <h1 class="post-title">关于我</h1>
        <p class="post-desc">Web 安全方向的探索者</p>
      </header>

      <div class="post-body custom-md">
        <div class="deco-card glass">
          <div class="deco-card-header">
            <img class="deco-avatar" src={site.avatar} alt="头像" width="80" height="80" />
            <div>
              <h3>{site.title}</h3>
              <p class="deco-subtitle">Web 安全 / CTF / 漏洞复现</p>
            </div>
          </div>
          <p>你好，我是 <strong>{site.title}</strong>。Web 安全方向的探索者，泡靶场、刷 CTF、复现漏洞，也折腾自己的小站。</p>
        </div>

        <h2><Icon name="code" size="1.3rem" /> 技术栈</h2>
        <div class="tech-grid">
          <div class="tech-card glass onload-animation" style="animation-delay: 0.05s">
            <span class="tech-icon"><Icon name="lock" size="1.8rem" /></span>
            <h4>Web 安全</h4><p>XSS / SQLi / SSRF / XXE</p>
          </div>
          <div class="tech-card glass onload-animation" style="animation-delay: 0.1s">
            <span class="tech-icon"><Icon name="flag" size="1.8rem" /></span>
            <h4>CTF</h4><p>Web / Misc</p>
          </div>
          <div class="tech-card glass onload-animation" style="animation-delay: 0.2s">
            <span class="tech-icon"><Icon name="terminal" size="1.8rem" /></span>
            <h4>运维</h4><p>Linux / Docker / Nginx</p>
          </div>
        </div>

        <h2><Icon name="calendar" size="1.3rem" /> 时间线</h2>
        <div class="timeline">
          <div class="timeline-item onload-animation" style="animation-delay: 0.1s">
            <div class="timeline-dot"></div>
            <div class="timeline-content card-base">
              <span class="timeline-date">2026</span>
              <h4>开始写博客</h4>
              <p>用 Astro 搭建了这个博客，记录安全学习之路。</p>
            </div>
          </div>
          <div class="timeline-item onload-animation" style="animation-delay: 0.2s">
            <div class="timeline-dot"></div>
            <div class="timeline-content card-base">
              <span class="timeline-date">2026</span>
              <h4>成为 CTF 选手</h4>
              <p>开始参加各种 CTF 比赛，刷题复现。</p>
            </div>
          </div>
        </div>

        <h2><Icon name="mail" size="1.3rem" /> 联系</h2>
        <div class="contact-grid">
          {site.links.map((l) => (
            <a class="contact-card glass" href={l.href} target="_blank" rel="noopener">
              <Icon name={l.label.toLowerCase().includes('github') ? 'github' : 'link'} size="1.05rem" />
              <span>{l.label}</span>
            </a>
          ))}
        </div>

        <h2><Icon name="person" size="1.3rem" /> 社交</h2>
        <SocialLinks />

        <h2><Icon name="code" size="1.3rem" /> 技能</h2>
        <SkillCloud />

        <!-- 站点统计 -->
        <h2><Icon name="chart" size="1.3rem" /> 站点统计</h2>
        <div class="about-stats">
          <div class="stat-box">
            <span class="stat-num">{totalPosts}</span>
            <span class="stat-label">文章</span>
          </div>
          <div class="stat-box">
            <span class="stat-num">{daysSince}</span>
            <span class="stat-label">天</span>
          </div>
          <div class="stat-box">
            <span class="stat-num">{totalWords}</span>
            <span class="stat-label">字</span>
          </div>
        </div>

        <!-- 关于这个站 -->
        <h2><Icon name="wave" size="1.3rem" /> 关于这个站</h2>
        <div class="about-site glass">
          <p>这个站是 <strong>2026 年</strong> 用 Astro 搭建的静态博客，没有数据库、没有后端，文章用 Markdown 写，推 GitHub 自动部署。</p>
          <p>为什么要搭这个站？因为博客园广告太多、CSDN 体验太差，想找一个干净的地方记录自己的学习过程。</p>
          <p>这里记录的东西可能很杂——Web 安全、CTF 题解、工具配置、踩坑记录、生活随笔。只要能帮到后来的自己，就值得写。</p>
        </div>

        <!-- 推荐 -->
        <h2><Icon name="heart" size="1.3rem" /> 推荐</h2>
        <div class="about-recommend glass">
          <div class="rec-item">
            <Icon name="link" size="0.9rem" />
            <a href="https://c1everf0x.cn/" target="_blank" rel="noopener">C1everF0x's Blog</a>
            <span class="rec-desc">—— 安全老哥的博客，我的视觉参照对象</span>
          </div>
        </div>

        <blockquote class="deco-quote"><p>"安全是一场没有终点的旅程。"</p></blockquote>
      </div>

      <GiscusComments />
    </article>

    <aside class="post-toc">
      <div class="card-base toc-card" id="toc-card">
        <h3 class="widget-title"><Icon name="article" size="1.05rem" /> 目录</h3>
        <nav class="toc-nav" id="toc-nav"></nav>
      </div>
    </aside>
  </div>
</Base>

<style>
  .post-layout { display: grid; grid-template-columns: minmax(0, 1fr) 220px; gap: 1.5rem; }
  .post-head { margin-bottom: 2rem; }
  .cover img, .cover-placeholder { width: 100%; aspect-ratio: 2 / 1; border-radius: var(--radius-xl); box-shadow: var(--shadow-lg); }
  .cover-placeholder { display: grid; place-items: center; background: var(--gradient-primary); }
  .cover-icon { font-size: 2.5rem; opacity: 0.8; }
  .post-title { font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 1rem 0 0.5rem; background: var(--gradient-primary); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .post-desc { color: var(--text-soft); font-size: 1.05rem; }
  .post-body { font-size: 1.02rem; }
  .deco-card { border-radius: var(--radius-lg); padding: 1.5rem; margin-bottom: 2rem; background: var(--gradient-card); }
  .deco-card-header { display: flex; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .deco-avatar { width: 56px; height: 56px; border-radius: 50%; border: 3px solid var(--surface); box-shadow: var(--shadow); }
  .deco-card h3 { margin: 0; font-size: 1.1rem; }
  .deco-subtitle { margin: 0; font-size: 0.82rem; color: var(--text-faint); }
  .custom-md :global(h2) { font-size: 1.5rem; margin-top: 2.5rem; margin-bottom: 1rem; padding-bottom: 0.4rem; border-bottom: 2px solid; border-image: var(--gradient-primary) 1; }
  .tech-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(180px, 1fr)); gap: 0.8rem; margin-bottom: 2rem; }
  .tech-card { border-radius: var(--radius-lg); padding: 1.2rem; text-align: center; transition: all 0.25s ease; }
  .tech-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .tech-icon { font-size: 1.8rem; display: block; margin-bottom: 0.5rem; }
  .tech-card h4 { margin: 0 0 0.3rem; font-size: 0.95rem; }
  .tech-card p { margin: 0; font-size: 0.8rem; color: var(--text-faint); }
  .timeline { position: relative; padding-left: 1.5rem; margin-bottom: 2rem; }
  .timeline::before { content: ''; position: absolute; left: 6px; top: 0; bottom: 0; width: 2px; background: var(--gradient-primary); border-radius: 999px; }
  .timeline-item { position: relative; margin-bottom: 1.2rem; }
  .timeline-dot { position: absolute; left: -1.5rem; top: 0.5rem; width: 12px; height: 12px; border-radius: 50%; background: var(--primary); border: 3px solid var(--surface); box-shadow: var(--shadow-sm); }
  .timeline-content { padding: 0.8rem 1rem; }
  .timeline-date { font-size: 0.75rem; color: var(--text-faint); font-weight: 600; }
  .timeline-content h4 { margin: 0.2rem 0; font-size: 1rem; }
  .timeline-content p { margin: 0; font-size: 0.88rem; color: var(--text-soft); }
  .contact-grid { display: flex; flex-wrap: wrap; gap: 0.6rem; margin-bottom: 2rem; }
  .contact-card { display: inline-flex; align-items: center; gap: 0.5rem; padding: 0.6rem 1.2rem; border-radius: 999px; font-size: 0.9rem; font-weight: 500; transition: all 0.2s ease; }
  .contact-card:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .contact-icon { font-size: 1rem; }
  .deco-quote { margin: 2rem 0; padding: 1.2rem 1.5rem; border-left: 4px solid; border-image: var(--gradient-primary) 1; background: var(--primary-soft); border-radius: 0 var(--radius) var(--radius) 0; font-style: italic; color: var(--text-soft); }
  .deco-quote p { margin: 0; font-size: 1.05rem; }

  /* 站点统计 */
  .about-stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.8rem;
    margin-bottom: 2rem;
  }
  .stat-box {
    text-align: center;
    padding: 1rem 0.5rem;
    border-radius: var(--radius-lg);
    background: var(--surface-2);
  }
  .stat-num {
    display: block;
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--primary);
    line-height: 1.2;
  }
  .stat-label {
    font-size: 0.78rem;
    color: var(--text-faint);
  }

  /* 关于这个站 */
  .about-site {
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    margin-bottom: 2rem;
  }
  .about-site p {
    margin: 0 0 0.8rem;
    line-height: 1.8;
    color: var(--text-soft);
  }
  .about-site p:last-child { margin-bottom: 0; }
  .about-site strong { color: var(--text); }

  /* 推荐 */
  .about-recommend {
    padding: 1.2rem 1.5rem;
    border-radius: var(--radius-lg);
    margin-bottom: 2rem;
  }
  .rec-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    flex-wrap: wrap;
  }
  .rec-item :global(.icon) { color: var(--primary); flex-shrink: 0; }
  .rec-item a {
    color: var(--primary-strong);
    text-decoration: none !important;
    font-weight: 500;
  }
  .rec-item a:hover { text-decoration: underline !important; }
  .rec-desc { color: var(--text-faint); font-size: 0.82rem; }

  /* 学习中的技能 */
  .learn-cloud {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
    gap: 0.7rem;
    margin-bottom: 2rem;
  }
  .learn-item {
    padding: 0.8rem 1rem;
    border-radius: var(--radius-lg);
    transition: all 0.2s ease;
  }
  .learn-item:hover { transform: translateY(-2px); box-shadow: var(--shadow); }
  .learn-head {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
  }
  .learn-head :global(.icon) { color: var(--primary); }
  .learn-name { font-size: 0.9rem; font-weight: 600; flex: 1; }
  .learn-pct { font-size: 0.75rem; color: var(--text-faint); font-weight: 600; }
  .learn-bar {
    height: 6px;
    background: oklch(0% 0 0 / 0.06);
    border-radius: 999px;
    overflow: hidden;
    margin-bottom: 0.3rem;
  }
  .learn-bar-fill {
    height: 100%;
    background: var(--gradient-primary);
    border-radius: 999px;
    transition: width 0.8s ease;
  }
  .learn-note { font-size: 0.72rem; color: var(--text-faint); }
  .custom-md :global(pre) { background: #1e1e2e; color: #e5e7eb; border-radius: var(--radius); padding: 1rem 1.2rem; overflow-x: auto; font-size: 0.85rem; line-height: 1.6; margin: 1.2em 0; box-shadow: var(--shadow-sm); }
  .custom-md :global(pre code) { background: none; padding: 0; color: inherit; }
  .custom-md :global(:not(pre) > code) { background: var(--surface-2); border: 1px solid var(--border); border-radius: 0.3rem; padding: 0.08em 0.35em; font-size: 0.86em; color: var(--primary-strong); }
  .custom-md :global(blockquote) { margin: 1.2em 0; padding: 0.7em 1.2em; border-left: 3px solid; border-image: var(--gradient-primary) 1; background: var(--primary-soft); border-radius: 0 var(--radius) var(--radius) 0; color: var(--text-soft); }
  .custom-md :global(table) { width: 100%; border-collapse: collapse; margin: 1.2em 0; font-size: 0.92rem; border-radius: var(--radius); overflow: hidden; box-shadow: var(--shadow-sm); }
  .custom-md :global(th), .custom-md :global(td) { border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left; }
  .custom-md :global(th) { background: var(--surface-2); font-weight: 600; }
  .custom-md :global(img) { border-radius: var(--radius-lg); margin: 1.2rem auto; box-shadow: var(--shadow); }
  .post-toc { position: sticky; top: 70px; align-self: start; }
  .toc-card { padding: 1rem; position: relative; }
  .toc-nav { display: flex; flex-direction: column; gap: 0.25rem; }
  .toc-item { font-size: 0.82rem; color: var(--text-soft); padding: 0.3rem 0.5rem; border-radius: var(--radius-sm); text-decoration: none !important; background: none !important; transition: all 0.15s ease; border-left: 2px solid transparent; }
  .toc-item:hover { color: var(--text); background: var(--surface-2) !important; }
  .toc-item.active { color: var(--primary-strong); border-left-color: var(--primary); font-weight: 500; }
  .toc-level-3 { padding-left: 1.2rem; font-size: 0.78rem; }
  @media (max-width: 860px) { .post-layout { grid-template-columns: 1fr; } .post-toc { display: none; } }
</style>
