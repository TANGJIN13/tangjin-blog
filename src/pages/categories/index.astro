---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SidebarLeft from '../../components/SidebarLeft.astro';
import SidebarRight from '../../components/SidebarRight.astro';
import { getCollection } from 'astro:content';
import { categories } from '../../data/categories';
import { site } from '../../site';

const posts = await getCollection('posts');

// 按分类统计（显示所有分类，包括空的）
const categoryPosts = categories.map((cat) => ({
  ...cat,
  count: posts.filter((p) => p.data.category === cat.slug || p.data.tags.includes(cat.name)).length,
}));
const totalPosts = posts.length;
---

<Base title="分类">
  <div class="page-shell">
    <SidebarLeft />
    <div class="page-main">
    <!-- 顶部横幅 -->
    <div class="cat-banner">
      <img class="cat-banner-bg" src="/images/wallpapers/wallpaper-01.svg" alt="" aria-hidden="true" />
      <div class="cat-banner-dim" aria-hidden="true"></div>
      <div class="cat-banner-content">
        <h1 class="cat-banner-title">分类</h1>
        <p class="cat-banner-desc">按分类浏览文章，共 {totalPosts} 篇</p>
      </div>
    </div>

    <div class="cat-page">
      <!-- 主内容：分类卡片 -->
      <div class="cat-main">
        <div class="cat-grid">
          {categoryPosts.map((cat, i) => (
            <a class="cat-card glass" href={`/categories/${cat.slug}/`} style={`animation-delay: ${i * 0.06}s`}>
              <div class="cat-card-icon" style={cat.icon ? '' : ''}>
                <Icon name={cat.icon || 'folder'} size="1.5rem" />
              </div>
              <div class="cat-card-body">
                <h3 class="cat-card-name">{cat.name}</h3>
                <p class="cat-card-desc">{cat.description || '暂无描述'}</p>
              </div>
              <div class="cat-card-right">
                <span class="cat-card-count">{cat.count}</span>
                <span class="cat-card-unit">篇</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
    </div>
    <SidebarRight />
  </div>
</Base>

<style>
  .cat-page { min-width: 0; }

  /* 横幅 */
  .cat-banner {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: 2rem;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cat-banner-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cat-banner-dim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, oklch(0% 0 0 / 0.3), oklch(0% 0 0 / 0.55));
  }
  .cat-banner-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2rem;
    color: #fff;
  }
  .cat-banner-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    margin: 0 0 0.5rem;
    text-shadow: 0 2px 12px oklch(0% 0 0 / 0.4);
  }
  .cat-banner-desc {
    margin: 0;
    font-size: 0.95rem;
    opacity: 0.9;
    text-shadow: 0 1px 8px oklch(0% 0 0 / 0.4);
  }

  /* 布局由全局 .page-shell 统一控制 */
  .cat-page { display: block; }

  /* 分类卡片网格 */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 0.8rem;
  }
  .cat-card {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 1.2rem;
    border-radius: var(--radius-lg);
    text-decoration: none !important;
    transition: all 0.25s ease;
  }
  .cat-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); }
  .cat-card-icon {
    width: 44px; height: 44px;
    border-radius: var(--radius-md);
    background: var(--primary-soft);
    color: var(--primary);
    display: grid;
    place-items: center;
    flex-shrink: 0;
  }
  .cat-card-body { flex: 1; min-width: 0; }
  .cat-card-name { margin: 0; font-size: 0.95rem; font-weight: 600; }
  .cat-card-desc { margin: 0.15rem 0 0; font-size: 0.78rem; color: var(--text-faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cat-card-right { text-align: right; flex-shrink: 0; }
  .cat-card-count { font-size: 1.4rem; font-weight: 800; color: var(--primary); line-height: 1; }
  .cat-card-unit { font-size: 0.7rem; color: var(--text-faint); }

  /* 手机端：分类卡片单列 */
  @media (max-width: 860px) {
    .cat-grid { grid-template-columns: 1fr; }
    .cat-banner { min-height: 150px; }
  }
</style>
