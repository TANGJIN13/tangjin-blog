---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import SidebarLeft from '../../components/SidebarLeft.astro';
import SidebarRight from '../../components/SidebarRight.astro';
import { categories } from '../../data/categories';
import { formatDate, getPublishedPosts } from '../../lib/posts';

const posts = await getPublishedPosts();

// 按分类统计（显示所有分类，包括空的）；有文章的排前面，空的沉到末尾
const categoryPosts = categories
  .map((cat) => ({
    ...cat,
    count: posts.filter((p) => p.data.category === cat.slug || p.data.tags.includes(cat.name)).length,
  }))
  .sort((a, b) => b.count - a.count);
const totalPosts = posts.length;
const recentPosts = posts.slice(0, 6);
---

<Base
  title="分类"
  pageBanner
  bannerIcon="folder"
  bannerTitle="分类"
  bannerDesc={`按分类浏览文章，共 ${totalPosts} 篇`}
>
  <div class="page-shell">
    <SidebarLeft />
    <div class="page-main">
    <!-- 手机端用的紧凑标题（电脑端由统一壁纸横幅承载标题） -->
    <div class="cat-banner hide-with-banner">
      <img class="cat-banner-bg" src="/images/wallpapers/wallpaper-01.svg" alt="" aria-hidden="true" />
      <div class="cat-banner-dim" aria-hidden="true"></div>
      <div class="cat-banner-content">
        <h1 class="cat-banner-title">分类</h1>
        <p class="cat-banner-desc">按分类浏览文章，共 {totalPosts} 篇</p>
      </div>
    </div>

    <div class="cat-page">
      <div class="section-head">
        <h2 class="section-title"><span class="section-index">01 /</span> 全部分类</h2>
        <span class="section-edition">共 {categoryPosts.length} 个分类 · {totalPosts} 篇文章</span>
      </div>
      <div class="cat-grid">
        {categoryPosts.map((cat, i) => (
          <a class:list={['cat-card', { 'is-empty': cat.count === 0 }]} href={`/categories/${cat.slug}/`} style={`animation-delay: ${i * 0.06}s`}>
            <span class="cat-card-glow" aria-hidden="true"></span>
            <span class="cat-card-icon">
              <Icon name={cat.icon || 'folder'} size="1.55rem" />
            </span>
            <span class="cat-card-body">
              <span class="cat-card-name">{cat.name}</span>
              <span class="cat-card-desc">{cat.description || '暂无描述'}</span>
            </span>
            <span class="cat-card-foot">
              <span class="cat-card-count">{cat.count}<em>篇</em></span>
              <span class="cat-card-arrow"><Icon name="arrow_right" size="0.95rem" /></span>
            </span>
          </a>
        ))}
      </div>

      {recentPosts.length > 0 && (
        <section class="cat-recent">
          <div class="section-head">
            <h2 class="section-title"><span class="section-index">02 /</span> 最近更新</h2>
            <a class="section-more" href="/archive/">全部归档 <Icon name="arrow_right" size="0.85rem" /></a>
          </div>
          <div class="cat-recent-list">
            {recentPosts.map((p) => {
              const cat = categories.find((c) => c.slug === p.data.category);
              return (
                <a class="cat-recent-item" href={`/posts/${p.id}/`}>
                  <span class="cat-recent-meta">
                    <time datetime={p.data.published.toISOString()}>{formatDate(p.data.published)}</time>
                    {cat && <em>{cat.name}</em>}
                  </span>
                  <span class="cat-recent-title">{p.data.title}</span>
                  <span class="cat-recent-arrow"><Icon name="arrow_right" size="0.9rem" /></span>
                </a>
              );
            })}
          </div>
        </section>
      )}
    </div>
    </div>
    <SidebarRight />
  </div>
</Base>

<style>
  .cat-page { min-width: 0; }

  /* 横幅 */
  .cat-banner {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    margin-bottom: 2rem;
    min-height: 200px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .cat-banner-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cat-banner-dim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, oklch(0% 0 0 / 0.3), oklch(0% 0 0 / 0.55));
  }
  .cat-banner-content {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2rem;
    color: #fff;
  }
  .cat-banner-title {
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 800;
    margin: 0 0 0.5rem;
    text-shadow: 0 2px 12px oklch(0% 0 0 / 0.4);
  }
  .cat-banner-desc {
    margin: 0;
    font-size: 0.95rem;
    opacity: 0.9;
    text-shadow: 0 1px 8px oklch(0% 0 0 / 0.4);
  }

  /* 布局由全局 .page-shell 统一控制 */
  .cat-page { display: block; }

  /* 区块标题：编号 + 标题 + 右侧附注 */
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1.15rem;
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--border);
  }
  .section-title {
    display: flex;
    align-items: baseline;
    gap: 0.45rem;
    margin: 0;
    color: var(--text);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .section-index { color: var(--primary); font-size: 0.68rem; letter-spacing: 0.05em; }
  .section-edition { color: var(--text-faint); font-size: 0.64rem; letter-spacing: 0.04em; }

  /* 分类大卡：两列、每张都留足呼吸感 */
  .cat-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(270px, 1fr));
    gap: 1rem;
  }
  .cat-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 178px;
    padding: 1.35rem 1.4rem 1.2rem;
    overflow: hidden;
    color: var(--text);
    text-decoration: none !important;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 2px 8px color-mix(in srgb, var(--text) 5%, transparent);
    transition: transform 0.3s cubic-bezier(.2,.75,.25,1), border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .cat-card-glow {
    position: absolute;
    top: -42%;
    right: -18%;
    width: 12rem;
    height: 12rem;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--primary) 17%, transparent), transparent 68%);
    opacity: 0;
    transition: opacity 0.35s ease;
    pointer-events: none;
  }
  .cat-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--primary) 34%, var(--border));
    box-shadow: 0 16px 36px color-mix(in srgb, var(--primary) 12%, transparent);
  }
  .cat-card:hover .cat-card-glow { opacity: 1; }
  .cat-card-icon {
    position: relative;
    width: 48px;
    height: 48px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--primary-soft);
    border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent);
    color: var(--primary);
    transition: background 0.3s ease, color 0.3s ease, transform 0.3s ease, border-color 0.3s ease;
  }
  .cat-card:hover .cat-card-icon {
    background: var(--gradient-primary);
    border-color: transparent;
    color: var(--text-on-primary);
    transform: scale(1.05) rotate(-4deg);
  }
  .cat-card-body { position: relative; display: flex; flex-direction: column; gap: 0.35rem; flex: 1; min-width: 0; }
  .cat-card-name { font-family: var(--font-display); font-size: 1.28rem; font-weight: 600; letter-spacing: -0.025em; line-height: 1.3; }
  .cat-card-desc {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text-soft);
    font-size: 0.8rem;
    line-height: 1.75;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }
  .cat-card-foot {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 0.85rem;
    border-top: 1px dashed var(--border);
  }
  .cat-card-count { color: var(--primary-strong); font-size: 1.32rem; font-weight: 800; line-height: 1; font-variant-numeric: tabular-nums; }
  .cat-card-count em { margin-left: 0.2rem; font-size: 0.68rem; font-style: normal; font-weight: 600; color: var(--text-faint); }
  .cat-card-arrow {
    display: grid;
    width: 1.85rem;
    height: 1.85rem;
    place-items: center;
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text-faint);
    transition: color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .cat-card:hover .cat-card-arrow {
    color: var(--primary);
    border-color: color-mix(in srgb, var(--primary) 40%, var(--border));
    transform: translateX(3px);
  }
  :global([data-theme='dark'] .cat-card-count) { color: var(--primary-light); }

  /* 空分类：压一档对比度，让有内容的分类先被看到 */
  .cat-card.is-empty { opacity: 0.62; }
  .cat-card.is-empty:hover { opacity: 1; }
  .cat-card.is-empty .cat-card-count { color: var(--text-faint); }
  .cat-card.is-empty .cat-card-icon { background: var(--surface-2); color: var(--text-faint); border-color: var(--border); }
  .cat-card.is-empty:hover .cat-card-icon { background: var(--surface-2); color: var(--text-soft); transform: none; }

  .cat-recent { margin-top: 2rem; }
  .section-more {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    color: var(--primary);
    font-size: 0.76rem;
    font-weight: 600;
    text-decoration: none !important;
    transition: transform 0.18s ease;
  }
  .section-more:hover { transform: translateX(3px); }
  .cat-recent-list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .cat-recent-item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-rows: auto auto;
    column-gap: 0.75rem;
    align-items: center;
    padding: 0.85rem 1rem;
    color: var(--text);
    text-decoration: none !important;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: transform 0.22s ease, border-color 0.22s ease, box-shadow 0.22s ease;
  }
  .cat-recent-item:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--primary) 34%, var(--border));
    box-shadow: 0 10px 24px color-mix(in srgb, var(--primary) 10%, transparent);
  }
  .cat-recent-meta {
    grid-column: 1;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-faint);
    font-size: 0.7rem;
  }
  .cat-recent-meta em {
    font-style: normal;
    padding: 0.08rem 0.4rem;
    border-radius: 999px;
    color: var(--primary-strong);
    background: var(--primary-soft);
    font-weight: 650;
  }
  .cat-recent-title {
    grid-column: 1;
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.4;
  }
  .cat-recent-arrow {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    color: var(--text-faint);
  }
  .cat-recent-item:hover .cat-recent-arrow { color: var(--primary); }

  @media (max-width: 860px) {
    .cat-grid { grid-template-columns: 1fr; }
    .cat-card { min-height: 150px; }
    .cat-banner { min-height: 150px; }
  }
</style>
