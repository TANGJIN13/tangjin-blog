---
import Base from '../layouts/Base.astro';
---

<Base title="404" description="页面不存在">
  <div class="container">
    <div class="notfound">
      <div class="code">404</div>
      <h1>页面走丢了</h1>
      <p>你要找的内容可能被移动、删除，或者从未存在。</p>
      <a class="btn" href="/">回到首页</a>
    </div>
  </div>
</Base>

<style>
  .notfound {
    max-width: 480px;
    margin: 5rem auto;
    text-align: center;
  }

  .code {
    font-size: 5rem;
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, var(--primary), var(--primary-strong));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    letter-spacing: -0.03em;
  }

  h1 {
    font-size: 1.6rem;
    margin-top: 0.5rem;
  }

  p {
    color: var(--text-soft);
  }

  .btn {
    display: inline-block;
    margin-top: 1rem;
    padding: 0.6rem 1.6rem;
    border-radius: 999px;
    background: var(--primary);
    color: var(--on-primary);
    font-weight: 500;
    transition: opacity 0.15s ease;
  }

  .btn:hover {
    opacity: 0.88;
    text-decoration: none;
  }
</style>
