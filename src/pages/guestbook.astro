---
import Base from '../layouts/Base.astro';
import GiscusComments from '../components/GiscusComments.astro';
import Icon from '../components/Icon.astro';
---

<Base title="留言板">
  <div class="container post-container">
    <div class="post-layout">
      <article class="post-main">
        <header class="post-head">
          <div class="cover">
            <div class="cover-placeholder guestbook-cover">
              <!-- 二次元装饰图 -->
              <svg class="gb-deco-svg" viewBox="0 0 200 200" width="120" height="120" aria-hidden="true">
                <defs>
                  <radialGradient id="gb-glow" cx="50%" cy="50%" r="50%">
                    <stop offset="0%" stop-color="#fff" stop-opacity="0.3"/>
                    <stop offset="100%" stop-color="#fff" stop-opacity="0"/>
                  </radialGradient>
                  <linearGradient id="gb-hair" x1="0" y1="0" x2="1" y2="1">
                    <stop offset="0%" stop-color="#a78bfa"/>
                    <stop offset="100%" stop-color="#7c3aed"/>
                  </linearGradient>
                  <linearGradient id="gb-dress" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#f0abfc"/>
                    <stop offset="100%" stop-color="#c084fc"/>
                  </linearGradient>
                </defs>
                <circle cx="100" cy="100" r="90" fill="url(#gb-glow)"/>
                <ellipse cx="100" cy="78" rx="42" ry="40" fill="url(#gb-hair)"/>
                <ellipse cx="100" cy="85" rx="28" ry="26" fill="#fef3c7"/>
                <path d="M72 75 Q80 55 100 52 Q120 55 128 75 Q125 65 100 62 Q75 65 72 75Z" fill="url(#gb-hair)"/>
                <ellipse cx="88" cy="90" rx="6" ry="8" fill="#fff"/>
                <ellipse cx="112" cy="90" rx="6" ry="8" fill="#fff"/>
                <circle cx="89" cy="91" r="4" fill="#1e1b4b"/>
                <circle cx="113" cy="91" r="4" fill="#1e1b4b"/>
                <circle cx="90" cy="89" r="1.5" fill="#fff"/>
                <circle cx="114" cy="89" r="1.5" fill="#fff"/>
                <ellipse cx="80" cy="98" rx="5" ry="3" fill="#f9a8d4" opacity="0.6"/>
                <ellipse cx="120" cy="98" rx="5" ry="3" fill="#f9a8d4" opacity="0.6"/>
                <path d="M95 103 Q100 107 105 103" fill="none" stroke="#c084fc" stroke-width="1.5" stroke-linecap="round"/>
                <path d="M82 110 Q100 105 118 110 L125 155 Q100 160 75 155 Z" fill="url(#gb-dress)"/>
                <path d="M60 120 Q50 100 65 90 Q70 105 60 120Z" fill="#a78bfa" opacity="0.5"/>
                <path d="M140 120 Q150 100 135 90 Q130 105 140 120Z" fill="#a78bfa" opacity="0.5"/>
                <circle cx="50" cy="60" r="2" fill="#fff"><animate attributeName="opacity" values="1;0.2;1" dur="2s" repeatCount="indefinite"/></circle>
                <circle cx="150" cy="70" r="1.5" fill="#fff"><animate attributeName="opacity" values="0.3;1;0.3" dur="2.5s" repeatCount="indefinite"/></circle>
                <circle cx="40" cy="130" r="1.5" fill="#f0abfc"><animate attributeName="opacity" values="0.5;1;0.5" dur="1.8s" repeatCount="indefinite"/></circle>
                <circle cx="160" cy="140" r="2" fill="#f0abfc"><animate attributeName="opacity" values="0.4;1;0.4" dur="2.2s" repeatCount="indefinite"/></circle>
              </svg>
              <span class="gb-icon-text"><Icon name="mail" size="1.2rem" /> 留言</span>
            </div>
          </div>
          <h1 class="post-title">留言板</h1>
          <p class="post-desc">说点什么吧，你的每一条留言我都会看到</p>
        </header>

        <div class="post-body custom-md card-base">
          <div class="guestbook-intro">
            <h2>📝 留言须知</h2>
            <ul>
              <li>文明发言，互相尊重</li>
              <li>禁止广告、违法内容</li>
              <li>需要 GitHub 账号登录后留言</li>
              <li>留言即表示同意公开展示</li>
            </ul>
          </div>
        </div>

        <div class="card-base comments-card">
          <h3 class="widget-title"><Icon name="article" size="1.05rem" /> 留言</h3>
          <GiscusComments />
        </div>
      </article>

      <aside class="post-toc">
        <div class="card-base toc-card" id="toc-card">
          <h3 class="widget-title"><Icon name="article" size="1.05rem" /> 信息</h3>
          <div class="toc-nav">
            <span class="toc-item">
              <Icon name="github" size="0.9rem" />
              需要 GitHub 账号
            </span>
            <span class="toc-item">
              <Icon name="lock" size="0.9rem" />
              留言公开展示
            </span>
            <span class="toc-item">
              <Icon name="heart" size="0.9rem" />
              文明交流
            </span>
          </div>
        </div>
      </aside>
    </div>
  </div>
</Base>

<style>
  .post-container { margin-top: 2rem; }
  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 1.5rem;
    align-items: start;
  }

  .post-head { margin-bottom: 2rem; }
  .cover img, .cover-placeholder {
    width: 100%; aspect-ratio: 2 / 1;
    border-radius: var(--radius-xl); box-shadow: var(--shadow-lg);
  }
  .cover-placeholder {
    display: grid; place-items: center;
    background: linear-gradient(145deg, oklch(70% 0.14 250) 0%, oklch(60% 0.18 280) 100%);
  }
  .post-title {
    font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 1rem 0 0.5rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .post-desc { color: var(--text-soft); font-size: 1.05rem; }
  .post-body { padding: 1.5rem 2rem; }
  .comments-card { margin-top: 1.25rem; padding: 1.5rem; }

  .guestbook-cover {
    background: linear-gradient(145deg, oklch(70% 0.14 250) 0%, oklch(60% 0.18 280) 50%, oklch(70% 0.16 320) 100%) !important;
    flex-direction: column;
    gap: 0.5rem;
  }
  .gb-deco-svg { animation: gb-float 4s ease-in-out infinite; }
  @keyframes gb-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
  .gb-icon-text {
    display: flex; align-items: center; gap: 0.35rem;
    font-size: 1.1rem; font-weight: 600; color: #fff;
    text-shadow: 0 2px 8px oklch(0% 0 0 / 0.3);
  }
  .guestbook-intro {
    padding: 0.5rem 0;
  }
  .guestbook-intro h2 {
    margin: 0 0 1rem;
    font-size: 1.3rem;
    display: flex; align-items: center; gap: 0.5rem;
  }
  .guestbook-intro ul {
    margin: 0; padding-left: 1.5rem;
    line-height: 2;
    color: var(--text-soft);
  }
  .guestbook-intro li { margin-bottom: 0.3rem; }

  .post-toc { position: sticky; top: 88px; align-self: start; }
  .toc-card { padding: 1rem; }
  .toc-nav { display: flex; flex-direction: column; gap: 0.4rem; }
  .toc-item {
    font-size: 0.82rem; color: var(--text-soft);
    padding: 0.4rem 0.5rem; border-radius: var(--radius-sm);
    display: flex; align-items: center; gap: 0.4rem;
  }
  .toc-item:hover { background: var(--surface-2); }

  @media (max-width: 860px) {
    .post-layout { grid-template-columns: 1fr; }
    .post-toc { display: none; }
  }
</style>
