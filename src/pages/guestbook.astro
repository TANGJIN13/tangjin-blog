---
import Base from '../layouts/Base.astro';
import WalineComments from '../components/WalineComments.astro';
import Icon from '../components/Icon.astro';
import SidebarLeft from '../components/SidebarLeft.astro';
import SidebarRight from '../components/SidebarRight.astro';
---

<Base
  title="留言板"
  pageBanner
  bannerIcon="mail"
  bannerTitle="留言板"
  bannerDesc="说点什么吧，你的每一条留言我都会看到"
>
  <div class="page-shell">
    <SidebarLeft />
    <article class="post-main">
        <header class="post-head hide-with-banner">
          <div class="cover">
            <div class="cover-placeholder guestbook-cover">
              <!-- 壁纸背景 -->
              <img class="gb-wallpaper" src="/images/wallpapers/wallpaper-02.svg" alt="" aria-hidden="true" />
              <div class="gb-wallpaper-dim" aria-hidden="true"></div>
              <!-- 哲理句子 -->
              <div class="gb-quote">
                <p class="gb-quote-text">"我们所做的每件事，都是在为未来投票。"</p>
                <span class="gb-quote-author">— 未知</span>
              </div>
              <span class="gb-icon-text"><Icon name="mail" size="1.2rem" /> 留言</span>
            </div>
          </div>
          <h1 class="post-title">留言板</h1>
          <p class="post-desc">说点什么吧，你的每一条留言我都会看到</p>
        </header>

        <div class="post-body custom-md card-base">
          <div class="guestbook-intro">
            <h2>📝 留言须知</h2>
            <ul>
              <li>文明发言，互相尊重</li>
              <li>禁止广告、违法内容</li>
              <li>填写昵称即可留言，邮箱可以不填</li>
              <li>留言即表示同意公开展示</li>
            </ul>
          </div>

          <div class="gb-quote-block">
            <p class="gb-quote-text">"世界上只有一种英雄主义，就是认清生活的真相后依然热爱它。"</p>
            <span class="gb-quote-author">— 罗曼·罗兰</span>
          </div>
        </div>

        <div class="card-base comments-card">
          <h3 class="widget-title"><Icon name="article" size="1.05rem" /> 留言</h3>
          <WalineComments />
        </div>
    </article>
    <SidebarRight />
  </div>
</Base>

<style>
  .post-main { min-width: 0; }

  .post-head { margin-bottom: 2rem; }
  .cover img, .cover-placeholder {
    width: 100%; aspect-ratio: auto; height: clamp(180px, 24vw, 250px);
    border-radius: var(--radius-xl); box-shadow: var(--shadow-lg);
  }
  .cover-placeholder {
    display: grid; place-items: center;
    background: linear-gradient(145deg, oklch(70% 0.14 250) 0%, oklch(60% 0.18 280) 100%);
  }
  .post-title {
    font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 1rem 0 0.5rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .post-desc { color: var(--text-soft); font-size: 1.05rem; }
  .post-body { padding: 1.5rem 2rem; }
  .comments-card { margin-top: 1.25rem; padding: 1.5rem; }

  .guestbook-cover {
    position: relative;
    overflow: hidden;
    height: clamp(180px, 24vw, 250px);
    flex-direction: column;
    gap: 0.5rem;
  }
  .gb-wallpaper {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 8s ease;
  }
  .guestbook-cover:hover .gb-wallpaper { transform: scale(1.08); }
  .gb-wallpaper-dim {
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom,
      oklch(0% 0 0 / 0.16) 0%,
      oklch(0% 0 0 / 0.45) 100%);
  }
  .gb-quote {
    position: relative;
    z-index: 1;
    text-align: center;
    padding: 2rem 1.5rem 1rem;
    color: #fff;
  }
  .gb-quote-text {
    font-size: clamp(1rem, 2.5vw, 1.35rem);
    font-weight: 600;
    line-height: 1.6;
    margin: 0 0 0.5rem;
    text-shadow: 0 2px 12px oklch(0% 0 0 / 0.5);
    letter-spacing: 0.02em;
  }
  .gb-quote-author {
    font-size: 0.85rem;
    opacity: 0.85;
    text-shadow: 0 1px 6px oklch(0% 0 0 / 0.5);
  }
  .gb-icon-text {
    position: relative;
    z-index: 1;
    display: flex; align-items: center; gap: 0.35rem;
    font-size: 1rem; font-weight: 500; color: #fff;
    text-shadow: 0 2px 8px oklch(0% 0 0 / 0.4);
    margin-bottom: 0.5rem;
  }

  .gb-quote-block {
    margin-top: 1.5rem;
    padding: 1.5rem 2rem;
    border-left: 3px solid var(--primary);
    background: var(--primary-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
    text-align: center;
  }
  .gb-quote-block .gb-quote-text {
    font-size: clamp(0.95rem, 2vw, 1.15rem);
    color: var(--text-soft);
    font-weight: 500;
    margin: 0 0 0.4rem;
  }
  .gb-quote-block .gb-quote-author {
    font-size: 0.8rem;
    color: var(--text-faint);
  }
  .guestbook-intro h2 {
    margin: 0 0 1rem;
    font-size: 1.3rem;
    display: flex; align-items: center; gap: 0.5rem;
  }
  .guestbook-intro ul {
    margin: 0; padding-left: 1.5rem;
    line-height: 2;
    color: var(--text-soft);
  }
  .guestbook-intro li { margin-bottom: 0.3rem; }

  @media (max-width: 860px) {
    .post-main { min-width: 0; }
  }
</style>
