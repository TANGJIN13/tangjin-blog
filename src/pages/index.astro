---
import Base from '../layouts/Base.astro';
import PostListItem from '../components/PostListItem.astro';
import PostCard from '../components/PostCard.astro';
import Paginate from '../components/Paginate.astro';
import Icon from '../components/Icon.astro';
import SidebarLeft from '../components/SidebarLeft.astro';
import SidebarRight from '../components/SidebarRight.astro';
import WallpaperBanner from '../components/WallpaperBanner.astro';
import { getPublishedPosts, getTags, pinToTop } from '../lib/posts';

const posts = await getPublishedPosts();
const totalWords = posts.reduce((sum, p) => sum + (p.body?.replace(/\s/g, '').length || 0), 0);
const tags = await getTags();

// 首页文章统一卡片网格；置顶文章浮到最前
// （原先这里会把第一篇单独拎出来做一张「置顶大卡」+ 大封面图，
//   用户反馈那张大卡太突兀，已移除 —— 现在全部文章走同一个列表。）
const ordered = pinToTop(posts);
const recentPosts = ordered;
---

<Base banner>
  <!-- 壁纸文字：交给 WallpaperBanner 自带的「书法潦草句子」轮播（内容来自 site.mottos）。
       之前这里塞了自定义的 <slot>（「把每一次好奇…」+ 一行 Web 安全·CTF），
       把原来那套有哲理的书法句子顶掉了 —— 现在撤掉 slot，恢复成原来那种。
       ⚠️ 这一层**不加** data-reveal：首屏壁纸的分镜（背景模糊→清晰、星光渐显、
          标题逐节揭幕）全部由 WallpaperBanner 自己在 intro-run 下驱动。
          在这里再包一层淡入会让壁纸整体先发灰一次，两层 opacity 相乘。 -->
  <!-- 首页壁纸高度：满屏（一屏）。
       用户要求「打开网站的时候壁纸要占满屏幕」—— 首屏就是一整幅水彩壁纸 +
       书法句子，内容区（文章列表/侧栏）整块落在第一屏之下，滚动才出现。
       `full` 让组件里的移动端「按屏高分档」覆盖规则失效（那些是为半屏横幅调的）。
       高度由 .wp-full 统一给 100svh（回退 100vh），这里传的值只是兜底。 -->
  <WallpaperBanner height="100vh" mobileHeight="100svh" full />

  <!-- 三栏内容 -->
  <div class="container">
    <div class="ref-layout">
      <!-- 左侧栏 -->
      <SidebarLeft />
      <!-- 主内容 -->
      <main class="ref-main" id="main-content" aria-label="文章列表">
        <!-- 文章列表（置顶文章仍会排在最前，但不再单独放大成一张大卡） -->
        {recentPosts.length > 0 && (
          <section class="block recent-feed" data-reveal style="--rv: 2650ms">
            <div class="section-head">
              <h2 class="section-title"><Icon name="article" size="1.05rem" /> 最新文章</h2>
              <div class="section-head-right">
                <!-- 布局切换：卡片网格 ↔ 单列卡片行。和主题/明暗一样存 localStorage，
                     偏好跨页面、跨刷新保持。 -->
                <div class="layout-switch" id="feed-layout-switch" data-active="list">
                  <span class="layout-thumb" aria-hidden="true"></span>
                  <button type="button" class="layout-btn is-list" data-layout="list" title="列表视图" aria-label="列表视图">
                    <Icon name="text" size="0.9rem" />
                  </button>
                  <button type="button" class="layout-btn is-grid" data-layout="grid" title="卡片网格" aria-label="卡片网格">
                    <Icon name="archive" size="0.9rem" />
                  </button>
                </div>
                <a class="section-more" href="/archive/">查看更多 <Icon name="arrow_right" size="0.85rem" /></a>
              </div>
            </div>
            <!-- 两种布局同屏渲染、CSS 切显隐 —— 不用 JS 重建 DOM，切换是即时的。
                 .post-rows（单列卡片行）与 .post-grid（卡片网格）共用同一批文章，
                 两侧的封面/标题/内容各自独立显示，互不干扰。 -->
            <div class="post-rows" data-feed="list">
              {recentPosts.map((p, i) => (
                <div class="paginate-item">
                  <PostListItem post={p} index={i + 1} />
                </div>
              ))}
            </div>
            <div class="post-grid" data-feed="grid">
              {recentPosts.map((p, i) => (
                <PostCard post={p} index={i + 1} />
              ))}
            </div>
            <Paginate pageSize={15} />
          </section>
        )}

        <!-- 标签 -->
        {tags.length > 0 && (
          <section class="block">
            <div class="card-base tag-card onload-animation">
              <h3 class="widget-title"><Icon name="tag" size="1.05rem" /> 标签</h3>
              <div class="tag-cloud">
                {tags.slice(0, 16).map((t, i) => (
                  <a class="cloud-tag" href={`/search/?q=${encodeURIComponent(t.tag)}`} style={`--i:${i}`}>
                    #{t.tag}<em>{t.count}</em>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )}
      </main>

      <!-- 右侧栏 -->
      <SidebarRight full />
    </div>
  </div>
</Base>

<style>
  /* 壁纸上的文字交给 WallpaperBanner 自带的 .wp-title / .wp-quote-sub（书法字体 + 轮播），
     首页不再自己画一套 hero 文字，所以这里原先的 .home-hero* 样式已全部移除。 */

  /* 内容区域 */
  .ref-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 900px) {
    .ref-layout { grid-template-columns: var(--sidebar-width) minmax(0, 1fr); }
    .ref-sidebar-right { display: none; }
  }

  @media (min-width: 1280px) {
    .ref-layout { grid-template-columns: var(--sidebar-width) minmax(0, 1fr) var(--sidebar-width); }
    .ref-sidebar-right { display: flex; }
  }

  .ref-sidebar-left, .ref-sidebar-right {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* 主内容分区间距
     用户明确要求：分类条与文章列表贴近、文章卡片与分页贴近。
     原先这里 gap: 1.5rem（24px），再叠上各 section 自己的
     margin-bottom: clamp(2rem,4vw,3.5rem)（32~56px），两段间距被加到 56~80px，非常空。
     改法：① 容器 gap 收到 0.5rem（只作最小兜底）；
           ② 各 section 改用**定向 margin**，不再用统一的大 margin-bottom。 */
  .ref-main { display: flex; flex-direction: column; gap: 0.5rem; min-width: 0; }
  .block { scroll-margin-top: 80px; min-width: 0; }

  /* ===== 个人资料卡 ===== */
  .profile-card {
    text-align: center;
    padding: 1.5rem 1rem 1.05rem;
    position: relative;
    overflow: hidden;
  }
  /* 卡片顶部一条主色渐变装饰线（左右缩进，避免直条穿过圆角显得毛躁） */
  .profile-card::before {
    content: '';
    position: absolute;
    inset: 0 20% auto;
    height: 3px;
    border-radius: 0 0 999px 999px;
    background: var(--gradient-primary);
    opacity: 0.9;
  }
  /* 右上角一团柔光，避免卡片显得平 */
  .profile-card::after {
    content: '';
    position: absolute;
    top: -46px;
    right: -46px;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    background: radial-gradient(circle, oklch(70% 0.15 282 / 0.16), transparent 68%);
    pointer-events: none;
  }

  .avatar-ring {
    position: relative;
    width: 84px; height: 84px;
    margin: 0 auto 0.7rem;
    border-radius: 50%;
    padding: 3px;
    background: var(--gradient-primary);
    box-shadow: 0 6px 20px oklch(62% 0.14 282 / 0.35);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* 头像右下角的在线状态点（呼吸扩散） */
  .avatar-status {
    position: absolute;
    right: 3px;
    bottom: 5px;
    width: 13px; height: 13px;
    border-radius: 50%;
    background: oklch(72% 0.17 150);
    border: 2.5px solid var(--surface);
    animation: statusPulse 2.6s ease-out infinite;
  }
  @keyframes statusPulse {
    0%   { box-shadow: 0 0 0 0 oklch(72% 0.17 150 / 0.55); }
    70%  { box-shadow: 0 0 0 8px oklch(72% 0.17 150 / 0); }
    100% { box-shadow: 0 0 0 0 oklch(72% 0.17 150 / 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .avatar-status { animation: none; }
  }
  .profile-card:hover .avatar-ring { transform: rotate(8deg) scale(1.05); }
  .profile-avatar {
    width: 100%; height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--surface);
    display: block;
  }

  .profile-name {
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0 0 0.25rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .profile-bio {
    font-size: 0.78rem;
    color: var(--text-faint);
    margin: 0 0 0.9rem;
    display: inline-block;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border-light);
  }
  .profile-nav { display: flex; flex-direction: column; gap: 0.15rem; }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-soft);
    font-size: 0.84rem;
    text-decoration: none !important;
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
    position: relative;
  }
  /* 图标坐进小色块 */
  .nav-icon {
    width: 1.7rem; height: 1.7rem;
    display: grid;
    place-items: center;
    border-radius: 0.5rem;
    background: var(--surface-2);
    border: 1px solid var(--border-light);
    color: var(--text-soft);
    flex-shrink: 0;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  .nav-item:hover { background: var(--surface-2); color: var(--text); }
  .nav-item:hover .nav-icon {
    background: var(--primary-soft);
    border-color: transparent;
    color: var(--primary);
    transform: scale(1.06);
  }
  .nav-item.active {
    background: var(--primary-soft);
    color: var(--primary-strong);
    font-weight: 600;
  }
  :global([data-theme='dark'] .nav-item.active) { color: var(--primary-light); }
  .nav-item.active .nav-icon {
    background: var(--gradient-primary);
    border-color: transparent;
    color: var(--text-on-primary);
    box-shadow: 0 3px 10px -2px var(--primary-glow);
  }


  /* 分区标题 */
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px dashed var(--border);
  }
  .section-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
    position: relative;
    padding-left: 0.7rem;
  }
  .section-title::before {
    content: '';
    position: absolute;
    left: 0; top: 50%;
    transform: translateY(-50%);
    width: 4px; height: 1.15rem;
    border-radius: 3px;
    background: var(--gradient-primary);
  }
  .section-title :global(.icon) { color: var(--primary); }
  .post-count {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border: 1px solid oklch(70% 0.14 282 / 0.25);
    padding: 0.12rem 0.6rem;
    border-radius: 999px;
    flex-shrink: 0;
  }
  :global([data-theme='dark'] .post-count) { color: var(--primary-light); }
  .section-more {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none !important;
    flex-shrink: 0;
    transition: transform 0.18s ease;
  }
  .section-more:hover { transform: translateX(3px); }

  /* ===== 布局切换：列表视图 ↔ 卡片网格 ===== */
  .section-head-right {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
  }
  .layout-switch {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.15rem;
    padding: 0.16rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
  }
  .layout-thumb {
    position: absolute;
    top: 0.16rem;
    bottom: 0.16rem;
    left: 0.16rem;
    width: calc((100% - 0.4rem) / 2);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: 0 1px 4px oklch(0% 0 0 / 0.12);
    transition: transform 0.3s cubic-bezier(0.34, 1.4, 0.64, 1);
    pointer-events: none;
  }
  :global([data-theme='dark']) .layout-thumb { background: oklch(30% 0.02 282); }
  .layout-switch[data-active='grid'] .layout-thumb {
    transform: translateX(calc(100% + 0.15rem));
  }
  .layout-btn {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 28px;
    height: 26px;
    border: none;
    background: transparent;
    border-radius: 999px;
    cursor: pointer;
    color: var(--text-faint);
    transition: color 0.2s ease;
  }
  .layout-btn:hover { color: var(--primary); }
  .layout-switch[data-active='list'] .layout-btn.is-list,
  .layout-switch[data-active='grid'] .layout-btn.is-grid { color: var(--primary); }

  /* 两种布局同屏渲染、按需显隐 —— 切换是即时，不重建 DOM。
     用 [hidden] 而不是 display:none，避免被 Astro/浏览器的默认样式覆盖。 */
  .post-grid[hidden], .post-rows[hidden] { display: none !important; }

  /* 卡片网格：窄屏两列，≥1280px 三列（和整页三栏布局同一断点），手机单列 */
  .post-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem;
  }
  @media (min-width: 1280px) {
    .post-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .post-grid { grid-template-columns: 1fr; }
  }
  /* 网格里的卡片自带 onload-animation 的延迟，这里不用再包一层 */
  .post-grid > .post-card { width: 100%; }

  /* 分区间距（用户要求"贴近一些"）：列表底部到分页留 1.5rem 收尾。
     原先这里还有一套「置顶大卡」(.editorial-feed / .featured-*) 的样式，
     用户反馈那张大卡太突兀，已连同 HTML 一起移除。 */
  .recent-feed { margin-bottom: 1.5rem; }
  .recent-feed .section-head {
    align-items: baseline;
    margin-bottom: 0.85rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }
  .recent-feed .section-title {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding-left: 0;
    font-family: var(--font-sans);
    font-size: 1.05rem;
    font-weight: 800;
    letter-spacing: 0.01em;
    text-transform: none;
  }
  .recent-feed .section-title :global(.icon) { color: var(--primary-strong); }
  :global([data-theme='dark']) .recent-feed .section-title :global(.icon) { color: var(--primary-light); }
  .recent-feed .section-title::before { display: none; }
  .section-index { color: var(--primary); font-size: 0.68rem; letter-spacing: 0.05em; }
  .section-edition { color: var(--text-faint); font-size: 0.62rem; }
  .recent-feed .post-rows { gap: 0.7rem; }
  @media (max-width: 640px) {
    .section-edition { font-size: 0.55rem; letter-spacing: 0.04em; }
  }

  /* ===== 标签云 ===== */
  .tag-card { padding: 1rem; }
  .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .cloud-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.24rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-soft);
    font-size: 0.74rem;
    font-weight: 600;
    text-decoration: none !important;
    transition: all 0.18s ease;
  }
  .cloud-tag em {
    font-style: normal;
    font-size: 0.64rem;
    font-weight: 700;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-faint);
  }
  .cloud-tag:hover {
    color: var(--text-on-primary);
    background: var(--gradient-primary);
    border-color: transparent;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px oklch(62% 0.14 282 / 0.28);
  }
  .cloud-tag:hover em { background: oklch(100% 0 0 / 0.22); color: inherit; }

  /* 首页「最新文章」：单列横向行（参考图形态 —— 左缩略图 + 标题 + 摘要 + 标签 + 时长）。
     不再用两列大卡片网格。 */
  .post-rows {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
  }
  .post-rows .post-row { width: 100%; }
</style>

<script>
  // 文章列表布局切换：卡片网格 ↔ 单列卡片行。
  // 偏好存 localStorage（键 'feed-layout'），跨页面、跨刷新保持。
  //
  // 为什么两种布局都渲染在 DOM 里：切布局是「即时的」—— 图早就解码好了，
  // 只切 display。若用 JS 按布局重建 DOM，网格→列表会重新触发封面解码，
  // 切换时先白一下。
  const LS_KEY = 'feed-layout';

  function readPref(): 'list' | 'grid' {
    try {
      const v = localStorage.getItem(LS_KEY);
      if (v === 'list' || v === 'grid') return v;
    } catch {}
    return 'list';
  }

  function apply(mode: 'list' | 'grid') {
    const wrap = document.getElementById('feed-layout-switch');
    const rows = document.querySelector('.post-rows');
    const grid = document.querySelector('.post-grid');
    if (!wrap) return;

    wrap.dataset.active = mode;

    // [hidden] 用属性切换，Astro 组件 scoped 样式里的 display:grid/flex
    // 会盖掉 [hidden] 的默认 display:none，所以 CSS 里额外用 .post-grid[hidden] { display:none!important } 兜底。
    if (rows) rows.toggleAttribute('hidden', mode !== 'list');
    if (grid) grid.toggleAttribute('hidden', mode !== 'grid');
  }

  function bind() {
    const wrap = document.getElementById('feed-layout-switch');
    if (!wrap) return;

    const current = readPref();
    apply(current);

    wrap.querySelectorAll<HTMLButtonElement>('.layout-btn').forEach((b) => {
      const mode = b.dataset.layout as 'list' | 'grid';
      b.onclick = () => {
        apply(mode);
        try { localStorage.setItem(LS_KEY, mode); } catch {}
      };
    });
  }

  bind();
  document.addEventListener('astro:page-load', bind);
</script>
