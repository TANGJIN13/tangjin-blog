---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import HeatmapWidget from '../components/HeatmapWidget.astro';
import SearchWidget from '../components/SearchWidget.astro';
import CalendarWidget from '../components/CalendarWidget.astro';
import HolidayWidget from '../components/HolidayWidget.astro';
import SiteStats from '../components/SiteStats.astro';
import Paginate from '../components/Paginate.astro';
import Icon from '../components/Icon.astro';
import { formatDate, getPublishedPosts, getTags, pinToTop, readingTime } from '../lib/posts';
import { categories } from '../data/categories';
import { site } from '../site';

const posts = await getPublishedPosts();
const totalWords = posts.reduce((sum, p) => sum + (p.body?.replace(/\s/g, '').length || 0), 0);
const tags = await getTags();

// 首页文章统一卡片网格；置顶文章浮到最前
const ordered = pinToTop(posts);
const featured = ordered[0] ?? null;
const featuredCategory = featured ? categories.find((c) => c.slug === featured.data.category) : null;
const featuredCover = featured?.data.cover ?? '/images/covers/cover-01.jpg';
const recentPosts = featured ? ordered.slice(1) : ordered;

const catCounts = categories.map((c) => ({
  ...c,
  count: posts.filter((p) => p.data.category === c.slug).length,
}));
// 分类占比条的基准（最多的那个分类占满）
const maxCatCount = Math.max(1, ...catCounts.map((c) => c.count));

---

<Base>
  <!-- 顶部全宽壁纸 -->
  <section class="home-masthead" aria-label="个人博客介绍">
    <div class="masthead-inner">
      <div class="masthead-kicker"><span class="masthead-rule"></span> WEB SECURITY · CTF · FIELD NOTES <span class="masthead-edition">个人研究手记 / 2026</span></div>
      <h1>把好奇心，<br /><em>写成可追溯的答案。</em></h1>
      <p>这里记录漏洞复现、CTF 解题与一路上的真实思考。<br class="desktop-break" />不追热点，认真留下每一次理解。</p>
      <div class="masthead-links">
        <a class="masthead-primary" href="#latest-notes">读最新文章 <Icon name="arrow_down" size="0.95rem" /></a>
        <a class="masthead-secondary" href="/about/">认识作者 <Icon name="arrow_right" size="0.85rem" /></a>
      </div>
      <span class="masthead-index" aria-hidden="true">01</span>
    </div>
    <div class="masthead-art" aria-hidden="true">
      <span class="art-orbit orbit-one"></span><span class="art-orbit orbit-two"></span><span class="art-core"></span>
      <span class="art-caption">OBSERVE<br />·<br />UNDERSTAND</span>
      <span class="art-coordinate">N 25°16′ · E 110°17′</span>
    </div>
    <div class="masthead-bottom"><span>INDEPENDENT NOTES / VOL. 01</span><span>SCROLL TO EXPLORE ↓</span><span>EST. 2026</span></div>
  </section>

  <!-- 三栏内容 -->
  <div class="container">
    <div class="ref-layout">
      <!-- 左侧栏 -->
      <aside class="ref-sidebar-left">
        <div class="card-base profile-card onload-animation">
          <div class="avatar-ring">
            <img class="profile-avatar" src={site.avatar} alt="头像" width="78" height="78" />
            <span class="avatar-status" title="在线"></span>
          </div>
          <h3 class="profile-name">{site.title}</h3>
          <p class="profile-bio">Web 安全 / CTF / 生活趣事</p>
          <nav class="profile-nav">
            <a href="/" class="nav-item active"><span class="nav-icon"><Icon name="home" size="0.95rem" /></span><span>首页</span></a>
            <a href="/archive/" class="nav-item"><span class="nav-icon"><Icon name="archive" size="0.95rem" /></span><span>归档</span></a>
            <a href="/album/" class="nav-item"><span class="nav-icon"><Icon name="photo" size="0.95rem" /></span><span>相册</span></a>
            <a href="/says/" class="nav-item"><span class="nav-icon"><Icon name="comment" size="0.95rem" /></span><span>说说</span></a>
            <a href="/about/" class="nav-item"><span class="nav-icon"><Icon name="person" size="0.95rem" /></span><span>关于</span></a>
          </nav>
        </div>

        <div class="card-base widget-card onload-animation" style="animation-delay: 0.1s">
          <h3 class="widget-title"><Icon name="palette" size="1.05rem" /> 主题</h3>
          <ThemeToggle />
        </div>

        <!-- 分类列表（竖向排列） -->
        <div class="card-base widget-card cat-widget onload-animation" style="animation-delay: 0.15s">
          <h3 class="widget-title"><Icon name="folder" size="1.05rem" /> 分类</h3>
          <div class="cat-list" id="cat-list" data-collapsed="5">
            {catCounts.map((c, i) => (
              <a class="cat-row" href={`/categories/${c.slug}/`} data-index={i}
                 style={`--pct: ${Math.round((c.count / maxCatCount) * 100)}%`}>
                <span class="cat-row-name">{c.name}</span>
                <span class="cat-row-count">{c.count}</span>
              </a>
            ))}
          </div>
          {catCounts.length > 5 && (
            <button class="cat-toggle" id="cat-toggle" type="button">
              <span class="cat-toggle-text">更多</span>
              <Icon name="arrow_down" size="0.8rem" />
            </button>
          )}
        </div>
      </aside>

      <!-- 主内容 -->
      <main class="ref-main" id="main-content" aria-label="文章列表">
        <!-- 快捷导航条：首页 + 归档 -->
        <section class="block onload-animation">
          <div class="cat-card card-base" id="category-bar">
            <div class="cat-bar-inner">
              <a class="cat-pill cat-pill-home is-active" href="/" aria-label="首页">
                <Icon name="home" size="1.125rem" />
              </a>
              <a class="cat-pill" href="/archive/">
                归档<span class="pill-count">{posts.length}</span>
              </a>
              <span class="cat-divider" aria-hidden="true"></span>
              <div class="cat-scroll-area">
                <div class="cat-scroll-fade cat-scroll-fade-left" aria-hidden="true"></div>
                <div class="cat-scroll">
                  {catCounts.map((c) => (
                    <a class="cat-pill" href={`/categories/${c.slug}/`}>
                      {c.name}<span class="pill-count">{c.count}</span>
                    </a>
                  ))}
                </div>
                <div class="cat-scroll-fade cat-scroll-fade-right" aria-hidden="true"></div>
              </div>
              <a class="cat-pill cat-more" href="/categories/" aria-label="查看全部分类">
                更多<Icon name="arrow_right" size="0.875rem" />
              </a>
            </div>
          </div>
        </section>

        <!-- 文章主编精选 + 最近更新 -->
        {featured && (
          <section class="block editorial-feed" id="latest-notes">
            <div class="section-head">
              <h2 class="section-title"><span class="section-index">01 /</span> 最新手记</h2>
              <span class="section-edition">按时间持续更新</span>
            </div>
            <a class="featured-note" href={`/posts/${featured.id}/`}>
              <div class="featured-copy">
                <span class="featured-kicker"><span class="featured-mark"></span> EDITOR'S PICK · {featuredCategory?.name ?? 'LATEST NOTE'}</span>
                <h3>{featured.data.title}</h3>
                <p>{featured.data.description || featured.body.replace(/\s+/g, ' ').slice(0, 150)}</p>
                <div class="featured-meta">
                  <time datetime={featured.data.published.toISOString()}>{formatDate(featured.data.published)}</time>
                  <span>·</span><span>{readingTime(featured.body)} 分钟阅读</span>
                  <span class="featured-read">打开手记 <Icon name="arrow_right" size="0.9rem" /></span>
                </div>
              </div>
              <div class="featured-image">
                <img src={featuredCover} alt="" fetchpriority="high" />
                <span class="featured-image-index">FIELD NOTE / 001</span>
                <span class="featured-image-arrow"><Icon name="arrow_right" size="1.15rem" /></span>
              </div>
            </a>
          </section>
        )}
        {recentPosts.length > 0 && (
          <section class="block recent-feed">
            <div class="section-head">
              <h2 class="section-title"><span class="section-index">02 /</span> 继续阅读</h2>
              <a class="section-more" href="/archive/">全部归档 <Icon name="arrow_right" size="0.85rem" /></a>
            </div>
            <div class="post-list">
              {recentPosts.map((p, i) => (
                <div class="paginate-item">
                  <PostCard post={p} index={i + 1} style={`animation-delay: ${Math.min(i, 8) * 0.06}s`} />
                </div>
              ))}
            </div>
            <Paginate pageSize={15} />
          </section>
        )}

        <!-- 标签 -->
        {tags.length > 0 && (
          <section class="block">
            <div class="card-base tag-card onload-animation">
              <h3 class="widget-title"><Icon name="tag" size="1.05rem" /> 标签</h3>
              <div class="tag-cloud">
                {tags.slice(0, 16).map((t, i) => (
                  <a class="cloud-tag" href={`/search/?q=${encodeURIComponent(t.tag)}`} style={`--i:${i}`}>
                    #{t.tag}<em>{t.count}</em>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )}
        <script>
          // 分类条左右渐隐：滚到最左时隐藏左遮罩，滚到最右时隐藏右遮罩
          (function () {
            function setup() {
              const bar = document.getElementById('category-bar');
              if (!bar || bar.dataset.bound) return;
              bar.dataset.bound = '1';
              const scroll = bar.querySelector('.cat-scroll');
              const fadeL = bar.querySelector('.cat-scroll-fade-left');
              const fadeR = bar.querySelector('.cat-scroll-fade-right');
              if (!scroll) return;
              function update() {
                const max = scroll.scrollWidth - scroll.clientWidth;
                if (fadeL) fadeL.style.opacity = scroll.scrollLeft > 4 ? '1' : '0';
                if (fadeR) fadeR.style.opacity = scroll.scrollLeft < max - 4 ? '1' : '0';
              }
              update();
              scroll.addEventListener('scroll', update, { passive: true });
              window.addEventListener('resize', update);
            }
            setup();
            document.addEventListener('astro:page-load', setup);
          })();
        </script>
      </main>

      <!-- 右侧栏 -->
      <aside class="ref-sidebar-right">
        <div class="card-base widget-card onload-animation" style="animation-delay: 0.1s">
          <h3 class="widget-title"><Icon name="search" size="1.05rem" /> 搜索</h3>
          <SearchWidget />
        </div>

        <div class="card-base widget-card onload-animation" style="animation-delay: 0.2s">
          <h3 class="widget-title"><Icon name="calendar" size="1.05rem" /> 日历</h3>
          <CalendarWidget />
        </div>

        <div class="card-base widget-card onload-animation" style="animation-delay: 0.3s">
          <h3 class="widget-title"><Icon name="clock" size="1.05rem" /> 节假日</h3>
          <HolidayWidget />
        </div>

        <div class="card-base widget-card onload-animation" style="animation-delay: 0.4s">
          <h3 class="widget-title"><Icon name="chart" size="1.05rem" /> 站点</h3>
          <SiteStats
            postsCount={posts.length}
            categoriesCount={categories.length}
            totalWords={totalWords}
          />
        </div>

        <HeatmapWidget />
      </aside>
    </div>
  </div>
</Base>

<style>
  .home-masthead {
    position: relative;
    width: 100vw;
    min-height: clamp(440px, 58vh, 650px);
    margin-left: calc(50% - 50vw);
    padding: clamp(5rem, 9vh, 7.5rem) max(5vw, calc((100vw - 100rem) / 2 + 2rem)) 3.7rem;
    overflow: hidden;
    color: oklch(22% 0.025 175);
    background:
      radial-gradient(ellipse at 82% 52%, oklch(72% 0.07 152 / 0.12), transparent 38%),
      linear-gradient(112deg, oklch(95.5% 0.018 82), oklch(92.5% 0.022 78) 54%, oklch(95% 0.02 84));
    border-bottom: 1px solid color-mix(in srgb, var(--text) 12%, transparent);
  }
  :global([data-theme='dark'] .home-masthead) {
    color: var(--text);
    background:
      radial-gradient(ellipse at 82% 52%, oklch(50% 0.06 155 / 0.18), transparent 38%),
      linear-gradient(112deg, oklch(20% 0.02 190), oklch(23% 0.022 180) 54%, oklch(20% 0.02 190));
  }
  .masthead-inner { position: relative; z-index: 1; max-width: 72rem; margin-inline: auto; }
  .masthead-kicker, .masthead-bottom, .masthead-edition, .masthead-index, .art-caption, .art-coordinate, .featured-kicker, .featured-image-index, .section-edition, .section-index {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.13em;
  }
  .masthead-kicker { display: flex; align-items: center; gap: 0.75rem; color: color-mix(in srgb, var(--text) 66%, transparent); }
  .masthead-rule { width: 2rem; height: 1px; background: var(--primary); }
  .masthead-edition { margin-left: 0.5rem; color: var(--text-faint); }
  .masthead-inner h1 { margin: 2.5rem 0 1.15rem; font-size: clamp(3rem, 6.8vw, 6.4rem); line-height: 1.13; letter-spacing: -0.065em; font-weight: 500; color: inherit; }
  .masthead-inner h1 em { color: var(--primary-strong); font-style: normal; }
  :global([data-theme='dark'] .masthead-inner h1 em) { color: var(--primary-light); }
  .masthead-inner > p { color: color-mix(in srgb, var(--text) 70%, transparent); font-size: clamp(0.95rem, 1.3vw, 1.08rem); line-height: 1.9; }
  .masthead-links { display: flex; align-items: center; gap: 1.5rem; margin-top: 1.8rem; }
  .masthead-primary, .masthead-secondary { display: inline-flex; align-items: center; gap: 0.55rem; text-decoration: none !important; font-size: 0.86rem; font-weight: 650; }
  .masthead-primary { padding: 0.75rem 1.05rem; color: oklch(98% 0.008 86) !important; background: oklch(34% 0.055 165); border: 1px solid oklch(34% 0.055 165); border-radius: 0.22rem; transition: background 0.2s ease, transform 0.2s ease; }
  .masthead-primary:hover { background: oklch(28% 0.05 165); transform: translateY(-2px); }
  .masthead-secondary { color: var(--text-soft); }
  .masthead-secondary:hover { color: var(--primary-strong); }
  .masthead-index { position: absolute; right: 0; top: 0.4rem; color: var(--text-faint); }
  .masthead-art { position: absolute; right: max(7vw, calc((100vw - 100rem) / 2 + 5rem)); top: 50%; width: clamp(230px, 28vw, 410px); aspect-ratio: 1; transform: translateY(-44%); border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent); border-radius: 50%; opacity: 0.78; }
  .masthead-art::before, .masthead-art::after { content: ''; position: absolute; inset: 12%; border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent); border-radius: 50%; }
  .masthead-art::after { inset: 25%; border-style: dashed; opacity: 0.65; }
  .art-orbit { position: absolute; inset: -8% 18%; border: 1px solid color-mix(in srgb, var(--accent) 32%, transparent); border-radius: 50%; transform: rotate(47deg); }
  .orbit-two { inset: 17% -7%; transform: rotate(-42deg); border-color: color-mix(in srgb, var(--primary) 24%, transparent); }
  .art-core { position: absolute; inset: 38%; border-radius: 50%; background: radial-gradient(circle at 32% 28%, oklch(79% 0.08 118), oklch(53% 0.075 157) 54%, oklch(32% 0.06 178)); box-shadow: 0 0 55px color-mix(in srgb, var(--primary) 25%, transparent), inset -12px -16px 24px rgb(21 42 34 / 0.18); }
  .art-caption { position: absolute; left: 2%; top: 35%; color: var(--primary-strong); line-height: 1.8; }
  .art-coordinate { position: absolute; right: 1%; bottom: 18%; color: var(--text-faint); font-size: 0.56rem; }
  .masthead-bottom { position: absolute; right: max(5vw, calc((100vw - 100rem) / 2 + 2rem)); bottom: 1.15rem; left: max(5vw, calc((100vw - 100rem) / 2 + 2rem)); display: flex; justify-content: space-between; padding-top: 0.75rem; color: var(--text-faint); border-top: 1px solid color-mix(in srgb, var(--text) 12%, transparent); font-size: 0.6rem; }
  .masthead-bottom span:nth-child(2) { color: var(--primary-strong); }

  /* 三栏布局保持组件功能，视觉系统由全局刊物版式统一 */
  .ref-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 900px) {
    .ref-layout { grid-template-columns: var(--sidebar-width) minmax(0, 1fr); }
    .ref-sidebar-right { display: none; }
  }

  @media (min-width: 1280px) {
    .ref-layout { grid-template-columns: var(--sidebar-width) minmax(0, 1fr) var(--sidebar-width); }
    .ref-sidebar-right { display: flex; }
  }

  .ref-sidebar-left, .ref-sidebar-right {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* 主内容分区间距 */
  .ref-main { display: flex; flex-direction: column; gap: 1.5rem; min-width: 0; }
  .block { scroll-margin-top: 80px; min-width: 0; }

  /* ===== 个人资料卡 ===== */
  .profile-card {
    text-align: center;
    padding: 1.5rem 1rem 1.05rem;
    position: relative;
    overflow: hidden;
  }
  /* 卡片顶部一条主色渐变装饰线（左右缩进，避免直条穿过圆角显得毛躁） */
  .profile-card::before {
    content: '';
    position: absolute;
    inset: 0 20% auto;
    height: 3px;
    border-radius: 0 0 999px 999px;
    background: var(--gradient-primary);
    opacity: 0.9;
  }
  /* 右上角一团柔光，避免卡片显得平 */
  .profile-card::after {
    content: '';
    position: absolute;
    top: -46px;
    right: -46px;
    width: 130px;
    height: 130px;
    border-radius: 50%;
    background: radial-gradient(circle, oklch(70% 0.15 158 / 0.16), transparent 68%);
    pointer-events: none;
  }

  .avatar-ring {
    position: relative;
    width: 84px; height: 84px;
    margin: 0 auto 0.7rem;
    border-radius: 50%;
    padding: 3px;
    background: var(--gradient-primary);
    box-shadow: 0 6px 20px oklch(62% 0.14 158 / 0.35);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* 头像右下角的在线状态点（呼吸扩散） */
  .avatar-status {
    position: absolute;
    right: 3px;
    bottom: 5px;
    width: 13px; height: 13px;
    border-radius: 50%;
    background: oklch(72% 0.17 150);
    border: 2.5px solid var(--surface);
    animation: statusPulse 2.6s ease-out infinite;
  }
  @keyframes statusPulse {
    0%   { box-shadow: 0 0 0 0 oklch(72% 0.17 150 / 0.55); }
    70%  { box-shadow: 0 0 0 8px oklch(72% 0.17 150 / 0); }
    100% { box-shadow: 0 0 0 0 oklch(72% 0.17 150 / 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .avatar-status { animation: none; }
  }
  .profile-card:hover .avatar-ring { transform: rotate(8deg) scale(1.05); }
  .profile-avatar {
    width: 100%; height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--surface);
    display: block;
  }

  .profile-name {
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0 0 0.25rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .profile-bio {
    font-size: 0.78rem;
    color: var(--text-faint);
    margin: 0 0 0.9rem;
    display: inline-block;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border-light);
  }
  .profile-nav { display: flex; flex-direction: column; gap: 0.15rem; }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.4rem 0.5rem;
    border-radius: var(--radius-sm);
    color: var(--text-soft);
    font-size: 0.84rem;
    text-decoration: none !important;
    transition: background 0.18s ease, color 0.18s ease, transform 0.18s ease;
    position: relative;
  }
  /* 图标坐进小色块 */
  .nav-icon {
    width: 1.7rem; height: 1.7rem;
    display: grid;
    place-items: center;
    border-radius: 0.5rem;
    background: var(--surface-2);
    border: 1px solid var(--border-light);
    color: var(--text-soft);
    flex-shrink: 0;
    transition: background 0.2s ease, color 0.2s ease, transform 0.2s ease, border-color 0.2s ease;
  }
  .nav-item:hover { background: var(--surface-2); color: var(--text); }
  .nav-item:hover .nav-icon {
    background: var(--primary-soft);
    border-color: transparent;
    color: var(--primary);
    transform: scale(1.06);
  }
  .nav-item.active {
    background: var(--primary-soft);
    color: var(--primary-strong);
    font-weight: 600;
  }
  :global([data-theme='dark'] .nav-item.active) { color: var(--primary-light); }
  .nav-item.active .nav-icon {
    background: var(--gradient-primary);
    border-color: transparent;
    color: var(--text-on-primary);
    box-shadow: 0 3px 10px -2px var(--primary-glow);
  }


  /* 分区标题 */
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px dashed var(--border);
  }
  .section-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
    position: relative;
    padding-left: 0.7rem;
  }
  .section-title::before {
    content: '';
    position: absolute;
    left: 0; top: 50%;
    transform: translateY(-50%);
    width: 4px; height: 1.15rem;
    border-radius: 3px;
    background: var(--gradient-primary);
  }
  .section-title :global(.icon) { color: var(--primary); }
  .post-count {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border: 1px solid oklch(70% 0.14 158 / 0.25);
    padding: 0.12rem 0.6rem;
    border-radius: 999px;
    flex-shrink: 0;
  }
  :global([data-theme='dark'] .post-count) { color: var(--primary-light); }
  .section-more {
    font-size: 0.76rem;
    font-weight: 600;
