---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import HeatmapWidget from '../components/HeatmapWidget.astro';
import SearchWidget from '../components/SearchWidget.astro';
import CalendarWidget from '../components/CalendarWidget.astro';
import HolidayWidget from '../components/HolidayWidget.astro';
import WallpaperBanner from '../components/WallpaperBanner.astro';
import SiteStats from '../components/SiteStats.astro';
import Icon from '../components/Icon.astro';
import { getPublishedPosts, getTags, pinToTop } from '../lib/posts';
import { categories } from '../data/categories';
import { site } from '../site';

const posts = await getPublishedPosts();
const totalWords = posts.reduce((sum, p) => sum + (p.body?.replace(/\s/g, '').length || 0), 0);
const tags = await getTags();

// 首页文章统一卡片网格；置顶文章浮到最前
const ordered = pinToTop(posts);

const catCounts = categories.map((c) => ({
  ...c,
  count: posts.filter((p) => p.data.category === c.slug).length,
}));

---

<Base banner>
  <!-- 顶部全宽壁纸 -->
  <WallpaperBanner />

  <!-- 三栏内容 -->
  <div class="container">
    <div class="ref-layout">
      <!-- 左侧栏 -->
      <aside class="ref-sidebar-left">
        <div class="card-base profile-card onload-animation">
          <div class="avatar-ring">
            <img class="profile-avatar" src={site.avatar} alt="头像" width="78" height="78" />
          </div>
          <h3 class="profile-name">{site.title}</h3>
          <p class="profile-bio">Web 安全 / CTF / 生活趣事</p>
          <nav class="profile-nav">
            <a href="/" class="nav-item active"><Icon name="home" size="1rem" /> 首页</a>
            <a href="/archive/" class="nav-item"><Icon name="archive" size="1rem" /> 归档</a>
            <a href="/album/" class="nav-item"><Icon name="photo" size="1rem" /> 相册</a>
            <a href="/says/" class="nav-item"><Icon name="comment" size="1rem" /> 说说</a>
            <a href="/about/" class="nav-item"><Icon name="person" size="1rem" /> 关于</a>
          </nav>
        </div>

        <div class="card-base widget-card onload-animation" style="animation-delay: 0.1s">
          <h3 class="widget-title"><Icon name="palette" size="1.05rem" /> 主题</h3>
          <ThemeToggle />
        </div>
      </aside>

      <!-- 主内容 -->
      <main class="ref-main" id="main-content" aria-label="文章列表">
        <!-- 分类导航：白色卡片 + 首页圆形按钮 + 归档 + 分隔线 + 可横向滚动的分类 -->
        <section class="block onload-animation">
          <div class="cat-card card-base" id="category-bar">
            <div class="cat-bar-inner">
              <a class="cat-pill cat-pill-home is-active" href="/" aria-label="首页">
                <Icon name="home" size="1.05rem" />
              </a>
              <a class="cat-pill" href="/archive/">
                归档<span class="pill-count">{posts.length}</span>
              </a>
              <span class="cat-divider" aria-hidden="true"></span>
              <div class="cat-scroll-area">
                <div class="cat-scroll-fade cat-scroll-fade-left" aria-hidden="true"></div>
                <div class="cat-scroll">
                  {catCounts.map((c) => (
                    <a class="cat-pill" href={`/categories/${c.slug}/`}>
                      {c.name}<span class="pill-count">{c.count}</span>
                    </a>
                  ))}
                </div>
                <div class="cat-scroll-fade cat-scroll-fade-right" aria-hidden="true"></div>
              </div>
            </div>
          </div>
        </section>

        <!-- 文章网格（统一卡片样式） -->
        {ordered.length > 0 && (
          <section class="block">
            <div class="section-head">
              <h2 class="section-title"><Icon name="book" size="1.1rem" /> 最新文章</h2>
              <a class="section-more" href="/archive/">全部归档 →</a>
            </div>
            <div class="post-list">
              {ordered.map((p, i) => (
                <PostCard post={p} style={`animation-delay: ${Math.min(i, 8) * 0.06}s`} />
              ))}
            </div>
          </section>
        )}

        <!-- 标签 -->
        {tags.length > 0 && (
          <section class="block">
            <div class="card-base tag-card onload-animation">
              <h3 class="widget-title"><Icon name="tag" size="1.05rem" /> 标签</h3>
              <div class="tag-cloud">
                {tags.slice(0, 16).map((t, i) => (
                  <a class="cloud-tag" href={`/search/?q=${encodeURIComponent(t.tag)}`} style={`--i:${i}`}>
                    #{t.tag}<em>{t.count}</em>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )}
        <script>
          // 分类条左右渐隐：滚到最左时隐藏左遮罩，滚到最右时隐藏右遮罩
          (function () {
            function setup() {
              const bar = document.getElementById('category-bar');
              if (!bar || bar.dataset.bound) return;
              bar.dataset.bound = '1';
              const scroll = bar.querySelector('.cat-scroll');
              const fadeL = bar.querySelector('.cat-scroll-fade-left');
              const fadeR = bar.querySelector('.cat-scroll-fade-right');
              if (!scroll) return;
              function update() {
                const max = scroll.scrollWidth - scroll.clientWidth;
                if (fadeL) fadeL.style.opacity = scroll.scrollLeft > 4 ? '1' : '0';
                if (fadeR) fadeR.style.opacity = scroll.scrollLeft < max - 4 ? '1' : '0';
              }
              update();
              scroll.addEventListener('scroll', update, { passive: true });
              window.addEventListener('resize', update);
            }
            setup();
            document.addEventListener('astro:page-load', setup);
          })();
        </script>
      </main>

      <!-- 右侧栏 -->
      <aside class="ref-sidebar-right">
        <div class="card-base widget-card onload-animation" style="animation-delay: 0.1s">
          <h3 class="widget-title"><Icon name="search" size="1.05rem" /> 搜索</h3>
          <SearchWidget />
        </div>

        <div class="card-base widget-card onload-animation" style="animation-delay: 0.2s">
          <h3 class="widget-title"><Icon name="calendar" size="1.05rem" /> 日历</h3>
          <CalendarWidget />
        </div>

        <div class="card-base widget-card onload-animation" style="animation-delay: 0.3s">
          <h3 class="widget-title"><Icon name="clock" size="1.05rem" /> 节假日</h3>
          <HolidayWidget />
        </div>

        <div class="card-base widget-card onload-animation" style="animation-delay: 0.4s">
          <h3 class="widget-title"><Icon name="chart" size="1.05rem" /> 站点</h3>
          <SiteStats
            postsCount={posts.length}
            categoriesCount={categories.length}
            totalWords={totalWords}
          />
        </div>

        <HeatmapWidget />
      </aside>
    </div>
  </div>
</Base>

<style>
  /* 三栏布局 —— 严格按照参照站：280 / 1fr / 280，gap 16 */
  .ref-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 900px) {
    .ref-layout { grid-template-columns: var(--sidebar-width) minmax(0, 1fr); }
    .ref-sidebar-right { display: none; }
  }

  @media (min-width: 1280px) {
    .ref-layout { grid-template-columns: var(--sidebar-width) minmax(0, 1fr) var(--sidebar-width); }
    .ref-sidebar-right { display: flex; }
  }

  .ref-sidebar-left, .ref-sidebar-right {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* 主内容分区间距 */
  .ref-main { display: flex; flex-direction: column; gap: 1.5rem; min-width: 0; }
  .block { scroll-margin-top: 80px; min-width: 0; }

  /* 资料卡 */
  .profile-card {
    text-align: center;
    padding: 1.5rem 1rem 1.1rem;
    position: relative;
    overflow: hidden;
  }
  /* 卡片顶部一条主色渐变装饰线 */
  .profile-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--gradient-primary);
  }

  .avatar-ring {
    width: 84px; height: 84px;
    margin: 0 auto 0.7rem;
    border-radius: 50%;
    padding: 3px;
    background: var(--gradient-primary);
    box-shadow: 0 6px 20px oklch(62% 0.14 250 / 0.35);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .profile-card:hover .avatar-ring { transform: rotate(8deg) scale(1.05); }
  .profile-avatar {
    width: 100%; height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--surface);
    display: block;
  }

  .profile-name {
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0 0 0.25rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .profile-bio {
    font-size: 0.78rem;
    color: var(--text-faint);
    margin: 0 0 0.9rem;
    display: inline-block;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border-light);
  }
  .profile-nav { display: flex; flex-direction: column; gap: 0.15rem; }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--text-soft);
    font-size: 0.84rem;
    text-decoration: none !important;
    transition: all 0.18s ease;
    position: relative;
  }
  .nav-item :global(.icon) { opacity: 0.8; transition: transform 0.18s ease; }
  .nav-item:hover { background: var(--surface-2); color: var(--text); transform: translateX(3px); }
  .nav-item:hover :global(.icon) { transform: scale(1.12); }
  .nav-item.active {
    background: var(--primary-soft);
    color: var(--primary-strong);
    font-weight: 600;
  }
  [data-theme='dark'] .nav-item.active { color: var(--primary-light); }
  .nav-item.active :global(.icon) { opacity: 1; }

  /* widget 标题带图标 */
  :global(.widget-title) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  :global(.widget-title .icon) { color: var(--primary); }

  /* 分区标题 */
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px dashed var(--border);
  }
  .section-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
    position: relative;
    padding-left: 0.7rem;
  }
  .section-title::before {
    content: '';
    position: absolute;
    left: 0; top: 50%;
    transform: translateY(-50%);
    width: 4px; height: 1.15rem;
    border-radius: 3px;
    background: var(--gradient-primary);
  }
  .section-title :global(.icon) { color: var(--primary); }
  .post-count {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border: 1px solid oklch(70% 0.14 250 / 0.25);
    padding: 0.12rem 0.6rem;
    border-radius: 999px;
    flex-shrink: 0;
  }
  [data-theme='dark'] .post-count { color: var(--primary-light); }
  .section-more {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none !important;
    flex-shrink: 0;
    transition: transform 0.18s ease;
  }
  .section-more:hover { transform: translateX(3px); }

  /* ===== 分类导航条（参照 c1everf0x.cn） ===== */
  .cat-card {
    padding: 0.75rem;
    margin-bottom: 1rem;
  }
  .cat-bar-inner {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  /* 首页：圆形图标按钮，激活时主色实心 */
  .cat-pill-home {
    width: 2rem;
    height: 2rem;
    padding: 0;
    border-radius: 50%;
    flex-shrink: 0;
  }
  .cat-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    flex-shrink: 0;
    padding: 0.38rem 0.85rem;
    border-radius: 999px;
    border: none;
    background: transparent;
    color: var(--text-soft);
    font-size: 0.82rem;
    font-weight: 500;
    text-decoration: none !important;
    white-space: nowrap;
    transition: background 0.15s ease-out, color 0.15s ease-out;
  }
  .cat-pill:hover {
    background: var(--surface-2);
    color: var(--text);
  }
  .cat-pill.is-active {
    background: var(--primary);
    color: #fff;
  }
  .cat-pill.is-active:hover { opacity: 0.9; background: var(--primary); }
  .cat-pill.is-active :global(.icon) { color: #fff; }
  /* 数量徽标 */
  .pill-count {
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1;
    padding: 0.1rem 0.38rem;
    border-radius: 999px;
    background: color-mix(in srgb, var(--text) 10%, transparent);
    color: var(--text-soft);
    opacity: 0.6;
  }
  .cat-pill.is-active .pill-count {
    background: rgba(255, 255, 255, 0.2);
    color: #fff;
    opacity: 0.9;
  }
  /* 归档与分类之间的竖线分隔 */
  .cat-divider {
    width: 1px;
    align-self: stretch;
    background: var(--border);
    opacity: 0.6;
    flex-shrink: 0;
  }
  /* 可横向滚动的分类区 */
  .cat-scroll-area {
    flex: 1;
    min-width: 0;
    position: relative;
  }
  .cat-scroll {
    display: flex;
    gap: 0.5rem;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-behavior: smooth;
  }
  .cat-scroll::-webkit-scrollbar { display: none; }
  /* 左右渐隐遮罩 */
  .cat-scroll-fade {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2rem;
    pointer-events: none;
    z-index: 1;
    transition: opacity 0.3s ease;
  }
  .cat-scroll-fade-left {
    left: 0;
    background: linear-gradient(to left, transparent, var(--surface));
    opacity: 0;
  }
  .cat-scroll-fade-right {
    right: 0;
    background: linear-gradient(to right, transparent, var(--surface));
    opacity: 1;
  }
  [data-theme='dark'] .cat-scroll-fade-left { background: linear-gradient(to left, transparent, var(--surface)); }
  [data-theme='dark'] .cat-scroll-fade-right { background: linear-gradient(to right, transparent, var(--surface)); }

  /* ===== 标签云 ===== */
  .tag-card { padding: 1rem; }
  .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .cloud-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.24rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-soft);
    font-size: 0.74rem;
    font-weight: 600;
    text-decoration: none !important;
    transition: all 0.18s ease;
  }
  .cloud-tag em {
    font-style: normal;
    font-size: 0.64rem;
    font-weight: 700;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-faint);
  }
  .cloud-tag:hover {
    color: var(--text-on-primary);
    background: var(--gradient-primary);
    border-color: transparent;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px oklch(62% 0.14 250 / 0.28);
  }
  .cloud-tag:hover em { background: oklch(100% 0 0 / 0.22); color: inherit; }

  /* 首页文章网格：固定两列（一行两篇），窄屏回退单列 */
  .post-list { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1rem; }

  @media (max-width: 640px) {
    .post-list { grid-template-columns: 1fr; }
  }

</style>
