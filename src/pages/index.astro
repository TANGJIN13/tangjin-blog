---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import HeatmapWidget from '../components/HeatmapWidget.astro';
import SearchWidget from '../components/SearchWidget.astro';
import CalendarWidget from '../components/CalendarWidget.astro';
import HolidayWidget from '../components/HolidayWidget.astro';
import WallpaperBanner from '../components/WallpaperBanner.astro';
import SiteStats from '../components/SiteStats.astro';
import Icon from '../components/Icon.astro';
import { getPublishedPosts, getTags, formatDate, readingTime } from '../lib/posts';
import { categories } from '../data/categories';
import { site } from '../site';

const posts = await getPublishedPosts();
const totalWords = posts.reduce((sum, p) => sum + (p.body?.replace(/\s/g, '').length || 0), 0);
const tags = await getTags();

// 最新一篇做「头条大卡」，其余走常规卡片
const [lead, ...rest] = posts;

const catCounts = categories.map((c) => ({
  ...c,
  count: posts.filter((p) => p.data.category === c.slug).length,
}));

const leadCat = lead ? categories.find((c) => c.slug === lead.data.category) : null;

// 没配封面时给一张渐变底，避免大块空白
const gradients = [
  'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
  'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
  'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',
  'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',
  'linear-gradient(135deg, #fa709a 0%, #fee140 100%)',
  'linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%)',
];
const gradOf = (id) => {
  const h = id.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
  return gradients[h % gradients.length];
};
const leadGrad = lead ? gradOf(lead.id) : gradients[0];
const leadMinutes = lead ? readingTime(lead.body) : 0;
---

<Base banner>
  <!-- 顶部全宽壁纸 -->
  <WallpaperBanner />

  <!-- 三栏内容 -->
  <div class="container">
    <div class="ref-layout">
      <!-- 左侧栏 -->
      <aside class="ref-sidebar-left">
        <div class="card-base profile-card onload-animation">
          <div class="avatar-ring">
            <img class="profile-avatar" src={site.avatar} alt="头像" width="78" height="78" />
          </div>
          <h3 class="profile-name">{site.title}</h3>
          <p class="profile-bio">Web 安全 / CTF / 漏洞复现</p>
          <nav class="profile-nav">
            <a href="/" class="nav-item active"><Icon name="home" size="1rem" /> 首页</a>
            <a href="/archive/" class="nav-item"><Icon name="archive" size="1rem" /> 归档</a>
            <a href="/about/" class="nav-item"><Icon name="person" size="1rem" /> 关于</a>
          </nav>
        </div>

        <div class="card-base widget-card onload-animation" style="animation-delay: 0.1s">
          <h3 class="widget-title"><Icon name="palette" size="1.05rem" /> 主题</h3>
          <ThemeToggle />
        </div>
      </aside>

      <!-- 主内容 -->
      <main class="ref-main" id="main-content" aria-label="文章列表">
        <!-- 从这里开始：分类入口 -->
        <section class="block onload-animation">
          <div class="section-head">
            <h2 class="section-title"><Icon name="folder" size="1.1rem" /> 从这里开始</h2>
            <span class="post-count">{categories.length} 个分类</span>
          </div>
          <div class="entry-grid">
            {catCounts.map((c) => (
              <a class="entry-card" href={`/categories/${c.slug}/`}>
                <span class="entry-icon"><Icon name={c.icon || 'folder'} size="1.15rem" /></span>
                <span class="entry-body">
                  <span class="entry-name">{c.name}</span>
                  <span class="entry-desc">{c.description}</span>
                </span>
                <span class="entry-count">{c.count}</span>
              </a>
            ))}
          </div>
        </section>

        <!-- 头条大卡 -->
        {lead && (
          <section class="block">
            <div class="section-head">
              <h2 class="section-title"><Icon name="sparkle" size="1.1rem" /> 最新一篇</h2>
              <span class="post-count">刚刚更新</span>
            </div>
            <a class="lead-card onload-animation" href={`/posts/${lead.id}/`}>
              <div class="lead-cover">
                {lead.data.cover ? (
                  <img src={lead.data.cover} alt="" loading="eager" />
                ) : (
                  <div class="lead-cover-ph" style={`background: ${leadGrad}`}>
                    <span class="lead-ph-char">{lead.data.title.slice(0, 1)}</span>
                    <span class="lead-ph-title">{lead.data.title}</span>
                  </div>
                )}
                <span class="lead-flag"><Icon name="sparkle" size="0.72rem" />最新</span>
                <span class="lead-shine" aria-hidden="true"></span>
              </div>
              <div class="lead-body">
                <div class="lead-meta">
                  {leadCat && (
                    <span class="lead-cat">
                      <Icon name={leadCat.icon || 'folder'} size="0.78rem" />{leadCat.name}
                    </span>
                  )}
                  <span class="lead-time"><Icon name="calendar" size="0.78rem" />{formatDate(lead.data.published)}</span>
                  <span class="lead-time"><Icon name="clock" size="0.78rem" />约 {leadMinutes} 分钟</span>
                </div>
                <h3 class="lead-title">{lead.data.title}</h3>
                <p class="lead-desc">{lead.data.description}</p>
                <span class="lead-cta">
                  开始阅读
                  <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true">
                    <path d="M13.2 5l-1.4 1.4 5.6 5.6-5.6 5.6 1.4 1.4 7-7z" /><path d="M4 11h9v2H4z" />
                  </svg>
                </span>
              </div>
            </a>
          </section>
        )}

        <!-- 其余文章 -->
        {rest.length > 0 && (
          <section class="block">
            <div class="section-head">
              <h2 class="section-title"><Icon name="book" size="1.1rem" /> 往期文章</h2>
              <a class="section-more" href="/archive/">全部归档 →</a>
            </div>
            <div class="post-list">
              {rest.map((p, i) => (
                <PostCard post={p} style={`animation-delay: ${Math.min(i, 8) * 0.06}s`} />
              ))}
            </div>
          </section>
        )}

        <!-- 标签 -->
        {tags.length > 0 && (
          <section class="block">
            <div class="card-base tag-card onload-animation">
              <h3 class="widget-title"><Icon name="tag" size="1.05rem" /> 标签</h3>
              <div class="tag-cloud">
                {tags.slice(0, 16).map((t, i) => (
                  <a class="cloud-tag" href={`/search/?q=${encodeURIComponent(t.tag)}`} style={`--i:${i}`}>
                    #{t.tag}<em>{t.count}</em>
                  </a>
                ))}
              </div>
            </div>
          </section>
        )}
      </main>

      <!-- 右侧栏 -->
      <aside class="ref-sidebar-right">
        <div class="card-base widget-card onload-animation" style="animation-delay: 0.1s">
          <h3 class="widget-title"><Icon name="search" size="1.05rem" /> 搜索</h3>
          <SearchWidget />
        </div>

        <div class="card-base widget-card onload-animation" style="animation-delay: 0.2s">
          <h3 class="widget-title"><Icon name="calendar" size="1.05rem" /> 日历</h3>
          <CalendarWidget />
        </div>

        <div class="card-base widget-card onload-animation" style="animation-delay: 0.3s">
          <h3 class="widget-title"><Icon name="clock" size="1.05rem" /> 节假日</h3>
          <HolidayWidget />
        </div>

        <div class="card-base widget-card onload-animation" style="animation-delay: 0.4s">
          <h3 class="widget-title"><Icon name="chart" size="1.05rem" /> 站点</h3>
          <SiteStats
            postsCount={posts.length}
            categoriesCount={categories.length}
            totalWords={totalWords}
          />
        </div>

        <HeatmapWidget />
      </aside>
    </div>
  </div>
</Base>

<style>
  /* 三栏布局 —— 严格按照参照站：280 / 1fr / 280，gap 16 */
  .ref-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.25rem;
  }

  @media (min-width: 768px) {
    .ref-layout { grid-template-columns: var(--sidebar-width) minmax(0, 1fr); }
    .ref-sidebar-right { display: none; }
  }

  @media (min-width: 1280px) {
    .ref-layout { grid-template-columns: var(--sidebar-width) minmax(0, 1fr) var(--sidebar-width); }
    .ref-sidebar-right { display: flex; }
  }

  .ref-sidebar-left, .ref-sidebar-right {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* 主内容分区间距 */
  .ref-main { display: flex; flex-direction: column; gap: 1.5rem; }
  .block { scroll-margin-top: 80px; }

  /* 资料卡 */
  .profile-card {
    text-align: center;
    padding: 1.5rem 1rem 1.1rem;
    position: relative;
    overflow: hidden;
  }
  /* 卡片顶部一条主色渐变装饰线 */
  .profile-card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: var(--gradient-primary);
  }

  .avatar-ring {
    width: 84px; height: 84px;
    margin: 0 auto 0.7rem;
    border-radius: 50%;
    padding: 3px;
    background: var(--gradient-primary);
    box-shadow: 0 6px 20px oklch(62% 0.14 250 / 0.35);
    transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .profile-card:hover .avatar-ring { transform: rotate(8deg) scale(1.05); }
  .profile-avatar {
    width: 100%; height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--surface);
    display: block;
  }

  .profile-name {
    font-size: 1.15rem;
    font-weight: 800;
    margin: 0 0 0.25rem;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .profile-bio {
    font-size: 0.78rem;
    color: var(--text-faint);
    margin: 0 0 0.9rem;
    display: inline-block;
    padding: 0.1rem 0.6rem;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border-light);
  }
  .profile-nav { display: flex; flex-direction: column; gap: 0.15rem; }
  .nav-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.6rem;
    border-radius: var(--radius-sm);
    color: var(--text-soft);
    font-size: 0.84rem;
    text-decoration: none !important;
    transition: all 0.18s ease;
    position: relative;
  }
  .nav-item :global(.icon) { opacity: 0.8; transition: transform 0.18s ease; }
  .nav-item:hover { background: var(--surface-2); color: var(--text); transform: translateX(3px); }
  .nav-item:hover :global(.icon) { transform: scale(1.12); }
  .nav-item.active {
    background: var(--primary-soft);
    color: var(--primary-strong);
    font-weight: 600;
  }
  [data-theme='dark'] .nav-item.active { color: var(--primary-light); }
  .nav-item.active :global(.icon) { opacity: 1; }

  /* widget 标题带图标 */
  :global(.widget-title) {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  :global(.widget-title .icon) { color: var(--primary); }

  /* 分区标题 */
  .section-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px dashed var(--border);
  }
  .section-title {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 1.25rem;
    font-weight: 800;
    margin: 0;
    position: relative;
    padding-left: 0.7rem;
  }
  .section-title::before {
    content: '';
    position: absolute;
    left: 0; top: 50%;
    transform: translateY(-50%);
    width: 4px; height: 1.15rem;
    border-radius: 3px;
    background: var(--gradient-primary);
  }
  .section-title :global(.icon) { color: var(--primary); }
  .post-count {
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border: 1px solid oklch(70% 0.14 250 / 0.25);
    padding: 0.12rem 0.6rem;
    border-radius: 999px;
    flex-shrink: 0;
  }
  [data-theme='dark'] .post-count { color: var(--primary-light); }
  .section-more {
    font-size: 0.76rem;
    font-weight: 600;
    color: var(--primary);
    text-decoration: none !important;
    flex-shrink: 0;
    transition: transform 0.18s ease;
  }
  .section-more:hover { transform: translateX(3px); }

  /* ===== 分类入口卡 ===== */
  .entry-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.6rem;
  }
  @media (min-width: 900px) {
    .entry-grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
  .entry-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.8rem 0.85rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    overflow: hidden;
    text-decoration: none !important;
    transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.25s ease, border-color 0.25s ease;
  }
  /* 悬停时从左侧铺一层主色渐变 */
  .entry-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--gradient-primary);
    opacity: 0;
    transition: opacity 0.28s ease;
  }
  .entry-card:hover::before { opacity: 0.08; }
  [data-theme='dark'] .entry-card:hover::before { opacity: 0.16; }
  .entry-card:hover {
    transform: translateY(-3px);
    border-color: oklch(70% 0.14 250 / 0.5);
    box-shadow: 0 2px 6px oklch(0% 0 0 / 0.05), 0 14px 30px oklch(62% 0.13 250 / 0.16);
  }
  [data-theme='dark'] .entry-card:hover { box-shadow: 0 2px 6px oklch(0% 0 0 / 0.3), 0 14px 30px oklch(0% 0 0 / 0.45); }

  .entry-icon {
    position: relative;
    flex-shrink: 0;
    width: 40px; height: 40px;
    border-radius: 12px;
    display: grid; place-items: center;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border: 1px solid oklch(70% 0.14 250 / 0.25);
    transition: transform 0.25s ease;
  }
  [data-theme='dark'] .entry-icon { color: var(--primary-light); }
  .entry-card:hover .entry-icon { transform: scale(1.08) rotate(-6deg); }

  .entry-body { position: relative; flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .entry-name {
    font-size: 0.92rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
  }
  .entry-desc {
    font-size: 0.68rem;
    color: var(--text-faint);
    line-height: 1.4;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .entry-count {
    position: relative;
    flex-shrink: 0;
    min-width: 1.6rem;
    text-align: center;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .entry-card:hover .entry-count { color: var(--primary); }

  /* ===== 头条大卡 ===== */
  .lead-card {
    display: block;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none !important;
    box-shadow: 0 1px 2px oklch(0% 0 0 / 0.04), 0 8px 24px oklch(0% 0 0 / 0.06);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease, border-color 0.3s ease;
  }
  [data-theme='dark'] .lead-card { box-shadow: 0 1px 2px oklch(0% 0 0 / 0.25), 0 8px 24px oklch(0% 0 0 / 0.35); }
  .lead-card:hover {
    transform: translateY(-5px);
    border-color: oklch(70% 0.14 250 / 0.55);
    box-shadow: 0 3px 8px oklch(0% 0 0 / 0.06), 0 22px 46px oklch(62% 0.13 250 / 0.2);
  }
  [data-theme='dark'] .lead-card:hover { box-shadow: 0 3px 8px oklch(0% 0 0 / 0.3), 0 22px 46px oklch(0% 0 0 / 0.5); }

  .lead-cover {
    position: relative;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    background: var(--surface-2);
  }
  .lead-cover img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1); }
  .lead-card:hover .lead-cover img { transform: scale(1.06); }
  .lead-cover-ph {
    position: relative;
    width: 100%; height: 100%;
    display: grid; place-items: center;
    overflow: hidden;
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .lead-card:hover .lead-cover-ph { transform: scale(1.06); }
  /* 占位封面：超大首字 + 半透明标题，像杂志封面而不是空白 */
  .lead-ph-char {
    font-size: clamp(4rem, 12vw, 7rem);
    font-weight: 800;
    color: oklch(100% 0 0 / 0.9);
    text-shadow: 0 6px 30px oklch(0% 0 0 / 0.3);
    line-height: 1;
  }
  .lead-ph-title {
    position: absolute;
    left: 1.2rem; right: 1.2rem; bottom: 0.9rem;
    font-size: clamp(0.95rem, 2vw, 1.3rem);
    font-weight: 700;
    color: oklch(100% 0 0 / 0.82);
    text-shadow: 0 2px 14px oklch(0% 0 0 / 0.4);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    text-align: center;
  }

  .lead-flag {
    position: absolute;
    top: 0.75rem; left: 0.75rem;
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    padding: 0.2rem 0.6rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-on-primary);
    background: var(--gradient-primary);
    box-shadow: 0 3px 12px oklch(0% 0 0 / 0.28);
  }
  /* 封面扫光 */
  .lead-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 38%, oklch(100% 0 0 / 0.24) 50%, transparent 62%);
    transform: translateX(-120%);
    transition: transform 0.8s ease;
    pointer-events: none;
  }
  .lead-card:hover .lead-shine { transform: translateX(120%); }

  .lead-body { padding: 1rem 1.15rem 1.1rem; display: flex; flex-direction: column; gap: 0.4rem; }
  .lead-meta { display: flex; align-items: center; gap: 0.6rem; flex-wrap: wrap; }
  .lead-cat {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    padding: 0.14rem 0.55rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border: 1px solid oklch(70% 0.14 250 / 0.28);
  }
  [data-theme='dark'] .lead-cat { color: var(--primary-light); }
  .lead-time {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    font-size: 0.72rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .lead-time :global(.icon) { opacity: 0.6; }

  .lead-title {
    margin: 0;
    font-size: clamp(1.15rem, 2.4vw, 1.5rem);
    font-weight: 800;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--text);
    transition: color 0.2s ease;
  }
  .lead-card:hover .lead-title { color: var(--primary) !important; }

  .lead-desc {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.88rem;
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .lead-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    margin-top: 0.15rem;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--primary);
    transition: gap 0.22s ease;
  }
  .lead-card:hover .lead-cta { gap: 0.45rem; }

  /* ===== 标签云 ===== */
  .tag-card { padding: 1rem; }
  .tag-cloud { display: flex; flex-wrap: wrap; gap: 0.35rem; }
  .cloud-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.24rem 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface-2);
    color: var(--text-soft);
    font-size: 0.74rem;
    font-weight: 600;
    text-decoration: none !important;
    transition: all 0.18s ease;
  }
  .cloud-tag em {
    font-style: normal;
    font-size: 0.64rem;
    font-weight: 700;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--surface);
    color: var(--text-faint);
  }
  .cloud-tag:hover {
    color: var(--text-on-primary);
    background: var(--gradient-primary);
    border-color: transparent;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px oklch(62% 0.14 250 / 0.28);
  }
  .cloud-tag:hover em { background: oklch(100% 0 0 / 0.22); color: inherit; }

  .post-list { display: flex; flex-direction: column; gap: 0.75rem; }

  @media (max-width: 767px) {
    .ref-sidebar-left, .ref-sidebar-right { flex-direction: row; flex-wrap: wrap; }
    .ref-sidebar-left > *, .ref-sidebar-right > * { flex: 1; min-width: 200px; }
    .lead-cover { aspect-ratio: 16 / 9; }
    .entry-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .entry-desc { display: none; }
  }
</style>
