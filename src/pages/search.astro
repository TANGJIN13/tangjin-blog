---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SidebarLeft from '../components/SidebarLeft.astro';
import SidebarRight from '../components/SidebarRight.astro';
import { getCollection } from 'astro:content';
import { categories } from '../data/categories';
import { downloads } from '../lib/downloads';

const posts = await getCollection('posts');
const postData = posts
  .map((p) => ({
    id: p.id,
    title: p.data.title,
    description: p.data.description || '',
    tags: p.data.tags || [],
    published: p.data.published,
    category: p.data.category || '',
  }))
  .sort((a, b) => b.published.valueOf() - a.published.valueOf());

// 资源库里的文件/工具也进搜索：按名称、描述、文件名、标签匹配
const resourceData = downloads.map((f) => ({
  id: f.file,
  title: f.name,
  description: f.desc,
  tags: f.tags,
  file: f.file,
  base: f.base,
  ext: f.ext,
  icon: f.icon,
  size: f.size,
  version: f.version,
  date: f.date,
  external: f.external,
}));

const catOf = (slug) => categories.find((c) => c.slug === slug);
const catCounts = categories.map((c) => ({
  ...c,
  count: postData.filter((p) => p.category === c.slug).length,
}));

const RESOURCE_CAT = 'resource';
const totalCount = postData.length + resourceData.length;
---

<Base title="搜索">
  <div class="page-shell">
    <SidebarLeft />
    <article class="post-main">
      <!-- 轻量头部：不再有大块蓝色 banner -->
      <header class="sp-hero">
        <span class="sp-hero-icon">
          <Icon name="search" size="1.5rem" />
        </span>
        <div>
          <h1 class="sp-title">搜索</h1>
          <p class="sp-sub">搜文章标题 / 描述 / 标签，也能搜到资源库里的文件与工具</p>
        </div>
        <span class="sp-total">{totalCount} 条</span>
      </header>

      <!-- 搜索栏（吸顶） -->
      <div class="sp-bar">
        <span class="sp-bar-icon"><Icon name="search" size="1.05rem" /></span>
        <input
          type="text"
          id="search-input"
          class="sp-input"
          placeholder="输入关键词…（按 / 快速聚焦）"
          autocomplete="off"
        />
        <button type="button" class="sp-clear" id="search-clear" title="清空" aria-label="清空">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20zm5 13.6L15.6 17 12 13.4 8.4 17 7 15.6 10.6 12 7 8.4 8.4 7 12 10.6 15.6 7 17 8.4 13.4 12z" />
          </svg>
        </button>
        <span class="sp-count" id="search-count">{totalCount} 条</span>
      </div>

      <!-- 分类筛选（最后一个「资源库」筛的是 downloads.json 里登记的文件） -->
      <div class="sp-chips" id="sp-chips">
        <button type="button" class="sp-chip active" data-cat="">
          <Icon name="archive" size="0.85rem" />全部
          <em>{totalCount}</em>
        </button>
        {catCounts.map((c) => (
          <button type="button" class="sp-chip" data-cat={c.slug}>
            <Icon name={c.icon || 'folder'} size="0.85rem" />{c.name}
            <em>{c.count}</em>
          </button>
        ))}
        <button type="button" class="sp-chip" data-cat={RESOURCE_CAT}>
          <Icon name="folder" size="0.85rem" />资源库
          <em>{resourceData.length}</em>
        </button>
      </div>

      <!-- 结果 -->
      <div class="sp-results" id="search-results">
        {postData.map((p, i) => {
          const cat = catOf(p.category);
          return (
            <a
              class="sp-item onload-animation"
              href={`/posts/${p.id}/`}
              style={`animation-delay: ${Math.min(i, 10) * 0.035}s`}
              data-category={p.category}
              data-search={`${p.title} ${p.description} ${p.tags.join(' ')} ${cat ? cat.name : ''}`}
            >
              <div class="sp-item-top">
                {cat && (
                  <span class="sp-cat">
                    <Icon name={cat.icon || 'folder'} size="0.78rem" />{cat.name}
                  </span>
                )}
                <time class="sp-date">{p.published.toISOString().slice(0, 10)}</time>
              </div>
              <h3 class="sp-item-title" data-text={p.title}>{p.title}</h3>
              <p class="sp-item-desc" data-text={p.description}>{p.description}</p>
              {p.tags.length > 0 && (
                <div class="sp-tags">{p.tags.slice(0, 4).map((t) => <span class="sp-tag">#{t}</span>)}</div>
              )}
            </a>
          );
        })}

        {/* 资源库：public/files/ 下上传的文件与工具也能被搜到，点一下直接下载 */}
        {resourceData.map((f, i) => (
          <a
            class="sp-item sp-item-file onload-animation"
            href={f.file}
            download={f.external ? undefined : f.base}
            target={f.external ? '_blank' : undefined}
            rel={f.external ? 'noopener noreferrer' : undefined}
            style={`animation-delay: ${Math.min(i, 10) * 0.035}s`}
            data-category={RESOURCE_CAT}
            data-search={`${f.title} ${f.description} ${f.base} ${f.tags.join(' ')} 资源库 下载 ${f.ext}`}
          >
            <div class="sp-item-top">
              <span class="sp-cat sp-cat-file">
                <Icon name="folder" size="0.78rem" />资源库
              </span>
              <span class="sp-file-badge">
                <Icon name={f.icon} size="0.78rem" />{f.ext.toUpperCase()}
              </span>
              {f.date && <time class="sp-date">{f.date}</time>}
            </div>
            <h3 class="sp-item-title" data-text={f.title}>{f.title}</h3>
            {f.description && <p class="sp-item-desc" data-text={f.description}>{f.description}</p>}
            <div class="sp-tags sp-tags-file">
              {f.version && <span class="sp-tag ver">{f.version}</span>}
              {f.tags.map((t) => <span class="sp-tag">#{t}</span>)}
              <span class="sp-file-name">{f.base}</span>
              <span class="sp-tag dl">
                <Icon name={f.external ? 'external' : 'download'} size="0.72rem" />
                {f.external ? '外部链接' : '点击下载'}
                {f.size && ` · ${f.size}`}
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="sp-empty" id="sp-empty">
        <Icon name="search" size="2rem" />
        <p>没有匹配的结果</p>
        <span>换个关键词，或点上面的分类 / 资源库筛选看看</span>
      </div>
    </article>
    <SidebarRight />
  </div>
</Base>

<script>
  const input = document.getElementById('search-input');
  const clearBtn = document.getElementById('search-clear');
  const count = document.getElementById('search-count');
  const chips = document.getElementById('sp-chips');
  const empty = document.getElementById('sp-empty');
  const items = [...document.querySelectorAll('.sp-item')];

  let activeCat = '';

  // 关键词高亮（纯 DOM 操作，不拼 HTML，避免注入）
  function highlight(el, q) {
    const text = el.dataset.text || '';
    el.textContent = '';
    if (!q) { el.textContent = text; return; }
    const lower = text.toLowerCase();
    let from = 0, idx;
    while ((idx = lower.indexOf(q, from)) !== -1) {
      if (idx > from) el.appendChild(document.createTextNode(text.slice(from, idx)));
      const mark = document.createElement('mark');
      mark.textContent = text.slice(idx, idx + q.length);
      el.appendChild(mark);
      from = idx + q.length;
      if (q.length === 0) break;
    }
    if (from < text.length) el.appendChild(document.createTextNode(text.slice(from)));
  }

  function apply() {
    const q = (input.value || '').toLowerCase().trim();
    let visible = 0;
    items.forEach((el) => {
      const inCat = !activeCat || el.dataset.category === activeCat;
      const text = (el.dataset.search || '').toLowerCase();
      const match = inCat && (!q || text.includes(q));
      el.style.display = match ? '' : 'none';
      if (match) visible++;
      highlight(el.querySelector('.sp-item-title'), q);
      highlight(el.querySelector('.sp-item-desc'), q);
    });
    count.textContent = q || activeCat ? `${visible} 条匹配` : `${items.length} 条`;
    clearBtn.classList.toggle('show', !!q);
    empty.classList.toggle('show', visible === 0);
  }

  input.addEventListener('input', apply);
  clearBtn.addEventListener('click', () => { input.value = ''; apply(); input.focus(); });

  chips.addEventListener('click', (e) => {
    const chip = e.target.closest('.sp-chip');
    if (!chip) return;
    chips.querySelectorAll('.sp-chip').forEach((c) => c.classList.toggle('active', c === chip));
    activeCat = chip.dataset.cat || '';
    apply();
  });

  // 快捷键：/ 聚焦，Esc 清空
  document.addEventListener('keydown', (e) => {
    const tag = (e.target.tagName || '').toLowerCase();
    const typing = tag === 'input' || tag === 'textarea';
    if (e.key === '/' && !typing) { e.preventDefault(); input.focus(); }
    if (e.key === 'Escape' && document.activeElement === input) {
      input.value = ''; apply(); input.blur();
    }
  });

  // 支持带条件直接进入：/search/?q=关键词 或 ?cat=分类slug
  // （首页标签、文章页标签都靠这个跳过来）
  const params = new URLSearchParams(location.search);
  const q0 = params.get('q') || '';
  const cat0 = params.get('cat') || '';
  if (q0) input.value = q0;
  if (cat0) {
    const chip = chips.querySelector('.sp-chip[data-cat="' + cat0 + '"]');
    if (chip) {
      chips.querySelectorAll('.sp-chip').forEach((c) => c.classList.toggle('active', c === chip));
      activeCat = cat0;
    }
  }

  apply();
</script>

<style>
  .post-main { min-width: 0; }

  /* ===== 头部（轻量，去掉大蓝块） ===== */
  .sp-hero {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-bottom: 1.25rem;
  }
  .sp-hero-icon {
    width: 46px; height: 46px;
    border-radius: 14px;
    display: grid; place-items: center;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border: 1px solid oklch(70% 0.14 250 / 0.25);
    box-shadow: 0 4px 14px oklch(62% 0.14 250 / 0.18);
    flex-shrink: 0;
  }
  [data-theme='dark'] .sp-hero-icon { color: var(--primary-light); }
  .sp-title {
    margin: 0;
    font-size: clamp(1.5rem, 3.4vw, 1.9rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    line-height: 1.2;
  }
  .sp-sub { margin: 0.1rem 0 0; font-size: 0.85rem; color: var(--text-faint); }
  .sp-total {
    margin-left: auto;
    flex-shrink: 0;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border: 1px solid oklch(70% 0.14 250 / 0.25);
    padding: 0.14rem 0.6rem;
    border-radius: 999px;
  }
  [data-theme='dark'] .sp-total { color: var(--primary-light); }

  /* ===== 搜索栏 ===== */
  .sp-bar {
    position: sticky;
    top: 64px;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.6rem 0.85rem;
    border-radius: 999px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 2px 6px oklch(0% 0 0 / 0.05), 0 10px 26px oklch(0% 0 0 / 0.06);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  [data-theme='dark'] .sp-bar { box-shadow: 0 2px 6px oklch(0% 0 0 / 0.3), 0 10px 26px oklch(0% 0 0 / 0.35); }
  .sp-bar:focus-within {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px var(--primary-soft), 0 10px 26px oklch(62% 0.14 250 / 0.16);
  }
  .sp-bar-icon { color: var(--text-faint); display: grid; place-items: center; flex-shrink: 0; }
  .sp-bar:focus-within .sp-bar-icon { color: var(--primary); }
  .sp-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: var(--text);
    font-size: 0.95rem;
    outline: none;
  }
  .sp-input::placeholder { color: var(--text-faint); }
  .sp-clear {
    display: none;
    border: none; background: transparent; cursor: pointer;
    color: var(--text-faint); padding: 0; line-height: 0;
    transition: color 0.15s ease;
  }
  .sp-clear.show { display: grid; place-items: center; }
  .sp-clear:hover { color: var(--primary); }
  .sp-count {
    font-size: 0.75rem;
    color: var(--text-faint);
    white-space: nowrap;
    padding-left: 0.4rem;
    border-left: 1px solid var(--border);
  }

  /* ===== 分类筛选胶囊 ===== */
  .sp-chips { display: flex; flex-wrap: wrap; gap: 0.4rem; margin: 0.9rem 0 1rem; }
  .sp-chip {
    display: inline-flex; align-items: center; gap: 0.3rem;
    padding: 0.3rem 0.75rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text-soft);
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.18s ease;
  }
  .sp-chip :global(.icon) { opacity: 0.8; }
  .sp-chip em {
    font-style: normal;
    font-size: 0.68rem;
    padding: 0 0.32rem;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text-faint);
  }
  .sp-chip:hover { border-color: oklch(70% 0.14 250 / 0.45); color: var(--primary-strong); transform: translateY(-1px); }
  [data-theme='dark'] .sp-chip:hover { color: var(--primary-light); }
  .sp-chip.active {
    background: var(--gradient-primary);
    border-color: transparent;
    color: var(--text-on-primary);
    box-shadow: 0 3px 12px oklch(62% 0.14 250 / 0.3);
  }
  .sp-chip.active em { background: oklch(100% 0 0 / 0.22); color: inherit; }

  /* ===== 结果列表 ===== */
  .sp-results { display: flex; flex-direction: column; gap: 0.6rem; }
  .sp-item {
    display: block;
    padding: 0.85rem 1.1rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    text-decoration: none !important;
    transition: transform 0.22s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.22s ease, border-color 0.22s ease;
  }
  .sp-item:hover {
    transform: translateY(-3px);
    border-color: oklch(70% 0.14 250 / 0.45);
    box-shadow: 0 2px 6px oklch(0% 0 0 / 0.05), 0 14px 32px oklch(60% 0.13 250 / 0.15);
  }
  [data-theme='dark'] .sp-item:hover { box-shadow: 0 2px 6px oklch(0% 0 0 / 0.3), 0 14px 32px oklch(0% 0 0 / 0.45); }

  .sp-item-top { display: flex; align-items: center; gap: 0.45rem; margin-bottom: 0.25rem; }
  .sp-cat {
    display: inline-flex; align-items: center; gap: 0.22rem;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border: 1px solid oklch(70% 0.14 250 / 0.25);
  }
  [data-theme='dark'] .sp-cat { color: var(--primary-light); }
  .sp-date { font-size: 0.72rem; color: var(--text-faint); font-variant-numeric: tabular-nums; }

  .sp-item-title {
    margin: 0 0 0.25rem;
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.4;
  }
  .sp-item:hover .sp-item-title { color: var(--primary) !important; }
  .sp-item-title mark, .sp-item-desc mark {
    background: oklch(80% 0.16 85 / 0.55);
    color: inherit;
    border-radius: 3px;
    padding: 0 1px;
  }
  [data-theme='dark'] .sp-item-title mark, [data-theme='dark'] .sp-item-desc mark {
    background: oklch(70% 0.18 85 / 0.35);
    color: oklch(98% 0.02 85);
  }

  .sp-item-desc {
    margin: 0 0 0.4rem;
    font-size: 0.86rem;
    color: var(--text-soft);
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .sp-tags { display: flex; flex-wrap: wrap; gap: 0.25rem; }
  .sp-tag {
    font-size: 0.68rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border-light);
    color: var(--text-faint);
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
  }

  /* ===== 资源库条目 ===== */
  .sp-cat-file {
    color: oklch(52% 0.15 150);
    background: oklch(96% 0.05 150);
    border-color: oklch(80% 0.1 150 / 0.5);
  }
  [data-theme='dark'] .sp-cat-file {
    color: oklch(80% 0.13 150);
    background: oklch(30% 0.06 150);
  }
  .sp-file-badge {
    display: inline-flex; align-items: center; gap: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.1rem 0.45rem;
    border-radius: 0.3rem;
    background: var(--surface-2);
    color: var(--text-faint);
  }
  .sp-tags-file { align-items: center; gap: 0.3rem; margin-top: 0.45rem; }
  .sp-tags-file .sp-tag.ver { color: var(--primary-strong); background: var(--primary-soft); border-color: transparent; }
  .sp-file-name {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--text-faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    max-width: 100%;
  }
  .sp-tags-file .sp-tag.dl {
    margin-left: auto;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border-color: transparent;
    font-weight: 600;
  }
  [data-theme='dark'] .sp-tags-file .sp-tag.dl { color: var(--primary-light); }

  /* ===== 空状态 ===== */
  .sp-empty,
  .sp-empty[hidden] { display: none; }
  .sp-empty.show { display: grid; }
  .sp-empty :global(.icon) { opacity: 0.35; }
  .sp-empty p { margin: 0; font-size: 0.95rem; font-weight: 600; color: var(--text-soft); }
  .sp-empty span { font-size: 0.78rem; }

  @media (max-width: 860px) {
    .sp-bar { top: 56px; }
    .sp-total { display: none; }
  }
</style>
