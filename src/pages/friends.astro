---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SidebarLeft from '../components/SidebarLeft.astro';
import SidebarRight from '../components/SidebarRight.astro';

interface Friend {
  name: string;
  url: string;
  avatar: string;
  description: string;
}

const friends: Friend[] = [
  { name: 'today', url: 'https://todaymvp.github.io/', avatar: 'https://avatars.githubusercontent.com/u/228346422?v=4', description: 'pwn手' },
];

const applyEmail = '2020556277@qq.com';
---

<Base
  title="友链"
  pageBanner
  bannerIcon="link"
  bannerTitle="友链"
  bannerDesc="好的友链，是彼此成长的见证"
>
  <div class="page-shell">
    <SidebarLeft />
    <article class="post-main">
      <!-- 引言卡：柔和插画底 + 标题 + 副文字 + 申请友链按钮 -->
      <section class="fr-hero onload-animation">
        <img class="fr-hero-bg" src="/images/wallpapers/wallpaper-03.svg" alt="" aria-hidden="true" />
        <div class="fr-hero-veil" aria-hidden="true"></div>
        <div class="fr-hero-inner">
          <div class="fr-hero-copy">
            <h1 class="fr-hero-title">好的友链，是彼此成长的见证</h1>
            <p class="fr-hero-sub">
              如果你也在认真记录、乐于分享，欢迎把链接留在这里——<br />
              让我们在各自的角落里，偶尔互相照亮。
            </p>
          </div>
          <a class="fr-apply-btn" href={`mailto:${applyEmail}?subject=${encodeURIComponent('申请友链')}`}>
            <Icon name="send" size="0.95rem" /> 申请友链
          </a>
        </div>
      </section>

      <!-- 我的友链 -->
      <section class="fr-section">
        <div class="section-head">
          <h2 class="section-title"><span class="section-index">01 /</span> 我的友链</h2>
          <span class="section-edition">{friends.length} 位朋友</span>
        </div>

        {friends.length > 0 ? (
          <div class="fr-grid">
            {friends.map((f, i) => (
              <a
                class="fr-card onload-animation"
                href={f.url}
                target="_blank"
                rel="noopener"
                style={`animation-delay: ${i * 0.07}s`}
              >
                <img class="fr-avatar" src={f.avatar} alt={f.name} width="46" height="46" loading="lazy" />
                <div class="fr-card-info">
                  <h3 class="fr-card-name">{f.name}</h3>
                  <p class="fr-card-desc">{f.description}</p>
                </div>
                <span class="fr-card-arrow"><Icon name="arrow_right" size="1rem" /></span>
              </a>
            ))}
          </div>
        ) : (
          <div class="fr-empty">
            <Icon name="link" size="1.6rem" />
            <p>还没有友链，来成为第一个吧</p>
          </div>
        )}
      </section>

      <!-- 申请说明 -->
      <section class="fr-section">
        <div class="card-base fr-apply onload-animation" style="animation-delay: 0.16s">
          <h3 class="widget-title"><Icon name="send" size="1.05rem" /> 申请友链</h3>
          <p>交换之前，想先确认这几件事：</p>
          <ul>
            <li>网站可以正常访问，内容稳定更新</li>
            <li>内容原创或有自己的思考，非采集站</li>
            <li>已经把我的站点加进了你的友链</li>
          </ul>
          <p class="fr-apply-mail">
            把站点名称、链接、头像与一句简介发到
            <a href={`mailto:${applyEmail}`}>{applyEmail}</a>
          </p>
        </div>
      </section>
    </article>
    <SidebarRight />
  </div>
</Base>

<style>
  .post-main { min-width: 0; }

  /* ===== 引言卡 ===== */
  .fr-hero {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-xl);
    border: 1px solid var(--border);
    box-shadow: var(--shadow);
    min-height: 190px;
    display: flex;
    align-items: center;
  }
  .fr-hero-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 10s ease;
  }
  .fr-hero:hover .fr-hero-bg { transform: scale(1.06); }
  /* 亮色页面里用一层浅色纱把插画压淡，保证深色文字可读；
     暗色主题叠深色纱，文字翻成浅色。 */
  .fr-hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--surface) 88%, transparent) 0%,
      color-mix(in srgb, var(--surface) 62%, transparent) 52%,
      color-mix(in srgb, var(--surface) 34%, transparent) 100%
    );
  }
  :global([data-theme='dark'] .fr-hero-veil) {
    background: linear-gradient(
      100deg,
      color-mix(in srgb, var(--surface) 92%, transparent) 0%,
      color-mix(in srgb, var(--surface) 72%, transparent) 54%,
      color-mix(in srgb, var(--surface) 46%, transparent) 100%
    );
  }
  .fr-hero-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    display: flex;
    align-items: center;
    gap: 1.2rem;
    padding: 1.7rem 1.6rem;
  }
  .fr-hero-copy { flex: 1; min-width: 0; }
  .fr-hero-title {
    margin: 0;
    font-size: clamp(1.3rem, 3.4vw, 1.85rem);
    font-weight: 800;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--text);
  }
  .fr-hero-sub {
    margin: 0.7rem 0 0;
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--text-soft);
  }
  .fr-apply-btn {
    flex-shrink: 0;
    align-self: flex-end;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.5rem 1.05rem;
    border-radius: 999px;
    font-size: 0.84rem;
    font-weight: 700;
    text-decoration: none !important;
    color: var(--text-on-primary);
    background: var(--gradient-primary);
    border: 1px solid transparent;
    box-shadow: 0 6px 18px oklch(62% 0.14 282 / 0.3);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .fr-apply-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 9px 24px oklch(62% 0.14 282 / 0.38);
  }

  /* ===== 分区标题 ===== */
  .fr-section { margin-top: 1.8rem; }
  .fr-section .section-head { margin-bottom: 0.9rem; }

  /* ===== 友链网格：响应式（宽屏 2 列 / 窄屏 1 列） ===== */
  .fr-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.85rem;
  }
  .fr-card {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 0.95rem 1.05rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: var(--shadow-sm, 0 1px 2px oklch(0% 0 0 / 0.04));
    text-decoration: none !important;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
  }
  .fr-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow);
    border-color: color-mix(in srgb, var(--primary) 34%, var(--border));
  }
  .fr-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border);
    flex-shrink: 0;
    background: var(--surface-2);
  }
  .fr-card-info { flex: 1; min-width: 0; }
  .fr-card-name {
    margin: 0;
    font-size: 0.98rem;
    font-weight: 700;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fr-card-desc {
    margin: 0.22rem 0 0;
    font-size: 0.8rem;
    color: var(--text-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .fr-card-arrow {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    color: var(--text-faint);
    background: var(--surface-2);
    flex-shrink: 0;
    transition: transform 0.22s ease, color 0.22s ease, background 0.22s ease;
  }
  .fr-card:hover .fr-card-arrow {
    transform: translateX(3px);
    color: var(--text-on-primary);
    background: var(--gradient-primary);
  }

  .fr-empty {
    display: grid;
    place-items: center;
    gap: 0.5rem;
    padding: 2.4rem 1rem;
    border-radius: var(--radius-lg);
    border: 1px dashed var(--border);
    color: var(--text-faint);
    font-size: 0.86rem;
  }

  /* ===== 申请说明卡 ===== */
  .fr-apply { padding: 1.2rem 1.25rem; }
  .fr-apply > p { margin: 0.2rem 0 0.6rem; font-size: 0.9rem; color: var(--text-soft); }
  .fr-apply ul { margin: 0; padding-left: 1.15rem; }
  .fr-apply li { margin-bottom: 0.32rem; font-size: 0.89rem; color: var(--text-soft); }
  .fr-apply-mail { margin-top: 0.8rem !important; }
  .fr-apply-mail a { font-weight: 700; color: var(--primary-strong); }
  :global([data-theme='dark'] .fr-apply-mail a) { color: var(--primary-light); }

  /* ===== 响应式 ===== */
  @media (max-width: 900px) {
    .fr-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .fr-hero-inner { flex-direction: column; align-items: flex-start; padding: 1.35rem 1.15rem; }
    .fr-apply-btn { align-self: flex-start; }
    .fr-hero-sub br { display: none; }
  }
</style>
