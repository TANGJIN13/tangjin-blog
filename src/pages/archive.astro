  .rl {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* 三层叠出「水」的厚度：最外是雾，中间是河身，最里是亮芯。
     宽度都用 non-scaling-stroke，因此在宽/窄屏上观感一致。 */
  .rl-haze {
    stroke-width: 52;
    opacity: 0.62;
    filter: blur(15px);
  }
  .rl-skin {
    stroke-width: 24;
    opacity: 0.55;
    filter: blur(5px);
  }
  .rl-core {
    stroke-width: 3.6;
    opacity: 0.95;
  }
  .rl-trib {
    stroke: color-mix(in srgb, var(--primary) 50%, transparent);
    stroke-width: 1.4;
    stroke-dasharray: 2 7;
    opacity: 0.62;
  }
  /* 年份处的「水面透镜」：河道在里程碑附近加宽成一片横向的浅水，
     年份因此坐在水上，成为河道上的阶段标记。非常淡，只是水的厚度变化。 */
  .rl-lenses path {
    fill: color-mix(in srgb, var(--primary) 26%, transparent);
    filter: blur(7px);
    opacity: 0.6;
  }
  /* 流光：几条短高光段沿河道缓缓推进，是"水在流"的主要线索。
     非常克制 —— 只有 0.5 的不透明度、14s 走完一轮，远看只是水面上的一点游光。 */
  .rl-flow {
    stroke: color-mix(in srgb, var(--primary-light) 88%, white);
    stroke-width: 2.2;
    opacity: 0.5;
    filter: blur(1.4px);
    animation: rl-flow-drift 14s linear infinite;
  }
  @keyframes rl-flow-drift {
    from {
      stroke-dashoffset: 0;
    }
    to {
