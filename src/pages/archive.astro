---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SidebarLeft from '../components/SidebarLeft.astro';
import SidebarRight from '../components/SidebarRight.astro';
import Paginate from '../components/Paginate.astro';
import { getPublishedPosts, formatDate, readingTime } from '../lib/posts';

const posts = await getPublishedPosts();

// 按年份分组
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.published.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const totalWords = posts.reduce((n, p) => n + p.body.replace(/\s/g, '').length, 0);

// 首屏先输出完整河道；分页后由客户端按当前可见条目重新校准曲线。
// 河道是一条平缓蜿蜒的正弦曲线，节点（圆点）落在河上，卡片分列两岸、用虚线支流相连。
const RIVER_W = 1000;
const RIVER_STEP = 158;
const riverNode = (count: number) => {
  // 条目少时用更短的周期，才摆得出 S 形；多了就放缓，避免锯齿感
  const period = count <= 3 ? 2 : Math.max(3, Math.min(6, count));
  const amp = count <= 3 ? 78 : 62;
  return Array.from({ length: count }, (_, i) => ({
    x: RIVER_W / 2 + amp * Math.sin((i / period) * Math.PI * 2),
    y: i * RIVER_STEP + RIVER_STEP / 2,
  }));
};
const riverPathFor = (count: number) => {
  const pts = riverNode(count);
  if (!pts.length) return '';
  const all = [{ x: pts[0].x, y: pts[0].y - 56 }, ...pts, { x: pts[pts.length - 1].x, y: pts[pts.length - 1].y + 56 }];
  let d = `M ${all[0].x.toFixed(1)} ${all[0].y.toFixed(1)}`;
  for (let i = 0; i < all.length - 1; i++) {
    const p0 = all[i - 1] ?? all[i];
    const p1 = all[i];
    const p2 = all[i + 1];
    const p3 = all[i + 2] ?? p2;
    d += ` C ${(p1.x + (p2.x - p0.x) / 6).toFixed(1)} ${(p1.y + (p2.y - p0.y) / 6).toFixed(1)}, ${(p2.x - (p3.x - p1.x) / 6).toFixed(1)} ${(p2.y - (p3.y - p1.y) / 6).toFixed(1)}, ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
  }
  return d;
};
---

<Base
  title="归档"
  pageBanner
  bannerIcon="archive"
  bannerTitle="归档"
  bannerDesc={`共 ${posts.length} 篇文章 · 约 ${(totalWords / 10000).toFixed(1)} 万字`}
>
  <div class="page-shell">
    <SidebarLeft />
    <div class="page-main">
    <header class="page-head onload-animation hide-with-banner">
      <h1><Icon name="archive" size="1.6rem" /> 归档</h1>
      <p>
        共 <strong>{posts.length}</strong> 篇文章 · 约 <strong>{(totalWords / 10000).toFixed(1)}</strong> 万字，按时间倒序
      </p>
    </header>

    <div class="timeline">
      {
        years.map((y) => (
          <section class="year" data-paginate-group>
            <div class="year-node">
              <span class="year-num">{y}</span>
              <span class="year-count">{byYear.get(y)!.length} 篇记忆</span>
              <span class="year-caption">这一年的文字，沿河而来</span>
            </div>
            <ul class="year-list">
              <svg
                class="river-canvas"
                aria-hidden="true"
                preserveAspectRatio="none"
                viewBox={`0 0 ${RIVER_W} ${Math.max(1, byYear.get(y)!.length * RIVER_STEP)}`}
              >
                <defs>
                  <linearGradient id={`river-gradient-${y}`} x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--primary)" stop-opacity=".1" />
                    <stop offset="14%" stop-color="var(--primary)" stop-opacity=".78" />
                    <stop offset="86%" stop-color="var(--primary)" stop-opacity=".7" />
                    <stop offset="100%" stop-color="var(--primary)" stop-opacity=".1" />
                  </linearGradient>
                </defs>
                <path class="river-glow" stroke={`url(#river-gradient-${y})`} />
                <path class="river-body" stroke={`url(#river-gradient-${y})`} />
                <path class="river-line" stroke={`url(#river-gradient-${y})`} d={riverPathFor(byYear.get(y)!.length)} />
                <path
                  class="river-trib"
                  d={riverNode(byYear.get(y)!.length)
                    .map((p, i) => `M ${p.x.toFixed(1)} ${p.y.toFixed(1)} L ${(i % 2 === 0 ? 420 : 580).toFixed(1)} ${p.y.toFixed(1)}`)
                    .join(' ')}
                />
              </svg>
              {byYear.get(y)!.map((p, i) => (
                <li class="tl-item onload-animation paginate-item" style={`animation-delay: ${Math.min(i, 10) * 0.05}s`}>
                  <span class="tl-dot" aria-hidden="true"></span>
                  <a class="tl-card" href={`/posts/${p.id}/`}>
                    <span class="tl-meta">
                      <time class="tl-date" datetime={p.data.published.toISOString()}>
                        {formatDate(p.data.published)}
                      </time>
                      <span class="tl-index">{String(i + 1).padStart(2, '0')}</span>
                    </span>
                    <span class="tl-title">{p.data.title}</span>
                    {p.data.tags.length > 0 && (
                      <span class="tl-tags">{p.data.tags.slice(0, 3).map((t) => `#${t}`).join('　')}</span>
                    )}
                    <span class="tl-arrow" aria-hidden="true">
                      <Icon name="next" size="0.9rem" />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <Paginate pageSize={15} />

    {
      posts.length === 0 && (
        <div class="empty">
          <p>还没有文章。</p>
        </div>
      )
    }
    </div>
    <SidebarRight />
  </div>
</Base>

<script>
  // 时光河流：把每个条目的圆点摆在一条平缓蜿蜒的河道上，
  // 河道用 Catmull-Rom 转三次贝塞尔连成柔弯，再画虚线支流接到两岸的卡片。
  function initRiverArchive() {
    document.querySelectorAll<HTMLElement>('.year-list').forEach((list) => {
      if (list.dataset.riverBound === 'true') return;
      list.dataset.riverBound = 'true';
      const svg = list.querySelector<SVGSVGElement>('.river-canvas');
      const line = list.querySelector<SVGPathElement>('.river-line');
      const glow = list.querySelector<SVGPathElement>('.river-glow');
      const body = list.querySelector<SVGPathElement>('.river-body');
      const trib = list.querySelector<SVGPathElement>('.river-trib');
      if (!svg || !line || !glow) return;

      const smooth = (pts: { x: number; y: number }[]) => {
        if (!pts.length) return '';
        if (pts.length === 1) return `M ${pts[0].x} ${pts[0].y}`;
        let d = `M ${pts[0].x} ${pts[0].y}`;
        for (let i = 0; i < pts.length - 1; i++) {
          const p0 = pts[i - 1] ?? pts[i];
          const p1 = pts[i];
          const p2 = pts[i + 1];
          const p3 = pts[i + 2] ?? p2;
          d += ` C ${p1.x + (p2.x - p0.x) / 6} ${p1.y + (p2.y - p0.y) / 6}, ${p2.x - (p3.x - p1.x) / 6} ${p2.y - (p3.y - p1.y) / 6}, ${p2.x} ${p2.y}`;
        }
        return d;
      };

      let frame = 0;
      const draw = () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const box = list.getBoundingClientRect();
          if (!box.width || !box.height) return;
          svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);

          const compact = box.width < 641;
          const items = Array.from(list.querySelectorAll<HTMLElement>('.tl-item:not(.is-hidden)'));
          const cx = box.width / 2;
          // 条目少时也要看得出「蜿蜒」：振幅按条目数放大，2 条也能摆出去
          const amp = Math.min(compact ? 0 : 78, box.width * (items.length <= 3 ? 0.1 : 0.07));
          const period = items.length <= 3 ? 2 : Math.max(3, Math.min(6, items.length));

          const pts = items.map((item, i) => {
            const r = item.getBoundingClientRect();
            const y = r.top + r.height / 2 - box.top;
            // 手机端河道靠左，桌面端在版心中线附近蜿蜒
            const x = compact ? 22 : cx + amp * Math.sin((i / period) * Math.PI * 2);
            const dot = item.querySelector<HTMLElement>('.tl-dot');
            if (dot) dot.style.left = `${(x / box.width) * 100}%`;

            let edge: number | null = null;
            const card = item.querySelector<HTMLElement>('.tl-card');
            if (card && !compact) {
              const cr = card.getBoundingClientRect();
              edge = i % 2 === 0 ? cr.right - box.left : cr.left - box.left;
            }
            return { x, y, edge };
          });

          if (!pts.length) {
            line.setAttribute('d', '');
            glow.setAttribute('d', '');
            if (body) body.setAttribute('d', '');
            if (trib) trib.setAttribute('d', '');
            return;
          }

          // 首尾各延出一小段，让河流「流进来 / 流出去」
          const head = { x: pts[0].x, y: pts[0].y - Math.min(52, pts[0].y - 4) };
          const tail = {
            x: pts[pts.length - 1].x,
            y: Math.min(box.height - 4, pts[pts.length - 1].y + 52),
          };
          const d = smooth([head, ...pts, tail]);
          line.setAttribute('d', d);
          glow.setAttribute('d', d);
          if (body) body.setAttribute('d', d);
          if (trib) {
            let td = '';
            for (const p of pts) if (p.edge != null) td += ` M ${p.x} ${p.y} L ${p.edge} ${p.y}`;
            trib.setAttribute('d', td);
          }
        });
      };

      const resizeObserver = new ResizeObserver(draw);
      resizeObserver.observe(list);
      list.querySelectorAll('.tl-item').forEach((item) => resizeObserver.observe(item));
      const mutationObserver = new MutationObserver(draw);
      mutationObserver.observe(list, { attributes: true, subtree: true, attributeFilter: ['class'] });
      draw();
      // 字体/图片载入后高度会变，再校准一次
      window.addEventListener('load', draw, { once: true });
    });
  }
  document.addEventListener('astro:page-load', initRiverArchive);
  initRiverArchive();
</script>

<style>
  .page-head {
    padding: 2.5rem 0 2rem;
    text-align: center;
  }
  .page-head h1 {
    font-size: 2rem;
    letter-spacing: -0.02em;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .page-head h1 :global(.icon) { color: var(--primary); }
  .page-head p {
    color: var(--text-soft);
    margin-top: 0.4rem;
  }
  .page-head strong {
    color: var(--primary-strong);
    font-weight: 800;
  }
  :global([data-theme='dark'] .page-head strong) { color: var(--primary-light); }

  /* ============ 时光河流 ============ */
  .timeline {
    position: relative;
    max-width: 58rem;
    margin: 0 auto;
    padding: 0.5rem 0 2rem;
    isolation: isolate;
  }
  .year {
    position: relative;
    margin: 0 0 2.8rem;
    padding-top: 0.2rem;
  }
  .year-node {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0 auto 1.2rem;
    text-align: center;
  }
  .year-num {
    font-size: clamp(2rem, 4vw, 2.65rem);
    font-weight: 850;
    letter-spacing: -0.055em;
    line-height: 1;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 8px 32px color-mix(in srgb, var(--primary) 18%, transparent);
  }
  .year-count {
    align-self: center;
    color: var(--primary-strong);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    border: 1px solid color-mix(in srgb, var(--primary) 22%, var(--border-light));
    border-radius: 999px;
    padding: 0.22rem 0.72rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  :global([data-theme='dark'] .year-count) { color: var(--primary-light); }
  .year-caption {
    flex-basis: 100%;
    color: var(--text-faint);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
  }

  .year-list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0.9rem 0;
  }
  .river-canvas {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .river-line, .river-glow, .river-body, .river-trib {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  /* 三层叠出「水」的厚度：宽柔光 → 河身 → 亮芯 */
  .river-line { stroke-width: 2.6; opacity: 0.9; }
  .river-body { stroke-width: 9; opacity: 0.16; }
  .river-glow { stroke-width: 22; opacity: 0.12; filter: blur(7px); }
  /* 支流：从河道牵一条虚线到两岸的卡片 */
  .river-trib {
    stroke: color-mix(in srgb, var(--primary) 52%, transparent);
    stroke-width: 1.3;
    stroke-dasharray: 1 6;
    opacity: 0.75;
  }

  .tl-item {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 132px;
  }
  .tl-item:nth-of-type(odd) { justify-content: flex-start; }
  .tl-item:nth-of-type(even) { justify-content: flex-end; }
  .tl-dot {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    width: 15px;
    height: 15px;
    border: 3px solid color-mix(in srgb, var(--primary) 74%, white);
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--primary) 12%, transparent), 0 0 22px color-mix(in srgb, var(--primary) 42%, transparent);
    transform: translate(-50%, -50%);
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease, left 0.5s cubic-bezier(.2,.75,.25,1);
  }
  .tl-item:hover .tl-dot {
    background: var(--primary);
    box-shadow: 0 0 0 8px color-mix(in srgb, var(--primary) 14%, transparent), 0 0 30px color-mix(in srgb, var(--primary) 56%, transparent);
    transform: translate(-50%, -50%) scale(1.12);
  }
  .tl-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.62rem;
    width: 42%;
    min-width: 0;
    min-height: 104px;
    padding: 1rem 1.2rem 1.05rem;
    overflow: hidden;
    color: var(--text);
    text-decoration: none !important;
    border: 1px solid color-mix(in srgb, var(--primary) 15%, var(--border));
    border-radius: 1.2rem;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    box-shadow: 0 8px 30px color-mix(in srgb, var(--primary) 7%, transparent), inset 0 1px 0 color-mix(in srgb, white 58%, transparent);
    backdrop-filter: blur(14px) saturate(135%);
    transition: transform 0.32s cubic-bezier(.2,.75,.25,1), border-color 0.32s ease, box-shadow 0.32s ease, background 0.32s ease;
  }
  .tl-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(180deg, transparent, var(--primary), color-mix(in srgb, var(--primary) 20%, transparent), transparent);
    opacity: 0.55;
    transition: opacity 0.3s ease;
  }
  .tl-item:nth-of-type(even) .tl-card::before { inset: 0 0 0 auto; }
  .tl-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--primary) 42%, var(--border));
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow: 0 16px 38px color-mix(in srgb, var(--primary) 14%, transparent), inset 0 1px 0 color-mix(in srgb, white 72%, transparent);
  }
  .tl-card:hover::before { opacity: 1; }
  .tl-meta { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .tl-date {
    color: var(--primary-strong);
    font-size: 0.73rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.025em;
  }
  :global([data-theme='dark'] .tl-date) { color: var(--primary-light); }
  .tl-index {
    color: var(--text-faint);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    opacity: 0.72;
  }
  .tl-title {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text);
    font-size: clamp(0.92rem, 1.3vw, 1.04rem);
    font-weight: 700;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    transition: color 0.2s ease;
  }
  .tl-card:hover .tl-title { color: var(--primary-strong); }
  :global([data-theme='dark'] .tl-card:hover .tl-title) { color: var(--primary-light); }
  .tl-tags { overflow: hidden; color: var(--text-faint); font-size: 0.7rem; white-space: nowrap; text-overflow: ellipsis; }
  .tl-arrow {
    position: absolute;
    right: 1rem;
    bottom: 0.85rem;
    color: var(--primary);
    opacity: 0;
    transform: translateX(-5px);
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  .tl-card:hover .tl-arrow { opacity: 1; transform: translateX(0); }

  .empty {
    padding: 3rem;
    text-align: center;
    color: var(--text-soft);
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
  }
  @media (max-width: 900px) {
    .tl-card { width: 44%; }
  }
  @media (max-width: 640px) {
    .timeline { padding: 0.3rem 0.1rem 1.5rem; }
    .year { margin-bottom: 2rem; }
    .year-node { margin-bottom: 0.75rem; }
    .year-caption { font-size: 0.7rem; }
    .year-list { gap: 1.1rem; padding: 0.5rem 0; }
    .tl-item { min-height: 112px; justify-content: flex-end !important; }
    .tl-dot, .tl-item:nth-of-type(even) .tl-dot { left: 22px; }
    .tl-card { width: calc(100% - 54px); min-height: 96px; padding: 0.85rem 0.95rem; border-radius: 1rem; }
    .tl-item:nth-of-type(even) .tl-card::before { inset: 0 auto 0 0; }
    .tl-tags { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tl-card, .tl-dot { transition: none; }
  }
</style>
