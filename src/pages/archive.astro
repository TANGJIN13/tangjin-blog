  /* 卡片：毛玻璃 + 极轻的边框，保证正文清晰可读 */
  .mem-card {
    position: relative;
    display: block;
    width: min(48%, 26rem);
    min-width: 0;
    padding: 0;
    color: var(--text);
    text-decoration: none !important;
    border: 1px solid color-mix(in srgb, var(--primary) 14%, var(--border));
