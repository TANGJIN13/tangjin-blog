---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SidebarLeft from '../components/SidebarLeft.astro';
import SidebarRight from '../components/SidebarRight.astro';
import Paginate from '../components/Paginate.astro';
import { getPublishedPosts, formatDate, readingTime } from '../lib/posts';

const posts = await getPublishedPosts();

// 按年份分组
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.published.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const totalWords = posts.reduce((n, p) => n + p.body.replace(/\s/g, '').length, 0);

// 首屏先输出完整河道；分页后由客户端按当前可见条目重新校准曲线。
const riverPathFor = (count: number) => {
  const step = 176;
  const xAt = (index: number) => (index % 2 === 0 ? 460 : 540);
  let d = `M ${xAt(0)} ${step / 2}`;
  for (let i = 1; i < count; i++) {
    const y = i * step + step / 2;
    d += ` C ${xAt(i - 1)} ${y - step / 2 + 48}, ${xAt(i)} ${y - 48}, ${xAt(i)} ${y}`;
  }
  return d;
};
---

<Base
  title="归档"
  pageBanner
  bannerIcon="archive"
  bannerTitle="归档"
  bannerDesc={`共 ${posts.length} 篇文章 · 约 ${(totalWords / 10000).toFixed(1)} 万字`}
>
  <div class="page-shell">
    <SidebarLeft />
    <div class="page-main">
    <header class="page-head onload-animation hide-with-banner">
      <h1><Icon name="archive" size="1.6rem" /> 归档</h1>
      <p>
        共 <strong>{posts.length}</strong> 篇文章 · 约 <strong>{(totalWords / 10000).toFixed(1)}</strong> 万字，按时间倒序
      </p>
    </header>

    <div class="timeline">
      {
        years.map((y) => (
          <section class="year" data-paginate-group>
            <div class="year-node">
              <span class="year-num">{y}</span>
              <span class="year-count">{byYear.get(y)!.length} 篇记忆</span>
              <span class="year-caption">这一年的文字，沿河而来</span>
            </div>
            <ul class="year-list">
              <svg class="river-canvas" aria-hidden="true" preserveAspectRatio="none">
                <defs>
                  <linearGradient id={`river-gradient-${y}`} x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="var(--primary)" stop-opacity=".12" />
                    <stop offset="16%" stop-color="var(--primary)" stop-opacity=".8" />
                    <stop offset="84%" stop-color="var(--primary)" stop-opacity=".72" />
                    <stop offset="100%" stop-color="var(--primary)" stop-opacity=".12" />
                  </linearGradient>
                  <filter id={`river-glow-${y}`} x="-30%" y="-30%" width="160%" height="160%">
                    <feGaussianBlur stdDeviation="3" />
                  </filter>
                </defs>
                <path class="river-glow" stroke={`url(#river-gradient-${y})`} />
                <path class="river-line" stroke={`url(#river-gradient-${y})`} />
              </svg>
              {byYear.get(y)!.map((p, i) => (
                <li class="tl-item onload-animation paginate-item" style={`animation-delay: ${Math.min(i, 10) * 0.05}s`}>
                  <span class="tl-dot" aria-hidden="true"></span>
                  <a class="tl-card" href={`/posts/${p.id}/`}>
                    <span class="tl-meta">
                      <time class="tl-date" datetime={p.data.published.toISOString()}>
                        {formatDate(p.data.published)}
                      </time>
                      <span class="tl-index">{String(i + 1).padStart(2, '0')}</span>
                    </span>
                    <span class="tl-title">{p.data.title}</span>
                    {p.data.tags.length > 0 && (
                      <span class="tl-tags">{p.data.tags.slice(0, 3).map((t) => `#${t}`).join('　')}</span>
                    )}
                    <span class="tl-arrow" aria-hidden="true">
                      <Icon name="next" size="0.9rem" />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>

    <Paginate pageSize={15} />

    {
      posts.length === 0 && (
        <div class="empty">
          <p>还没有文章。</p>
        </div>
      )
    }
    </div>
    <SidebarRight />
  </div>
</Base>

<script>
  function initRiverArchive() {
    document.querySelectorAll<HTMLElement>('.year-list').forEach((list) => {
      if (list.dataset.riverBound === 'true') return;
      list.dataset.riverBound = 'true';
      const svg = list.querySelector<SVGSVGElement>('.river-canvas');
      const line = list.querySelector<SVGPathElement>('.river-line');
      const glow = list.querySelector<SVGPathElement>('.river-glow');
      if (!svg || !line || !glow) return;

      let frame = 0;
      const draw = () => {
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          const box = list.getBoundingClientRect();
          if (!box.width || !box.height) return;
          svg.setAttribute('viewBox', `0 0 ${box.width} ${box.height}`);
          const items = Array.from(list.querySelectorAll('.tl-item:not(.is-hidden)'));
          const points = items.map((item) => {
            const dot = item.querySelector('.tl-dot');
            const r = dot.getBoundingClientRect();
            return { x: r.left + r.width / 2 - box.left, y: r.top + r.height / 2 - box.top };
          });
          if (!points.length) {
            line.setAttribute('d', '');
            glow.setAttribute('d', '');
            return;
          }
          let d = `M ${points[0].x} ${points[0].y}`;
          for (let i = 1; i < points.length; i++) {
            const prev = points[i - 1];
            const current = points[i];
            const dy = current.y - prev.y;
            const dx = current.x - prev.x;
            d += ` C ${prev.x + dx * 0.42} ${prev.y + dy * 0.38}, ${current.x - dx * 0.42} ${current.y - dy * 0.38}, ${current.x} ${current.y}`;
          }
          line.setAttribute('d', d);
          glow.setAttribute('d', d);
        });
      };
      const resizeObserver = new ResizeObserver(draw);
      resizeObserver.observe(list);
      list.querySelectorAll('.tl-item').forEach((item) => resizeObserver.observe(item));
      const mutationObserver = new MutationObserver(draw);
      mutationObserver.observe(list, { attributes: true, subtree: true, attributeFilter: ['class'] });
      draw();
    });
  }
  document.addEventListener('astro:page-load', initRiverArchive);
  initRiverArchive();
</script>

<style>
  .page-head {
    padding: 2.5rem 0 2rem;
    text-align: center;
  }
  .page-head h1 {
    font-size: 2rem;
    letter-spacing: -0.02em;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }
  .page-head h1 :global(.icon) { color: var(--primary); }
  .page-head p {
    color: var(--text-soft);
    margin-top: 0.4rem;
  }
  .page-head strong {
    color: var(--primary-strong);
    font-weight: 800;
  }
  :global([data-theme='dark'] .page-head strong) { color: var(--primary-light); }

  /* ============ 时光河流 ============ */
  .timeline {
    position: relative;
    max-width: 58rem;
    margin: 0 auto;
    padding: 0.5rem 0 2rem;
    isolation: isolate;
  }
  .year {
    position: relative;
    margin: 0 0 2.8rem;
    padding-top: 0.2rem;
  }
  .year-node {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0 auto 1.2rem;
    text-align: center;
  }
  .year-num {
    font-size: clamp(2rem, 4vw, 2.65rem);
    font-weight: 850;
    letter-spacing: -0.055em;
    line-height: 1;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    text-shadow: 0 8px 32px color-mix(in srgb, var(--primary) 18%, transparent);
  }
  .year-count {
    align-self: center;
    color: var(--primary-strong);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    border: 1px solid color-mix(in srgb, var(--primary) 22%, var(--border-light));
    border-radius: 999px;
    padding: 0.22rem 0.72rem;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.03em;
  }
  :global([data-theme='dark'] .year-count) { color: var(--primary-light); }
  .year-caption {
    flex-basis: 100%;
    color: var(--text-faint);
    font-size: 0.78rem;
    letter-spacing: 0.12em;
  }

  .year-list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1.35rem;
    list-style: none;
    margin: 0;
    padding: 0.7rem 0;
  }
  .river-canvas {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .river-line, .river-glow {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
  }
  .river-line { stroke-width: 2.2; opacity: 0.82; }
  .river-glow { stroke-width: 9; opacity: 0.16; filter: blur(4px); }

  .tl-item {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    width: 100%;
    min-height: 112px;
  }
  .tl-item:nth-of-type(odd) { justify-content: flex-start; }
  .tl-item:nth-of-type(even) { justify-content: flex-end; }
  .tl-dot {
    position: absolute;
    top: 50%;
    left: 46%;
    z-index: 2;
    width: 15px;
    height: 15px;
    border: 3px solid color-mix(in srgb, var(--primary) 74%, white);
    border-radius: 50%;
    background: var(--surface);
    box-shadow: 0 0 0 5px color-mix(in srgb, var(--primary) 12%, transparent), 0 0 22px color-mix(in srgb, var(--primary) 42%, transparent);
    transform: translate(-50%, -50%);
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  }
  .tl-item:nth-of-type(even) .tl-dot { left: 54%; }
  .tl-item:hover .tl-dot {
    background: var(--primary);
    box-shadow: 0 0 0 8px color-mix(in srgb, var(--primary) 14%, transparent), 0 0 30px color-mix(in srgb, var(--primary) 56%, transparent);
    transform: translate(-50%, -50%) scale(1.12);
  }
  .tl-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.62rem;
    width: 42%;
    min-width: 0;
    min-height: 104px;
    padding: 1rem 1.2rem 1.05rem;
    overflow: hidden;
    color: var(--text);
    text-decoration: none !important;
    border: 1px solid color-mix(in srgb, var(--primary) 15%, var(--border));
    border-radius: 1.2rem;
    background: color-mix(in srgb, var(--surface) 80%, transparent);
    box-shadow: 0 8px 30px color-mix(in srgb, var(--primary) 7%, transparent), inset 0 1px 0 color-mix(in srgb, white 58%, transparent);
    backdrop-filter: blur(14px) saturate(135%);
    transition: transform 0.32s cubic-bezier(.2,.75,.25,1), border-color 0.32s ease, box-shadow 0.32s ease, background 0.32s ease;
  }
  .tl-card::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: linear-gradient(180deg, transparent, var(--primary), color-mix(in srgb, var(--primary) 20%, transparent), transparent);
    opacity: 0.55;
    transition: opacity 0.3s ease;
  }
  .tl-item:nth-of-type(even) .tl-card::before { inset: 0 0 0 auto; }
  .tl-card:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--primary) 42%, var(--border));
    background: color-mix(in srgb, var(--surface) 92%, transparent);
    box-shadow: 0 16px 38px color-mix(in srgb, var(--primary) 14%, transparent), inset 0 1px 0 color-mix(in srgb, white 72%, transparent);
  }
  .tl-card:hover::before { opacity: 1; }
  .tl-meta { display: flex; align-items: center; justify-content: space-between; gap: 0.5rem; }
  .tl-date {
    color: var(--primary-strong);
    font-size: 0.73rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.025em;
  }
  :global([data-theme='dark'] .tl-date) { color: var(--primary-light); }
  .tl-index {
    color: var(--text-faint);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    opacity: 0.72;
  }
  .tl-title {
    display: -webkit-box;
    overflow: hidden;
    color: var(--text);
    font-size: clamp(0.92rem, 1.3vw, 1.04rem);
    font-weight: 700;
    line-height: 1.55;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    transition: color 0.2s ease;
  }
  .tl-card:hover .tl-title { color: var(--primary-strong); }
  :global([data-theme='dark'] .tl-card:hover .tl-title) { color: var(--primary-light); }
  .tl-tags { overflow: hidden; color: var(--text-faint); font-size: 0.7rem; white-space: nowrap; text-overflow: ellipsis; }
  .tl-arrow {
    position: absolute;
    right: 1rem;
    bottom: 0.85rem;
    color: var(--primary);
    opacity: 0;
    transform: translateX(-5px);
    transition: opacity 0.22s ease, transform 0.22s ease;
  }
  .tl-card:hover .tl-arrow { opacity: 1; transform: translateX(0); }

  .empty {
    padding: 3rem;
    text-align: center;
    color: var(--text-soft);
    background: var(--surface);
    border: 1px dashed var(--border);
    border-radius: var(--radius-lg);
  }
  @media (max-width: 900px) {
    .tl-card { width: 44%; }
  }
  @media (max-width: 640px) {
    .timeline { padding: 0.3rem 0.1rem 1.5rem; }
    .year { margin-bottom: 2rem; }
    .year-node { margin-bottom: 0.75rem; }
    .year-caption { font-size: 0.7rem; }
    .year-list { gap: 0.85rem; padding: 0.4rem 0; }
    .tl-item { min-height: 104px; justify-content: flex-end !important; }
    .tl-dot, .tl-item:nth-of-type(even) .tl-dot { left: 14px; }
    .tl-card { width: calc(100% - 42px); min-height: 96px; padding: 0.85rem 0.95rem; border-radius: 1rem; }
    .tl-item:nth-of-type(even) .tl-card::before { inset: 0 auto 0 0; }
    .tl-tags { display: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tl-card, .tl-dot { transition: none; }
  }
</style>
