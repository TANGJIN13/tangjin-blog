---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import SidebarLeft from '../components/SidebarLeft.astro';
import SidebarRight from '../components/SidebarRight.astro';
import Paginate from '../components/Paginate.astro';
import { getPublishedPosts, formatDate } from '../lib/posts';

const posts = await getPublishedPosts();

// 按年份分组（保持日期倒序）
const byYear = new Map<number, typeof posts>();
for (const p of posts) {
  const y = p.data.published.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(p);
}
const years = [...byYear.keys()].sort((a, b) => b - a);
const totalWords = posts.reduce((n, p) => n + p.body.replace(/\s/g, '').length, 0);

// 每一年配一句诗意描述 —— 年份是「时间长河」上的地标，不是普通标题。
const YEAR_MOTTOS = [
  '这一年的文字，沿河而来',
  '往昔的文字，也值得被记起',
  '水声拂过，旧事仍在',
  '河床沉淀下来的句子',
  '远处的灯，还亮着',
];
const yearMotto = (i: number) => YEAR_MOTTOS[i] ?? '岁月把文字汇入长河';
/*
  「时间节点」序列 —— 河道、里程碑、卡片全部由**真实文章数据**驱动。

  首页把第一年的第一条也当作里程碑（当年开篇），所以：
    第 0 年 → [里程碑, ...全部条目]
    其余年 → [里程碑, ...全部条目]
  即每年都以一个里程碑（年份 + 月份）开场，河道在里程碑附近自然加宽、
  月份刻度落在里程碑处 —— 年份与月份因此都成为河道上的地标。
*/
type Node =
  | { kind: 'mile'; year: number; month: number; label: string; motto: string; anchor: boolean; index: number }
  | { kind: 'post'; post: typeof posts[number]; date: string; tags: string[]; anchor: boolean; index: number };

const streams = years.map((y, yi) => {
  const list = byYear.get(y)!;
  const nodes: Node[] = [];
  // 年份里程碑：月份取该年最新一条的月份；只有一条时它本身就是锚点
  const lead = list[0];
  nodes.push({
    kind: 'mile',
    year: y,
    month: lead.data.published.getMonth() + 1,
    label: `${lead.data.published.getMonth() + 1} 月`,
    motto: yearMotto(yi),
    anchor: list.length === 1,
    index: 0,
  });
  list.forEach((p, i) => {
    nodes.push({
      kind: 'post',
      post: p,
      date: formatDate(p.data.published),
      tags: p.data.tags.slice(0, 3),
      // 只有一条文章的年份，里程碑本身就是那一篇 → 卡牌对齐锚点高度
      anchor: list.length === 1,
      index: i,
    });
  });
  return { year: y, count: list.length, motto: yearMotto(yi), nodes, isFirst: yi === 0 };
});
---

<Base
  title="归档"
  pageBanner
  bannerIcon="archive"
  bannerTitle="归档"
  bannerDesc={`共 ${posts.length} 篇文章 · 约 ${(totalWords / 10000).toFixed(1)} 万字`}
>
  <div class="page-shell">
    <SidebarLeft />
    <div class="page-main">
      <div class="river-page">
        <!-- 河流自身（贯穿整条时间轴的一整条河；仅装饰） -->
        <svg class="river-svg" aria-hidden="true" preserveAspectRatio="none">
          <defs>
            <linearGradient id="river-core" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="var(--primary)" stop-opacity=".10" />
              <stop offset="16%" stop-color="var(--primary)" stop-opacity=".72" />
              <stop offset="50%" stop-color="var(--primary)" stop-opacity=".88" />
              <stop offset="86%" stop-color="var(--primary)" stop-opacity=".7" />
              <stop offset="100%" stop-color="var(--primary)" stop-opacity=".08" />
            </linearGradient>
            <!-- 河身的横向光照：中央亮、两岸淡 —— 形成「水」的厚度 -->
            <linearGradient id="river-skin" x1="0" y1="0" x2="1" y2="0">
              <stop offset="0%" stop-color="var(--primary)" stop-opacity="0" />
              <stop offset="50%" stop-color="var(--primary)" stop-opacity=".5" />
              <stop offset="100%" stop-color="var(--primary)" stop-opacity="0" />
            </linearGradient>
            <linearGradient id="river-haze" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="var(--primary-light)" stop-opacity=".5" />
              <stop offset="55%" stop-color="var(--primary)" stop-opacity=".34" />
              <stop offset="100%" stop-color="var(--primary-light)" stop-opacity=".42" />
            </linearGradient>
          </defs>
          <!-- 一层柔雾：整体轮廓，把河流「虚」出去 -->
          <path class="rl rl-haze" stroke="url(#river-haze)" />
          <!-- 一层河身：宽而淡，是水的主体 -->
          <path class="rl rl-skin" stroke="url(#river-skin)" />
          <!-- 一层亮芯：细，是水流的高光 -->
          <path class="rl rl-core" stroke="url(#river-core)" />
          <!-- 年份处的「水面透镜」：河道在里程碑附近自然加宽，形成阶段标记 -->
          <g class="rl-lenses"></g>
          <!-- 一层流光：沿河缓慢推进的短高光段，让水「在动」 -->
          <path class="rl rl-flow" />
          <!-- 支流：从河道优雅地拐向两侧卡片 -->
          <path class="rl rl-trib" />
        </svg>

        <!-- 沿河漂浮的微光（装饰，JS 注入） -->
        <div class="river-motes" aria-hidden="true"></div>

        {streams.map((s) => (
          <section class="stream" data-year={s.year}>
            <div class="river-track">
              {s.nodes.map((n) => (
                <div
                  class:list={['node', n.kind === 'mile' ? 'node-mile' : 'node-post', n.anchor && 'node-anchor']}
                  data-index={n.index}
                >
                  {n.kind === 'mile' ? (
                    <>
                      {n.anchor && <span class="mile-month" aria-hidden="true">{n.label}</span>}
                      <div class="milestone">
                        <span class="milestone-rule" aria-hidden="true" />
                        <div class="milestone-text">
                          <span class="medallion" aria-hidden="true">
                            <span class="medallion-ring" />
                          </span>
                          <h2 class="year-num">{n.year}</h2>
                          <p class="year-caption">{n.motto}</p>
                          <p class="year-count">{s.count} 篇记忆</p>
                        </div>
                        <span class="milestone-rule" aria-hidden="true" />
                      </div>
                    </>
                  ) : (
                    <a class="mem-card" href={`/posts/${n.post.id}/`}>
                      <span class="mem-side" aria-hidden="true">
                        <span class="mem-line" />
                        <span class="mem-node">
                          <span class="mem-node-core" />
                          <span class="mem-node-pulse" />
                        </span>
                      </span>
                      <span class="mem-body">
                        <span class="mem-head">
                          <span class="mem-month">{n.date}</span>
                          <span class="mem-index">{String(n.index + 1).padStart(2, '0')}</span>
                        </span>
                        <span class="mem-title">{n.post.data.title}</span>
                        <span class="mem-desc">{n.post.data.description}</span>
                        <span class="mem-foot">
                          {n.tags.length > 0 && (
                            <span class="mem-tags">
                              {n.tags.map((t) => (
                                <span class="mem-tag">#{t}</span>
                              ))}
                            </span>
                          )}
                          <span class="mem-more">
                            阅读全文
                            <Icon name="arrow_right" size="0.82rem" />
                          </span>
                        </span>
                      </span>
                    </a>
                  )}
                </div>
              ))}
            </div>
          </section>
        ))}

        {posts.length === 0 && (
          <div class="empty">
            <p>还没有文章。</p>
          </div>
        )}
      </div>

      <Paginate pageSize={15} />
    </div>
    <SidebarRight />
  </div>
</Base>

<script>
  /*
    时光长河 —— 河道布局引擎。

    河道是一条贯穿所有年份的纵向连续曲线。它的横向位置由「时间节点」的
    横向轨迹经 Catmull-Rom 平滑得到；节点自己的 x 又由 y 的相位决定，
    所以节点天然落在河上，而河在每个节点附近加宽 —— 年份与月份地标正好
    踩在这些加宽处，看起来像是河道与时间交汇的节点。

    全部尺寸都从 DOM 实测，因此文章数量、字数、屏幕宽度变化时都能自适应。
  */
  function initRiverArchive() {
    const page = document.querySelector<HTMLElement>('.river-page');
    if (!page) return;
    const svg = page.querySelector<SVGSVGElement>('.river-svg');
    const haze = page.querySelector<SVGPathElement>('.rl-haze');
    const skin = page.querySelector<SVGPathElement>('.rl-skin');
    const core = page.querySelector<SVGPathElement>('.rl-core');
    const flow = page.querySelector<SVGPathElement>('.rl-flow');
    const trib = page.querySelector<SVGPathElement>('.rl-trib');
    const lenses = page.querySelector<SVGGElement>('.rl-lenses');
    if (!svg || !haze || !skin || !core || !flow || !trib || !lenses) return;

    const reduce = (() => {
      try {
        return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      } catch {
        return false;
      }
    })();

    /*
      ⚠️ 入场隐藏必须由 JS「启用」，绝不能在 CSS 里默认把节点藏起来。
         否则一旦脚本没跑（SEO 爬虫、禁用 JS、打包异常），文章就永远看不见了。
         这里先加 js-on（此刻节点大多还在视口外，不会闪），
         随后立刻做一次布局、IntersectionObserver 会把可见的立刻标 is-in。
    */
    if (!reduce) page.classList.add('js-on');
    if (reduce) page.classList.add('river-static');

    // 河道横向轨迹：一条**整体居中**的平缓正弦。
    // 关键：必须加一个让波形在 x∈[-1,1] 单调递减的相位 φ——
    // 否则首尾两端会同时停在 sin(c) 上，河道整天粘在同一个 x（早期版本的 bug）。
    // φ=1.78(102°) 让整条河横向铺得最开，再由居中偏移把它摆到版心中线。
    const WAVE_PHI = 1.78;
    let riverX: ((y: number) => number) | null = null;
    let pts: { x: number; y: number; edge: number | null }[] = [];

    // Catmull-Rom → 三次贝塞尔，得到柔顺的连续曲线
    const smooth = (p: { x: number; y: number }[]) => {
      if (p.length < 2) return '';
      let d = `M ${p[0].x.toFixed(1)} ${p[0].y.toFixed(1)}`;
      for (let i = 0; i < p.length - 1; i++) {
        const p0 = p[i - 1] ?? p[i];
        const p1 = p[i];
        const p2 = p[i + 1];
        const p3 = p[i + 2] ?? p2;
        d +=
          ` C ${(p1.x + (p2.x - p0.x) / 6).toFixed(1)} ${(p1.y + (p2.y - p0.y) / 6).toFixed(1)},` +
          ` ${(p2.x - (p3.x - p1.x) / 6).toFixed(1)} ${(p2.y - (p3.y - p1.y) / 6).toFixed(1)},` +
          ` ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
      }
      return d;
    };

    const layout = () => {
      const pr = page.getBoundingClientRect();
      if (!pr.width || !pr.height) return;
      svg.setAttribute('viewBox', `0 0 ${pr.width.toFixed(1)} ${pr.height.toFixed(1)}`);

      /*
        ⚠️ 断点必须用 **视口宽度**，不能用 .river-page 的宽度。
        CSS 的 `@media (max-width: 760px)` 比的是视口；而 .river-page 只是
        中间那一列（.page-shell 减去左右侧栏后的内容列），
        在 768~1280 的视口下它只有 670~740px —— 拿它去比 760 会**误判成手机**，
        于是河道被压成靠左的一条细线，而卡片其实是桌面端的两列。
        实测：768/1024/1280 三个视口全部掉进手机分支（河道 x 恒在 28~40），
        只有 1440 才正常（列宽 814 > 760）。这正是「平板宽度下河道贴死左边缘」的根因。
      */
      const mobile = window.innerWidth <= 760;
      // 桌面端河道在版心中线附近蜿蜒；手机端靠左留出一条单列阅读道
      const amp = mobile ? 6 : Math.min(56, pr.width * 0.066);
      // 波数：整页只走 2.5 个周期左右，缓慢而舒展；页面越长波长越长
      const waves = Math.max(2, Math.min(4, pr.height / 420));
      const wavelength = pr.height / waves;
      const theta = (y: number) => (y / wavelength + WAVE_PHI) * Math.PI * 2;
      const wave = (y: number, a: number) => a * Math.sin(theta(y));

      const nodes = Array.from(page.querySelectorAll<HTMLElement>('.node'));

      /*
        先量出「河道两侧的可用走廊」，再决定振幅。
        河道必须始终走在两岸卡片之间的空档里 —— 一旦某张卡片越过了中线，
        河道就会从卡片身上穿过去（实测 768px 那版就是这样）。
        所以：把每张卡片靠河那一侧的边缘取出来，取最靠里的一条，
        让河道最多贴到它再留余量。

        ⚠️ 「卡片在左还是在右」**不能按索引奇偶推断**：CSS 用的是
        `nth-of-type`，它数的是所有 `.node` 兄弟（里程碑也占一个位），
        所以 JS 里的 posts 序号和视觉左右是错位的 —— 早期版本就是这么算错的，
        在 768px 得到 room=0，河道振幅被压成 6px、贴死在左边缘。
        正确做法：直接比较卡片左右边缘到页面中线的距离，谁近就在那一侧。
      */
      let ampSafe = amp;
      if (!mobile) {
        let room = (pr.width / 2) * 0.94;
        for (const el of nodes) {
          const card = el.querySelector<HTMLElement>('.mem-card');
          if (!card) continue;
          const cr = card.getBoundingClientRect();
          const l = cr.left - pr.left;
          const r = cr.right - pr.left;
          // 卡片靠河那一侧 = 离版心中线更近的那条边
          const toward = Math.abs(l - pr.width / 2) <= Math.abs(r - pr.width / 2) ? l : r;
          room = Math.min(room, toward);
        }
        // 再留 26px 余量，河道绝不贴上卡片（实测取 18px 时仍有 0.2px 的擦边）
        ampSafe = Math.max(16, Math.min(amp, room - 26));
      }

      if (mobile) {
        const mx = Math.min(34, pr.width * 0.085);
        riverX = (y: number) => mx + wave(y, amp);
      } else {
        // 河道在整页内横向居中：把两边余量对半分给振幅
        const x1 = wave(0, ampSafe);
        const x2 = wave(pr.height, ampSafe);
        const center = pr.width / 2 - (x1 + x2) / 2;
        riverX = (y: number) => center + wave(y, ampSafe);
      }
      const rx = riverX;

      pts = nodes.map((el) => {
        const r = el.getBoundingClientRect();
        const y = r.top + r.height / 2 - pr.top;
        return { x: rx(y), y, edge: null };
      });

      if (pts.length < 2) {
        haze.setAttribute('d', '');
        skin.setAttribute('d', '');
        core.setAttribute('d', '');
        flow.setAttribute('d', '');
        trib.setAttribute('d', '');
        lenses.innerHTML = '';
        return;
      }

      // 河道两端各延出一小段，让河「流进 / 流出」页面
      const head = { x: rx(0), y: 0 };
      const last = pts[pts.length - 1];
      const tail = { x: rx(pr.height), y: pr.height };
      const d = smooth([head, ...pts, tail]);

      haze.setAttribute('d', d);
      skin.setAttribute('d', d);
      core.setAttribute('d', d);
      flow.setAttribute('d', d);

      // 流光的节奏：用 stroke-dasharray 切出若干短高光段，
      // 再由 CSS 的 rl-flow-drift 动画缓慢推着它们沿河前进。
      // 段长/间隔按河长算，这样无论页面多长，光段密度都一致。
      const L = core.getTotalLength() || 1;
      const seg = Math.max(60, L * 0.075);
      const gap = Math.max(150, L * 0.2);
      flow.style.strokeDasharray = `${seg.toFixed(1)} ${gap.toFixed(1)}`;
      flow.style.setProperty('--flow-shift', `${(seg + gap).toFixed(1)}`);

      // 把每个节点摆到河道上，并算出卡片靠河那一侧的边缘 ——
      // 两者都必须在同一帧里、以同一份河道坐标写出，否则会各算各的。
      let td = '';
      let lens = '';
      nodes.forEach((el, i) => {
        const y = pts[i].y;
        const x = pts[i].x;
        const dot = el.querySelector<HTMLElement>('.mem-node');
        if (dot) dot.style.setProperty('--nx', `${x.toFixed(1)}px`);

        // 里程碑（年份）→ 在河道上铺一片横向的「水面透镜」，
        // 让河道在年份处自然加宽，年份因此成为河道上的阶段标记。
        if (el.classList.contains('node-mile')) {
          el.style.setProperty('--nx', `${x.toFixed(1)}px`);
          const lr = (mobile ? 30 : Math.min(58, pr.width * 0.085)).toFixed(1);
          const lh = (mobile ? 13 : 19).toFixed(1);
          // 透镜形状：一段很扁的椭圆，用两段对称的贝塞尔画出来
          lens +=
            ` M ${(x - +lr).toFixed(1)} ${y.toFixed(1)}` +
            ` C ${(x - +lr * 0.45).toFixed(1)} ${(y - +lh * 0.5).toFixed(1)},` +
            ` ${(x + +lr * 0.45).toFixed(1)} ${(y - +lh * 0.5).toFixed(1)},` +
            ` ${(x + +lr).toFixed(1)} ${y.toFixed(1)}` +
            ` C ${(x + +lr * 0.45).toFixed(1)} ${(y + +lh * 0.5).toFixed(1)},` +
            ` ${(x - +lr * 0.45).toFixed(1)} ${(y + +lh * 0.5).toFixed(1)},` +
            ` ${(x - +lr).toFixed(1)} ${y.toFixed(1)} Z`;
        }

        const card = el.querySelector<HTMLElement>('.mem-card');
        if (!card) return;
        const cr = card.getBoundingClientRect();
        const yc = cr.top + cr.height / 2 - pr.top;
        const edge = Math.abs(cr.left - pr.left - x) <= Math.abs(cr.right - pr.left - x) ? cr.left - pr.left : cr.right - pr.left;
        // 支流：从河道上的点，用一条柔弯接到卡片边缘（略微下探，避免机械的直线）
        const mid = x + (edge - x) * 0.55;
        td += ` M ${x.toFixed(1)} ${y.toFixed(1)} C ${mid.toFixed(1)} ${y.toFixed(1)}, ${mid.toFixed(1)} ${yc.toFixed(1)}, ${edge.toFixed(1)} ${yc.toFixed(1)}`;
      });
      trib.setAttribute('d', td);
      if (lenses) lenses.innerHTML = lens ? `<path d="${lens}" />` : '';

      // 沿河漂浮的微光：等距撒在河道的延长线上
      const motes = page.querySelector<HTMLElement>('.river-motes');
      if (motes) {
        const N = Math.max(10, Math.min(30, Math.round(pr.height / 240)));
        const step = pr.height / (N - 1);
        let html = '';
        for (let i = 0; i < N; i++) {
          const y = step * i;
          const x = rx(y) + Math.sin(i * 2.4) * 13;
          const dur = 13 + ((i * 3.7) % 9);
          const delay = -((i * 2.9) % dur);
          const size = 2.4 + ((i * 1.7) % 3.4);
          const sway = 9 + ((i * 2.3) % 11);
          html += `<i style="--mx:${x.toFixed(1)}px;--my:${y.toFixed(1)}px;--ds:${dur.toFixed(1)}s;--dl:${delay.toFixed(1)}s;--sz:${size.toFixed(1)}px;--sw:${sway.toFixed(1)}px"></i>`;
        }
        motes.innerHTML = html;
      }
    };

    let raf = 0;
    const schedule = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(layout);
    };

    const ro = new ResizeObserver(schedule);
    ro.observe(page);
    Array.from(page.querySelectorAll('.node')).forEach((el) => ro.observe(el));
    window.addEventListener('resize', schedule, { passive: true });
    if (document.fonts?.ready) document.fonts.ready.then(schedule).catch(() => {});
    window.addEventListener('load', schedule, { once: true });
    layout();

    // ===== 滚动时「点亮」阅读位置：当前年份 + 当前节点 =====
    // 只做 class 切换（不写样式），交给 CSS 处理，避免滚动时的高频样式计算。
    const marks = Array.from(page.querySelectorAll<HTMLElement>('.stream'));
    let sraf = 0;
    const syncScroll = () => {
      sraf = 0;
      const probe = window.innerHeight * 0.42;
      let current: HTMLElement | null = null;
      for (const m of marks) {
        const r = m.getBoundingClientRect();
        if (r.top <= probe && r.bottom > probe) current = m;
      }
      for (const m of marks) m.classList.toggle('is-current', m === current);
    };
    const onScroll = () => {
      if (sraf) return;
      sraf = requestAnimationFrame(syncScroll);
    };
    if (!reduce) {
      window.addEventListener('scroll', onScroll, { passive: true });
      syncScroll();
    }

    // ===== 节点逐个「浮出水面」：进入视口的卡片才播入场 =====
    // rootMargin 上下都留出容差 —— 否则 `is-in` 时元素从 translateY(16px) 归位，
    // 会触发 ResizeObserver → 重算河道 → 分数像素抖动 → 反复越过 0.08 阈值而闪烁。
    if (!reduce && 'IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              (e.target as HTMLElement).classList.add('is-in');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '18% 0px 18% 0px', threshold: 0 },
      );
      Array.from(page.querySelectorAll('.node')).forEach((el) => io.observe(el));
    } else {
      page.classList.add('river-static');
    }
  }

  document.addEventListener('astro:page-load', initRiverArchive);
  initRiverArchive();
</script>

<style>
  /* ============ 时光长河 ============ */
  .river-page {
    position: relative;
    isolation: isolate;
    padding: 0.4rem 0 2.6rem;
  }

  /* ---- 河道 SVG：贯穿整个时间轴，绝对定位铺满，不接收事件 ---- */
  .river-svg {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
