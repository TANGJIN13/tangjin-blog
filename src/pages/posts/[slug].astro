---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WallpaperBanner from '../../components/WallpaperBanner.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import Icon from '../../components/Icon.astro';
import { getPublishedPosts, formatDate, readingTime } from '../../lib/posts';
import { site } from '../../site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return Promise.all(
    posts.map(async (post) => {
      const { Content } = await render(post);
      return {
        params: { slug: post.id },
        props: { post, Content },
      };
    }),
  );
}

const { post, Content } = Astro.props;
const { title, description, published, updated, tags, cover } = post.data;
const minutes = readingTime(post.body);
const wordCount = post.body.replace(/\s/g, '').length;
const coverSrc = cover ?? '/images/post-placeholder.svg';

// 有封面就用封面当横幅图（单图不轮播），没有就用站点默认壁纸轮播
const hasCover = Boolean(cover);
const bannerImages = hasCover ? [coverSrc] : undefined;
---

<Base
  title={title}
  description={description}
  image={coverSrc.startsWith('http') ? coverSrc : `${site.url}${coverSrc}`}
  banner
>
  <!-- 顶部壁纸横幅：文章标题 / 标签 / 元信息 -->
  <WallpaperBanner
    height="clamp(360px, 48vh, 540px)"
    images={bannerImages}
    single={hasCover}
  >
    <div class="post-banner">
      {tags.length > 0 && (
        <div class="pb-tags">
          {tags.map((t) => (
            <a class="pb-tag" href={`/tags/${t}/`}>
              <Icon name="tag" size="0.78rem" />{t}
            </a>
          ))}
        </div>
      )}

      <h1 class="pb-title">{title}</h1>

      {description && <p class="pb-desc">{description}</p>}

      <div class="pb-meta">
        <span class="pb-meta-item">
          <Icon name="calendar" size="0.95rem" />
          <time datetime={published.toISOString()}>{formatDate(published)}</time>
        </span>
        <span class="pb-sep" aria-hidden="true">·</span>
        <span class="pb-meta-item">
          <Icon name="clock" size="0.95rem" />约 {minutes} 分钟
        </span>
        <span class="pb-sep" aria-hidden="true">·</span>
        <span class="pb-meta-item">
          <Icon name="text" size="0.95rem" />{wordCount} 字
        </span>
        {updated && updated > published && (
          <>
            <span class="pb-sep" aria-hidden="true">·</span>
            <span class="pb-meta-item">
              <Icon name="repeat" size="0.95rem" />更新于 {formatDate(updated)}
            </span>
          </>
        )}
      </div>
    </div>
  </WallpaperBanner>

  <!-- 正文区 -->
  <div class="post-layout">
    <!-- 主内容 -->
    <article class="post-main">
      <div class="post-body custom-md card-base">
        <Content />
      </div>

      <!-- 文末：标签 + 分享 -->
      <div class="post-foot card-base">
        {tags.length > 0 && (
          <div class="foot-tags">
            <span class="foot-label"><Icon name="tag" size="0.9rem" />标签</span>
            {tags.map((t) => (
              <a class="tag" href={`/tags/${t}/`}>{t}</a>
            ))}
          </div>
        )}
        <div class="foot-actions">
          <a class="foot-btn" href="/archive/">
            <Icon name="archive" size="1rem" />更多文章
          </a>
          <a class="foot-btn" href="/">
            <Icon name="home" size="1rem" />回到首页
          </a>
        </div>
      </div>

      <!-- Giscus 评论 -->
      <div class="card-base comments-card">
        <GiscusComments />
      </div>
    </article>

    <!-- 右侧 TOC -->
    <aside class="post-toc">
      <div class="card-base toc-card" id="toc-card">
        <h3 class="widget-title"><Icon name="article" size="1.05rem" /> 目录</h3>
        <nav class="toc-nav" id="toc-nav"></nav>
      </div>
    </aside>
  </div>
</Base>

<script>
  // 自动生成目录
  const content = document.querySelector('.custom-md');
  const tocNav = document.getElementById('toc-nav');
  if (content && tocNav) {
    const headings = content.querySelectorAll('h2, h3');
    headings.forEach((h, i) => {
      h.id = h.id || `heading-${i}`;
      const a = document.createElement('a');
      a.className = 'toc-item toc-level-' + h.tagName[1];
      a.href = `#${h.id}`;
      a.textContent = h.textContent;
      a.addEventListener('click', (e) => {
        e.preventDefault();
        h.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
      tocNav.appendChild(a);
    });

    // 滚动高亮
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          tocNav.querySelectorAll('.toc-item').forEach(a => a.classList.remove('active'));
          tocNav.querySelector(`a[href="#${entry.target.id}"]`)?.classList.add('active');
        }
      });
    }, { rootMargin: '-80px 0px -70% 0px' });
    headings.forEach(h => observer.observe(h));
  }
</script>

<style>
  /* ============ 横幅内的文章头 ============ */
  .post-banner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.85rem;
    max-width: 46rem;
  }

  /* 逐层浮现，和首页同款节奏 */
  @keyframes pb-reveal {
    from { opacity: 0; transform: translateY(26px); filter: blur(9px); }
    to   { opacity: 1; transform: translateY(0);    filter: blur(0); }
  }
  .pb-tags  { animation: pb-reveal 1.5s cubic-bezier(.16,1,.3,1) .15s both; }
  .pb-title { animation: pb-reveal 1.8s cubic-bezier(.16,1,.3,1) .35s both; }
  .pb-desc  { animation: pb-reveal 1.8s cubic-bezier(.16,1,.3,1) .6s both; }
  .pb-meta  { animation: pb-reveal 1.8s cubic-bezier(.16,1,.3,1) .85s both; }

  .pb-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center; }
  .pb-tag {
    display: inline-flex; align-items: center; gap: 0.25rem;
    font-size: 0.78rem; padding: 0.25rem 0.75rem;
    border-radius: 999px;
    color: #fff;
    background: oklch(100% 0 0 / 0.18);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid oklch(100% 0 0 / 0.28);
    text-decoration: none !important;
    transition: all 0.2s ease;
  }
  .pb-tag:hover { background: oklch(100% 0 0 / 0.3); transform: translateY(-2px); }

  .pb-title {
    margin: 0;
    font-size: clamp(1.55rem, 3.6vw, 2.5rem);
    font-weight: 800;
    line-height: 1.3;
    color: #fff;
    letter-spacing: 0.01em;
    text-shadow: 0 2px 28px oklch(0% 0 0 / 0.55);
  }

  .pb-desc {
    margin: 0;
    font-size: clamp(0.86rem, 1.4vw, 1rem);
    color: oklch(100% 0 0 / 0.88);
    text-shadow: 0 1px 12px oklch(0% 0 0 / 0.55);
    line-height: 1.7;
  }

  .pb-meta {
    display: flex; flex-wrap: wrap; align-items: center;
    justify-content: center; gap: 0.45rem;
    font-size: 0.82rem;
    color: oklch(100% 0 0 / 0.82);
    text-shadow: 0 1px 10px oklch(0% 0 0 / 0.5);
  }
  .pb-meta-item { display: inline-flex; align-items: center; gap: 0.28rem; }
  .pb-meta-item :global(.icon) { opacity: 0.8; }
  .pb-sep { opacity: 0.45; }

  /* ============ 正文区 ============ */
  .post-layout {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr) 220px;
    gap: 1.5rem;
    align-items: start;
  }

  .post-body { padding: 1.75rem 2rem; font-size: 1.02rem; }

  .post-foot {
    margin-top: 1.25rem;
    padding: 1.1rem 1.5rem;
    display: flex; flex-wrap: wrap; align-items: center;
    justify-content: space-between; gap: 1rem;
  }
  .foot-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  .foot-label {
    display: inline-flex; align-items: center; gap: 0.25rem;
    font-size: 0.82rem; color: var(--text-faint); margin-right: 0.2rem;
  }
  .tag {
    display: inline-flex; align-items: center; gap: 0.2rem;
    font-size: 0.78rem; padding: 0.18rem 0.65rem;
    border-radius: 999px; background: var(--primary-soft); color: var(--primary-strong);
    text-decoration: none !important;
    transition: all 0.15s ease;
  }
  .tag:hover { transform: translateY(-1px); background: var(--primary); color: var(--text-on-primary); }

  .foot-actions { display: flex; gap: 0.5rem; }
  .foot-btn {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font-size: 0.82rem; padding: 0.35rem 0.85rem;
    border-radius: 999px;
    color: var(--text-soft);
    background: var(--surface-2);
    border: 1px solid var(--border);
    text-decoration: none !important;
    transition: all 0.18s ease;
  }
  .foot-btn:hover {
    color: var(--primary-strong);
    background: var(--primary-soft);
    border-color: var(--primary);
    transform: translateY(-1px);
  }

  .comments-card { margin-top: 1.25rem; padding: 1.5rem; }

  /* ============ Markdown 正文样式 ============ */
  .custom-md :global(h2) {
    font-size: 1.45rem; margin-top: 2rem; padding-bottom: 0.4rem;
    border-bottom: 2px solid; border-image: var(--gradient-primary) 1;
    color: var(--text);
  }
  .custom-md :global(h2:first-child) { margin-top: 0; }
  .custom-md :global(h3) { font-size: 1.2rem; margin-top: 1.5rem; }
  .custom-md :global(p) { margin-bottom: 1em; }

  .custom-md :global(a) {
    color: var(--primary-strong);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    padding: 0 1px;
  }
  .custom-md :global(a:hover) { background: var(--primary-soft); text-decoration: none; }

  .custom-md :global(pre) {
    background: #f6f6fa;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
    overflow-x: auto;
    font-size: 0.86rem;
    line-height: 1.6;
    margin: 1.2em 0;
    box-shadow: var(--shadow-sm);
  }
  [data-theme='dark'] .custom-md :global(pre) { background: #1e1e2e; }
  .custom-md :global(pre code) { background: none; padding: 0; }

  .custom-md :global(:not(pre) > code) {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    padding: 0.08em 0.35em;
    font-size: 0.86em;
    color: var(--primary-strong);
  }

  .custom-md :global(blockquote) {
    margin: 1.2em 0; padding: 0.7em 1.2em;
    border-left: 3px solid; border-image: var(--gradient-primary) 1;
    background: var(--primary-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text-soft);
  }
  .custom-md :global(blockquote p) { margin: 0; }

  .custom-md :global(table) {
    width: 100%; border-collapse: collapse; margin: 1.2em 0;
    font-size: 0.92rem; border-radius: var(--radius); overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .custom-md :global(th), .custom-md :global(td) {
    border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left;
  }
  .custom-md :global(th) { background: var(--surface-2); font-weight: 600; }

  .custom-md :global(img) {
    border-radius: var(--radius-lg); margin: 1.2rem auto; box-shadow: var(--shadow);
  }

  /* ============ TOC ============ */
  .post-toc { position: sticky; top: 88px; align-self: start; }
  .toc-card { padding: 1rem; position: relative; }
  .toc-nav { display: flex; flex-direction: column; gap: 0.25rem; }
  .toc-item {
    font-size: 0.82rem; color: var(--text-soft);
    padding: 0.3rem 0.5rem; border-radius: var(--radius-sm);
    text-decoration: none !important; background: none !important;
    transition: all 0.15s ease; border-left: 2px solid transparent;
  }
  .toc-item:hover { color: var(--text); background: var(--surface-2) !important; }
  .toc-item.active { color: var(--primary-strong); border-left-color: var(--primary); font-weight: 500; }
  .toc-level-3 { padding-left: 1.2rem; font-size: 0.78rem; }

  /* ============ 响应式 ============ */
  @media (max-width: 860px) {
    .post-layout { grid-template-columns: 1fr; }
    .post-toc { display: none; }
    .post-body { padding: 1.8rem 1.4rem; }
    .post-foot { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
    .post-banner { padding-inline: 1rem; }
    .pb-title { font-size: 1.4rem; }
    .pb-meta { font-size: 0.78rem; gap: 0.3rem; }
  }
</style>
