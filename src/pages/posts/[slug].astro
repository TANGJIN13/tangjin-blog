---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import WallpaperBanner from '../../components/WallpaperBanner.astro';
import GiscusComments from '../../components/GiscusComments.astro';
import SakuraEffect from '../../components/SakuraEffect.astro';
import Icon from '../../components/Icon.astro';
import { getPublishedPosts, formatDate, readingTime } from '../../lib/posts';
import { site } from '../../site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return Promise.all(
    posts.map(async (post, i) => {
      const { Content } = await render(post);
      return {
        params: { slug: post.id },
        props: {
          post,
          Content,
          // 上一篇 = 更旧的一篇，下一篇 = 更新的一篇
          older: posts[i + 1] ?? null,
          newer: posts[i - 1] ?? null,
        },
      };
    }),
  );
}

const { post, Content, older, newer } = Astro.props;
const { title, description, published, updated, tags, cover } = post.data;
const minutes = readingTime(post.body);
const wordCount = post.body.replace(/\s/g, '').length;
const coverSrc = cover ?? '/images/post-placeholder.svg';

// 结构化数据 BlogPosting（帮助搜索引擎收录与展示）
const postLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: published.toISOString(),
  dateModified: (updated && updated > published ? updated : published).toISOString(),
  author: { '@type': 'Person', name: site.author },
  publisher: { '@type': 'Organization', name: site.title },
  mainEntityOfPage: { '@type': 'WebPage', '@id': `${site.url}/posts/${post.id}/` },
  image: coverSrc.startsWith('http') ? coverSrc : `${site.url}${coverSrc}`,
  keywords: tags.join(', '),
};

// 有封面就用封面当横幅图（单图不轮播），没有就用站点默认壁纸轮播
const hasCover = Boolean(cover);
const bannerImages = hasCover ? [coverSrc] : undefined;
---

<Base
  title={title}
  description={description}
  image={coverSrc.startsWith('http') ? coverSrc : `${site.url}${coverSrc}`}
  banner
  jsonLd={postLd}
>
  <!-- 阅读进度条 -->
  <div class="read-progress" id="read-progress" aria-hidden="true"></div>

  <!-- 樱花特效：只在进入文章时飘一阵子 -->
  <SakuraEffect />

  <!-- 顶部壁纸横幅：文章标题 / 标签 / 元信息 -->
  <WallpaperBanner
    height="clamp(360px, 48vh, 540px)"
    images={bannerImages}
    single={hasCover}
  >
    <div class="post-banner">
      {tags.length > 0 && (
        <div class="pb-tags">
          {tags.map((t) => (
            <a class="pb-tag" href={`/tags/${t}/`}>
              <Icon name="tag" size="0.78rem" />{t}
            </a>
          ))}
        </div>
      )}

      <h1 class="pb-title">{title}</h1>

      {description && <p class="pb-desc">{description}</p>}

      <div class="pb-meta">
        <span class="pb-meta-item">
          <Icon name="calendar" size="0.95rem" />
          <time datetime={published.toISOString()}>{formatDate(published)}</time>
        </span>
        <span class="pb-sep" aria-hidden="true">·</span>
        <span class="pb-meta-item">
          <Icon name="clock" size="0.95rem" />约 {minutes} 分钟
        </span>
        <span class="pb-sep" aria-hidden="true">·</span>
        <span class="pb-meta-item">
          <Icon name="text" size="0.95rem" />{wordCount} 字
        </span>
        <span class="pb-sep" aria-hidden="true">·</span>
        <span class="pb-meta-item" data-vc-wrap style="display:none">
          <Icon name="eye" size="0.95rem" /><span data-vc="page_pv">--</span> 阅读
        </span>
        {updated && updated > published && (
          <>
            <span class="pb-sep" aria-hidden="true">·</span>
            <span class="pb-meta-item">
              <Icon name="repeat" size="0.95rem" />更新于 {formatDate(updated)}
            </span>
          </>
        )}
      </div>
    </div>
  </WallpaperBanner>

  <!-- 正文区 -->
  <div class="post-layout">
    <!-- 主内容 -->
    <article class="post-main">
      <div class="post-body custom-md card-base">
        <Content />
      </div>

      <!-- 文末：标签 + 分享 -->
      <div class="post-foot card-base">
        {tags.length > 0 && (
          <div class="foot-tags">
            <span class="foot-label"><Icon name="tag" size="0.9rem" />标签</span>
            {tags.map((t) => (
              <a class="tag" href={`/tags/${t}/`}>{t}</a>
            ))}
          </div>
        )}
        <div class="foot-actions">
          <div class="share-box">
            <button class="foot-btn" id="share-toggle" type="button" title="分享本文">
              <Icon name="send" size="1rem" />分享
            </button>
            <div class="share-panel" id="share-panel" hidden>
              <button class="share-item" id="share-copy" type="button">
                <Icon name="copy" size="1rem" />复制链接
              </button>
              <a class="share-item" id="share-weibo" href="#" target="_blank" rel="noopener">
                <Icon name="send" size="1rem" />微博
              </a>
              <a class="share-item" id="share-qzone" href="#" target="_blank" rel="noopener">
                <Icon name="link" size="1rem" />QQ空间
              </a>
            </div>
          </div>
          <a class="foot-btn" href="/archive/">
            <Icon name="archive" size="1rem" />更多文章
          </a>
          <a class="foot-btn" href="/">
            <Icon name="home" size="1rem" />回到首页
          </a>
        </div>
      </div>

      <!-- 上一篇 / 下一篇 -->
      {(older || newer) && (
        <nav class="pn-nav">
          {older ? (
            <a class="pn-card prev" href={`/posts/${older.id}/`}>
              <span class="pn-label"><Icon name="prev" size="0.9rem" />上一篇</span>
              <span class="pn-title">{older.data.title}</span>
            </a>
          ) : <span class="pn-card ghost" aria-hidden="true"></span>}
          {newer ? (
            <a class="pn-card next" href={`/posts/${newer.id}/`}>
              <span class="pn-label">下一篇<Icon name="next" size="0.9rem" /></span>
              <span class="pn-title">{newer.data.title}</span>
            </a>
          ) : <span class="pn-card ghost" aria-hidden="true"></span>}
        </nav>
      )}

      <!-- Giscus 评论 -->
      <div class="card-base comments-card">
        <GiscusComments />
      </div>
    </article>

  </div>
</Base>

<script>
  // 分享功能
  const shareToggle = document.getElementById('share-toggle');
  const sharePanel = document.getElementById('share-panel');
  if (shareToggle && sharePanel) {
    shareToggle.addEventListener('click', (e) => {
      e.stopPropagation();
      sharePanel.hidden = !sharePanel.hidden;
    });
    document.addEventListener('click', (e) => {
      if (!sharePanel.hidden && !e.target.closest('.share-box')) sharePanel.hidden = true;
    });
  }

  const pageUrl = window.location.href;
  const pageTitle = document.title;

  const shareCopy = document.getElementById('share-copy');
  shareCopy?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(pageUrl);
      shareCopy.classList.add('copied');
      const orig = shareCopy.innerHTML;
      shareCopy.innerHTML = '<span class="share-ok">✓</span> 已复制';
      setTimeout(() => { shareCopy.innerHTML = orig; shareCopy.classList.remove('copied'); }, 1600);
    } catch {
      window.prompt('复制链接：', pageUrl);
    }
  });

  const shareWeibo = document.getElementById('share-weibo');
  shareWeibo?.setAttribute('href', `https://service.weibo.com/share/share.php?url=${encodeURIComponent(pageUrl)}&title=${encodeURIComponent(pageTitle)}`);
  const shareQzone = document.getElementById('share-qzone');
  shareQzone?.setAttribute('href', `https://sns.qzone.qq.com/cgi-bin/qzshare/cgi_qzshare_onekey?url=${encodeURIComponent(pageUrl)}&title=${encodeURIComponent(pageTitle)}`);

  // 阅读进度条
  const bar = document.getElementById('read-progress');
  if (bar) {
    const update = () => {
      const total = document.documentElement.scrollHeight - window.innerHeight;
      const ratio = total > 0 ? Math.min(window.scrollY / total, 1) : 0;
      bar.style.transform = `scaleX(${ratio})`;
    };
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  /* ============ 阅读进度条 ============ */
  .read-progress {
    position: fixed;
    top: 0; left: 0; right: 0;
    height: 3px;
    background: var(--gradient-primary);
    transform-origin: left center;
    transform: scaleX(0);
    z-index: 200;
    pointer-events: none;
  }

  /* ============ 上一篇 / 下一篇 ============ */
  .pn-nav {
    margin-top: 1.25rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .pn-card {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 0.85rem 1.05rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: 0 1px 2px oklch(0% 0 0 / 0.04);
    text-decoration: none !important;
    transition: transform 0.22s ease, box-shadow 0.22s ease, border-color 0.22s ease;
    min-width: 0;
  }
  .pn-card:hover {
    transform: translateY(-3px);
    border-color: oklch(70% 0.14 250 / 0.5);
    box-shadow: 0 12px 28px oklch(62% 0.13 250 / 0.16);
  }
  .pn-card.ghost { visibility: hidden; }
  .pn-card.next { text-align: right; }
  .pn-label {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    font-size: 0.72rem;
    font-weight: 700;
    color: var(--primary-strong);
  }
  [data-theme='dark'] .pn-label { color: var(--primary-light); }
  .pn-card.next .pn-label { justify-content: flex-end; }
  .pn-title {
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--text);
    line-height: 1.45;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ============ 横幅内的文章头 ============ */
  .post-banner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.85rem;
    max-width: 46rem;
  }

  /* 逐层浮现，和首页同款节奏 */
  @keyframes pb-reveal {
    from { opacity: 0; transform: translateY(26px); filter: blur(9px); }
    to   { opacity: 1; transform: translateY(0);    filter: blur(0); }
  }
  .pb-tags  { animation: pb-reveal 1.5s cubic-bezier(.16,1,.3,1) .15s both; }
  .pb-title { animation: pb-reveal 1.8s cubic-bezier(.16,1,.3,1) .35s both; }
  .pb-desc  { animation: pb-reveal 1.8s cubic-bezier(.16,1,.3,1) .6s both; }
  .pb-meta  { animation: pb-reveal 1.8s cubic-bezier(.16,1,.3,1) .85s both; }

  .pb-tags { display: flex; flex-wrap: wrap; gap: 0.4rem; justify-content: center; }
  .pb-tag {
    display: inline-flex; align-items: center; gap: 0.25rem;
    font-size: 0.78rem; padding: 0.25rem 0.75rem;
    border-radius: 999px;
    color: #fff;
    background: oklch(100% 0 0 / 0.18);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid oklch(100% 0 0 / 0.28);
    text-decoration: none !important;
    transition: all 0.2s ease;
  }
  .pb-tag:hover { background: oklch(100% 0 0 / 0.3); transform: translateY(-2px); }

  .pb-title {
    margin: 0;
    font-size: clamp(1.55rem, 3.6vw, 2.5rem);
    font-weight: 800;
    line-height: 1.3;
    color: #fff;
    letter-spacing: 0.01em;
    text-shadow: 0 2px 28px oklch(0% 0 0 / 0.55);
  }

  .pb-desc {
    margin: 0;
    font-size: clamp(0.86rem, 1.4vw, 1rem);
    color: oklch(100% 0 0 / 0.88);
    text-shadow: 0 1px 12px oklch(0% 0 0 / 0.55);
    line-height: 1.7;
  }

  .pb-meta {
    display: flex; flex-wrap: wrap; align-items: center;
    justify-content: center; gap: 0.45rem;
    font-size: 0.82rem;
    color: oklch(100% 0 0 / 0.82);
    text-shadow: 0 1px 10px oklch(0% 0 0 / 0.5);
  }
  .pb-meta-item { display: inline-flex; align-items: center; gap: 0.28rem; }
  .pb-meta-item :global(.icon) { opacity: 0.8; }
  .pb-sep { opacity: 0.45; }

  /* ============ 正文区 ============ */
  /* 去掉右侧目录后：正文单栏，收窄到适合阅读的宽度并在页面居中 */
  .post-layout {
    margin-top: 2rem;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 860px;
    gap: 1.5rem;
    align-items: start;
  }

  .post-body { padding: 1.75rem 2rem; font-size: 1.02rem; }

  .post-foot {
    margin-top: 1.25rem;
    padding: 1.1rem 1.5rem;
    display: flex; flex-wrap: wrap; align-items: center;
    justify-content: space-between; gap: 1rem;
  }
  .foot-tags { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  .foot-label {
    display: inline-flex; align-items: center; gap: 0.25rem;
    font-size: 0.82rem; color: var(--text-faint); margin-right: 0.2rem;
  }
  .tag {
    display: inline-flex; align-items: center; gap: 0.2rem;
    font-size: 0.78rem; padding: 0.18rem 0.65rem;
    border-radius: 999px; background: var(--primary-soft); color: var(--primary-strong);
    text-decoration: none !important;
    transition: all 0.15s ease;
  }
  .tag:hover { transform: translateY(-1px); background: var(--primary); color: var(--text-on-primary); }

  .foot-actions { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }

  /* 分享面板 */
  .share-box { position: relative; }
  .share-panel {
    position: absolute;
    bottom: calc(100% + 0.5rem);
    left: 0;
    min-width: 150px;
    padding: 0.4rem;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow-lg);
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    z-index: 30;
  }
  .share-panel[hidden] { display: none; }
  .share-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.7rem;
    border: none;
    background: transparent;
    border-radius: var(--radius-sm);
    font-size: 0.82rem;
    color: var(--text-soft);
    cursor: pointer;
    text-decoration: none !important;
    transition: all 0.15s ease;
    text-align: left;
    white-space: nowrap;
  }
  .share-item:hover { background: var(--surface-2); color: var(--primary-strong); }
  .share-item :global(.icon) { color: var(--primary); opacity: 0.85; }
  .share-ok { color: var(--primary); font-weight: 700; }
  .foot-btn {
    display: inline-flex; align-items: center; gap: 0.3rem;
    font-size: 0.82rem; padding: 0.35rem 0.85rem;
    border-radius: 999px;
    color: var(--text-soft);
    background: var(--surface-2);
    border: 1px solid var(--border);
    text-decoration: none !important;
    transition: all 0.18s ease;
  }
  .foot-btn:hover {
    color: var(--primary-strong);
    background: var(--primary-soft);
    border-color: var(--primary);
    transform: translateY(-1px);
  }

  .comments-card { margin-top: 1.25rem; padding: 1.5rem; }

  /* ============ Markdown 正文样式 ============ */
  .custom-md :global(h2) {
    font-size: 1.45rem; margin-top: 2rem; padding-bottom: 0.4rem;
    border-bottom: 2px solid; border-image: var(--gradient-primary) 1;
    color: var(--text);
  }
  .custom-md :global(h2:first-child) { margin-top: 0; }
  .custom-md :global(h3) { font-size: 1.2rem; margin-top: 1.5rem; }
  .custom-md :global(p) { margin-bottom: 1em; }

  .custom-md :global(a) {
    color: var(--primary-strong);
    text-decoration: underline;
    text-decoration-style: dashed;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
    padding: 0 1px;
  }
  .custom-md :global(a:hover) { background: var(--primary-soft); text-decoration: none; }

  .custom-md :global(pre) {
    background: #f6f6fa;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1rem 1.2rem;
    overflow-x: auto;
    font-size: 0.86rem;
    line-height: 1.6;
    margin: 1.2em 0;
    box-shadow: var(--shadow-sm);
  }
  [data-theme='dark'] .custom-md :global(pre) { background: #1e1e2e; }
  .custom-md :global(pre code) { background: none; padding: 0; }

  .custom-md :global(:not(pre) > code) {
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 0.3rem;
    padding: 0.08em 0.35em;
    font-size: 0.86em;
    color: var(--primary-strong);
  }

  .custom-md :global(blockquote) {
    margin: 1.2em 0; padding: 0.7em 1.2em;
    border-left: 3px solid; border-image: var(--gradient-primary) 1;
    background: var(--primary-soft);
    border-radius: 0 var(--radius) var(--radius) 0;
    color: var(--text-soft);
  }
  .custom-md :global(blockquote p) { margin: 0; }

  .custom-md :global(table) {
    width: 100%; border-collapse: collapse; margin: 1.2em 0;
    font-size: 0.92rem; border-radius: var(--radius); overflow: hidden;
    box-shadow: var(--shadow-sm);
  }
  .custom-md :global(th), .custom-md :global(td) {
    border: 1px solid var(--border); padding: 0.5rem 0.75rem; text-align: left;
  }
  .custom-md :global(th) { background: var(--surface-2); font-weight: 600; }

  .custom-md :global(img) {
    border-radius: var(--radius-lg); margin: 1.2rem auto; box-shadow: var(--shadow);
  }

  /* ============ 响应式 ============ */
  @media (max-width: 860px) {
    .post-body { padding: 1.8rem 1.4rem; }
    .post-foot { flex-direction: column; align-items: flex-start; gap: 0.8rem; }
    .post-banner { padding-inline: 1rem; }
    .pb-title { font-size: 1.4rem; }
    .pb-meta { font-size: 0.78rem; gap: 0.3rem; }
    .pn-nav { grid-template-columns: 1fr; }
    .pn-card.next { text-align: left; }
    .pn-card.next .pn-label { justify-content: flex-start; }
    .pn-card.ghost { display: none; }
  }
</style>
