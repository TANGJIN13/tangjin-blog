---
// 侧栏搜索：输入即过滤首页文章；支持按 "/" 快速聚焦
import Icon from './Icon.astro';
---

<div class="search-widget">
  <div class="search-input-wrap">
    <Icon name="search" size="0.9rem" />
    <input
      class="search-input"
      id="sw-search-input"
      type="text"
      placeholder="搜索文章..."
      autocomplete="off"
    />
    <kbd class="search-kbd">/</kbd>
  </div>
  <div class="search-results" id="sw-search-results"></div>
</div>

<script>
  // 注意：站点启用了 ClientRouter，换页会替换 DOM；模块脚本只执行一次，
  // 所以这里用 init() + astro:page-load 重新绑定，并且一律用 on* 赋值（幂等）。
  (() => {
    function init() {
      // id 带 sw- 前缀：页面级的 /search 页面也用 search-input 这类通用 id，撞车会互相冲掉内容
      const input = document.getElementById('sw-search-input') as HTMLInputElement | null;
      const results = document.getElementById('sw-search-results');
      if (!input || !results) return;

      // 每次重新抓取当前页面的文章列表（SPA 换页后内容会变）
      const posts = [...document.querySelectorAll('.post-list article, .post-list a')].map((el) => {
        const title = el.querySelector('.post-card-title, .post-title')?.textContent?.trim() || '';
        const link = el.closest('a') || el.querySelector('a');
        const href = link?.getAttribute('href') || '#';
        const desc = el.querySelector('.post-card-desc, .post-desc')?.textContent?.trim() || '';
        return { title, href, desc };
      }).filter((p) => p.title);

      input.oninput = () => {
        const q = input.value.trim().toLowerCase();
        if (!q) { results.innerHTML = ''; results.style.display = 'none'; return; }
        const matches = posts.filter((p) =>
          p.title.toLowerCase().includes(q) || p.desc.toLowerCase().includes(q)
        ).slice(0, 6);

        if (matches.length === 0) {
          results.innerHTML = '<div class="search-empty">没有找到相关文章</div>';
        } else {
          results.innerHTML = matches.map((p) => `
            <a class="search-result-item" href="${p.href}">
              <span class="search-result-title">${p.title}</span>
              ${p.desc ? `<span class="search-result-desc">${p.desc}</span>` : ''}
            </a>
          `).join('');
        }
        results.style.display = 'block';
      };

      // 页面里没有可见的表单时，按 "/" 直接把光标送进搜索框
      document.onkeydown = (e: KeyboardEvent) => {
        if (e.key !== '/' || e.metaKey || e.ctrlKey || e.altKey) return;
        const tag = (document.activeElement?.tagName || '').toUpperCase();
        if (tag === 'INPUT' || tag === 'TEXTAREA' || (document.activeElement as HTMLElement)?.isContentEditable) return;
        e.preventDefault();
        input.focus();
      };
    }

    // 点击外部收起（绑在 document 上，只需一次）
    document.addEventListener('click', (e) => {
      const results = document.getElementById('sw-search-results');
      if (results && !(e.target as HTMLElement).closest('.search-widget')) {
        results.style.display = 'none';
      }
    });

    init();
    document.addEventListener('astro:page-load', init);
  })();
</script>

<style>
  .search-widget { position: relative; }
  .search-input-wrap {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.55rem 0.5rem 0.8rem;
    border-radius: var(--radius);
    /* 输入框是「玻璃上凿出来的一道凹槽」：半透明 + 内阴影，
       不要用不透明的 --surface-2，否则毛玻璃卡上会贴出一块实心白补丁 */
    background: color-mix(in srgb, var(--surface-2) 55%, transparent);
    border: 1px solid var(--glass-hairline);
    box-shadow: inset 0 1px 3px oklch(0% 0 0 / 0.05), inset 0 1px 0 oklch(100% 0 0 / 0.5);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }
  .search-input-wrap:focus-within {
    border-color: var(--primary);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    box-shadow: 0 0 0 3px var(--primary-soft), inset 0 1px 3px oklch(0% 0 0 / 0.04);
  }
  .search-input-wrap :global(.icon) { color: var(--text-faint); flex-shrink: 0; transition: color 0.2s ease; }
  .search-input-wrap:focus-within :global(.icon) { color: var(--primary); }
  .search-input {
    flex: 1;
    min-width: 0;
    border: none;
    background: transparent;
    color: var(--text);
    font-size: 0.85rem;
    outline: none;
  }
  .search-input::placeholder { color: var(--text-faint); }
  /* 快捷键提示：聚焦后淡出，不挡视线 */
  .search-kbd {
    flex-shrink: 0;
    font-family: inherit;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.22rem 0.4rem;
    border-radius: 0.35rem;
    color: var(--text-faint);
    background: var(--surface);
    border: 1px solid var(--border-light);
    box-shadow: 0 1px 0 var(--border);
    transition: opacity 0.2s ease;
  }
  .search-input-wrap:focus-within .search-kbd { opacity: 0; }

  .search-results {
    display: none;
    position: absolute;
    top: calc(100% + 6px);
    left: 0;
    right: 0;
    z-index: 10;
    padding: 0.25rem;
    /* 下拉浮层：比卡片更实一档（保证可读性），但仍留一点透明 + 背景模糊，
       这样它像「另一块玻璃叠在上面」而不是一张硬纸片 */
    background: color-mix(in srgb, var(--surface) 86%, transparent);
    backdrop-filter: var(--glass-blur);
    border: 1px solid var(--glass-edge);
    border-radius: var(--radius-md);
    box-shadow:
      inset 0 1px 0 0 var(--glass-edge),
      0 0 0 1px var(--glass-hairline),
      0 16px 40px oklch(45% 0.07 300 / 0.18);
    max-height: 280px;
    overflow-y: auto;
  }
  .search-result-item {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius-sm);
    text-decoration: none !important;
    transition: background 0.12s ease;
  }
  .search-result-item:hover { background: var(--primary-soft); }
  .search-result-title {
    font-size: 0.83rem;
    font-weight: 600;
    color: var(--text);
  }
  .search-result-item:hover .search-result-title { color: var(--primary-strong); }
  :global([data-theme='dark'] .search-result-item:hover .search-result-title) { color: var(--primary-light); }
  .search-result-desc {
    font-size: 0.73rem;
    color: var(--text-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .search-empty {
    padding: 0.8rem;
    text-align: center;
    font-size: 0.82rem;
    color: var(--text-faint);
  }
  :global([data-theme='dark'] .search-results) {
    background: oklch(20% 0.025 300 / 0.86);
    border-color: var(--glass-edge);
  }
</style>
