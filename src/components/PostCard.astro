---
import { formatDateTime, readingTime, type Post } from '../lib/posts';
import { categories } from '../data/categories';

interface Props {
  post: Post;
  style?: string;
}

const { post, style } = Astro.props;
const { title, description, published, updated, tags, cover, category, pinned } = post.data;
const minutes = readingTime(post.body);
const showUpdated = updated && updated > published;

const cat = categories.find((c) => c.slug === (category ?? '')) ?? categories.find((c) => c.name === tags?.[0]);
const shownTags = tags.slice(0, 3);
const moreTagCount = tags.length - shownTags.length;

// 摘要：优先用 frontmatter 的 description；没写就从正文提取纯文本兜底
const plainBody = post.body
  .replace(/!?\[\[([^\]|]*)(?:\|([^\]]*))?\]\]/g, '$1')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/^\s{0,3}>\s?/gm, '')
  .replace(/^\s{0,3}#+\s+/gm, '')
  .replace(/[*_~`]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const excerpt = (description ?? '').trim() || plainBody.slice(0, 120);
---

<article class="post-card" {style}>
  {cover && (
    <a class="post-card-thumb" href={`/posts/${post.id}/`} tabindex="-1" aria-hidden="true">
      <img src={cover} alt="" loading="lazy" />
    </a>
  )}

  <div class="post-card-body">
    <div class="post-card-meta">
      {pinned && <span class="post-card-flag">置顶</span>}
      <time datetime={published.toISOString()}>{formatDateTime(published)}</time>
      {cat && (
        <>
          <span class="dot">·</span>
          <a class="meta-cat" href={`/search/?cat=${cat.slug}`}>{cat.name}</a>
        </>
      )}
      {showUpdated && (
        <>
          <span class="dot">·</span>
          <span class="meta-soft">更新于 <time datetime={updated.toISOString()}>{formatDateTime(updated)}</time></span>
        </>
      )}
      <span class="dot">·</span>
      <span class="meta-soft">约 {minutes} 分钟</span>
    </div>

    <a class="post-card-title" href={`/posts/${post.id}/`}>{title}</a>

    {excerpt && <p class="post-card-desc">{excerpt}</p>}

    <div class="post-card-tags">
      {shownTags.map((t) => (
        <a class="tag" href={`/search/?q=${encodeURIComponent(t)}`}>#{t}</a>
      ))}
      {moreTagCount > 0 && <span class="tag tag-more">+{moreTagCount}</span>}
    </div>
  </div>
</article>

<style>
  /* 极简文章卡：单层圆角白底，细发丝线边框，悬停只换边框色。
     不用 .glass-card：毛玻璃在这里只会让「一列文章」变成一列闪亮的玻璃块，
     既不耐看又会和其他玻璃组件（侧栏卡、浮动按钮）撞风格。
     封面缩略图：只有 post.data.cover 存在时才显示，没写的文章就是纯文本卡。 */
  .post-card {
    display: flex;
    align-items: stretch;
    gap: 0.95rem;
    padding: 1rem 1.05rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: border-color 0.18s ease, background-color 0.18s ease;
  }
  .post-card:hover {
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary) 3%, var(--surface));
  }

  /* ===== 封面缩略图（可选，1:1 方形）=====
     没写 cover 的文章 → .post-card-thumb 不渲染，整个 body 区域会占满宽度。 */
  .post-card-thumb {
    flex-shrink: 0;
    width: 80px;
    height: 80px;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--surface-2);
  }
  .post-card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-card-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
  }

  /* ===== 元信息：单行小字（日期 · 分类 · 时长），不是彩色药丸 ===== */
  .post-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.32rem;
    font-size: 0.74rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .post-card-meta .dot { opacity: 0.5; }
  .post-card-meta a.meta-cat {
    color: var(--primary);
    text-decoration: none;
  }
  .post-card-meta a.meta-cat:hover { text-decoration: underline; }
  .post-card-meta .meta-soft { color: var(--text-faint); }
  .post-card-flag {
    display: inline-block;
    padding: 0 0.42rem;
    border-radius: 4px;
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--text-on-primary);
    background: var(--gradient-primary);
  }

  /* ===== 标题：单行省略，hover 走主色 ===== */
  .post-card-title {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 700;
    line-height: 1.45;
    color: var(--text);
    text-decoration: none !important;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.18s ease;
  }
  .post-card:hover .post-card-title { color: var(--primary); }

  /* ===== 摘要：两行省略 ===== */
  .post-card-desc {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== 标签：行内 #tag，悬停主色 ===== */
  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.1rem;
  }
  .tag {
    font-size: 0.74rem;
    color: var(--text-faint);
    text-decoration: none !important;
    transition: color 0.18s ease;
  }
  .tag:hover { color: var(--primary); }
  .tag.tag-more { color: var(--text-faint); opacity: 0.65; cursor: default; }

  /* 窄屏：缩略图略小，元信息更紧凑 */
  @media (max-width: 560px) {
    .post-card { gap: 0.7rem; padding: 0.85rem 0.9rem; }
    .post-card-thumb { width: 64px; height: 64px; }
    .post-card-title { font-size: 0.96rem; }
  }
</style>
