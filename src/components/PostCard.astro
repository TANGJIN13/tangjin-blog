---
import { formatDateTime, readingTime, type Post } from '../lib/posts';
import { categories } from '../data/categories';
import Icon from './Icon.astro';

interface Props {
  post: Post;
  style?: string;
}

const { post, style } = Astro.props;
const { title, description, published, updated, tags, cover, category, pinned } = post.data;
const coverSrc = cover ?? null;
const minutes = readingTime(post.body);
const showUpdated = updated && updated > published;

// 分类（frontmatter 里的 category 是 slug，取不到就按第一个标签兜底）
const catSlug = category ?? '';
const cat = categories.find((c) => c.slug === catSlug) ?? categories.find((c) => c.name === tags?.[0]);

// 标签展示：最多 4 个，多的显示「+N」
const shownTags = tags.slice(0, 4);
const moreTagCount = tags.length - shownTags.length;

// 占位封面：按文章 id 稳定选一组双色调（半透明色叠加在 surface-2 上，亮/暗主题都自适应）
const tints = [
  ['oklch(70% 0.15 250 / 0.34)', 'oklch(62% 0.17 265 / 0.22)'],
  ['oklch(72% 0.13 200 / 0.34)', 'oklch(64% 0.15 230 / 0.22)'],
  ['oklch(74% 0.13 300 / 0.32)', 'oklch(66% 0.16 330 / 0.22)'],
  ['oklch(74% 0.13 160 / 0.32)', 'oklch(66% 0.15 190 / 0.22)'],
  ['oklch(76% 0.14 80 / 0.32)', 'oklch(68% 0.15 110 / 0.22)'],
  ['oklch(74% 0.14 20 / 0.32)', 'oklch(66% 0.16 50 / 0.22)'],
];
const hash = post.id.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
const [tintA, tintB] = tints[hash % tints.length];
const phStyle = `--ph-a: ${tintA}; --ph-b: ${tintB}`;
---

<article class="post-card onload-animation" {style}>
  <!-- 封面：置顶，16:9（无封面时用跟随主题的低饱和占位色 + 分类图标） -->
  <a class="post-card-cover" href={`/posts/${post.id}/`} tabindex="-1" aria-hidden="true">
    {coverSrc ? (
      <img src={coverSrc} alt="" loading="lazy" />
    ) : (
      <div class="cover-placeholder" style={phStyle}>
        <span class="cover-ph-mark"><Icon name={cat?.icon || 'article'} size="6.5rem" /></span>
        <span class="cover-ph-icon"><Icon name={cat?.icon || 'article'} size="1.5rem" /></span>
      </div>
    )}
    <span class="cover-shine" aria-hidden="true"></span>
    {pinned && (
      <span class="cover-flag"><Icon name="flag" size="0.68rem" />置顶</span>
    )}
  </a>

  <!-- 正文：标题 → 图标小标签 → 摘要 → #标签 -->
  <div class="post-card-body">
    <a class="post-card-title" href={`/posts/${post.id}/`}>{title}</a>

    <div class="card-meta">
      <span class="meta-chip">
        <Icon name="calendar" size="0.72rem" /><time datetime={published.toISOString()}>{formatDateTime(published)}</time>
      </span>
      {cat && (
        <a class="meta-chip is-link" href={`/categories/${cat.slug}/`}>
          <Icon name={cat.icon || 'folder'} size="0.72rem" />{cat.name}
        </a>
      )}
      {showUpdated && (
        <span class="meta-chip is-soft">
          <Icon name="repeat" size="0.72rem" />更新于 <time datetime={updated.toISOString()}>{formatDateTime(updated)}</time>
        </span>
      )}
      <span class="meta-chip is-soft"><Icon name="clock" size="0.72rem" />约 {minutes} 分钟</span>
    </div>

    {description && <p class="post-card-desc">{description}</p>}

    <div class="card-foot">
      {shownTags.map((t) => (
        <a class="tag-chip" href={`/search/?q=${encodeURIComponent(t)}`}>#{t}</a>
      ))}
      {moreTagCount > 0 && <span class="tag-chip is-more">+{moreTagCount}</span>}
      <span class="card-cta">阅读全文<span class="cta-arrow">→</span></span>
    </div>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: 0 1px 2px oklch(0% 0 0 / 0.04), 0 6px 18px oklch(0% 0 0 / 0.05);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.28s ease, border-color 0.28s ease;
  }
  [data-theme='dark'] .post-card {
    box-shadow: 0 1px 2px oklch(0% 0 0 / 0.25), 0 6px 18px oklch(0% 0 0 / 0.28);
  }
  .post-card:hover {
    transform: translateY(-4px);
    border-color: oklch(70% 0.14 250 / 0.5);
    box-shadow: 0 2px 6px oklch(0% 0 0 / 0.06), 0 18px 38px oklch(62% 0.13 250 / 0.18);
  }
  [data-theme='dark'] .post-card:hover {
    box-shadow: 0 2px 6px oklch(0% 0 0 / 0.3), 0 18px 38px oklch(0% 0 0 / 0.5);
  }

  /* ===== 封面：顶部通栏 16:9 ===== */
  .post-card-cover {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--surface-2);
    text-decoration: none !important;
  }
  .post-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .post-card:hover .post-card-cover img { transform: scale(1.06); }

  .cover-placeholder {
    position: relative;
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
      radial-gradient(ellipse 95% 130% at 88% -12%, var(--ph-a), transparent 62%),
      radial-gradient(ellipse 90% 125% at 4% 110%, var(--ph-b), transparent 62%),
      var(--surface-2);
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .post-card:hover .cover-placeholder { transform: scale(1.06); }

  /* 网格纹理：中心清晰、四周径向淡出，填补大片空白 */
  .cover-placeholder::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(oklch(45% 0.14 250 / 0.10) 1px, transparent 1px),
      linear-gradient(90deg, oklch(45% 0.14 250 / 0.10) 1px, transparent 1px);
    background-size: 30px 30px;
    mask-image: radial-gradient(ellipse 78% 80% at 50% 45%, #000 18%, transparent 74%);
    -webkit-mask-image: radial-gradient(ellipse 78% 80% at 50% 45%, #000 18%, transparent 74%);
  }
  [data-theme='dark'] .cover-placeholder::before {
    background-image:
      linear-gradient(oklch(85% 0.10 250 / 0.12) 1px, transparent 1px),
      linear-gradient(90deg, oklch(85% 0.10 250 / 0.12) 1px, transparent 1px);
  }

  /* 右下角超大幽灵图标（很低的存在感，但把角落填满） */
  .cover-ph-mark {
    position: absolute;
    right: -16px;
    bottom: -20px;
    color: oklch(50% 0.12 250 / 0.10);
    transform: rotate(-8deg);
    transition: transform 0.6s cubic-bezier(0.4, 0, 0.2, 1), color 0.3s ease;
  }
  .cover-ph-mark :global(.icon) { display: block; }
  [data-theme='dark'] .cover-ph-mark { color: oklch(88% 0.10 250 / 0.10); }
  .post-card:hover .cover-ph-mark { transform: rotate(0deg) scale(1.06); color: oklch(50% 0.12 250 / 0.16); }

  /* 居中图标徽章：更大、更立体，悬停回正 */
  .cover-ph-icon {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 54px;
    height: 54px;
    border-radius: 15px;
    color: var(--primary-strong);
    background: var(--surface);
    border: 1px solid oklch(70% 0.14 250 / 0.35);
    box-shadow: 0 10px 26px oklch(45% 0.14 250 / 0.22), 0 2px 6px oklch(0% 0 0 / 0.06);
    transform: rotate(-4deg);
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.3s ease;
  }
  [data-theme='dark'] .cover-ph-icon { color: var(--primary-light); }
  .post-card:hover .cover-ph-icon {
    transform: rotate(0deg) scale(1.08);
    box-shadow: 0 14px 32px oklch(45% 0.14 250 / 0.30), 0 2px 6px oklch(0% 0 0 / 0.08);
  }

  /* 封面上的斜向光泽扫过 */
  .cover-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, oklch(100% 0 0 / 0.28) 50%, transparent 65%);
    transform: translateX(-120%);
    transition: transform 0.7s ease;
    pointer-events: none;
  }
  .post-card:hover .cover-shine { transform: translateX(120%); }

  /* 封面左上角置顶小徽章 */
  .cover-flag {
    position: absolute;
    top: 0.6rem;
    left: 0.6rem;
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    padding: 0.18rem 0.55rem;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 700;
    color: var(--text-on-primary);
    background: var(--gradient-primary);
    box-shadow: 0 3px 12px oklch(0% 0 0 / 0.28);
  }

  .post-card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    flex: 1;
    padding: 0.95rem 1rem 1rem;
  }

  .post-card-title {
    font-size: 1.05rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--text);
    text-decoration: none !important;
    transition: color 0.18s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-card:hover .post-card-title { color: var(--primary) !important; }

  /* ===== 元信息小标签（图标 + 文字，带浅色底） ===== */
  .card-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }
  .meta-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    padding: 0.22rem 0.55rem;
    border-radius: 8px;
    font-size: 0.72rem;
    font-weight: 600;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
    text-decoration: none !important;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border: 1px solid oklch(70% 0.14 250 / 0.22);
    transition: all 0.18s ease;
  }
  [data-theme='dark'] .meta-chip { color: var(--primary-light); }
  .meta-chip :global(.icon) { opacity: 0.85; flex-shrink: 0; }
  /* 次要信息（更新于 / 时长）：灰底，弱化 */
  .meta-chip.is-soft {
    color: var(--text-faint);
    background: var(--surface-2);
    border-color: var(--border-light);
  }
  .meta-chip.is-link:hover {
    color: var(--text-on-primary);
    background: var(--gradient-primary);
    border-color: transparent;
  }
  .meta-chip.is-link:hover :global(.icon) { opacity: 1; }

  .post-card-desc {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.84rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* ===== 底部：#标签 + 阅读 CTA（贴底对齐） ===== */
  .card-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem;
    margin-top: auto;
    padding-top: 0.15rem;
  }
  .card-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    margin-left: auto;
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--primary);
    white-space: nowrap;
    transition: gap 0.22s ease;
  }
  .cta-arrow { transition: transform 0.22s ease; }
  .post-card:hover .card-cta { gap: 0.4rem; }
  .post-card:hover .card-cta .cta-arrow { transform: translateX(2px); }
  .tag-chip {
    display: inline-flex;
    align-items: center;
    padding: 0.16rem 0.55rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-faint);
    background: var(--surface-2);
    border: 1px solid var(--border-light);
    text-decoration: none !important;
    transition: all 0.18s ease;
  }
  .tag-chip:hover {
    color: var(--text-on-primary);
    background: var(--gradient-primary);
    border-color: transparent;
  }
  .tag-chip.is-more { cursor: default; }
</style>
