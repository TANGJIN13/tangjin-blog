---
import { formatDate, type Post } from '../lib/posts';
import Icon from './Icon.astro';

interface Props {
  post: Post;
  style?: string;
}

const { post, style } = Astro.props;
const { title, description, published, tags, cover } = post.data;
const coverSrc = cover ?? null;

// 随机渐变封面
const gradients = [
  'linear-gradient(135deg, #667eea 0%, #764ba2 100%)',
  'linear-gradient(135deg, #f093fb 0%, #f5576c 100%)',
  'linear-gradient(135deg, #4facfe 0%, #00f2fe 100%)',
  'linear-gradient(135deg, #43e97b 0%, #38f9d7 100%)',
  'linear-gradient(135deg, #fa709a 0%, #fee140 100%)',
  'linear-gradient(135deg, #a18cd1 0%, #fbc2eb 100%)',
];
const hash = post.id.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
const randomGradient = gradients[hash % gradients.length];
---

<article class="post-card onload-animation" {style}>
  <div class="post-card-inner">
    <!-- 内容 -->
    <div class="post-card-content">
      <a class="post-card-title" href={`/posts/${post.id}/`}>{title}</a>

      <div class="post-meta">
        <span class="meta-item">
          <Icon name="calendar" size="0.95rem" />
          <time datetime={published.toISOString()}>{formatDate(published)}</time>
        </span>
        {tags.length > 0 && (
          <span class="meta-item">
            <Icon name="tag" size="0.95rem" />
            {tags[0]}
          </span>
        )}
      </div>

      <p class="post-card-desc">{description}</p>

      {tags.length > 0 && (
        <div class="post-card-tags">
          {tags.map((t) => <span class="tag">#{t}</span>)}
        </div>
      )}
    </div>

    <!-- 封面 -->
    <a class="post-card-cover" href={`/posts/${post.id}/`}>
      {coverSrc ? (
        <img src={coverSrc} alt="" loading="lazy" />
      ) : (
        <div class="cover-placeholder" style={`background: ${randomGradient}`}>
          <Icon name="text" size="1.7rem" />
        </div>
      )}
    </a>
  </div>
</article>

<style>
  .post-card {
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
    transition: border-color 0.2s ease;
  }
  .post-card:hover { border-color: var(--primary); }

  .post-card-inner {
    display: flex;
    flex-direction: column-reverse;
  }

  @media (min-width: 768px) {
    .post-card-inner { flex-direction: row; align-items: stretch; }
  }

  .post-card-content {
    flex: 1;
    padding: 1rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .post-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    color: var(--text);
    text-decoration: none !important;
    transition: color 0.15s ease;
    position: relative;
    padding-left: 0.75rem;
  }
  .post-card-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%);
    width: 3px;
    height: 1.1rem;
    border-radius: 2px;
    background: var(--primary);
    opacity: 0;
    transition: opacity 0.15s ease;
  }
  .post-card:hover .post-card-title::before { opacity: 1; }
  .post-card-title:hover { color: var(--primary) !important; }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    font-size: 0.78rem;
    color: var(--text-faint);
  }
  .meta-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }
  .meta-item :global(.icon) { opacity: 0.7; }

  .post-card-desc {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.88rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    margin-top: auto;
  }
  .tag {
    font-size: 0.68rem;
    padding: 0.1rem 0.45rem;
    border-radius: 999px;
    background: oklch(93% 0.01 250);
    color: var(--text-faint);
  }
  .post-card:hover .tag { background: var(--primary-soft); color: var(--primary); }

  .post-card-cover {
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    flex-shrink: 0;
    text-decoration: none !important;
  }

  @media (min-width: 768px) {
    .post-card-cover {
      width: 28%;
      aspect-ratio: auto;
      min-height: 130px;
    }
  }

  .post-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .post-card:hover .post-card-cover img { transform: scale(1.05); }

  .cover-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: oklch(100% 0 0 / 0.85);
  }
</style>
