---
import { formatDate, formatDateTime, readingTime, type Post } from '../lib/posts';
import { categories } from '../data/categories';
import Icon from './Icon.astro';

interface Props {
  post: Post;
  style?: string;
}

const { post, style } = Astro.props;
const { title, description, published, updated, tags, cover, category, pinned } = post.data;
const coverSrc = cover ?? null;
const minutes = readingTime(post.body);
const showUpdated = updated && updated > published;

// 分类（frontmatter 里的 category 是 slug，取不到就按第一个标签兜底）
const catSlug = category ?? '';
const cat = categories.find((c) => c.slug === catSlug) ?? categories.find((c) => c.name === tags?.[0]);

// 占位封面：按文章 id 稳定选一种低饱和色调（半透明色叠加在 surface-2 上，亮/暗主题都自适应）
const tints = [
  'oklch(62% 0.14 250 / 0.16), oklch(55% 0.17 265 / 0.10)',
  'oklch(62% 0.13 200 / 0.16), oklch(55% 0.15 230 / 0.10)',
  'oklch(65% 0.12 300 / 0.14), oklch(58% 0.15 330 / 0.10)',
  'oklch(64% 0.12 160 / 0.14), oklch(58% 0.14 190 / 0.10)',
  'oklch(66% 0.13 80 / 0.14), oklch(60% 0.14 110 / 0.10)',
  'oklch(64% 0.13 20 / 0.14), oklch(58% 0.15 50 / 0.10)',
];
const hash = post.id.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
const randomGradient = `radial-gradient(ellipse 120% 140% at 80% 0%, ${tints[hash % tints.length]}), var(--surface-2)`;
---

<article class="post-card onload-animation" {style}>
  <div class="post-card-inner">
    <!-- 内容 -->
    <div class="post-card-content">
      <div class="card-top-row">
        {pinned && (
          <span class="pin-badge" title="置顶"><Icon name="flag" size="0.78rem" />置顶</span>
        )}
        {cat && (
          <a class="cat-badge" href={`/categories/${cat.slug}/`}>
            <Icon name={cat.icon || 'folder'} size="0.8rem" />{cat.name}
          </a>
        )}
        <span class="card-date" title="发表于">
          <Icon name="calendar" size="0.82rem" />
          <time datetime={published.toISOString()}>发表于 {formatDateTime(published)}</time>
        </span>
      </div>

      <a class="post-card-title" href={`/posts/${post.id}/`}>{title}</a>

      <p class="post-card-desc">{description}</p>

      <div class="card-bottom-row">
        {tags.length > 0 && (
          <div class="post-card-tags">
            {tags.slice(0, 3).map((t) => <span class="tag">#{t}</span>)}
          </div>
        )}
        <span class="read-meta">
          <Icon name="clock" size="0.8rem" />{minutes} 分钟
        </span>
        <span class="read-more">
          阅读全文
          <svg class="arrow" viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="M13.2 5l-1.4 1.4 5.6 5.6-5.6 5.6 1.4 1.4 7-7z" /><path d="M4 11h9v2H4z" /></svg>
        </span>
      </div>

      {showUpdated && (
        <div class="card-updated">
          <Icon name="repeat" size="0.78rem" />
          <time datetime={updated.toISOString()}>更新于 {formatDateTime(updated)}</time>
        </div>
      )}
    </div>

    <!-- 封面 -->
    <a class="post-card-cover" href={`/posts/${post.id}/`}>
      {coverSrc ? (
        <img src={coverSrc} alt="" loading="lazy" />
      ) : (
        <div class="cover-placeholder" style={`background: ${randomGradient}`}>
          <Icon name="text" size="1.7rem" />
        </div>
      )}
      <span class="cover-shine" aria-hidden="true"></span>
    </a>
  </div>
</article>

<style>
  .post-card {
    position: relative;
    border-radius: var(--radius-xl);
    overflow: hidden;
    border: 1px solid var(--border);
    background: var(--surface);
    box-shadow: 0 1px 2px oklch(0% 0 0 / 0.04), 0 6px 18px oklch(0% 0 0 / 0.05);
    transition: transform 0.28s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.28s ease, border-color 0.28s ease;
  }
  [data-theme='dark'] .post-card {
    box-shadow: 0 1px 2px oklch(0% 0 0 / 0.25), 0 6px 18px oklch(0% 0 0 / 0.28);
  }
  .post-card:hover {
    transform: translateY(-4px);
    border-color: oklch(70% 0.14 250 / 0.5);
    box-shadow: 0 2px 6px oklch(0% 0 0 / 0.06), 0 18px 38px oklch(62% 0.13 250 / 0.18);
  }
  [data-theme='dark'] .post-card:hover {
    box-shadow: 0 2px 6px oklch(0% 0 0 / 0.3), 0 18px 38px oklch(0% 0 0 / 0.5);
  }
  /* 悬停时左侧亮起一条主色高光 */
  .post-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0; bottom: 0;
    width: 3px;
    background: var(--gradient-primary);
    transform: scaleY(0);
    transform-origin: center;
    transition: transform 0.28s ease;
    z-index: 2;
  }
  .post-card:hover::before { transform: scaleY(1); }

  .post-card-inner {
    display: flex;
    flex-direction: column-reverse;
  }

  @media (min-width: 768px) {
    .post-card-inner { flex-direction: row; align-items: stretch; }
  }

  .post-card-content {
    flex: 1;
    padding: 0.9rem 1.15rem 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .card-top-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.1rem;
  }

  .cat-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.14rem 0.5rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--primary-strong);
    background: var(--primary-soft);
    border: 1px solid oklch(70% 0.14 250 / 0.28);
    text-decoration: none !important;
    transition: all 0.18s ease;
  }
  .cat-badge:hover {
    background: var(--gradient-primary);
    color: var(--text-on-primary);
    border-color: transparent;
  }
  [data-theme='dark'] .cat-badge { color: var(--primary-light); }

  .card-date {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    font-size: 0.72rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .card-date :global(.icon) { opacity: 0.65; }

  .post-card-title {
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text);
    text-decoration: none !important;
    transition: color 0.18s ease;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-card:hover .post-card-title { color: var(--primary) !important; }

  .post-card-desc {
    margin: 0;
    color: var(--text-soft);
    font-size: 0.86rem;
    line-height: 1.65;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex: 1;
  }

  .card-bottom-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: auto;
    padding-top: 0.15rem;
  }

  .post-card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    flex: 1;
    min-width: 0;
  }
  .tag {
    font-size: 0.68rem;
    padding: 0.12rem 0.5rem;
    border-radius: 999px;
    background: var(--surface-2);
    border: 1px solid var(--border-light);
    color: var(--text-faint);
    transition: all 0.18s ease;
  }
  .post-card:hover .tag {
    background: var(--primary-soft);
    border-color: oklch(70% 0.14 250 / 0.25);
    color: var(--primary-strong);
  }
  [data-theme='dark'] .post-card:hover .tag { color: var(--primary-light); }

  .read-more {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--primary);
    opacity: 0;
    transform: translateX(-4px);
    transition: all 0.25s ease;
  }
  .post-card:hover .read-more { opacity: 1; transform: translateX(0); }
  .arrow { flex-shrink: 0; }

  /* 置顶徽章：主色渐变小标 */
  .pin-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding: 0.14rem 0.5rem;
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    color: var(--text-on-primary);
    background: var(--gradient-primary);
    box-shadow: 0 2px 8px oklch(62% 0.14 250 / 0.22);
    flex-shrink: 0;
  }

  /* 阅读时长：卡片底部右侧小字 */
  .read-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    font-size: 0.7rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
    margin-left: auto;
  }
  .read-meta :global(.icon) { opacity: 0.6; }

  /* 更新于：标题下方一行浅色小字 */
  .card-updated {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    margin-top: 0.1rem;
    font-size: 0.72rem;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }
  .card-updated :global(.icon) { opacity: 0.6; color: var(--primary-strong); }
  [data-theme='dark'] .card-updated :global(.icon) { color: var(--primary-light); }

  .post-card-cover {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 2 / 1;
    overflow: hidden;
    flex-shrink: 0;
    text-decoration: none !important;
  }

  @media (min-width: 768px) {
    .post-card-cover {
      width: 28%;
      aspect-ratio: auto;
      min-height: 140px;
    }
  }

  .post-card-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .post-card:hover .post-card-cover img { transform: scale(1.07); }

  .cover-placeholder {
    width: 100%;
    height: 100%;
    display: grid;
    place-items: center;
    color: var(--primary-strong);
    transition: transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  [data-theme='dark'] .cover-placeholder { color: var(--primary-light); }
  .post-card:hover .cover-placeholder { transform: scale(1.07); }

  /* 封面上的斜向光泽扫过 */
  .cover-shine {
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 35%, oklch(100% 0 0 / 0.28) 50%, transparent 65%);
    transform: translateX(-120%);
    transition: transform 0.7s ease;
    pointer-events: none;
  }
  .post-card:hover .cover-shine { transform: translateX(120%); }

  @media (max-width: 767px) {
    .read-more { opacity: 1; transform: none; }
  }
</style>
