---
// 入站动画 —— 「水墨开卷」
//
// 一条完整的时间轴，约 3.4s，四段：
//   ①  0.00s 墨滴落纸：一滴墨从正中落下，在宣纸上晕开（canvas 粒子 + 纸纹）
//   ②  0.35s 游丝走笔：墨丝沿标题字形游走，把轮廓「描」出来
//   ③  0.35s 落笔成题：站点名按笔顺自左向右写实，下方小字与细线依次浮出
//   ④  2.30s 卷帘上掀：整幕向上卷起，主页随之「推近 → 回落」，完成镜头交接
//
// 为什么用 canvas 而不是纯 CSS：
//   纯 CSS 做不到「墨滴在随机方向游走」「纸纹颗粒」这类有机形态；
//   而逐帧对齐也更容易——canvas 里 rAF 自己掌握时间轴，不存在 CSS 交错延迟算错帧的问题。
//
// 设计约束（每一条都踩过坑）：
//   · 只在**硬加载**播一次；SPA 软导航（ClientRouter）换页不重播 —— sessionStorage 记标记
//   · 尊重 prefers-reduced-motion：直接跳过，不做任何遮挡
//   · 幕布在 HTML 里就是完整一屏（100dvh），不靠 CSS 动画撑开，避免首帧露缝
//   · 播放期间锁滚动；结束 remove()，不留 DOM / rAF 残留
//   · 点击 / Esc / Enter 可随时跳过
import { site } from '../site';

const title = site.title;
// 幕布上的句子：取站点箴言第一句（就是首页壁纸上那套书法句子），
// 句尾不带标点 —— 落笔成题要的是「一句题词」，不是一句文案。
const motto = site.mottos[0]?.text ?? '';

// ⚠️ 为什么这段 CSS 不写在下面 <style> 里：
//    Astro 会把 <style> 打包成**外链** CSS 文件，而上面 Base.astro 里那段「抢首帧」的
//    内联脚本走的是同步路径 —— 内联脚本执行时外链 CSS 还没下载解析完，
//    html.intro-pending 那一刻命中的是「没有任何样式」的裸 HTML，于是会先画一帧白底 +
//    没有定位的裸文字，再被样式追上。表现就是「闪一下白」。所以这里把**首帧必需**的
//    几条规则（幕布底色 / 铺满 / 盖住一切 / 藏住标题）作为 style 内联输出，
//    先于任何渲染生效；其余非首帧关键的规则继续留在 <style> 里。
const criticalCss = `
.intro-curtain{position:fixed;inset:0;z-index:9999;display:grid;place-items:center;overflow:hidden;cursor:pointer;background:var(--bg)}
.ic-paper{position:absolute;inset:0;display:block;width:100%;height:100%}
.ic-stage{position:relative;display:flex;flex-direction:column;align-items:center;gap:1.1rem;padding-inline:1.5rem;text-align:center;transform:translateY(-2vh);min-height:9rem;justify-content:center}
/* 标题底：只留极淡的「字痕」（6% 墨色 + 0.8px 细描边）。
   之前这里是 42%、1.5px —— 结果整块画面上是一个空心灰字，观感像「字没加载出来」，非常廉价。
   真实的落笔不是先画空壳再填色，而是墨随笔走：骨架要近乎看不见，让实心字本身成为唯一主体。 */
.ic-title{position:relative;margin:0;font-family:var(--font-display);font-size:clamp(2.5rem,8.6vw,5.6rem);font-weight:600;letter-spacing:-.02em;line-height:1.12;color:transparent;-webkit-text-stroke:.8px color-mix(in srgb,var(--text) 7%,transparent);white-space:nowrap}
.ic-title::after,
.ic-title::before{pointer-events:none}
.ic-veil{position:absolute;inset:0;background:transparent;pointer-events:none;border-radius:0}
.ic-title::after{content:attr(data-text);position:absolute;inset:0;background:var(--gradient-primary);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent;-webkit-text-stroke:0;clip-path:inset(0 100% 0 0);filter:drop-shadow(0 2px 10px color-mix(in srgb,var(--primary) 26%,transparent))}
.ic-title::before{content:'';position:absolute;top:-9%;bottom:-9%;left:0;width:2px;background:linear-gradient(180deg,transparent,var(--primary),transparent);opacity:0}
`;
---

<div id="intro-curtain" class="intro-curtain" role="presentation">
  <style is:inline set:html={criticalCss}></style>
  <!-- 纸面：极淡的纸纹 + 中心柔光，整个动画的底 -->
  <canvas class="ic-paper" aria-hidden="true"></canvas>

  <!-- 舞台：标题 / 小字 / 细线，用 CSS 做「书写」 -->
  <div class="ic-stage">
    <h1 class="ic-title" data-text={title}>{title}</h1>
    {motto && <p class="ic-sub">{motto}</p>}
    <span class="ic-line" aria-hidden="true"></span>
  </div>

  <!-- 卷帘：动画最后向上掀起的那一整块。
       ⚠️ 关键：它必须**透明**。它盖在 canvas 之上（canvas 没有 z-index，
       而它是后来者、又带 position，所以天然压在 canvas 上面），
       如果给它不透明底色，墨滴和游丝就被整块糊掉了 —— 表现为「每帧都在画但什么都看不见」。
       幕布的整体底色交给 .intro-curtain 自己，卷帘只负责最后那一刻的位移。 -->
  <div class="ic-veil" aria-hidden="true"></div>

  <span class="ic-skip">点击任意处跳过</span>
</div>

<script is:inline>
  (function () {
    var KEY = 'intro-played';
    var el = document.getElementById('intro-curtain');
    if (!el) { document.documentElement.classList.remove('intro-pending'); return; }

    var reduce = false;
    try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
    var seen = false;
    try { seen = sessionStorage.getItem(KEY) === '1'; } catch (e) {}

    // 已看过 / 用户偏好减少动态 → 立刻移除，不做任何遮挡
    if (reduce || seen) {
      el.remove();
      document.documentElement.classList.remove('intro-pending');
      return;
    }
    try { sessionStorage.setItem(KEY, '1'); } catch (e) {}

    document.documentElement.classList.add('intro-lock');
    el.classList.add('is-running');
    document.documentElement.classList.add('is-intro');
    // ⚠️ ic-live 必须**立刻**加：CSS 里书写 / 小字 / 细线 / 卷帘四段动画
    //    全都挂在 `.intro-curtain.ic-live` 之下，靠自己的 animation-delay 排序。
    //    曾经把它放在 teardown() 里加 —— 那是「收尾」时刻（1580ms），
    //    结果书写动画到 1580ms 才起跑，前 1.5 秒标题只有 7% 的淡字痕，
    //    整段动画看起来就是「一个紫球悬在空白页上，什么都没发生」。
    el.classList.add('ic-live');

    /* ================= 时间轴（ms） =================
       节奏原则：墨滴与书写**重叠**推进，而不是排队。
       总长约 2.9s（含 0.9s 揭幕）。入站动画的黄金法则是「看一眼就完」，
       但也不能快到看不清 —— 关键是三段要**有重叠**：
         · 墨滴 0 → 900        落墨晕开
         · 书写 460 → 460+write 墨还没落定就开始写（墨随笔走）
         · 小字/细线 在书写中段浮出，不等到写完
         · 卷帘 1900 上掀（此时书写早已完成，留 200ms 让人看清成品） */
    var T = {
      blot: 0,        // 墨滴落下
      thread: 200,    // 游丝开始走（和书写几乎同时，边落墨边写字）
      write: 460,     // 书写开始
      lift: 1900,     // 卷帘上掀
      end: 2900
    };

    var dots = window.innerWidth < 640 ? 520 : window.innerWidth < 1024 ? 720 : 900;
    el.style.setProperty('--ic-stroke', dots + '');
    var titleEl = el.querySelector('.ic-title');
    var titleChars = ((titleEl && titleEl.getAttribute('data-text')) || '').replace(/\s/g, '').length || 8;
    // 书写时长跟字数走：字多给宽一点，保证「一笔一笔」看得出来。
    // 上限压到 900ms：再长就和「看一眼就完」的原则冲突了。
    var writeMs = Math.max(620, Math.min(900, titleChars * 68));
    el.style.setProperty('--ic-write', writeMs + 'ms');
    el.style.setProperty('--ic-t-write', T.write + 'ms');
    el.style.setProperty('--ic-t-line', Math.round(T.write + writeMs * 0.30) + 'ms');
    el.style.setProperty('--ic-t-sub', Math.round(T.write + writeMs * 0.55) + 'ms');
    el.style.setProperty('--ic-t-lift', T.lift + 'ms');

    /* ================= canvas：墨滴 + 游丝 + 纸纹 ================= */
    var cv = el.querySelector('.ic-paper');
    var ctx = cv && cv.getContext ? cv.getContext('2d') : null;
    var W = 0, H = 0, DPR = 1;

    // 主题色：从 CSS 变量里读，亮/暗自动跟着走。
    // ⚠️⚠️ 这个函数踩了两个坑，两次都表现为「整屏纯蓝」：
    //   坑 1：canvas 的 fillStyle **不认** oklch() / color-mix() 的**旧**浏览器会静默忽略 → 什么都画不出来。
    //   坑 2（更隐蔽）：想用 DOM 探针归一，但实测的 Chrome 上
    //        · `getComputedStyle(span).color` 对 oklch 输入返回的**仍是** `oklch(...)`；
    //        · 连离屏 canvas 的 `ctx.fillStyle = 'oklch(...)'` 之后读回来，**也还是** `oklch(...)`
    //          （CSS Color 4 支持它，但 getter 保留原颜色空间，不做 sRGB 归一）。
    //        于是按 /[\d.]+/ 抓数字得到 ["0.975","0.009","285"] → 当 RGB 用 → clamp 成 rgb(1,0,255)
    //        → **整屏纯蓝**（实测像素 [6,5,252]）。
    //
    //   唯一 100% 可靠的归一：**让浏览器真的画一像素，再读回来**。
    //   做法是一个 1×1 的离屏 canvas：fillStyle = raw → fillRect → getImageData。
    //   getImageData 返回的字节一定已经是 sRGB，跟它内部怎么表示颜色无关。
    var _c1 = document.createElement('canvas');
    _c1.width = _c1.height = 1;
    var _px = _c1.getContext('2d', { willReadFrequently: true });
    var cs = getComputedStyle(document.documentElement);
    function channels(name, fallback) {
      var raw = (cs.getPropertyValue(name) || '').trim() || fallback;
      try {
        _px.clearRect(0, 0, 1, 1);
        _px.fillStyle = raw;          // 不合法则保留上一次的值
        _px.fillRect(0, 0, 1, 1);
        var d = _px.getImageData(0, 0, 1, 1).data;
        if (d[3] > 0 || d[0] + d[1] + d[2] > 0) return [d[0], d[1], d[2]];
      } catch (e) {}
      return [110, 92, 200];
    }
    // 兜底值必须也是**合法颜色**，否则 fillStyle 保持上一个值 → 读出一片黑
    var INK = channels('--primary', 'oklch(0.61 0.105 282)');
    var WARM = channels('--accent', 'oklch(0.72 0.09 15)');
    // 站点真实背景色：纸面底色直接用它，揭幕时才不会跳色
    var BG = channels('--bg', 'oklch(0.975 0.009 285)');
    // 亮/暗主题下墨的观感差别很大：暗底上墨是"发光"的，需要压低不透明度才不刺眼
    var dark = document.documentElement.getAttribute('data-theme') === 'dark';
    function ink(a, warm) {
      var c = warm ? WARM : INK;
      return 'rgba(' + c[0] + ',' + c[1] + ',' + c[2] + ',' + Math.max(0, Math.min(1, a)).toFixed(3) + ')';
    }

    function resize() {
      DPR = Math.min(window.devicePixelRatio || 1, 2);
      W = window.innerWidth;
      H = window.innerHeight;
      cv.width = Math.round(W * DPR);
      cv.height = Math.round(H * DPR);
      cv.style.width = W + 'px';
      cv.style.height = H + 'px';
      if (ctx) ctx.setTransform(DPR, 0, 0, DPR, 0, 0);
    }

    // 墨丝：从墨团外缘向外游走的短笔触。
    // ⚠️ 长度是这里最敏感的参数，两个极端都试过、都不行：
    //    · 太短（0.16~0.42 maxR）→ 前半截埋在墨团里，等于没画，完全看不见；
    //    · 太长（0.22~0.52 maxR）→ 变成放射状的"星芒 / 海胆"，像爆炸特效，非常廉价。
    //    正解是**短而弯、且长短悬殊**：让它们读作"几笔甩出去的飞白"，
    //    而不是"从一个点射出的光线"。所以：基准长度压回 0.12~0.30，
    //    但把 curve 放大（弯曲 → 不再指向圆心），并让笔宽/不透明度差异拉开。
    var threads = [];
    function seedThreads() {
      threads = [];
      var n = W < 640 ? 20 : 34;
      var maxR = Math.min(W, H) * 0.5;
      for (var i = 0; i < n; i++) {
        // 角度刻意不均匀：加随机抖动，避免"放射状太阳"的观感
        var a = (i / n) * Math.PI * 2 + (Math.random() - 0.5) * 1.1;
        threads.push({
          a: a,
          len: maxR * (0.12 + Math.random() * 0.18),
          // 弯曲幅度给大：弧线一弯，就不再是"从圆心射出的光线"
          curve: (Math.random() - 0.5) * 1.9,
          // 笔宽：1px 以下的线在 1× DPR 上会被抗锯齿"融"进背景，等于没画。
          // 起档抬到 1.1，最粗 2.6 —— 读作"细笔触"，而不是"发丝"。
          w: 1.1 + Math.random() * 1.5,
          warm: Math.random() < 0.30,        // 少量取杏粉色，避免整片死紫
          // 延迟拉开到 0~0.55：让它们**陆续甩出**，而不是同一瞬间全部出现。
          // 这一步是"从爆发感 → 书写感"的关键 —— 同时出现永远像爆炸。
          delay: Math.random() * 0.55
        });
      }
    }

    // 纸纹：一次性烘到离屏画布上，每帧只 drawImage，省算力
    var paper = document.createElement('canvas');
    function bakePaper() {
      paper.width = Math.round(W * DPR);
      paper.height = Math.round(H * DPR);
      var pc = paper.getContext('2d');
      pc.setTransform(DPR, 0, 0, DPR, 0, 0);

      // ① 纸底色：**就用站点真实的 --bg**，别的什么都不叠。
      //    ⚠️ 这里曾经叠了两层色（一层暖黄 rgba(196,178,152,0.055) + 一层
      //       中心提亮 rgba(255,255,255,0.62)），结果整屏变成饱和的蓝紫色，
      //       标题直接被吃掉。原因是：--bg 本身已经很淡（oklch 97.5% 0.009），
      //       衬底极浅；再往中心糊 62% 的纯白，中心接近纯白，而四周仍是 --bg 的
      //       冷调 → 大脑把四周读作"蓝"，整块画面就"泛蓝"了。
      //       纸感的来源应该是**纤维颗粒**（见 ③），不是靠加大面积叠色。
      pc.fillStyle = 'rgb(' + BG[0] + ',' + BG[1] + ',' + BG[2] + ')';
      pc.fillRect(0, 0, W, H);

      // ② 极轻的暗角：只压边缘 3~6%，让视线收拢到中间，不做中心提亮。
      var vg = pc.createRadialGradient(W / 2, H * 0.46, Math.min(W, H) * 0.3, W / 2, H * 0.46, Math.max(W, H) * 0.78);
      if (dark) {
        vg.addColorStop(0, 'rgba(0,0,0,0)');
        vg.addColorStop(1, 'rgba(0,0,0,0.30)');
      } else {
        vg.addColorStop(0, 'rgba(255,255,255,0)');
        vg.addColorStop(1, 'rgba(108,98,132,0.055)');
      }
      pc.fillStyle = vg;
      pc.fillRect(0, 0, W, H);

      // ③ 纸纤维：细短的线条，方向随机 —— 比圆点更像"纸"（圆点看着像噪点/脏点）。
      //    底色不再提亮之后，纸感**全靠这一层**，所以颗粒可以稍微给足一点，
      //    但仍然要压在不透明度 4% 以下：纸上不该看出"噪点"，只觉得"不平"。
      var fibers = Math.round(W * H / 64);
      pc.lineWidth = 0.6;
      for (var i = 0; i < fibers; i++) {
        var x = Math.random() * W;
        var y = Math.random() * H;
        var ang = Math.random() * Math.PI;
        var len = 2 + Math.random() * 8;
        pc.strokeStyle = dark
          ? 'rgba(215,210,240,' + (0.020 + Math.random() * 0.032) + ')'
          : 'rgba(110,98,135,' + (0.014 + Math.random() * 0.026) + ')';
        pc.beginPath();
        pc.moveTo(x, y);
        pc.lineTo(x + Math.cos(ang) * len, y + Math.sin(ang) * len);
        pc.stroke();
      }
    }

    function ease(t) { return 1 - Math.pow(1 - t, 3); }

    /* ============ 不规则墨迹 ============
       真实墨滴晕开的轮廓**不是圆**，也**不是花**。
       ⚠️ 踩过的坑：早先用「几个不同频率的正弦叠加」扰动半径 —— 数学上必然产生
          周期性瓣状轮廓，画出来就是一坨 6~7 瓣的"多边形花 / 雪花 / 齿轮"，
          完全不像墨，非常廉价。正弦是周期函数，这条路走不通。

       正确做法：在圆周上**独立随机采样**一圈半径（每个角度一个随机数，互不相关），
       然后做若干轮「相邻三点加权平均」把它磨圆 —— 随机数负责"不可预测的凹凸"，
       平滑负责"墨的张力把它拉圆"。平滑必须**环状**处理（首尾互邻），
       否则接缝处会出现一条直棱。

       采样点数与平滑强度挂钩：点越少越有机（大形起伏），点越多越毛（细碎边）。
       三层叠加时用不同的点数与强度，就得到了"浓墨核心紧致、外层洇散毛糙"的层次。 */
    var BLOTS = [];
    function smoothRing(arr, passes) {
      var n = arr.length;
      var a = arr;
      for (var p = 0; p < passes; p++) {
        var b = new Array(n);
        for (var i = 0; i < n; i++) {
          // 环状邻域：1-2-1 加权平均，首尾互邻保证闭合连续
          b[i] = (a[(i - 1 + n) % n] + a[i] * 2 + a[(i + 1) % n]) * 0.25;
        }
        a = b;
      }
      return a;
    }
    // 预生成若干组轮廓：每组就是一个「已经磨圆过的随机半径数组」
    function makeRing(n, amp, passes) {
      var r = new Array(n);
      for (var i = 0; i < n; i++) r[i] = 1 + (Math.random() * 2 - 1) * amp;
      return smoothRing(r, passes);
    }
    function seedBlot() {
      BLOTS = [
        // 外圈：点少 + 幅度大 + 平滑轻 → 大块不规则的洇散形
        { ring: makeRing(14, 0.26, 2), squash: 0.86 },
        // 中圈：中等
        { ring: makeRing(18, 0.20, 3), squash: 0.93 },
        // 内圈：点较密 + 幅度小 + 平滑重 → 紧致但仍有微起伏的核心
        { ring: makeRing(20, 0.13, 4), squash: 0.95 },
        { ring: makeRing(16, 0.17, 3), squash: 0.90 },
        { ring: makeRing(22, 0.10, 5), squash: 0.94 },
      ];
    }
    // 画一个不规则墨团：r = 基准半径，seed = 用哪一组轮廓
    function blot(cx, cy, r, seed, alpha, squash) {
      if (r <= 0 || alpha <= 0.002) return;
      var B = BLOTS[seed % BLOTS.length];
      var ring = B.ring;
      var n = ring.length;
      var sq = squash || B.squash;
      // 用二次贝塞尔穿过每个采样点（控制点取相邻两点中点），
      // 得到没有折角的柔性曲线 —— 直接 lineTo 会在点少时看出多边形棱。
      ctx.beginPath();
      var p0x = cx + Math.cos(0) * r * ring[0];
      var p0y = cy + Math.sin(0) * r * ring[0] * sq;
      ctx.moveTo(p0x, p0y);
      for (var i = 0; i < n; i++) {
        var ia = (i / n) * Math.PI * 2;
        var ib = ((i + 1) / n) * Math.PI * 2;
        var ax = cx + Math.cos(ia) * r * ring[i];
        var ay = cy + Math.sin(ia) * r * ring[i] * sq;
        var bx = cx + Math.cos(ib) * r * ring[(i + 1) % n];
        var by = cy + Math.sin(ib) * r * ring[(i + 1) % n] * sq;
        ctx.quadraticCurveTo(ax, ay, (ax + bx) / 2, (ay + by) / 2);
      }
      ctx.closePath();
      ctx.fillStyle = alpha;
      ctx.fill();
    }

    var start = 0;
    var raf = 0;
    var done = false;

    function draw(now) {
      if (!start) start = now;
      var e = now - start;               // 已过去的时间
      var t = Math.min(1, Math.max(0, (e - T.blot) / 900));       // 墨滴进度
      var tt = Math.min(1, Math.max(0, (e - T.thread) / 1500));   // 游丝进度
      // 落墨点在**标题下方**：标题居中的位置约在 H*0.46（.ic-stage 带 -2vh 上移），
      // 墨团若放在同一高度，就会把标题整块糊住（实测 1150ms 帧上标题几乎看不见）。
      // 放到 H*0.66 —— 视觉读作"一笔落在标题下面"，游丝往上飘去碰字。
      var cx = W / 2, cy = H * 0.66;
      var unit = Math.min(W, H);

      ctx.clearRect(0, 0, W, H);
      ctx.drawImage(paper, 0, 0, W, H);

      // ---- 墨团：不规则墨迹 + 浓淡分离 ----
      // 尺度必须克制：标题宽约 330px、字高约 100px，墨团是**给字做底**的，
      // 直径控制在 ~180px 左右即可。曾经把系数放大到 2.4 倍外层，
      // 半径直接超过屏幕 → 墨团糊满全屏、把标题整个吞掉，那是不可用的。
      //
      // ⚠️⚠️ 「同心圆靶」的坑（踩了两次）：
      //   第一次：四层全部共心，半径 1.34/1.02/0.72/0.36 递减、不透明度逐层升高
      //           → 一组完美的同心环，像"一颗眼睛/一个靶子"。
      //   第二次：加了小偏移 + 压小不透明度落差，仍然像靶 —— 因为**两层之间
      //           存在色差**（中间层用暖色 accent、内外层用冷色 primary），
      //           冷暖分界本身就在替人勾边。
      //   真正的修法有三条，缺一不可：
      //     ① 色彩统一：墨就是墨，全套用 primary，暖色只允许出现在**游丝**上；
      //     ② 偏移要够大：内层相对外层错开 30%~50% 半径，让"环"散成"偏心的团"；
      //     ③ 用**多层低不透明度叠加**代替"少层高不透明度分层" ——
      //        5 层各 4% 叠出来的是一团雾，2 层各 15% 叠出来的是两个边。
      var inK = ease(t);
      // base 提到分支外：游丝要用它当起笔半径，不能依赖「墨团已经画过」
      var base = (W < 640 ? 0.095 : 0.072) * unit * (0.5 + inK * 0.85);
      if (inK > 0) {
        var life = 1 - Math.max(0, (e - 1500) / 1400) * 0.45;   // 后半程整体变淡
        var blur = 1 - inK;                                     // 1 → 0：起点虚、落定实
        var grow = 0.45 + inK * 0.55;                           // 偏移随墨团一起长大
        // 每层：半径系数 / 半径方向的偏移量(x,y，单位=base) / 不透明度 / squash
        // 偏移刻意错开方向，任何两层都不共心 —— 这是"不成为靶"的根本。
        var LAYERS = [
          [1.32, -0.14, 0.10, 0.055, 0.88],
          [1.10, 0.20, -0.08, 0.055, 0.92],
          [0.92, -0.06, -0.24, 0.060, 0.90],
          [0.70, 0.26, 0.18, 0.065, 0.95],
          [0.46, -0.30, 0.06, 0.075, 0.97],
        ];
        ctx.save();
        for (var li = 0; li < LAYERS.length; li++) {
          var L = LAYERS[li];
          // 外层模糊大、内层紧：造成"越到中心越实"的墨性
          var solid = li / (LAYERS.length - 1);
          ctx.shadowColor = ink(0.10 * life);
          ctx.shadowBlur = (30 - solid * 22) + blur * 26;
          blot(
            cx + L[1] * base * grow,
            cy + L[2] * base * grow,
            base * L[0],
            li,
            ink(L[3] * life),
            L[4]
          );
        }
        ctx.restore();
      }

      // ---- 游丝：从墨团边缘往外游走的细笔触 ----
      if (tt > 0) {
        ctx.lineCap = 'round';
        var threadRef = Math.min(W, H) * 0.5;
        for (var i = 0; i < threads.length; i++) {
          var s = threads[i];
          var p = Math.min(1, Math.max(0, (tt - s.delay) / (1 - s.delay || 1)));
          if (p <= 0) continue;
          var pe = ease(p);
          // 从墨团**最外层轮廓之外**起笔。
          // ⚠️ 这里有个隐形的浪费：墨团最外层半径是 base*1.32，早先起笔半径取 base*1.02,
          //    意味着笔触的前 1/4 完全埋在墨团底下 —— 白画。
          //    起笔半径必须 ≥ 最外层半径，才谈得上"从墨团边缘甩出去"。
          var r0 = base * 1.30;
          var len = s.len * pe;
          // 两头淡中间浓：让游丝像「笔尖蘸墨写了半笔」，不是一根硬线。
          // ⚠️ 谷底不能到 0：sin() 在 pe→0 和 pe→1 时归零，
          //    而 pe 小的时候正好是"笔刚刚甩出去"的瞬间 —— 全透明就等于没画。
          //    抬到 0.35 保底，笔触始终有一点点墨。
          var fade = 0.35 + 0.65 * Math.sin(Math.PI * Math.min(1, pe * 1.05));
          ctx.beginPath();
          var steps = 24;
          for (var k = 0; k <= steps; k++) {
            var q = r0 + (k / steps) * len;
            var ang = s.a + s.curve * (q / threadRef) * 1.1;
            var x = cx + Math.cos(ang) * q;
            var y = cy + Math.sin(ang) * q * 0.92;
            if (k === 0) ctx.moveTo(x, y);
            else ctx.lineTo(x, y);
          }
          // 不透明度：它是"墨在纸里散开的痕迹"，不该像画上去的线 ——
          // 但这个上限被实测卡得很死：0.075 完全看不见（画布上根本统计不到暗像素），
          // 0.13 也几乎看不见。浅色纸上要有"能察觉但不像描边"的效果，0.30 是起点。
          // 暗色主题下墨是发光的，压到 0.22 免得刺眼。
          ctx.strokeStyle = ink((dark ? 0.22 : 0.30) * fade, s.warm);
          ctx.lineWidth = s.w;
          ctx.stroke();
        }
      }

      if (!done) raf = requestAnimationFrame(draw);
    }

    /* ================= 起播 ================= */
    if (ctx) {
      resize();
      bakePaper();
      seedBlot();
      seedThreads();
      raf = requestAnimationFrame(draw);
    } else {
      el.classList.add('no-canvas'); // 极老浏览器：只留 CSS 那部分
    }
    window.addEventListener('resize', function () {
      if (!ctx || done) return;
      resize(); bakePaper();
    });

    /* ================= 收尾 =================
       只有一条收尾路径（teardown），由三处共同驱动：
         · 时间轴走到 T.lift → 正常揭幕
         · 用户点击 / 按键 → 跳过
         · 兜底定时器 → 标签页被挂起导致 rAF 停摆时保底
       三者都可能先到，所以用 `torn` 做**幂等**闸门：第一个到的执行，后面的直接返回。
       ⚠️ 之前这里有一个「跳过失效」的坑：闸门用的是 `done`，而时间轴回调先把 done 置 true
          再走自己的收尾分支 —— 于是 T.lift 之后用户再点，skip() 里的 finish() 看到 done=true
          立刻 return，幕布永远留在页面上（实测 curtain:true / pending:true）。 */
    var torn = false;
    var endTimer = 0;
    var fallbackTimer = 0;
    function teardown() {
      if (torn) return;
      torn = true;
      done = true;
      if (raf) cancelAnimationFrame(raf);
      if (endTimer) clearTimeout(endTimer);
      if (fallbackTimer) clearTimeout(fallbackTimer);

      // 立刻放行滚动 / 撤掉镜头推近 —— 用户点了就得马上响应，
      // 不能让他再等 0.9s 的卷帘动画走完才「感觉」能动。
      document.documentElement.classList.remove('intro-lock');
      document.documentElement.classList.remove('is-intro');

      // 幕布退场：只做一次 opacity 淡出（0.4s），**不再**等 ic-curtain-up。
      // ⚠️ 之前这里分「正常 / 跳过」两条路，按 writeMs 算 hold 再挂 is-gone ——
      //    逻辑建立在「ic-live 是收尾时才加」的旧设计上。现在 ic-live 早就在播放前
      //    加好了，CSS 里四段动画各自带 delay 自己跑；收尾只需要**淡出 + 摘 DOM**。
      var removed = false;
      function drop() {
        if (removed) return;
        removed = true;
        el.remove();
        document.documentElement.classList.remove('intro-pending');
      }
      el.classList.add('is-gone');
      window.setTimeout(drop, 460);
    }

    // 时间轴到点：正常揭幕
    endTimer = window.setTimeout(teardown, T.lift);

    // 跳过 = 直接到终点
    function skip() { teardown(); }
    el.addEventListener('click', skip);
    window.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' || e.key === 'Enter' || e.key === ' ') skip();
    });

    // 兜底：标签页被挂起导致 rAF 停摆时，也要收尾
    fallbackTimer = window.setTimeout(function () {
      if (!el.isConnected) return;
      if (!torn) teardown();
    }, T.lift + 2600);

    // SPA 软导航（ClientRouter）的收尾 —— 这里有个容易漏掉的坑：
    //   换页时新页面的 HTML 会被整体替换进来，其中**也包含一份** #intro-curtain。
    //   新节点上的 <script is:inline> 在 ClientRouter 的替换流程里**不会重新执行**
    //   （内联脚本只在整页加载时跑），所以那份幕布会以「可见、满屏」的状态留在页面上
    //   （实测：切到 /archive/ 后 count:1、h:900）。
    //   因此必须自己监听 astro:page-load —— 它每次换页都会触发 —— 把多余的幕布清掉。
    function sweep() {
      if (!document.documentElement.classList.contains('intro-pending')) {
        var stale = document.querySelectorAll('#intro-curtain');
        for (var i = 0; i < stale.length; i++) stale[i].remove();
        document.documentElement.classList.remove('intro-lock', 'is-intro');
      }
    }
    document.addEventListener('astro:before-swap', sweep);
    document.addEventListener('astro:page-load', sweep);
  })();
</script>

<style>
  /* ===== 根上挂一个「动画未定」标记，供首屏防抖用 =====
     ⚠️ html / body 上**只能有一个** overflow:hidden！
     这里同时给 html 和 body 挂 overflow，会命中一个老坑：
     body 一旦被设成 overflow:hidden，它自身仍会按内容撑高；
     而 .intro-curtain 是 position:fixed —— fixed 元素的包含块是**最近的、带 transform 的祖先**。
     播放期间 body 正好带 transform（ic-page-in 镜头推近），于是幕布不再以视口为参照，
     而是以 body 的**整个文档高度**为参照 → 它在布局里被撑成 1845px（视口才 900），
     居中的标题跟着跑到 y=827，直接被裁到屏幕外。
     解法：只锁 html。body 不设 overflow，幕布就老老实实贴合视口。 */
  html.intro-pending,
  html.intro-lock { overflow: hidden; }
  /* ===== 幕布本体 / 纸面 / 舞台 / 标题 / 卷帘的**首帧关键样式**已内联在组件顶部
     （见 criticalCss，原因写在那边），这里只放「非首帧必需」的部分。 ===== */

  .intro-curtain.no-canvas .ic-paper {
    background: radial-gradient(120% 90% at 50% 44%, color-mix(in srgb, var(--primary) 9%, transparent), transparent 70%);
  }

  /* 上层实心字：clip-path 自左向右「写」出来 */
  .ic-title::after {
    content: attr(data-text);
    position: absolute;
    inset: 0;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    -webkit-text-stroke: 0;
    clip-path: inset(0 100% 0 0);
  }
  /* 笔尖：跟着书写进度游走的一小束光 */
  .ic-title::before {
    content: '';
    position: absolute;
    top: -8%;
    bottom: -8%;
    left: 0;
    width: 2px;
    background: linear-gradient(180deg, transparent, var(--primary), transparent);
    box-shadow: 0 0 20px 5px color-mix(in srgb, var(--primary) 50%, transparent);
    opacity: 0;
  }
  /* 时间轴由 JS 注入的三个变量统一驱动，CSS 里不重复硬编码秒数：
       --ic-write  书写时长（跟标题字数走）
       --ic-t-write 书写**起跑**时刻（= T.write）
       --ic-t-lift  卷帘上掀时刻（= T.lift） */
  .intro-curtain.ic-live .ic-title::after {
    animation: ic-write var(--ic-write, 900ms) cubic-bezier(0.66, 0.02, 0.3, 1) var(--ic-t-write, 460ms) both;
  }
  .intro-curtain.ic-live .ic-title::before {
    animation: ic-pen var(--ic-write, 900ms) cubic-bezier(0.66, 0.02, 0.3, 1) var(--ic-t-write, 460ms) both;
  }
  @keyframes ic-write {
    from { clip-path: inset(0 100% 0 0); }
    to   { clip-path: inset(0 0 0 0); }
  }
  @keyframes ic-pen {
    0%   { left: 0%; opacity: 0; }
    10%  { opacity: 0.95; }
    90%  { opacity: 0.9; }
    100% { left: 100%; opacity: 0; }
  }

  /* 幕布副题 = 站点箴言第一句，用的是首页壁纸同一套「书法潦草」字体，
     和标题（衬线）形成对照。中文书法句子不能套 mono + 大字距那套（那是给英文小标的），
     所以这里换成手写体、收窄字距、字号取到读得清的档。 */
  .ic-sub {
    margin: 0;
    color: var(--text-soft);
    font-family: 'Liu Jian Mao Cao', 'Xingkai SC', 'STXingkai', 'HanziPen SC', 'Kaiti SC', 'STKaiti', 'KaiTi', '楷体', cursive;
    font-size: clamp(1rem, 2.6vw, 1.5rem);
    line-height: 1.5;
    letter-spacing: 0.08em;
    text-indent: 0.08em;
    white-space: nowrap;
    opacity: 0;
  }
  .intro-curtain.ic-live .ic-sub {
    animation: ic-sub-in 0.9s cubic-bezier(0.16, 1, 0.3, 1) var(--ic-t-sub, 780ms) both;
  }
  @keyframes ic-sub-in {
    from { opacity: 0; transform: translateY(10px); letter-spacing: 0.24em; filter: blur(5px); }
    to   { opacity: 1; transform: translateY(0); letter-spacing: 0.08em; filter: blur(0); }
  }

  .ic-line {
    display: block;
    width: min(56vw, 21rem);
    height: 1px;
    margin-top: 0.35rem;
    background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--primary) 58%, transparent), transparent);
    transform: scaleX(0);
    transform-origin: center;
  }
  .intro-curtain.ic-live .ic-line {
    animation: ic-line-out 0.9s cubic-bezier(0.16, 1, 0.3, 1) var(--ic-t-line, 620ms) both;
  }
  @keyframes ic-line-out {
    from { transform: scaleX(0); opacity: 0; }
    to   { transform: scaleX(1); opacity: 1; }
  }

  /* ===== 跳过提示：淡入得晚、消失得早，不打扰 ===== */
  .ic-skip {
    position: absolute;
    left: 50%;
    bottom: clamp(1.6rem, 5vh, 3rem);
    transform: translateX(-50%);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.22em;
    color: var(--text-faint);
    opacity: 0;
    animation: ic-skip-in 0.8s ease 1.6s both;
    pointer-events: none;
  }
  @keyframes ic-skip-in { to { opacity: 0.6; } }

  /* 「字痕」是极淡的一层（7%），只为给书写提供落脚点，不承担辨识度 ——
     辨识度全部交给实心渐变字。曾经把它调到 42% 想让它"看得清"，
     结果画面上是个空心灰字在飘，像字体没加载完，非常廉价。 */

  /* 暗色主题：底色是深蓝紫，字痕要反过来用更亮一档的墨，否则完全看不见。
     ⚠️ Astro 的 scoped <style> 会把 `[data-theme='dark'] .foo` 这种**前缀写法**整条丢掉
     （编译后选择器里根本不存在）。必须把整条包进 :global(...)，见本项目既有约定。 */
  :global([data-theme='dark'] .ic-title) {
    -webkit-text-stroke-color: color-mix(in srgb, var(--text) 13%, transparent);
  }

  /* ===== ④ 卷帘上掀 =====
     .ic-veil 是**透明**的（原因见组件顶部注释：它压在 canvas 之上，不透明会把墨全糊掉），
     所以抬升必须由幕布本体自己完成 —— 连同它身上的纸色一起向上卷走。
     veil 只补一个底缘圆角，让抬起的那一瞬像纸被卷起来，而不是一块硬板滑走。 */
  .intro-curtain.ic-live {
    animation: ic-curtain-up 0.92s cubic-bezier(0.72, 0, 0.2, 1) var(--ic-t-lift, 1900ms) both;
  }
  .intro-curtain.ic-live .ic-veil {
    animation: ic-veil-round 0.92s cubic-bezier(0.72, 0, 0.2, 1) var(--ic-t-lift, 1900ms) both;
  }
  @keyframes ic-curtain-up {
    from { transform: translateY(0); }
    to   { transform: translateY(-101.5%); }
  }
  @keyframes ic-veil-round {
    from { border-radius: 0 0 0 0; }
    to   { border-radius: 0 0 52% 52% / 0 0 11% 11%; }
  }

  /* 幕布升起的同时，主页「推近 → 回落」，形成镜头交接。
     时长 1.5s 比上掀的 0.92s 略长 —— 让主页的回落落后于幕布一拍，
     结束时刚好稳下来，不会有「拉过头再弹回」的滞涩感。

     ⚠️⚠️ 这段「推近」**不能**作用在 <html> 或 <body> 上 —— 这是本项目踩得最深的一个坑：
       给 html / body 任何一个加 transform（或 filter / perspective），
        它就会成为 position:fixed 元素的**包含块**。
       而幕布 .intro-curtain 正是 fixed + inset:0，本该贴合视口（900px）。
       一旦 html 成了包含块，幕布改按**整个文档盒**计尺寸 → 实测被撑到 1845~1928px
       （body.scrollHeight 的高度），居中后的标题掉到 y≈827，被整个推到屏幕外。
       实测对照：documentElement 去掉 is-intro → 幕布高度立刻从 1848px 回到 900px。

     正确做法：推近挂在 .main-layout 这个**内层内容容器**上（它只包正文，不包幕布）。
     幕布的包含块因此仍是视口，位置永远准。 */
  html.is-intro .main-layout {
    animation: ic-page-in 1.5s cubic-bezier(0.16, 1, 0.3, 1) both;
    transform-origin: 50% 30%;
  }
  @keyframes ic-page-in {
    from { transform: scale(1.045); filter: saturate(0.78) brightness(1.05); }
    to   { transform: scale(1); filter: none; }
  }

  /* 播放期间禁滚动：只锁 html（原因见上面 intro-pending 的注释），body 保持原样 */

  /* 收尾：整幕再退一次场，避免揭幕瞬间的硬切 */
  .intro-curtain.is-gone {
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  /* 减少动态偏好：完全不参与（JS 已提前 return，这里再兜一层） */
  @media (prefers-reduced-motion: reduce) {
    .intro-curtain { display: none !important; }
  }

  /* 小屏：标题不许换行、字距收一档 */
