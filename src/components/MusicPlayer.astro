---
// 音乐播放器 —— 在线歌单（Meting API）+ 本地备选
// 视觉参照 Firefly（c1everf0x.cn）：旋转专辑封面 + 细进度条（悬停圆点）
// + 手风琴抽屉（歌词 / 播放列表）+ 列表封面缩略图与频谱动效
import { site } from '../site';
import Icon from './Icon.astro';

// ===== 本地备选歌曲 =====
const localTracks = [
  { name: '我走后', artist: '小咪', url: '/music/wo-zou-hou.mp3' },
  { name: 'Whatever Happen', artist: 'tangjin', url: '/music/whatever-happen.mp3' },
];

// ===== Meting API 配置（歌单来源）=====
// 注意：api.i-meto.com 的歌单接口可用，但其歌曲 url（type=url）已失效(404)；
// api.injahow.cn 的歌曲 url 能正常 302 重定向到网易云真实 mp3，故排在首位。
const metingConfig = {
  server: 'netease',
  type: 'playlist',
  id: '151681834',
  api: 'https://api.injahow.cn/meting/?server=:server&type=:type&id=:id',
  fallbackApis: [
    'https://api.i-meto.com/meting/api?server=:server&type=:type&id=:id&r=:r',
    'https://api.moeyao.cn/meting/?server=:server&type=:type&id=:id',
  ],
};
---

<div class="music-player" id="music-player">
  <!-- 顶行：旋转封面 + 信息 + 歌词开关 -->
  <div class="player-top">
    <div class="disc-wrap">
      <div class="player-disc" id="player-disc">
        <img id="player-cover" src={site.avatar} alt="封面" />
      </div>
      <span class="disc-ring" aria-hidden="true"></span>
    </div>
    <div class="player-info">
      <div class="player-title-row">
        <span class="player-title" id="player-title">加载中...</span>
        <span class="eq-bars" aria-hidden="true">
          <i class="eq-bar"></i><i class="eq-bar"></i><i class="eq-bar"></i>
        </span>
        <button class="mini-btn" id="lyrics-toggle" title="歌词" aria-label="歌词">
          <Icon name="lyrics" size="1.05rem" />
        </button>
        <button class="mini-btn src-toggle" id="source-toggle" title="切换歌曲来源（在线歌单 / 本地歌曲）" aria-label="切换歌曲来源" data-source="online">
          <Icon name="cloud" size="1.05rem" class="ico-cloud" />
          <Icon name="library_music" size="1.05rem" class="ico-local" />
        </button>
      </div>
      <div class="player-artist" id="player-artist">正在连接音乐平台...</div>
      <div class="player-sub-row">
        <span class="player-clock">
          <span id="player-current">0:00</span><i>/</i><span id="player-duration">0:00</span>
        </span>
        <div class="player-volume">
          <Icon name="volume" size="0.95rem" class="vol-icon" />
          <input type="range" id="player-volume" min="0" max="1" step="0.01" value="0.7" aria-label="音量" />
        </div>
      </div>
    </div>
  </div>

  <!-- 细进度条（悬停出现圆点抓手） -->
  <div class="player-progress" id="player-progress" role="slider" aria-label="播放进度">
    <div class="player-progress-bar" id="player-progress-bar"></div>
    <div class="progress-thumb" id="progress-thumb" aria-hidden="true"></div>
  </div>

  <!-- 控制行：模式 | 上一首 | 播放 | 下一首 | 列表 -->
  <div class="player-controls">
    <button class="ctrl-btn ctrl-side" id="btn-mode" title="播放模式" data-mode="list">
      <Icon name="repeat" size="1.05rem" class="ico-list" />
      <Icon name="repeat_one" size="1.05rem" class="ico-one" />
      <Icon name="shuffle" size="1.05rem" class="ico-shuffle" />
    </button>
    <button class="ctrl-btn" id="btn-prev" title="上一首"><Icon name="prev" size="1.3rem" /></button>
    <button class="ctrl-btn ctrl-play" id="btn-play" title="播放/暂停">
      <Icon name="play" size="1.4rem" class="ico-play" />
      <Icon name="pause" size="1.4rem" class="ico-pause" />
    </button>
    <button class="ctrl-btn" id="btn-next" title="下一首"><Icon name="next" size="1.3rem" /></button>
    <button class="ctrl-btn ctrl-side" id="playlist-toggle" title="播放列表">
      <Icon name="playlist" size="1.1rem" />
    </button>
  </div>

  <!-- 抽屉：歌词 -->
  <div class="drawer" id="lyrics-drawer">
    <div class="drawer-inner">
      <div class="drawer-body">
        <div class="lyrics-scroll" id="lyrics-scroll"></div>
      </div>
    </div>
  </div>

  <!-- 抽屉：播放列表 -->
  <div class="drawer" id="playlist-drawer">
    <div class="drawer-inner">
      <div class="drawer-body">
        <div class="playlist-head">
          <div class="src-switch" id="src-switch" role="tablist" aria-label="歌曲来源">
            <button type="button" class="src-chip" data-source="online">
              <Icon name="cloud" size="0.9rem" />在线歌单
            </button>
            <button type="button" class="src-chip" data-source="local">
              <Icon name="library_music" size="0.9rem" />本地歌曲
            </button>
          </div>
          <span class="playlist-count" id="playlist-count">-- 首</span>
        </div>
        <div class="player-playlist" id="player-playlist"></div>
      </div>
    </div>
  </div>
</div>
<audio id="audio-el" preload="metadata"></audio>

<!-- APlayer（在线歌单播放，本地备选用原生 audio） -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.css">
<script src="https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.js"></script>

<script define:vars={{ localTracks, metingConfig, siteAvatar: site.avatar }}>
  const player = document.getElementById('music-player');
  const audio = document.getElementById('audio-el');
  const titleEl = document.getElementById('player-title');
  const artistEl = document.getElementById('player-artist');
  const coverEl = document.getElementById('player-cover');
  const progressBar = document.getElementById('player-progress-bar');
  const progressWrap = document.getElementById('player-progress');
  const thumbEl = document.getElementById('progress-thumb');
  const currentEl = document.getElementById('player-current');
  const durationEl = document.getElementById('player-duration');
  const playBtn = document.getElementById('btn-play');
  const prevBtn = document.getElementById('btn-prev');
  const nextBtn = document.getElementById('btn-next');
  const modeBtn = document.getElementById('btn-mode');
  const volumeEl = document.getElementById('player-volume');
  const playlistEl = document.getElementById('player-playlist');
  const playlistToggle = document.getElementById('playlist-toggle');
  const playlistCount = document.getElementById('playlist-count');
  const lyricsToggle = document.getElementById('lyrics-toggle');
  const lyricsDrawer = document.getElementById('lyrics-drawer');
  const playlistDrawer = document.getElementById('playlist-drawer');
  const lyricsScroll = document.getElementById('lyrics-scroll');
  const sourceToggle = document.getElementById('source-toggle');
  const srcSwitch = document.getElementById('src-switch');

  let tracks = [];
  let onlineTracks = [];          // 在线歌单缓存，切回来不用重新请求
  let currentSource = 'online';   // 'online' | 'local'
  let onlineAvailable = false;    // 在线歌单是否可用
  let currentIndex = 0;
  let playMode = 'list';
  let useMeting = false;
  let metingPlayer = null;
  let currentLyrics = [];
  let currentLrcIndex = -1;
  let lrcUserScrolling = false;
  let lrcScrollTimer = null;

  function fmt(s) { if (!isFinite(s)) return '0:00'; const m = Math.floor(s/60), x = Math.floor(s%60); return m+':'+x.toString().padStart(2,'0'); }

  // 同步进度条与圆点位置（pct: 0-100）
  function setProgress(pct) {
    progressBar.style.width = pct + '%';
    if (thumbEl) thumbEl.style.left = pct + '%';
  }

  function updateHighlight() {
    document.querySelectorAll('.track-item').forEach((el, i) => el.classList.toggle('active', i === currentIndex));
  }

  function renderPlaylist() {
    playlistEl.innerHTML = '';
    tracks.forEach((t, i) => {
      const div = document.createElement('div');
      div.className = 'track-item' + (i === currentIndex ? ' active' : '');
      div.dataset.idx = i;
      div.innerHTML = `<span class="track-cover"><img src="${t.cover || siteAvatar}" alt="" loading="lazy" /><span class="track-eq"><i></i><i></i><i></i></span></span>
        <span class="track-info"><span class="track-name">${t.name}</span><span class="track-artist">${t.artist}</span></span>`;
      div.addEventListener('click', () => { loadTrack(i, true); play(); });
      playlistEl.appendChild(div);
    });
    playlistCount.textContent = tracks.length + ' 首';
  }

  // autoplay=true 表示切完这首要立刻播放（下一首/上一首/点列表）；否则只加载不播
  function loadTrack(i, autoplay = false) {
    const t = tracks[i]; if (!t) return;
    currentIndex = i;
    if (useMeting && metingPlayer) {
      metingPlayer.list.switch(i);
      if (!autoplay) { try { metingPlayer.pause(); } catch (e) {} }
    } else if (t.url) {
      // ★ 本地模式：把真实音频地址挂到 <audio> 上（原来漏了这步，本地歌根本放不出来）
      const abs = new URL(t.url, location.href).href;
      if (audio.src !== abs) { audio.src = t.url; audio.load(); }
    }
    titleEl.textContent = t.name;
    artistEl.textContent = t.artist;
    if (coverEl) coverEl.src = t.cover || siteAvatar;
    updateHighlight();
    loadLyricsForCurrent();
  }

  // 加载当前歌曲歌词
  async function loadLyricsForCurrent() {
    const t = tracks[currentIndex];
    currentLyrics = [];
    currentLrcIndex = -1;
    renderLyrics([]);
    if (!t || !t.lrc) return;
    try {
      const resp = await fetch(t.lrc, { cache: 'no-cache' });
      if (!resp.ok) return;
      const text = await resp.text();
      currentLyrics = parseLrc(text);
      renderLyrics(currentLyrics);
    } catch (e) {}
  }

  function renderLyrics(lyrics) {
    lyricsScroll.innerHTML = '';
    if (!lyrics || lyrics.length === 0) {
      lyricsScroll.innerHTML = '<div class="lyrics-empty">暂无歌词</div>';
      return;
    }
    lyrics.forEach((line, i) => {
      const div = document.createElement('div');
      div.className = 'lyric-line';
      div.dataset.idx = i;
      div.textContent = line.text;
      div.addEventListener('click', () => {
        if (useMeting && metingPlayer && metingPlayer.audio) metingPlayer.audio.currentTime = line.time;
        else audio.currentTime = line.time;
      });
      lyricsScroll.appendChild(div);
    });
  }

  function updateLyricHighlight(curTime) {
    if (!currentLyrics.length) return;
    let idx = -1;
    for (let i = 0; i < currentLyrics.length; i++) {
      if (currentLyrics[i].time <= curTime) idx = i;
      else break;
    }
    if (idx === currentLrcIndex) return;
    currentLrcIndex = idx;
    const lines = lyricsScroll.querySelectorAll('.lyric-line');
    lines.forEach((el, i) => el.classList.toggle('active', i === idx));
    if (idx !== -1 && !lrcUserScrolling) {
      const line = lines[idx];
      if (line) {
        const target = line.offsetTop - (lyricsScroll.clientHeight / 2) + (line.offsetHeight / 2);
        lyricsScroll.scrollTo({ top: target, behavior: 'smooth' });
      }
    }
  }

  function play() {
    if (useMeting && metingPlayer) { metingPlayer.play(); }
    else { audio.play().catch(()=>{}); }
    playBtn.classList.add('playing'); player.classList.add('playing');
  }

  function pause() {
    if (useMeting && metingPlayer) { metingPlayer.pause(); }
    else { audio.pause(); }
    playBtn.classList.remove('playing'); player.classList.remove('playing');
  }

  function isPlaying() {
    if (useMeting && metingPlayer) return !metingPlayer.audio.paused;
    return !audio.paused;
  }

  function next() {
    if (playMode === 'shuffle' && tracks.length > 1) {
      let r = currentIndex;
      while (r === currentIndex) r = Math.floor(Math.random() * tracks.length);
      loadTrack(r, true);
    } else {
      loadTrack((currentIndex + 1) % tracks.length, true);
    }
    play();
  }

  function prev() {
    loadTrack((currentIndex - 1 + tracks.length) % tracks.length, true);
    play();
  }

  // 归一化 Meting API 返回的字段（不同 API 字段名不同）
  function normalizeTrack(item) {
    return {
      name: item.name || item.title || '未知歌曲',
      artist: item.artist || item.author || '未知歌手',
      url: item.url || '',
      cover: item.cover || item.pic || '',
      lrc: item.lrc || '',
    };
  }

  // 解析 LRC 歌词文本 → [{ time: 秒, text }]
  function parseLrc(lrcText) {
    const lines = [];
    const re = /\[(\d{1,2}):(\d{1,2})(?:[.:](\d{1,3}))?\]/g;
    (lrcText || '').split('\n').forEach((line) => {
      const times = [];
      let m;
      while ((m = re.exec(line)) !== null) {
        times.push(parseInt(m[1]) * 60 + parseInt(m[2]) + parseInt(m[3] || '0') / (m[3] && m[3].length === 3 ? 1000 : 1));
      }
      const text = line.replace(/\[[^\]]*\]/g, '').trim();
      if (text) times.forEach((t) => lines.push({ time: t, text }));
    });
    return lines.sort((a, b) => a.time - b.time);
  }

  // 拉取歌单：依次尝试主 API 与备用 API
  async function fetchPlaylist() {
    const apis = [metingConfig.api, ...(metingConfig.fallbackApis || [])];
    for (const api of apis) {
      const url = api
        .replace(':server', metingConfig.server)
        .replace(':type', metingConfig.type)
        .replace(':id', metingConfig.id)
        .replace(':r', String(Math.random()));
      try {
        const resp = await fetch(url, { cache: 'no-cache' });
        if (!resp.ok) continue;
        const data = await resp.json();
        if (Array.isArray(data) && data.length > 0) {
          return data.map(normalizeTrack).filter(t => t.url);
        }
      } catch (e) {
        console.log('Meting API 请求失败:', url, e);
      }
    }
    return [];
  }

  // ===== 歌曲来源切换：在线歌单 ⇄ 本地歌曲 =====
  function stopAll() {
    try { if (metingPlayer && metingPlayer.audio) metingPlayer.pause(); } catch (e) {}
    try { audio.pause(); } catch (e) {}
    playBtn.classList.remove('playing');
    player.classList.remove('playing');
    setProgress(0);
  }

  function updateSourceUI() {
    if (sourceToggle) {
      sourceToggle.dataset.source = currentSource;
      sourceToggle.title = currentSource === 'online' ? '当前：在线歌单（点击切到本地歌曲）' : '当前：本地歌曲（点击切到在线歌单）';
    }
    if (srcSwitch) {
      srcSwitch.querySelectorAll('.src-chip').forEach((b) => {
        const on = b.dataset.source === currentSource;
        b.classList.toggle('active', on);
        b.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      const onBtn = srcSwitch.querySelector('.src-chip[data-source="online"]');
      if (onBtn) onBtn.title = onlineAvailable ? '网易云在线歌单' : '在线歌单暂不可用（接口请求失败）';
    }
    if (artistEl && !isPlaying()) {
      artistEl.textContent = currentSource === 'online' ? '在线歌单' : '本地歌曲';
    }
  }

  async function switchSource(src, opts = {}) {
    // 首次进入在线源 / 在线源还没拉到数据 → 先尝试拉取
    if (src === 'online' && (onlineTracks.length === 0 || !metingPlayer)) {
      const ok = await initMeting();
      if (!ok) { onlineAvailable = false; src = 'local'; }
    }
    if (src === 'online' && !onlineAvailable) src = 'local';

    const wasPlaying = isPlaying();
    stopAll();
    currentSource = src;
    try { localStorage.setItem('tj-music-source', currentSource); } catch (e) {}

    if (currentSource === 'online') {
      tracks = onlineTracks;
      useMeting = true;
    } else {
      tracks = localTracks;
      useMeting = false;
    }
    currentIndex = 0;
    renderPlaylist();
    updateSourceUI();
    loadTrack(0);
    // 切换是用户点击触发的，原来在放就接着放（浏览器允许）
    if (wasPlaying || opts.autoplay) play();
  }

  // 尝试初始化在线歌单
  async function initMeting() {
    try {
      const list = await fetchPlaylist();
      if (list.length === 0) throw new Error('歌单为空');

      const ap = new APlayer({
        container: document.createElement('div'),
        audio: list,
        mini: false,
        autoplay: false,
        loop: 'all',
        order: 'list',
        preload: 'auto',
        volume: 0.7,
      });

      onlineTracks = list;
      onlineAvailable = true;
      tracks = list;
      useMeting = true;
      metingPlayer = ap;
      titleEl.textContent = tracks[0].name;
      artistEl.textContent = tracks[0].artist;
      if (coverEl) coverEl.src = tracks[0].cover || siteAvatar;
      renderPlaylist();
      loadLyricsForCurrent();

      // 同步播放状态
      ap.on('play', () => { playBtn.classList.add('playing'); player.classList.add('playing'); });
      ap.on('pause', () => { playBtn.classList.remove('playing'); player.classList.remove('playing'); });
      ap.on('timeupdate', () => {
        if (ap.audio && ap.audio.duration) {
          setProgress(ap.audio.currentTime / ap.audio.duration * 100);
          currentEl.textContent = fmt(ap.audio.currentTime);
          durationEl.textContent = fmt(ap.audio.duration);
        }
        updateLyricHighlight(ap.audio.currentTime);
      });
      ap.on('ended', () => {
        if (playMode === 'one') { ap.list.switch(currentIndex); ap.play(); }
        else { next(); }
      });

      return true;
    } catch (e) {
      console.log('Meting failed, fallback to local:', e);
      onlineAvailable = false;
    }
    return false;
  }

  // 本地模式
  function initLocal() {
    tracks = localTracks;
    useMeting = false;
    currentSource = 'local';
    titleEl.textContent = tracks[0].name;
    artistEl.textContent = tracks[0].artist;
    if (coverEl) coverEl.src = siteAvatar;
    renderPlaylist();
    updateSourceUI();
    loadTrack(0);
  }

  // 控制
  playBtn.addEventListener('click', () => isPlaying() ? pause() : play());
  nextBtn.addEventListener('click', next);
  prevBtn.addEventListener('click', prev);
  modeBtn.addEventListener('click', () => { playMode = playMode==='list'?'one':playMode==='one'?'shuffle':'list'; modeBtn.dataset.mode = playMode; });
  volumeEl.addEventListener('input', () => setVolume(parseFloat(volumeEl.value)));

  // 来源切换：标题栏小按钮（来回切）
  if (sourceToggle) {
    sourceToggle.addEventListener('click', () => {
      switchSource(currentSource === 'online' ? 'local' : 'online');
    });
  }
  // 来源切换：播放列表里的分段开关
  if (srcSwitch) {
    srcSwitch.querySelectorAll('.src-chip').forEach((b) => {
      b.addEventListener('click', () => switchSource(b.dataset.source));
    });
  }

  // 抽屉开关（歌词 / 列表互斥，手风琴动画）
  playlistToggle.addEventListener('click', () => {
    const willOpen = !playlistDrawer.classList.contains('open');
    playlistDrawer.classList.toggle('open', willOpen);
    lyricsDrawer.classList.remove('open');
    playlistToggle.classList.toggle('active', willOpen);
    lyricsToggle.classList.remove('active');
  });
  lyricsToggle.addEventListener('click', () => {
    const willOpen = !lyricsDrawer.classList.contains('open');
    lyricsDrawer.classList.toggle('open', willOpen);
    playlistDrawer.classList.remove('open');
    lyricsToggle.classList.toggle('active', willOpen);
    playlistToggle.classList.remove('active');
  });

  // 歌词区用户手动滚动时暂停自动跟随，3 秒后恢复
  const lrcUserScrollReset = () => {
    lrcUserScrolling = true;
    clearTimeout(lrcScrollTimer);
    lrcScrollTimer = setTimeout(() => { lrcUserScrolling = false; }, 3000);
  };
  lyricsScroll.addEventListener('wheel', lrcUserScrollReset);
  lyricsScroll.addEventListener('touchstart', lrcUserScrollReset);

  audio.addEventListener('timeupdate', () => {
    currentEl.textContent = fmt(audio.currentTime);
    if (audio.duration) setProgress(audio.currentTime / audio.duration * 100);
    updateLyricHighlight(audio.currentTime);
  });
  audio.addEventListener('loadedmetadata', () => durationEl.textContent = fmt(audio.duration));
  audio.addEventListener('ended', () => { if (playMode==='one'){audio.currentTime=0;play();} else { next(); } });
  audio.addEventListener('pause', () => { playBtn.classList.remove('playing'); player.classList.remove('playing'); });
  audio.addEventListener('play', () => { playBtn.classList.add('playing'); player.classList.add('playing'); });
  progressWrap.addEventListener('click', e => {
    const r = progressWrap.getBoundingClientRect();
    const ratio = (e.clientX - r.left) / r.width;
    if (useMeting && metingPlayer && metingPlayer.audio && metingPlayer.audio.duration) {
      metingPlayer.audio.currentTime = ratio * metingPlayer.audio.duration;
    } else if (audio.duration) {
      audio.currentTime = ratio * audio.duration;
    }
  });

  // 续播
  const STATE_KEY = 'tj-music-state';
  function getCurTime() { return (useMeting && metingPlayer && metingPlayer.audio) ? metingPlayer.audio.currentTime : audio.currentTime; }
  function setCurTime(t) { if (useMeting && metingPlayer && metingPlayer.audio) metingPlayer.audio.currentTime = t; else audio.currentTime = t; }
  function getDuration() { return (useMeting && metingPlayer && metingPlayer.audio) ? metingPlayer.audio.duration : audio.duration; }
  function getVolume() { return (useMeting && metingPlayer) ? metingPlayer.audio.volume : audio.volume; }
  function setVolume(v) { if (useMeting && metingPlayer) metingPlayer.volume(v); else audio.volume = v; }
  function saveState() { try { localStorage.setItem(STATE_KEY, JSON.stringify({ idx: currentIndex, src: currentSource, time: getCurTime(), playing: isPlaying(), mode: playMode, vol: getVolume() })); } catch {} }
  function restoreState() {
    try {
      const s = JSON.parse(localStorage.getItem(STATE_KEY) || 'null'); if (!s) return;
      // 只有来源一致才恢复曲目（在线第 5 首 ≠ 本地第 5 首）
      if (!s.src || s.src === currentSource) {
        if (typeof s.idx === 'number' && s.idx < tracks.length && s.idx !== currentIndex) loadTrack(s.idx);
      }
      const v = (typeof s.vol === 'number') ? s.vol : 0.7; setVolume(v); volumeEl.value = String(v);
      if (s.mode) { playMode = s.mode; modeBtn.dataset.mode = playMode; }
      const t = (typeof s.time === 'number' && s.time > 1) ? s.time : 0;
      if (t > 0) {
        const apply = () => { const d = getDuration(); if (d && t < d - 1) setCurTime(t); };
        const once = () => { apply(); };
        if (useMeting && metingPlayer && metingPlayer.audio) { metingPlayer.audio.addEventListener('loadedmetadata', once, { once: true }); }
        else audio.addEventListener('loadedmetadata', once, { once: true });
      }
      if (s.playing) play();
    } catch {}
  }
  setInterval(saveState, 2000);
  window.addEventListener('pagehide', saveState);
  document.addEventListener('visibilitychange', () => { if (document.hidden) saveState(); });

  // ===== 初始化 =====
  // 优先用上次记住的来源；默认在线，在线不可用会自动退回本地
  let savedSource = 'online';
  try { savedSource = localStorage.getItem('tj-music-source') || 'online'; } catch (e) {}

  updateSourceUI();
  (async () => {
    // 先静默探测在线歌单是否可用（这样"在线"按钮的状态才准确），再落到目标来源
    await initMeting();
    await switchSource(savedSource === 'local' ? 'local' : 'online');
    restoreState();
  })();
</script>

