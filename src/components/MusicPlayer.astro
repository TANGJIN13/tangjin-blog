---
// 音乐播放器 —— Meting.js + 本地备选
import { site } from '../site';
import Icon from './Icon.astro';

// ===== 本地备选歌曲 =====
const localTracks = [
  { name: '我走后', artist: '小咪', url: '/music/wo-zou-hou.mp3' },
  { name: 'Whatever Happen', artist: 'tangjin', url: '/music/whatever-happen.mp3' },
];

// ===== Meting.js 配置（参考 c1everf0x.cn）=====
const metingConfig = {
  server: 'netease',
  type: 'playlist',
  id: '151681834',
  api: 'https://api.i-meto.com/meting/api?server=:server&type=:type&id=:id&r=:r',
  fallbackApis: [
    'https://api.injahow.cn/meting/?server=:server&type=:type&id=:id',
    'https://api.moeyao.cn/meting/?server=:server&type=:type&id=:id',
  ],
};
---

<div class="music-player" id="music-player">
  <div class="music-deco" aria-hidden="true">
    <Icon name="music" size="5rem" class="deco-note deco-note-1" />
    <Icon name="play_circle" size="3.5rem" class="deco-note deco-note-2" />
  </div>
  <div class="player-head">
    <div class="disc-wrap">
      <div class="player-disc" id="player-disc">
        <img src={site.avatar} alt="封面" width="64" height="64" />
      </div>
      <span class="disc-ring" aria-hidden="true"></span>
    </div>
    <div class="player-info">
      <div class="player-title-row">
        <span class="player-title" id="player-title">加载中...</span>
        <span class="eq-bars" id="eq-bars" aria-hidden="true">
          <i class="eq-bar"></i><i class="eq-bar"></i><i class="eq-bar"></i><i class="eq-bar"></i>
        </span>
      </div>
      <div class="player-artist" id="player-artist">正在连接音乐平台...</div>
    </div>
  </div>
  <div class="player-playlist-head">
    <span class="playlist-count" id="playlist-count">-- 首</span>
    <button class="playlist-toggle" id="playlist-toggle" title="展开/收起">
      <Icon name="palette" size="0.9rem" /><span class="playlist-toggle-text">列表</span>
    </button>
  </div>
  <div class="player-playlist" id="player-playlist" style="display:none"></div>
  <div class="player-progress" id="player-progress">
    <div class="player-progress-bar" id="player-progress-bar"></div>
  </div>
  <div class="player-time">
    <span id="player-current">0:00</span>
    <span id="player-duration">0:00</span>
  </div>
  <div class="player-controls">
    <button class="ctrl-btn" id="btn-prev" title="上一首"><Icon name="prev" size="1.15rem" /></button>
    <button class="ctrl-btn ctrl-play" id="btn-play" title="播放/暂停">
      <Icon name="play" size="1.35rem" class="ico-play" />
      <Icon name="pause" size="1.35rem" class="ico-pause" />
    </button>
    <button class="ctrl-btn" id="btn-next" title="下一首"><Icon name="next" size="1.15rem" /></button>
    <button class="ctrl-btn" id="btn-mode" title="播放模式" data-mode="list">
      <Icon name="repeat" size="1.1rem" class="ico-list" />
      <Icon name="repeat_one" size="1.1rem" class="ico-one" />
      <Icon name="shuffle" size="1.1rem" class="ico-shuffle" />
    </button>
  </div>
  <div class="player-volume">
    <Icon name="volume" size="1rem" class="vol-icon" />
    <input type="range" id="player-volume" min="0" max="1" step="0.01" value="0.7" aria-label="音量" />
  </div>
</div>
<audio id="audio-el" preload="metadata"></audio>

<!-- Meting.js + APlayer -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.css">
<script src="https://cdn.jsdelivr.net/npm/aplayer@1.10.1/dist/APlayer.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/meting@2.0.1/dist/Meting.min.js"></script>

<script define:vars={{ localTracks, metingConfig }}>
  const player = document.getElementById('music-player');
  const audio = document.getElementById('audio-el');
  const titleEl = document.getElementById('player-title');
  const artistEl = document.getElementById('player-artist');
  const progressBar = document.getElementById('player-progress-bar');
  const progressWrap = document.getElementById('player-progress');
  const currentEl = document.getElementById('player-current');
  const durationEl = document.getElementById('player-duration');
  const playBtn = document.getElementById('btn-play');
  const prevBtn = document.getElementById('btn-prev');
  const nextBtn = document.getElementById('btn-next');
  const modeBtn = document.getElementById('btn-mode');
  const volumeEl = document.getElementById('player-volume');
  const playlistEl = document.getElementById('player-playlist');
  const playlistToggle = document.getElementById('playlist-toggle');
  const playlistCount = document.getElementById('playlist-count');

  let tracks = [];
  let currentIndex = 0;
  let playMode = 'list';
  let useMeting = false;
  let metingPlayer = null;

  function fmt(s) { if (!isFinite(s)) return '0:00'; const m = Math.floor(s/60), x = Math.floor(s%60); return m+':'+x.toString().padStart(2,'0'); }

  function updateHighlight() {
    document.querySelectorAll('.track-item').forEach((el, i) => el.classList.toggle('active', i === currentIndex));
  }

  function renderPlaylist() {
    playlistEl.innerHTML = '';
    tracks.forEach((t, i) => {
      const div = document.createElement('div');
      div.className = 'track-item' + (i === currentIndex ? ' active' : '');
      div.dataset.idx = i;
      div.innerHTML = `<span class="track-num">${i + 1}</span>
        <span class="track-info"><span class="track-name">${t.name}</span><span class="track-artist">${t.artist}</span></span>
        <span class="track-playing"><Icon name="play" size="0.8rem" /></span>`;
      div.addEventListener('click', () => { if (i !== currentIndex) { loadTrack(i); play(); } });
      playlistEl.appendChild(div);
    });
    playlistCount.textContent = tracks.length + ' 首';
  }

  function loadTrack(i) {
    const t = tracks[i]; if (!t) return;
    currentIndex = i;
    if (useMeting && metingPlayer) {
      metingPlayer.list.switch(i);
    } else {
      audio.src = t.url;
      titleEl.textContent = t.name;
      artistEl.textContent = t.artist;
    }
    updateHighlight();
  }

  function play() {
    if (useMeting && metingPlayer) { metingPlayer.play(); }
    else { audio.play().catch(()=>{}); }
    playBtn.classList.add('playing'); player.classList.add('playing');
  }

  function pause() {
    if (useMeting && metingPlayer) { metingPlayer.pause(); }
    else { audio.pause(); }
    playBtn.classList.remove('playing'); player.classList.remove('playing');
  }

  // 尝试初始化 Meting.js
  async function initMeting() {
    try {
      const ap = new APlayer({
        container: document.createElement('div'),
        audio: [],
        mini: false,
        autoplay: false,
        loop: 'all',
        order: 'list',
        preload: 'auto',
        volume: 0.7,
        customAudioType: {
          'audio/mpeg': function(audio, player) { /* fallback */ }
        },
        meting: {
          api: metingConfig.api,
          server: metingConfig.server,
          type: metingConfig.type,
          id: metingConfig.id,
        }
      });

      // 等待 Meting 加载
      await new Promise((resolve, reject) => {
        const timeout = setTimeout(() => reject(new Error('Meting timeout')), 15000);
        ap.on('listready', () => { clearTimeout(timeout); resolve(); });
        ap.on('error', () => { clearTimeout(timeout); reject(new Error('Meting error')); });
      });

      // 获取歌单
      const list = ap.list;
      if (list && list.audios && list.audios.length > 0) {
        tracks = list.audios.map(a => ({ name: a.name, artist: a.artist, url: a.url, cover: a.cover }));
        useMeting = true;
        metingPlayer = ap;
        titleEl.textContent = tracks[0].name;
        artistEl.textContent = tracks[0].artist;
        renderPlaylist();

        // 同步播放状态
        ap.on('play', () => { playBtn.classList.add('playing'); player.classList.add('playing'); });
        ap.on('pause', () => { playBtn.classList.remove('playing'); player.classList.remove('playing'); });
        ap.on('timeupdate', () => {
          if (ap.audio && ap.audio.duration) {
            progressBar.style.width = (ap.audio.currentTime / ap.audio.duration * 100) + '%';
            currentEl.textContent = fmt(ap.audio.currentTime);
            durationEl.textContent = fmt(ap.audio.duration);
          }
        });
        ap.on('ended', () => {
          if (playMode === 'one') { ap.list.switch(currentIndex); ap.play(); }
          else { next(); }
        });

        return true;
      }
    } catch (e) {
      console.log('Meting failed, fallback to local:', e);
    }
    return false;
  }

  // 本地模式
  function initLocal() {
    tracks = localTracks;
    useMeting = false;
    titleEl.textContent = tracks[0].name;
    artistEl.textContent = tracks[0].artist;
    renderPlaylist();
    loadTrack(0);
  }

  // 控制
  playBtn.addEventListener('click', () => audio.paused ? play() : pause());
  nextBtn.addEventListener('click', () => { loadTrack((currentIndex+1)%tracks.length); play(); });
  prevBtn.addEventListener('click', () => { loadTrack((currentIndex-1+tracks.length)%tracks.length); play(); });
  modeBtn.addEventListener('click', () => { playMode = playMode==='list'?'one':playMode==='one'?'shuffle':'list'; modeBtn.dataset.mode = playMode; });
  volumeEl.addEventListener('input', () => {
    const v = parseFloat(volumeEl.value);
    if (useMeting && metingPlayer) metingPlayer.volume(v);
    else audio.volume = v;
  });
  playlistToggle.addEventListener('click', () => {
    const isOpen = playlistEl.style.display !== 'none';
    playlistEl.style.display = isOpen ? 'none' : 'block';
  });

  audio.addEventListener('timeupdate', () => { currentEl.textContent = fmt(audio.currentTime); if (audio.duration) progressBar.style.width = (audio.currentTime/audio.duration*100)+'%'; });
  audio.addEventListener('loadedmetadata', () => durationEl.textContent = fmt(audio.duration));
  audio.addEventListener('ended', () => { if (playMode==='one'){audio.currentTime=0;play();} else { loadTrack((currentIndex+1)%tracks.length); play(); } });
  audio.addEventListener('pause', () => { playBtn.classList.remove('playing'); player.classList.remove('playing'); });
  audio.addEventListener('play', () => { playBtn.classList.add('playing'); player.classList.add('playing'); });
  progressWrap.addEventListener('click', e => { const r = progressWrap.getBoundingClientRect(); if (audio.duration) audio.currentTime = ((e.clientX-r.left)/r.width)*audio.duration; });

  // 续播
  const STATE_KEY = 'tj-music-state';
  function saveState() { try { localStorage.setItem(STATE_KEY, JSON.stringify({ idx: currentIndex, time: audio.currentTime, playing: !audio.paused, mode: playMode, vol: audio.volume })); } catch {} }
  function restoreState() {
    try {
      const s = JSON.parse(localStorage.getItem(STATE_KEY) || 'null'); if (!s) return;
      if (typeof s.idx === 'number' && s.idx < tracks.length) loadTrack(s.idx);
      audio.volume = (typeof s.vol === 'number') ? s.vol : 0.7; volumeEl.value = String(audio.volume);
      if (s.mode) { playMode = s.mode; modeBtn.dataset.mode = playMode; }
      const t = (typeof s.time === 'number' && s.time > 1) ? s.time : 0;
      if (t > 0) audio.addEventListener('loadedmetadata', () => { if (audio.duration && t < audio.duration-1) audio.currentTime = t; }, { once: true });
      if (s.playing) { const p = audio.play(); if (p && p.catch) p.catch(() => {}); }
    } catch {}
  }
  setInterval(saveState, 2000);
  window.addEventListener('pagehide', saveState);
  document.addEventListener('visibilitychange', () => { if (document.hidden) saveState(); });

  // 初始化：先尝试 Meting，失败则用本地
  initMeting().then(success => { if (!success) initLocal(); });
  restoreState();
</script>

<style>
  .music-player { position: relative; display: flex; flex-direction: column; gap: 0.7rem; padding: 0.9rem; border-radius: var(--radius-lg); background: linear-gradient(145deg, oklch(97% 0.02 250) 0%, oklch(95% 0.03 265) 100%); border: 1px solid var(--border); overflow: hidden; }
  [data-theme='dark'] .music-player { background: linear-gradient(145deg, oklch(21% 0.03 250) 0%, oklch(18% 0.04 265) 100%); }
  .music-deco { position: absolute; inset: 0; pointer-events: none; overflow: hidden; }
  .music-deco :global(.deco-note) { position: absolute; color: var(--primary); opacity: 0.06; }
  .music-deco :global(.deco-note-1) { right: -0.8rem; top: -0.6rem; transform: rotate(14deg); }
  .music-deco :global(.deco-note-2) { left: -0.7rem; bottom: -0.5rem; transform: rotate(-12deg); }
  .player-head { position: relative; display: flex; align-items: center; gap: 0.75rem; }
  .disc-wrap { position: relative; width: 60px; height: 60px; flex-shrink: 0; }
  .player-disc { width: 60px; height: 60px; border-radius: 50%; overflow: hidden; box-shadow: 0 4px 14px oklch(0% 0 0 / 0.18); border: 2px solid oklch(100% 0 0 / 0.7); position: relative; z-index: 1; background: #14111f; }
  [data-theme='dark'] .player-disc { border-color: oklch(100% 0 0 / 0.14); }
  .player-disc img { width: 100%; height: 100%; object-fit: cover; }
  .music-player.playing .player-disc { animation: disc-spin 8s linear infinite; }
  @keyframes disc-spin { to { transform: rotate(360deg); } }
  .disc-ring { position: absolute; inset: -4px; border-radius: 50%; border: 2px solid var(--primary); opacity: 0; transition: opacity 0.3s ease; }
  .music-player.playing .disc-ring { opacity: 0.45; animation: ring-pulse 2s ease-in-out infinite; }
  @keyframes ring-pulse { 0%, 100% { transform: scale(1); opacity: 0.35; } 50% { transform: scale(1.12); opacity: 0.12; } }
  .player-info { flex: 1; min-width: 0; }
  .player-title-row { display: flex; align-items: center; gap: 0.45rem; }
  .player-title { font-weight: 600; font-size: 0.92rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .eq-bars { display: flex; align-items: flex-end; gap: 2px; height: 14px; flex-shrink: 0; }
  .eq-bar { display: block; width: 3px; height: 4px; border-radius: 2px; background: var(--primary); opacity: 0.35; transition: opacity 0.3s ease; }
  .music-player.playing .eq-bar { opacity: 1; animation: eq-bounce 1.2s ease-in-out infinite; }
  .music-player.playing .eq-bar:nth-child(1) { animation-duration: 0.8s; }
  .music-player.playing .eq-bar:nth-child(2) { animation-duration: 0.6s; animation-delay: 0.15s; }
  .music-player.playing .eq-bar:nth-child(3) { animation-duration: 1s; animation-delay: 0.3s; }
  .music-player.playing .eq-bar:nth-child(4) { animation-duration: 0.9s; animation-delay: 0.1s; }
  @keyframes eq-bounce { 0%, 100% { height: 4px; } 50% { height: 14px; } }
  .player-artist { font-size: 0.75rem; color: var(--text-faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .player-playlist-head { display: flex; align-items: center; justify-content: space-between; padding: 0.3rem 0.2rem; }
  .playlist-count { font-size: 0.72rem; color: var(--text-faint); }
  .playlist-toggle { display: inline-flex; align-items: center; gap: 0.25rem; border: none; background: transparent; color: var(--text-faint); cursor: pointer; font-size: 0.75rem; padding: 0.15rem 0.4rem; border-radius: 999px; transition: all 0.15s ease; }
  .playlist-toggle:hover { color: var(--primary); background: var(--primary-soft); }
  .playlist-toggle :global(.icon) { opacity: 0.7; }
  .player-playlist { max-height: 180px; overflow-y: auto; margin-top: 0.3rem; border-top: 1px solid var(--border); padding-top: 0.3rem; }
  .track-item { display: flex; align-items: center; gap: 0.5rem; padding: 0.35rem 0.4rem; border-radius: var(--radius-sm); cursor: pointer; transition: all 0.12s ease; }
  .track-item:hover { background: var(--surface-2); }
  .track-item.active { background: var(--primary-soft); }
  .track-item.active .track-name { color: var(--primary-strong); font-weight: 600; }
  .track-num { width: 1.2rem; text-align: center; font-size: 0.72rem; color: var(--text-faint); flex-shrink: 0; }
  .track-item.active .track-num { display: none; }
  .track-info { flex: 1; min-width: 0; display: flex; flex-direction: column; }
  .track-name { font-size: 0.8rem; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .track-artist { font-size: 0.68rem; color: var(--text-faint); }
  .track-playing { display: none; color: var(--primary); flex-shrink: 0; }
  .track-item.active .track-playing { display: inline-block; }
  [data-theme='dark'] .track-item:hover { background: oklch(22% 0.02 250); }
  [data-theme='dark'] .track-item.active { background: oklch(25% 0.04 265); }
  .player-progress { height: 4px; background: oklch(0% 0 0 / 0.07); border-radius: 999px; cursor: pointer; overflow: hidden; }
  [data-theme='dark'] .player-progress { background: oklch(100% 0 0 / 0.1); }
  .player-progress-bar { height: 100%; width: 0; background: var(--primary); border-radius: 999px; transition: width 0.1s linear; }
  .player-time { display: flex; justify-content: space-between; font-size: 0.7rem; color: var(--text-faint); margin-top: -0.35rem; }
  .player-controls { display: flex; justify-content: center; align-items: center; gap: 0.5rem; }
  .ctrl-btn { width: 36px; height: 36px; border-radius: 50%; border: 1px solid transparent; background: transparent; color: var(--text-soft); cursor: pointer; display: grid; place-items: center; transition: all 0.18s ease; }
  .ctrl-btn:hover { background: var(--primary-soft); color: var(--primary); }
  .ctrl-btn:active { transform: scale(0.94); }
  .ctrl-btn :global(.icon) { grid-area: 1 / 1; }
  .ctrl-play :global(.ico-pause) { display: none; }
  .ctrl-play.playing :global(.ico-play) { display: none; }
  .ctrl-play.playing :global(.ico-pause) { display: inline-block; }
  #btn-mode :global(.ico-one), #btn-mode :global(.ico-shuffle) { display: none; }
  #btn-mode[data-mode='one'] :global(.ico-list) { display: none; }
  #btn-mode[data-mode='one'] :global(.ico-one) { display: inline-block; }
  #btn-mode[data-mode='shuffle'] :global(.ico-list) { display: none; }
  #btn-mode[data-mode='shuffle'] :global(.ico-shuffle) { display: inline-block; }
  .ctrl-play { width: 46px; height: 46px; background: var(--primary); color: var(--text-on-primary); box-shadow: 0 4px 14px oklch(70% 0.14 250 / 0.35); }
  .ctrl-play:hover { background: var(--primary-strong); color: var(--text-on-primary); transform: scale(1.05); }
  .ctrl-play:active { transform: scale(0.96); }
  .player-volume { display: flex; align-items: center; gap: 0.5rem; }
  .vol-icon { color: var(--text-faint); flex-shrink: 0; }
  .player-volume input[type='range'] { flex: 1; height: 4px; accent-color: var(--primary); cursor: pointer; }
</style>
