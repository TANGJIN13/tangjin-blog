---
// 正在学习中
import Icon from './Icon.astro';

const learning = [
  { name: 'Web 安全', icon: 'lock' },
  { name: 'CTF', icon: 'flag' },
  { name: 'Python', icon: 'code' },
  { name: 'Linux', icon: 'terminal' },
  { name: 'Docker', icon: 'cube' },
  { name: 'Astro', icon: 'code' },
];
---

<div class="learn-list">
  {learning.map(item => (
    <span class="learn-tag glass">
      <Icon name={item.icon} size="0.85rem" />
      {item.name}
    </span>
  ))}
</div>

<style>
  .learn-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .learn-tag {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.85rem;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 500;
    transition: all 0.15s ease;
  }
  .learn-tag:hover { transform: translateY(-2px); box-shadow: var(--shadow-sm); }
  .learn-tag :global(.icon) { color: var(--primary); opacity: 0.8; }
</style>
