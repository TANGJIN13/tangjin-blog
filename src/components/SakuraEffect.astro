---
// 樱花飘落特效 —— canvas 实现，全站生效
// 三种状态：
//   burst（默认）—— 打开页面时飘 10 秒，落完自动收摊，不打扰
//   on           —— 点按钮后常开，一直飘
//   off          —— 再点一次关掉
// 状态存 sessionStorage，客户端路由切页 / 刷新都能续上。
//
// 按钮本体（#btn-sakura）不在这里，而是挂在 Base.astro 的 .floating-controls 里，
// 作为那一列浮动按钮的第四个 —— 这样它天然和另外三个同一条右轨、同一个层叠上下文，
// 不会像之前那样被浮动按钮盖住（之前它 fixed 在 right:1.35rem / bottom:8.5rem，
// 正好落在浮动按钮栈 [bottom 48px 起、高 119px] 的范围内，elementFromPoint 打到的
// 永远是别人的图标，整颗按钮根本点不到）。本组件只负责行为：按 id 找到它、绑事件、同步状态。
//
// 注意：脚本部分**必须写纯 JS**，Astro 的脚本块里塞 TS 类型标注会直接报错、整段不执行（踩过）。
---

<canvas id="sakura-canvas" aria-hidden="true"></canvas>

<script>
  // 打开页面先飘一阵子的时长
  const BURST_MS = 10000;
  // 常开时的花瓣数量（少一点更像「偶尔飘落」而不是暴雪）
  const TARGET_PETALS = 32;
  const KEY = 'tj-sakura-mode';

  // 花瓣配色：比早期的浅粉更深。整站底色换成浅色水彩后，
  // 原来的 #ffb7c5 之类贴在浅色背景上色差只有 6% 左右，几乎看不见。
  const PETAL_COLORS = ['#f489a6', '#ef7d9c', '#f795ae', '#e8708f', '#f58aa3', '#ec7f9d'];
  // 描边：浅色背景（白色正文、浅色壁纸）上给花瓣一个轮廓，不然会糊在背景里
  const PETAL_EDGE = 'rgba(198, 88, 132, 0.42)';
  const SPARKLE_COLORS = ['#fff', '#ffe4f0', '#ffd7ec', '#fff0f5', '#ffe0ec'];

  const rand = (a, b) => a + Math.random() * (b - a);

  let canvas = null;
  let toggleBtn = null;
  let ctx = null;

  let mode = 'burst';       // 'burst' | 'on' | 'off'
  let animId = 0;
  let petals = [];
  let sparkles = [];
  let mouse = { x: -1000, y: -1000 };
  let spawnDeadline = 0;
  // 本次会话是否已经飘过「开站那一阵子」，避免每次切页都重来一遍
  let burstPlayed = false;

  function readSaved() {
    try {
      return sessionStorage.getItem(KEY);
    } catch (e) {
      return null;
    }
  }
  function saveMode(m) {
    try {
      sessionStorage.setItem(KEY, m);
    } catch (e) {}
  }

  function resize() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
  }

  // initial = true 时把花瓣随机撒在整个视口里（一进来就已经是「在飘」的状态），
  // 否则从屏幕上方外部生成，让花瓣自然飘进来
  function createPetal(initial) {
    return {
      x: Math.random() * canvas.width,
      y: initial ? Math.random() * canvas.height : -20 - Math.random() * 100,
      size: 6 + Math.random() * 10,
      speedY: rand(0.35, 1.25),
      speedX: rand(-0.3, 0.3),
      rotation: Math.random() * Math.PI * 2,
      rotSpeed: rand(-0.022, 0.022),
      // 透明度整体上调：浅色底需要更高的不透明度才看得出花瓣
      opacity: rand(0.55, 0.9),
      color: PETAL_COLORS[Math.floor(Math.random() * PETAL_COLORS.length)],
      swing: 0,
      swingSpeed: rand(0.008, 0.03),
    };
  }

  function createSparkle() {
    return {
      x: mouse.x + (Math.random() - 0.5) * 60,
      y: mouse.y + (Math.random() - 0.5) * 60,
      size: 1 + Math.random() * 3,
      opacity: 0,
      speed: rand(0.5, 2),
      angle: Math.random() * Math.PI * 2,
      color: SPARKLE_COLORS[Math.floor(Math.random() * SPARKLE_COLORS.length)],
      life: 0,
      maxLife: rand(30, 70),
    };
  }

  // 花瓣形状：基部收窄、末端宽圆并带一个凹口 —— 比原来的「两头尖」更像樱花瓣
  function petalPath(size) {
    ctx.beginPath();
    ctx.moveTo(0, -size);
    ctx.bezierCurveTo(size * 0.74, -size * 0.44, size * 0.64, size * 0.5, size * 0.4, size * 0.84);
    ctx.quadraticCurveTo(0, size * 0.6, -size * 0.4, size * 0.84);
    ctx.bezierCurveTo(-size * 0.64, size * 0.5, -size * 0.74, -size * 0.44, 0, -size);
    ctx.closePath();
  }

  function drawPetal(p) {
    ctx.save();
    ctx.translate(p.x, p.y);
    ctx.rotate(p.rotation);
    ctx.globalAlpha = p.opacity;
    ctx.fillStyle = p.color;

    petalPath(p.size);
    ctx.fill();
    // 描边：浅色区域（白色正文、浅色壁纸）上给花瓣一个轮廓，不然会糊在背景里
    ctx.globalAlpha = p.opacity * 0.8;
    ctx.strokeStyle = PETAL_EDGE;
    ctx.lineWidth = 1;
    ctx.stroke();

    // 花瓣上的高光
    ctx.globalAlpha = p.opacity * 0.35;
    ctx.fillStyle = '#fff';
    ctx.beginPath();
    ctx.ellipse(-p.size * 0.14, -p.size * 0.1, p.size * 0.13, p.size * 0.26, -0.3, 0, Math.PI * 2);
    ctx.fill();

    ctx.restore();
  }

  function drawSparkle(s) {
    const fadeIn = Math.min(s.life / 10, 1);
    const fadeOut = Math.min((s.maxLife - s.life) / 15, 1);
    const alpha = s.opacity * fadeIn * fadeOut;
    if (alpha <= 0) return;

    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.fillStyle = s.color;
    ctx.shadowColor = s.color;
    ctx.shadowBlur = 6;

    ctx.translate(s.x, s.y);
    ctx.beginPath();
    ctx.moveTo(0, -s.size);
    ctx.lineTo(s.size * 0.2, -s.size * 0.2);
    ctx.lineTo(s.size, 0);
    ctx.lineTo(s.size * 0.2, s.size * 0.2);
    ctx.lineTo(0, s.size);
    ctx.lineTo(-s.size * 0.2, s.size * 0.2);
    ctx.lineTo(-s.size, 0);
    ctx.lineTo(-s.size * 0.2, -s.size * 0.2);
    ctx.closePath();
    ctx.fill();

    ctx.restore();
  }

  // 鼠标跟随光晕（用站点主色相）
  function drawMouseGlow() {
    if (mouse.x < 0) return;
    const hue = getComputedStyle(document.documentElement).getPropertyValue('--hue').trim() || '300';
    ctx.save();
    const grad = ctx.createRadialGradient(mouse.x, mouse.y, 0, mouse.x, mouse.y, 120);
    grad.addColorStop(0, 'hsl(' + hue + ' 80% 70% / 0.08)');
    grad.addColorStop(0.5, 'hsl(' + hue + ' 80% 70% / 0.03)');
    grad.addColorStop(1, 'transparent');
    ctx.fillStyle = grad;
    ctx.fillRect(mouse.x - 120, mouse.y - 120, 240, 240);
    ctx.restore();
  }

  function tick() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    drawMouseGlow();

    const continuous = mode === 'on';
    const spawning = continuous || Date.now() < spawnDeadline;

    // 常开模式：维持一个稳定的花瓣数量
    if (continuous) {
      while (petals.length < TARGET_PETALS) petals.push(createPetal(false));
    }

    for (let i = petals.length - 1; i >= 0; i--) {
      const p = petals[i];
      p.y += p.speedY;
      p.x += p.speedX + Math.sin(p.swing) * 0.5;
      p.swing += p.swingSpeed;
      p.rotation += p.rotSpeed;
      if (p.y > canvas.height + 20) {
        if (continuous || Date.now() < spawnDeadline) {
          Object.assign(p, createPetal(false));
        } else {
          petals.splice(i, 1);
          continue;
        }
      }
      drawPetal(p);
    }

    // 闪光粒子（只在生成窗口内、且有鼠标时）
    if (spawning && mouse.x > 0 && Math.random() < 0.3) sparkles.push(createSparkle());
    for (let i = sparkles.length - 1; i >= 0; i--) {
      const s = sparkles[i];
      s.life++;
      s.x += Math.cos(s.angle) * s.speed;
      s.y += Math.sin(s.angle) * s.speed - 0.3;
      s.opacity = 1;
      drawSparkle(s);
      if (s.life >= s.maxLife) sparkles.splice(i, 1);
    }

    // 一阵子模式：过点且花瓣/闪光都落完了 → 自动收摊
    if (mode === 'burst' && Date.now() >= spawnDeadline && petals.length === 0 && sparkles.length === 0) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      animId = 0;
      return;
    }

    animId = requestAnimationFrame(tick);
  }

  function start(initial) {
    resize();
    petals = Array.from({ length: initial ? TARGET_PETALS : 6 }, function () {
      return createPetal(initial);
    });
    sparkles = [];
    if (animId) cancelAnimationFrame(animId);
    tick();
  }

  function stop() {
    if (animId) cancelAnimationFrame(animId);
    animId = 0;
    if (ctx && canvas) ctx.clearRect(0, 0, canvas.width, canvas.height);
    petals = [];
    sparkles = [];
    spawnDeadline = 0;
  }

  function syncButton() {
    if (!toggleBtn) return;
    const on = mode === 'on';
    toggleBtn.classList.toggle('active', on);
    toggleBtn.title = on ? '关闭樱花特效' : '一直飘樱花';
    toggleBtn.setAttribute('aria-pressed', String(on));
  }

  function setMode(next, initial) {
    mode = next;
    saveMode(next);
    syncButton();
    if (next === 'off') {
      stop();
    } else {
      spawnDeadline = next === 'burst' ? Date.now() + BURST_MS : 0;
      start(!!initial);
    }
  }

  function onClick() {
    setMode(mode === 'on' ? 'off' : 'on');
  }

  function onMove(e) {
    mouse.x = e.clientX;
    mouse.y = e.clientY;
  }
  function onLeave() {
    mouse.x = -1000;
    mouse.y = -1000;
  }
  function onResize() {
    if (mode !== 'off') resize();
  }

  window.addEventListener('mousemove', onMove);
  window.addEventListener('mouseleave', onLeave);
  window.addEventListener('resize', onResize);

  // 初始化：每次换页（客户端路由会换掉 canvas / 按钮元素）都要重新取元素、重绑事件
  function init() {
    // 先把挂在旧元素上的循环停掉
    if (animId) cancelAnimationFrame(animId);
    animId = 0;
    petals = [];
    sparkles = [];

    canvas = document.getElementById('sakura-canvas');
    toggleBtn = document.getElementById('btn-sakura');
    if (!canvas || !toggleBtn) return;
    ctx = canvas.getContext('2d');
    if (!ctx) return;
    toggleBtn.onclick = onClick;

    const saved = readSaved();
    if (saved === 'off') return setMode('off', false);
    if (saved === 'on') return setMode('on', true);

    // 只尊重系统的「减少动态效果」；手机端也照常飘。
    // 之前这里还有一条 `window.innerWidth < 768` 直接跳过，「刚点开网站飘 10 秒」
    // 在手机上根本没生效过。花瓣只有 32 片、10 秒后自动收摊，开销可以忽略。
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce) return setMode('off', false);

    // 开站那一阵子只在本次会话的第一次播放
    if (burstPlayed) return syncButton();
    burstPlayed = true;
    setMode('burst', true);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  #sakura-canvas {
    position: fixed;
    inset: 0;
    pointer-events: none;
    z-index: 1;
  }

  /* 按钮样式不在这里 —— 按钮本体和外观都归 Base.astro 的 .floating-controls /
     global.css 的 .floating-btn（第四个按钮），开/关态用 .floating-btn.active。
     本组件只保留上面这层 canvas。 */
</style>
