---
// 首页「最新文章」单列横向行：左缩略图 + 标题 + 摘要 + 标签药丸 + 右下角阅读时长
// 仅首页使用；归档 / 标签页用 PostCard（极简文本卡），与本组件同语言。
import { readingTime, type Post } from '../lib/posts';
import { fallbackCover } from '../lib/covers';
import { categories } from '../data/categories';
import Icon from './Icon.astro';

interface Props {
  post: Post;
  index?: number;
}

const { post, index } = Astro.props;
const { title, description, tags, cover, category } = post.data;
const minutes = readingTime(post.body);

const cat = categories.find((c) => c.slug === (category ?? ''));
const shownTags = tags.slice(0, 3);

// 摘要：description 优先，否则从正文提取纯文本
const plainBody = post.body
  .replace(/!?\[\[([^\]|]*)(?:\|([^\]]*))?\]\]/g, '$1')
  .replace(/!\[[^\]]*\]\([^)]*\)/g, ' ')
  .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')
  .replace(/```[\s\S]*?```/g, ' ')
  .replace(/^\s{0,3}>\s?/gm, '')
  .replace(/^\s{0,3}#+\s+/gm, '')
  .replace(/[*_~`]/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const excerpt = (description ?? '').trim() || plainBody.slice(0, 110);

// 缩略图兜底：与 PostCard 共用同一套池子（见 lib/covers.ts），按位置轮换避免相邻撞图。
const pick = typeof index === 'number' ? index : 0;
const coverSrc = cover ?? fallbackCover(pick);
---

<a class="post-row" href={`/posts/${post.id}/`}>
  <div class="post-row-thumb">
    <img src={coverSrc} alt="" loading="lazy" />
  </div>

  <div class="post-row-body">
    <h3 class="post-row-title">{title}</h3>
    {excerpt && <p class="post-row-desc">{excerpt}</p>}

    <div class="post-row-foot">
      <div class="post-row-tags">
        {cat && (
          <span class="pr-chip is-cat">
            <Icon name={cat.icon || 'folder'} size="0.66rem" />{cat.name}
          </span>
        )}
        {shownTags.map((t) => (
          <span class="pr-chip">#{t}</span>
        ))}
      </div>
      <span class="post-row-read">
        <Icon name="clock" size="0.72rem" /> {minutes} 分钟
      </span>
    </div>
  </div>
</a>

<style>
  /* 极简横向行卡：白底 + 细发丝线 + 悬停只换边框色。
     不挂 .glass-card：和 PostCard 保持同一套语言，整站只剩一种卡片外观。 */
  .post-row {
    display: flex;
    align-items: stretch;
    gap: 1rem;
    padding: 0.95rem 1rem;
    border: 1px solid var(--border-light);
    border-radius: var(--radius-lg);
    background: var(--surface);
    text-decoration: none !important;
    color: inherit;
    transition: border-color 0.18s ease, background-color 0.18s ease;
  }
  .post-row:hover {
    border-color: var(--primary);
    background: color-mix(in srgb, var(--primary) 3%, var(--surface));
  }

  /* 左缩略图：固定 140×96，不再 hover 缩放 */
  .post-row-thumb {
    position: relative;
    flex-shrink: 0;
    width: 140px;
    height: 96px;
    border-radius: 0.75rem;
    overflow: hidden;
    background: var(--surface-2);
  }
  .post-row-thumb img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .post-row-body {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .post-row-title {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
    color: var(--text);
    transition: color 0.18s ease;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .post-row:hover .post-row-title { color: var(--primary); }

  .post-row-desc {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--text-soft);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-row-foot {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 0.15rem;
  }
  .post-row-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.28rem;
    min-width: 0;
    overflow: hidden;
  }
  .pr-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.22rem;
    padding: 0.14rem 0.5rem;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 600;
    white-space: nowrap;
    color: var(--text-faint);
    background: color-mix(in srgb, var(--text) 4%, transparent);
    border: 1px solid color-mix(in srgb, var(--text) 8%, transparent);
  }
  .pr-chip.is-cat {
    color: var(--primary-strong);
    background: var(--primary-soft);
    border-color: color-mix(in srgb, var(--primary) 20%, transparent);
  }
  :global([data-theme='dark'] .pr-chip.is-cat) { color: var(--primary-light); }
  .post-row-read {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    margin-left: auto;
    flex-shrink: 0;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--text-faint);
    font-variant-numeric: tabular-nums;
  }

  /* 窄屏：缩略图缩小，仍保持左右布局 */
  @media (max-width: 560px) {
    .post-row { gap: 0.75rem; padding: 0.8rem; }
    .post-row-thumb { width: 96px; height: 72px; }
    .post-row-title { font-size: 0.92rem; }
  }
</style>
