       顶部那条像素停靠的导航带和桌面共用，不动。 */
    .wallpaper-dim::after {
      background:
        linear-gradient(180deg,
          oklch(0% 0 0 / 0) 26%,
          oklch(0% 0 0 / 0.04) 34%,
          oklch(0% 0 0 / 0.09) 43%,
          oklch(0% 0 0 / 0.10) 52%,
          oklch(0% 0 0 / 0.08) 60%,
