  @media (max-width: 1023px) and (max-height: 500px) { .wallpaper-wrapper:not([style*='--wp-mobile-height']) { height: 85vh !important; } }
  @media (max-width: 1023px) and (min-height: 501px) and (max-height: 600px) { .wallpaper-wrapper:not([style*='--wp-mobile-height']) { height: 80vh !important; } }
  @media (max-width: 1023px) and (min-height: 601px) and (max-height: 700px) { .wallpaper-wrapper:not([style*='--wp-mobile-height']) { height: 75vh !important; } }

  /* ===== 满屏模式（首页）=====
     ⚠️ 必须写在上面所有移动端覆盖规则**之后**：那些规则带 !important，
