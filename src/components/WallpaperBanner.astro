  .wave-layer:nth-child(1) { animation-duration: 7s;  animation-delay: -2s; }
  .wave-layer:nth-child(2) { animation-duration: 10s; animation-delay: -3s; }
  .wave-layer:nth-child(3) { animation-duration: 13s; animation-delay: -4s; }
  .wave-layer:nth-child(4) { animation-duration: 20s; animation-delay: -5s; }

  @keyframes wave-move {
    0%   { transform: translate(-90px); }
    100% { transform: translate(85px); }
  }

  /* 渐变淡出：长距离柔和过渡，让壁纸底部自然消融到页面背景 */
  .wallpaper-gradient {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 17%;
    z-index: 4;
    pointer-events: none;
    /* 只在波浪正上方一小段柔化交界，不再拉出一条大色带 */
