---
// 顶部壁纸横幅 —— 参照 c1everf0x.cn 的 #wallpaper-wrapper
// 全宽 720px、多图轮播、底部波浪 + 渐变淡出
import { site } from '../site';

interface Props {
  images?: string[];
  height?: string;
}

const {
  images = [
    '/images/wallpapers/banner-cosmic.jpg',
    '/images/wallpapers/banner-nebula.jpg',
    '/images/wallpapers/banner-starry.jpg',
  ],
  height = 'clamp(520px, 88vh, 920px)',
  mobileHeight = 'clamp(320px, 65vh, 520px)',
  /** 单图模式：不轮播（文章页用封面图时开启） */
  single = false,
} = Astro.props;

// 有插槽内容时用它替代默认的「头像 + 座右铭」，文章页据此放自己的标题
const hasSlot = Astro.slots.has('default');
const slides = single ? images.slice(0, 1) : images;
---

<div class="wallpaper-wrapper" style={`--wp-height: ${height}; --wp-mobile-height: ${mobileHeight}`} data-interval="7000">
  <!-- 轮播图片 -->
  <div class="wallpaper-images" id="wallpaper-images">
    {slides.map((src, i) => (
      <div class:list={['wp-slide', { active: i === 0 }]} data-index={i}>
        <img src={src} alt={`壁纸 ${i + 1}`} loading={i === 0 ? 'eager' : 'lazy'} />
      </div>
    ))}
  </div>

  <!-- 暗角遮罩 -->
  <div class="wallpaper-dim" aria-hidden="true"></div>

  <!-- 文字覆盖层 -->
  <div class="wallpaper-content">
    <div class="container wp-inner">
      {hasSlot ? (
        <slot />
      ) : (
        <>
          <!-- 轮换句子 —— 直接作为横幅文字，句尾带闪烁光标，每隔几秒淡入换一句 -->
          <div class="wp-quotes" id="wp-quotes" data-interval="6000">
            {site.mottos.map((m, i) => (
              <div class:list={['wp-quote', { active: i === 0 }]}>
                <h1 class="wp-title">{m.text}<span class="wp-caret" aria-hidden="true"></span></h1>
                {m.sub && <p class="wp-quote-sub">{m.sub}</p>}
              </div>
            ))}
          </div>
        </>
      )}
    </div>

    <!-- 向下浏览引导 -->
    {!hasSlot && (
      <a class="wp-scroll" href="#main-content" aria-label="向下浏览">
        <span class="wp-mouse"><i></i></span>
        <span class="wp-scroll-text">向下浏览</span>
      </a>
    )}
  </div>

  <!-- 底部海浪：4 层同色波浪错速流动，颜色 = 页面背景色，与内容区无缝衔接 -->
  <div class="header-waves" aria-hidden="true">
    <svg viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="geometricPrecision">
      <defs>
        <path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v48h-352z"/>
      </defs>
      <g class="parallax">
        <use href="#gentle-wave" x="48" y="0" class="wave-layer" style="--wave-op: 0.25;" />
        <use href="#gentle-wave" x="48" y="3" class="wave-layer" style="--wave-op: 0.5;" />
        <use href="#gentle-wave" x="48" y="5" class="wave-layer" style="--wave-op: 0.65;" />
        <use href="#gentle-wave" x="48" y="7" class="wave-layer" style="--wave-op: 0.75;" />
      </g>
    </svg>
  </div>

  <!-- 渐变淡出：长过渡层，让壁纸底部自然消融到页面背景中 -->
  <div class="wallpaper-gradient" aria-hidden="true"></div>
</div>

<script>
  // 壁纸轮播
  const wrap = document.querySelector('.wallpaper-wrapper');
  const slides = document.querySelectorAll('.wp-slide');
  if (wrap && slides.length > 1) {
    const interval = parseInt(wrap.dataset.interval || '7000', 10);
    let idx = 0;
    setInterval(() => {
      slides[idx].classList.remove('active');
      idx = (idx + 1) % slides.length;
      slides[idx].classList.add('active');
    }, interval);
  }

  // 座右铭轮换：淡入浮现 → 停留几秒 → 淡出，再换下一句
  const quoteWrap = document.getElementById('wp-quotes');
  if (quoteWrap) {
    const quotes = Array.from(quoteWrap.querySelectorAll('.wp-quote'));
    if (quotes.length > 1) {
      const quoteInterval = parseInt(quoteWrap.dataset.interval || '6000', 10);
      let qi = 0;
      setInterval(() => {
        const cur = quotes[qi];
        cur.classList.remove('active');
        cur.classList.add('leaving');
        setTimeout(() => cur.classList.remove('leaving'), 700);
        qi = (qi + 1) % quotes.length;
        quotes[qi].classList.add('active');
      }, quoteInterval);
    }
  }
</script>

<style>
  .wallpaper-wrapper {
    position: relative;
    width: 100%;
    height: var(--wp-height);
    overflow: hidden;
    z-index: 0;
  }
  @media (max-width: 767px) {
    .wallpaper-wrapper { height: var(--wp-mobile-height); }
  }

  /* 图片层 */
  .wallpaper-images { position: absolute; inset: 0; background: #1a1735; }
  .wp-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 1.4s ease, transform 8s ease-out;
  }
  .wp-slide.active { opacity: 1; transform: scale(1); }
  .wp-slide img { width: 100%; height: 100%; object-fit: cover; }

  /* 暗角遮罩 —— 让白色文字可读 */
  .wallpaper-dim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg,
        oklch(0% 0 0 / 0.35) 0%,
        oklch(0% 0 0 / 0.22) 30%,
        oklch(0% 0 0 / 0.30) 65%,
        oklch(0% 0 0 / 0.18) 100%);
    z-index: 1;
  }

  /* 文字内容 */
  .wallpaper-content {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .wp-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.75rem;
  }

  /* ===== 慢慢浮现：模糊 → 清晰 + 上移，逐层延迟 ===== */
  @keyframes wp-reveal {
    from {
      opacity: 0;
      transform: translateY(28px) scale(0.985);
      filter: blur(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
      filter: blur(0);
    }
  }

  .wp-desc        { animation: wp-reveal 1.9s cubic-bezier(0.16, 1, 0.3, 1) 1.3s both; }
  .wp-links       { animation: wp-reveal 1.9s cubic-bezier(0.16, 1, 0.3, 1) 1.5s both; }


  /* ===== 向下浏览引导 ===== */
  .wp-scroll {
    position: absolute;
    left: 50%;
    bottom: 178px;
    transform: translateX(-50%);
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.35rem;
    color: oklch(100% 0 0 / 0.8);
    text-decoration: none !important;
    animation: wp-reveal 1.2s ease 1.9s both;
  }
  .wp-scroll:hover { color: #fff; }
  .wp-mouse {
    width: 22px; height: 34px;
    border-radius: 999px;
    border: 2px solid oklch(100% 0 0 / 0.65);
    display: grid;
    justify-items: center;
    padding-top: 6px;
  }
  .wp-mouse i {
    width: 3px; height: 7px;
    border-radius: 999px;
    background: oklch(100% 0 0 / 0.9);
    animation: wheel-roll 1.6s ease-in-out infinite;
  }
  @keyframes wheel-roll {
    0%   { opacity: 0; transform: translateY(-3px); }
    40%  { opacity: 1; transform: translateY(0); }
    100% { opacity: 0; transform: translateY(8px); }
  }
  .wp-scroll-text {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-shadow: 0 1px 10px oklch(0% 0 0 / 0.5);
  }
  .wp-scroll:hover .wp-mouse { border-color: oklch(100% 0 0 / 0.95); }

  .wp-title {
    font-size: clamp(2.4rem, 6vw, 4.5rem);
    font-weight: 400;
    margin: 0;
    color: #fff;
    letter-spacing: normal;
    line-height: 1.2;
    font-family: 'Zhi Mang Xing', 'Xingkai SC', 'STXingkai', 'HanziPen SC', 'Kaiti SC', 'STKaiti', 'KaiTi', '楷体', serif;
    text-wrap: balance;
    word-break: keep-all;
    text-shadow: 0 4px 24px rgba(0, 0, 0, 0.6);
  }

  /* ===== 句子轮换：同格堆叠，逐句淡入浮现 / 淡出上移 ===== */
  .wp-quotes {
    display: grid;
    width: 100%;
    animation: wp-reveal 1.4s cubic-bezier(0.16, 1, 0.3, 1) 0.15s both;
  }
  .wp-quote {
    grid-area: 1 / 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    opacity: 0;
    pointer-events: none;
  }
  .wp-quote-sub {
    margin: 0.6rem 0 0;
    font-size: clamp(0.95rem, 1.6vw, 1.5rem);
    font-weight: 400;
    color: rgba(255, 255, 255, 0.9);
    letter-spacing: normal;
    font-family: 'Zhi Mang Xing', 'Xingkai SC', 'STXingkai', 'HanziPen SC', 'Kaiti SC', 'STKaiti', 'KaiTi', '楷体', serif;
    text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.7);
  }
  .wp-quote.active {
    opacity: 1;
    pointer-events: auto;
    animation: quote-in 1s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  .wp-quote.leaving { animation: quote-out 0.7s ease both; }

  /* 句尾闪烁光标 */
  .wp-caret {
    display: inline-block;
    width: 2px;
    height: 1em;
    margin-left: 0.32em;
    vertical-align: -0.12em;
    background: currentColor;
    animation: caret-blink 1.1s step-end infinite;
  }
  @keyframes caret-blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
  @keyframes quote-in {
    from { opacity: 0; transform: translateY(26px) scale(0.98); filter: blur(10px); }
    to   { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
  }
  @keyframes quote-out {
    from { opacity: 1; transform: translateY(0) scale(1); filter: blur(0); }
    to   { opacity: 0; transform: translateY(-20px) scale(0.99); filter: blur(8px); }
  }

  .wp-desc {
    margin: 0;
    max-width: 36rem;
    font-size: clamp(0.88rem, 1.5vw, 1.02rem);
    color: oklch(100% 0 0 / 0.9);
    text-shadow: 0 1px 14px oklch(0% 0 0 / 0.6);
  }

  .wp-links { display: flex; gap: 0.5rem; margin-top: 0.2rem; }
  .wp-link {
    padding: 0.45rem 1.1rem;
    border-radius: 999px;
    font-size: 0.88rem;
    font-weight: 500;
    color: #fff;
    background: oklch(100% 0 0 / 0.16);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border: 1px solid oklch(100% 0 0 / 0.28);
    text-decoration: none !important;
    transition: all 0.2s ease;
  }
  .wp-link:hover {
    background: oklch(100% 0 0 / 0.28);
    transform: translateY(-2px);
    color: #fff;
  }

  /* ===== 底部海浪：4 层同色波浪错速流动（参照 c1everf0x.cn）===== */
  .header-waves {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    width: 100%;
    height: 15vh;
    min-height: 50px;
    max-height: 150px;
    z-index: 6;
    pointer-events: none;
    overflow: visible;
  }
  .header-waves svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .header-waves .parallax {
    will-change: transform;
    backface-visibility: hidden;
    transform: translateZ(0);
  }
  /* 每层都填页面背景色，透明度递进，速度各异 → 视差流动 */
  .wave-layer {
    fill: var(--bg);
    opacity: var(--wave-op);
    animation: wave-move 25s cubic-bezier(0.5, 0.5, 0.45, 0.5) infinite;
  }
  .wave-layer:nth-child(1) { animation-duration: 7s;  animation-delay: -2s; }
  .wave-layer:nth-child(2) { animation-duration: 10s; animation-delay: -3s; }
  .wave-layer:nth-child(3) { animation-duration: 13s; animation-delay: -4s; }
  .wave-layer:nth-child(4) { animation-duration: 20s; animation-delay: -5s; }

  @keyframes wave-move {
    0%   { transform: translate(-90px); }
    100% { transform: translate(85px); }
  }

  /* 渐变淡出：长距离柔和过渡，让壁纸底部自然消融到页面背景 */
  .wallpaper-gradient {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 17%;
    z-index: 4;
    pointer-events: none;
    /* 只在波浪正上方一小段柔化交界，不再拉出一条大色带 */
    background: linear-gradient(to bottom,
      transparent 0%,
      transparent 55%,
      color-mix(in srgb, var(--bg) 55%, transparent) 82%,
      var(--bg) 100%);
  }

  /* ===== 移动端一比一参照 Firefly：banner 65vh、波浪 10vh ===== */
  @media (max-width: 1023px) {
    .wallpaper-wrapper { height: 65vh !important; }
    .header-waves { height: 10vh; min-height: 50px; max-height: 150px; }
    .wp-scroll { display: none; }
    .wp-inner { gap: 0.5rem; }
    .wp-title {
      font-size: min(4.5rem, 8vw) !important;
      line-height: 1.1 !important;
      font-weight: 400 !important;
      letter-spacing: normal !important;
      font-family: 'Zhi Mang Xing', 'Xingkai SC', 'STXingkai', 'HanziPen SC', 'Kaiti SC', 'STKaiti', 'KaiTi', '楷体', serif !important;
      text-shadow: 2px 2px 8px rgba(0, 0, 0, 0.8) !important;
      margin-bottom: 0.85rem;
    }
    .wp-quote-sub {
      font-size: 1.25rem;
      line-height: 1.4;
      letter-spacing: normal;
      font-family: 'Zhi Mang Xing', 'Xingkai SC', 'STXingkai', 'HanziPen SC', 'Kaiti SC', 'STKaiti', 'KaiTi', '楷体', serif;
      text-shadow: 1px 1px 4px rgba(0, 0, 0, 0.7);
    }
    .wp-links { flex-wrap: wrap; justify-content: center; gap: 0.4rem; margin-top: 0.3rem; }
    .wp-link { padding: 0.38rem 0.85rem; font-size: 0.8rem; }
    .wp-desc { font-size: 0.82rem; padding-inline: 0.5rem; }
  }
  @media (max-width: 640px) {
    .wp-title { font-size: min(4.5rem, 8vw) !important; letter-spacing: 0.02em; margin-bottom: 0.75rem; }
    .wp-quote-sub { font-size: 1.125rem; }
  }
  @media (max-width: 480px) {
    .wp-title { margin-bottom: 0.5rem; }
    .wp-quote-sub { font-size: 1rem; line-height: 1.3; }
  }
  /* 按屏幕高度分档（仅移动端，照抄 Firefly） */
  @media (max-width: 1023px) and (max-height: 500px) { .wallpaper-wrapper { height: 85vh !important; } }
  @media (max-width: 1023px) and (min-height: 501px) and (max-height: 600px) { .wallpaper-wrapper { height: 80vh !important; } }
  @media (max-width: 1023px) and (min-height: 601px) and (max-height: 700px) { .wallpaper-wrapper { height: 75vh !important; } }
</style>
