      font-size: min(4.6rem, 9vw) !important;
      line-height: 1.1 !important;
      font-weight: 400 !important;
      letter-spacing: normal !important;
      font-family: 'Liu Jian Mao Cao', 'Xingkai SC', 'STXingkai', 'HanziPen SC', 'Kaiti SC', 'STKaiti', 'KaiTi', '楷体', cursive !important;
      /* ⚠️ 别再加大面积软阴影（8px/24px 那种）：书法字笔画很细，
