  html.intro-run .wp-quote.active { animation: none; opacity: 1; }
  .wp-quote.leaving { animation: quote-out 0.7s ease both; }

  /* 句尾闪烁光标 */
  .wp-caret {
    display: inline-block;
    width: 2px;
    height: 1em;
