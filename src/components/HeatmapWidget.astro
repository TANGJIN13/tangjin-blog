---
import { getCollection } from 'astro:content';
import Icon from './Icon.astro';

const posts = await getCollection('posts');

// 按日期统计文章数量
const dateCount = new Map<string, number>();
for (const p of posts) {
  const date = p.data.published.toISOString().slice(0, 10);
  dateCount.set(date, (dateCount.get(date) || 0) + 1);
}

// 生成过去 365 天的热力图数据
const today = new Date();
const days: { date: string; count: number }[] = [];
for (let i = 364; i >= 0; i--) {
  const d = new Date(today);
  d.setDate(d.getDate() - i);
  const dateStr = d.toISOString().slice(0, 10);
  days.push({ date: dateStr, count: dateCount.get(dateStr) || 0 });
}

// 计算统计数据
const totalPosts = posts.length;
const totalDays = days.length;
const activeDays = days.filter((d) => d.count > 0).length;
const maxCount = Math.max(...days.map((d) => d.count), 1);

function getLevel(count: number): number {
  if (count === 0) return 0;
  if (count >= 4) return 4;
  return count;
}
---

<div class="card-base heatmap-widget">
  <h3 class="widget-title"><Icon name="chart" size="1.05rem" /> 活跃度</h3>
  <div class="heatmap-stats">
    <span><strong>{totalPosts}</strong> 篇文章</span>
    <span><strong>{activeDays}</strong> 活跃天</span>
  </div>
  <div class="heatmap-grid">
    {days.map((d) => (
      <div
        class={`heatmap-cell level-${getLevel(d.count)}`}
        title={`${d.date}: ${d.count} 篇文章`}
      ></div>
    ))}
  </div>
  <div class="heatmap-legend">
    <span>少</span>
    <span class="heatmap-cell level-0"></span>
    <span class="heatmap-cell level-1"></span>
    <span class="heatmap-cell level-2"></span>
    <span class="heatmap-cell level-3"></span>
    <span class="heatmap-cell level-4"></span>
    <span>多</span>
  </div>
</div>

<style>
  .heatmap-widget { padding: 1rem; }
  .heatmap-stats { display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--text-faint); margin-bottom: 0.6rem; }
  .heatmap-stats strong { color: var(--text); }
  .heatmap-grid { display: grid; grid-template-rows: repeat(7, 1fr); grid-auto-flow: column; gap: 2px; }
  .heatmap-cell { width: 10px; height: 10px; border-radius: 2px; transition: all 0.15s ease; cursor: pointer; }
  .heatmap-cell:hover { transform: scale(1.3); }
  .heatmap-cell.level-0 { background: var(--surface-2); }
  .heatmap-cell.level-1 { background: hsl(var(--hue), 60%, 85%); }
  .heatmap-cell.level-2 { background: hsl(var(--hue), 65%, 70%); }
  .heatmap-cell.level-3 { background: hsl(var(--hue), 70%, 55%); }
  .heatmap-cell.level-4 { background: hsl(var(--hue), 75%, 45%); }
  [data-theme='dark'] .heatmap-cell.level-0 { background: rgba(255,255,255,0.06); }
  [data-theme='dark'] .heatmap-cell.level-1 { background: hsl(var(--hue), 50%, 25%); }
  [data-theme='dark'] .heatmap-cell.level-2 { background: hsl(var(--hue), 55%, 35%); }
  [data-theme='dark'] .heatmap-cell.level-3 { background: hsl(var(--hue), 60%, 45%); }
  [data-theme='dark'] .heatmap-cell.level-4 { background: hsl(var(--hue), 65%, 55%); }
  .heatmap-legend { display: flex; align-items: center; gap: 3px; margin-top: 0.5rem; font-size: 0.7rem; color: var(--text-faint); }
  .heatmap-legend .heatmap-cell { cursor: default; }
  .heatmap-legend .heatmap-cell:hover { transform: none; }
</style>
