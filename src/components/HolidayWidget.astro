---
// 节假日倒计时组件 —— 渐变卡片 + 大号倒计时数字
import Icon from './Icon.astro';

// 2026年中国法定节假日（公历日期）
// 图标名必须是 Icon.astro 里已定义的，否则会退化成占位图标
const holidays = [
  { name: '元旦', date: '2026-01-01', icon: 'sparkle' },
  { name: '春节', date: '2026-02-17', icon: 'flag' },
  { name: '清明节', date: '2026-04-05', icon: 'image' },
  { name: '劳动节', date: '2026-05-01', icon: 'code' },
  { name: '端午节', date: '2026-06-19', icon: 'wave' },
  { name: '中秋节', date: '2026-09-27', icon: 'moon' },
  { name: '国庆节', date: '2026-10-01', icon: 'flag' },
];

const now = new Date();
const today = new Date(now.getFullYear(), now.getMonth(), now.getDate());

// 找到下一个节假日
let nextHoliday = null;
let minDays = Infinity;

for (const h of holidays) {
  const hDate = new Date(h.date);
  const diff = Math.ceil((hDate - today) / (1000 * 60 * 60 * 24));
  if (diff >= 0 && diff < minDays) {
    minDays = diff;
    nextHoliday = { ...h, daysLeft: diff };
  }
}

// 如果今年的节日都过了，找明年的
if (!nextHoliday) {
  const nextYear = now.getFullYear() + 1;
  for (const h of holidays) {
    const hDate = new Date(h.date);
    hDate.setFullYear(nextYear);
    const diff = Math.ceil((hDate - today) / (1000 * 60 * 60 * 24));
    if (diff >= 0 && diff < minDays) {
      minDays = diff;
      nextHoliday = { ...h, daysLeft: diff };
    }
  }
}

// 日期显示成「2月17日 周二」
const dateLabel = nextHoliday
  ? `${new Date(nextHoliday.date).getMonth() + 1}月${new Date(nextHoliday.date).getDate()}日`
  : '';
---

<div class="holiday-widget">
  {nextHoliday ? (
    <div class="holiday-card">
      <span class="holiday-glow" aria-hidden="true"></span>
      <div class="holiday-icon">
        <Icon name={nextHoliday.icon} size="1.3rem" />
      </div>
      <div class="holiday-info">
        <span class="holiday-tag">下一个假期</span>
        <span class="holiday-name">{nextHoliday.name}</span>
        <span class="holiday-date">{dateLabel}</span>
      </div>
      <div class="holiday-countdown">
        <span class="countdown-num">{nextHoliday.daysLeft}</span>
        <span class="countdown-label">天后</span>
      </div>
    </div>
  ) : (
    <div class="holiday-empty">今年没有更多节假日了</div>
  )}
</div>

<style>
  .holiday-widget { padding: 0; }
  .holiday-card {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.8rem 0.85rem;
    border-radius: var(--radius-lg);
    background: linear-gradient(135deg, var(--primary-soft), color-mix(in srgb, var(--primary) 5%, transparent));
    border: 1px solid color-mix(in srgb, var(--primary) 18%, transparent);
    overflow: hidden;
  }
  /* 右上角一团柔光 */
  .holiday-glow {
    position: absolute;
    top: -42px;
    right: -30px;
    width: 112px;
    height: 112px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--primary) 28%, transparent), transparent 70%);
    pointer-events: none;
  }
  .holiday-icon {
    position: relative;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 0.75rem;
    display: grid;
    place-items: center;
    color: var(--text-on-primary);
    background: var(--gradient-primary);
    box-shadow: 0 6px 16px -5px var(--primary-glow);
  }
  .holiday-info {
    position: relative;
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.05rem;
  }
  .holiday-tag {
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--primary);
    opacity: 0.8;
  }
  :global([data-theme='dark'] .holiday-tag) { color: var(--primary-light); }
  .holiday-name { font-size: 1rem; font-weight: 700; color: var(--text); line-height: 1.25; }
  .holiday-date { font-size: 0.72rem; color: var(--text-faint); font-variant-numeric: tabular-nums; }
  .holiday-countdown { position: relative; text-align: right; flex-shrink: 0; }
  .countdown-num {
    display: block;
    font-size: 1.7rem;
    font-weight: 800;
    line-height: 1;
    font-variant-numeric: tabular-nums;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .countdown-label { font-size: 0.66rem; color: var(--text-faint); }
  .holiday-empty {
    text-align: center;
    color: var(--text-faint);
    font-size: 0.85rem;
    padding: 1rem 0;
  }
</style>
