---
// 首屏入场（Intro）
//
// 打开网站时首页首屏的分镜：
//   ① 背景从轻微模糊 → 清晰（.wallpaper-images，1.5s，power3.out）
//   ② 星光渐显 + 微弱闪烁 + 缓慢漂浮（.wp-stars，纯 CSS 光斑）
//   ③ 书法标题**逐节揭幕**：每节从自身高度之下 110% 升到原位（.wp-line > .wp-line-inner）
//   ④ 副标题随后浮现（blur → 清晰 + 上移）
//   ⑤ 导航栏轻移淡入；波浪保持既有的缓慢流动
// 总时长约 1.6~1.9s（用户明确要求"短"）。
//
// 为什么这次不是"全屏遮罩幕布"：
//   之前那版是 IntroCurtain —— 不透明幕布 + canvas 水墨 + 卷帘升起。
//   它把用户的前 2 秒整块占掉（什么都读不到），canvas 逐帧渲染还是这一页最重的开销，
//   而且遮罩与底层内容要对齐底色、锁滚动、处理 fixed 包含块，每条都是坑。
//   现在改成**首屏本身的分镜**：用户第一眼就看到真实内容在动，不需要等。
//   动画的层次感来自"分镜之间的时序"，而不是"一块布盖着再掀开"。
//
// 关键技术选择：
//   · 全部纯 CSS（keyframes + 各元素自己的 --ln-d / --sub-d 延迟变量），
//     组件本体不渲染 DOM、不碰 rAF、不读像素 —— 不会因标签页挂起而卡半途。
//   · 首帧隐藏样式内联在 Base 的 <head>（见那里），保证不闪一帧完整页面。
//   · **每次硬加载都播一次**（不再用 sessionStorage 记"已看过"）。
//     用户明确要求："只要重新加载 / 新开页面就播"，这样访客每次打开都有仪式感，
//     开发时反复刷新也能看到。站内软导航（ClientRouter）换页不重播，保持不打断阅读。
//   · prefers-reduced-motion → 完全不参与，内容直接可见。
//   · 播完摘掉 intro-run（让 will-change / 动画终态都退场，页面回到完全静止的常态），
//     同时挂上 intro-done（放行句尾光标闪烁等"常态动效"）。
//
// ⚠️ 踩过的坑（务必保留这些约束）：
//   1) `astro:page-load` 在**初次硬加载**时也会触发（不只是软导航），
//      而清理函数本来只该服务软导航。第一版把清理直接挂在 page-load 上，
//      结果开播后 ~50ms 就被自己的清理函数判定"已播过"而摘掉 intro-run，
//      动画看起来"完全没播"（实机表现为标题瞬间出现、毫无揭幕）。
//      → 现在用 `softNav` 标志位把「初始加载」和「软导航」严格分开。
//   2) `animationend` 会从**任意后代**冒泡上来（fade-in-up / star-in / quote-in
//      都在 document 上被收到）。靠 animationName 过滤既脆弱又容易误判。
//      → 现在只监听目标元素本身，且用 `{ once: true }` 自摘。
//   3) 收尾必须**幂等**：定时器、animationend、（可能的）软导航清理
//      三条路径都可能先到，重复执行不能有任何副作用。
---

<script is:inline>
  (function () {
    var DONE_AT = 1900; // 最长一段：标题末节延迟 440ms + 1.05s ≈ 1.5s，留 0.4s 余量
    var root = document.documentElement;

    var finished = false;
    function finish() {
      if (finished) return;
      finished = true;
      root.classList.remove('intro-pending', 'intro-run');
      root.classList.add('intro-done');
    }

    // ---- 是否需要播 ----
    // 只尊重 reduced-motion；**不再**用 sessionStorage 拦"已看过" ——
    // 每次硬加载都播（用户明确要求），软导航由下面的 softNav 排除。
    var reduce = false;
    try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}

    if (reduce) {
      // 用户要求减少动效 → 直接落到终态
      finished = true;
      root.classList.remove('intro-pending', 'intro-run');
      root.classList.add('intro-done');
    } else {
      root.classList.add('intro-run');

      // 主收尾：定时器（最可靠，不受动画是否真的跑起来影响）
      window.setTimeout(finish, DONE_AT);

      // 兜底：标题最后一节动画真的结束时立刻收（比定时器更贴实际节奏）。
      // ⚠️ 只在目标元素上监听，绝不在 document 上监听 —— 见文件头的坑 2。
      var lines = document.querySelectorAll('.wp-quote.active .wp-line-inner');
      var last = lines.length ? lines[lines.length - 1] : null;
      if (last) last.addEventListener('animationend', finish, { once: true });
    }

    // ---- 软导航清理 ----
    // 换页时新文档的 HTML 里也带着 intro-pending（服务端渲染时就写死了类名），
    // 而本脚本在 ClientRouter 的替换流程里**不会重新执行**。
    // 站内换页不重播入场，所以必须立刻落终态，
    // 否则整页停在 intro-pending（内容全部 opacity:0）。
    // ⚠️ 首次硬加载时 page-load 也会触发，所以必须用 softNav 把它排除掉（见坑 1）。
    var softNav = false;
    document.addEventListener('astro:before-swap', function () { softNav = true; });
    document.addEventListener('astro:page-load', function () {
      if (!softNav) return;      // 初次加载不是软导航，交给上面的时间轴
      finished = true;
      root.classList.remove('intro-pending', 'intro-run');
      root.classList.add('intro-done');
    });
  })();
</script>
