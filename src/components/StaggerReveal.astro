---
// 首屏入场（Intro）
//
// 打开网站时首页首屏的分镜：
//   ① 背景从轻微模糊 → 清晰（.wallpaper-images，1.5s，power3.out）
//   ② 星光渐显 + 微弱闪烁 + 缓慢漂浮（.wp-stars，纯 CSS 光斑）
//   ③ 书法标题**逐节揭幕**：每节从自身高度之下 110% 升到原位（.wp-line > .wp-line-inner）
//   ④ 副标题随后浮现（blur → 清晰 + 上移）
//   ⑤ 导航栏轻移淡入；波浪保持既有的缓慢流动
// 总时长约 1.6~1.8s（用户明确要求"短"）。
//
// 为什么这次不是"全屏遮罩幕布"：
//   之前那版是 IntroCurtain —— 不透明幕布 + canvas 水墨 + 卷帘升起。
//   它把用户的前 2 秒整块占掉（什么都读不到），canvas 逐帧渲染还是这一页最重的开销，
//   而且遮罩与底层内容要对齐底色、锁滚动、处理 fixed 包含块，每条都是坑。
//   现在改成**首屏本身的分镜**：用户第一眼就看到真实内容在动，不需要等。
//   动画的层次感来自"分镜之间的时序"，而不是"一块布盖着再掀开"。
//
// 关键技术选择：
//   · 全部纯 CSS（keyframes + 各元素自己的 --ln-d / --sub-d 延迟变量），
//     组件本体不渲染 DOM、不碰 rAF、不读像素 —— 不会因标签页挂起而卡半途。
//   · 首帧隐藏样式内联在 Base 的 <head>（见那里），保证不闪一帧完整页面。
//   · 只在**硬加载**播一次；软导航换页不重播（sessionStorage）。
//   · prefers-reduced-motion → 完全不参与，内容直接可见。
//   · 播完摘掉 intro-run（让 will-change / 动画终态都退场，页面回到完全静止的常态），
//     同时挂上 intro-done（放行句尾光标闪烁等"常态动效"）。
---

<script is:inline>
  (function () {
    var KEY = 'intro-played';
    var root = document.documentElement;

    // ---- 软导航清理 ----
    // 换页时新文档的 HTML 里也带着 intro-pending（服务端渲染时就写死了类名），
    // 而本脚本在 ClientRouter 的替换流程里**不会重新执行** → 不主动清就是"切页后整页不可见"。
    function clear() {
      var played = false;
      try { played = sessionStorage.getItem(KEY) === '1'; } catch (e) {}
      if (!played) return;
      root.classList.remove('intro-pending', 'intro-run');
      root.classList.add('intro-done');
    }
    document.addEventListener('astro:before-swap', clear);
    document.addEventListener('astro:page-load', clear);

    // ---- 是否需要播 ----
    var reduce = false;
    try { reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) {}
    var seen = false;
    try { seen = sessionStorage.getItem(KEY) === '1'; } catch (e) {}
    if (reduce || seen) {
      root.classList.remove('intro-pending');
      root.classList.add('intro-done');
      return;
    }

    try { sessionStorage.setItem(KEY, '1'); } catch (e) {}

    // ---- 开播 ----
    root.classList.add('intro-run');

    // ---- 收尾 ----
    // 动画最长的那一段是标题：最后一节的延迟 + 1.05s 时长。
    // 这里按站点箴言可能的最大节数（3 节）算：260 + 2*180 + 1050 ≈ 1670ms，
    // 留到 1900ms 收尾。摘掉 intro-run 之后：
    //   · will-change 释放，合成层回收；
    //   · 标题/副标题回到"没有任何动画"的常态，后续 hover 之类不受干扰；
    //   · 挂上 intro-done 让光标开始闪。
    var DONE_AT = 1900;
    window.setTimeout(function () {
      root.classList.remove('intro-pending', 'intro-run');
      root.classList.add('intro-done');
    }, DONE_AT);

    // 兜底：万一上面的定时器被标签页挂起拖住，用 animationend 再补一次
    // （取最长的那条动画，任一元素触发即可认为整段结束）
    document.addEventListener('animationend', function (ev) {
      if (ev.animationName !== 'wp-line-up') return;
      if (root.classList.contains('intro-run')) {
        root.classList.remove('intro-pending', 'intro-run');
        root.classList.add('intro-done');
      }
    });
  })();
</script>
