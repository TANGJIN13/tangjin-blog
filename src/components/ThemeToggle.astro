---
// 主题切换组件 —— 亮色 / 暗色 / 跟随系统
// 视觉上是一个带滑动指示块的分段控件（paint() 里同步 data-active，滑块跟着走）
import Icon from './Icon.astro';
---

<div class="theme-toggle" id="theme-toggle">
  <span class="theme-thumb" aria-hidden="true"></span>
  <button class="theme-btn" data-theme="light" title="亮色" aria-label="亮色模式">
    <Icon name="sun" size="1rem" />
  </button>
  <button class="theme-btn" data-theme="dark" title="暗色" aria-label="暗色模式">
    <Icon name="moon" size="1rem" />
  </button>
  <button class="theme-btn" data-theme="system" title="跟随系统" aria-label="跟随系统">
    <Icon name="monitor" size="1rem" />
  </button>
</div>

<script>
  // 侧栏主题卡 —— 与导航栏主题按钮共用同一个存储键 'theme'，避免两套状态互相打架。
  // 注意：站点启用了 ClientRouter（客户端路由），切页会替换 DOM 元素，
  // 而模块脚本只在首次加载执行一次，所以必须在每次 astro:page-load 时重新绑定；
  // 用 onclick= 赋值（而非 addEventListener）保证幂等，重复初始化也不会叠加事件。
  const root = document.documentElement;
  const KEY = 'theme';

  const getSystem = (): 'light' | 'dark' =>
    window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

  function getPref(): 'light' | 'dark' | 'system' {
    try {
      const v = localStorage.getItem(KEY);
      if (v === 'light' || v === 'dark' || v === 'system') return v;
    } catch {}
    return 'system';
  }

  function paint() {
    const toggle = document.getElementById('theme-toggle');
    if (!toggle) return;
    const pref = getPref();
    // 恢复当前偏好对应的实际主题（system 时跟随系统）
    root.setAttribute('data-theme', pref === 'system' ? getSystem() : pref);
    // 滑块指示块跟着当前选项走（CSS 靠这个属性做位移）
    toggle.dataset.active = pref;
    toggle.querySelectorAll<HTMLButtonElement>('.theme-btn').forEach((b) => {
      // 高亮当前选中的按钮
      b.classList.toggle('active', b.dataset.theme === pref);
      // 绑定点击（onclick 赋值是幂等的）
      b.onclick = () => {
        const t = b.dataset.theme as 'light' | 'dark' | 'system';
        root.setAttribute('data-theme', t === 'system' ? getSystem() : t);
        try {
          localStorage.setItem(KEY, t);
        } catch {}
        paint();
      };
    });
  }

  paint();
  // 客户端路由每次换页完成后重新初始化（首次加载也会触发一次，幂等无副作用）
  document.addEventListener('astro:page-load', paint);
</script>

<style>
  .theme-toggle {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.2rem;
    padding: 0.25rem;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  /* 会滑动的白色指示块：位置由 .theme-toggle[data-active] 决定 */
  .theme-thumb {
    position: absolute;
    top: 0.25rem;
    bottom: 0.25rem;
    left: 0.25rem;
    width: calc((100% - 0.9rem) / 3);
    border-radius: 999px;
    background: var(--surface);
    box-shadow: 0 2px 8px oklch(0% 0 0 / 0.14), 0 1px 2px oklch(0% 0 0 / 0.08);
    transition: transform 0.3s cubic-bezier(0.34, 1.4, 0.64, 1);
    pointer-events: none;
  }
  :global([data-theme='dark'] .theme-thumb) {
    background: oklch(30% 0.02 300);
    box-shadow: 0 2px 10px oklch(0% 0 0 / 0.45);
  }
  .theme-toggle[data-active='dark'] .theme-thumb { transform: translateX(calc(100% + 0.2rem)); }
  .theme-toggle[data-active='system'] .theme-thumb { transform: translateX(calc(200% + 0.4rem)); }

  .theme-btn {
    position: relative;
    z-index: 1;
    height: 34px;
    border: none;
    background: transparent;
    border-radius: 999px;
    cursor: pointer;
    display: grid;
    place-items: center;
    color: var(--text-faint);
    transition: color 0.2s ease, transform 0.2s ease;
  }
  .theme-btn:hover { color: var(--primary); transform: translateY(-1px); }
  .theme-btn.active { color: var(--primary); }
  .theme-btn.active :global(.icon) { transform: scale(1.06); }
</style>
