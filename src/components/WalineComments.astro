---
// Waline 评论组件 —— 自建 Waline 服务，读者无需登录任何账号
// 填个昵称就能留言，邮箱选填；数据存在自己服务器的 SQLite 里
import { site } from '../site';
import '../vendor/waline.css';
import { init } from '../vendor/waline.js';

interface Props {
  /** 评论串标识，同一条 path 的留言归到同一个评论区 */
  path?: string;
}

const { path = '/guestbook' } = Astro.props;
const serverURL = site.waline.serverURL;
---

<section
  id="comments"
  class="waline-container"
  data-server-url={serverURL}
  data-path={path}
>
  <div id="waline"></div>
</section>

<script>
  import { init } from '../vendor/waline.js';

  // 注意：本脚本是 Astro 模块脚本（非 is:inline），整个会话只执行一次；
  // 通过 astro:page-load 处理每次 SPA 导航，避免重复初始化。
  let instance: any = null;

  function mountWaline() {
    const root = document.getElementById('waline');
    if (!root) return; // 当前页面没有评论区
    if (root.dataset.mounted === '1') return; // 已经初始化过

    const section = root.closest('.waline-container');
    const rawServerURL = section?.getAttribute('data-server-url') || '/waline/';
    const path = section?.getAttribute('data-path') || '/guestbook';

    // Waline 会给「非绝对地址」自动补上 https://，所以这里先转成完整地址，
    // 否则 "/waline/" 会被当成域名 "waline"，请求就发到不存在的 https://waline/ 去了。
    const serverURL = new URL(rawServerURL, window.location.origin).href;

    // 从别的页面回到留言板时，先销毁上一个实例再重建
    if (instance) {
      try {
        instance.destroy();
      } catch {
        /* 上一个实例所在 DOM 已被移除，忽略 */
      }
      instance = null;
    }

    instance = init({
      el: '#waline',
      serverURL,
      path,
      lang: 'zh-CN',
      login: 'disable', // 关闭登录，允许匿名留言
      meta: ['nick', 'mail'], // 只显示昵称、邮箱两个输入框
      requiredMeta: ['nick'], // 昵称必填，邮箱选填
      dark: 'html[data-theme="dark"]', // 深浅色跟随站点主题（纯 CSS 自动生效）
      imageUploader: false, // 未配置图床，关闭图片上传
      search: false, // 关闭 GIF 搜索，避免请求外部接口
      pageSize: 10,
    });
    root.dataset.mounted = '1';
  }

  document.addEventListener('astro:page-load', mountWaline);
  mountWaline();
</script>

<style>
  .waline-container {
    margin-top: 1.5rem;
  }
  /* 让 Waline 的控件圆角跟站点风格一致 */
  .waline-container :global(.wl-panel),
  .waline-container :global(.wl-editor) {
    border-radius: var(--radius);
  }
</style>