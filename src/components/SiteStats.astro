---
// 站点统计 —— 文章/分类/总字数 + 运行时长 + 访问量 + 本年/本月/本周剩余（带进度条）
import { site } from '../site';
import Icon from './Icon.astro';

interface Props {
  postsCount: number;
  categoriesCount: number;
  totalWords?: number;
}

const {
  postsCount,
  categoriesCount,
  totalWords = 0,
} = Astro.props;
---

<div class="site-stats">
  <!-- 统计网格 -->
  <div class="stats-grid">
    <div class="stat-item">
      <span class="stat-num">{postsCount}</span>
      <span class="stat-label">文章</span>
    </div>
    <div class="stat-item">
      <span class="stat-num">{categoriesCount}</span>
      <span class="stat-label">分类</span>
    </div>
    {totalWords > 0 && (
      <div class="stat-item">
        <span class="stat-num">{totalWords.toLocaleString('zh-CN')}</span>
        <span class="stat-label">总字数</span>
      </div>
    )}
  </div>

  <!-- 运行时长 -->
  <div class="stat-row">
    <span class="stat-row-icon"><Icon name="clock" size="0.85rem" /></span>
    <span class="stat-row-label">运行时长</span>
    <span class="stat-row-value" id="run-days">--<em>天</em></span>
  </div>

  <!-- 访问量（由 Base.astro 的计数脚本填充） -->
  <div class="stat-row" data-vc-wrap style="display:none">
    <span class="stat-row-icon"><Icon name="eye" size="0.85rem" /></span>
    <span class="stat-row-label">总访问量</span>
    <span class="stat-row-value" data-vc="site_pv">--<em>次</em></span>
  </div>

  <!-- 剩余天数（每条下面一根进度条，表示已过比例） -->
  <div class="days-left">
    <div class="dl-item">
      <span class="dl-num" id="dl-year">--</span>
      <span class="dl-label">本年还剩</span>
      <span class="dl-bar"><i id="dl-year-bar"></i></span>
    </div>
    <div class="dl-item">
      <span class="dl-num" id="dl-month">--</span>
      <span class="dl-label">本月还剩</span>
      <span class="dl-bar"><i id="dl-month-bar"></i></span>
    </div>
    <div class="dl-item">
      <span class="dl-num" id="dl-week">--</span>
      <span class="dl-label">本周还剩</span>
      <span class="dl-bar"><i id="dl-week-bar"></i></span>
    </div>
  </div>
</div>

<script define:vars={{ startDate: site.startDate }}>
  const start = new Date(startDate + 'T00:00:00');

  function calc() {
    const now = new Date();
    // 运行时长（天）
    const diffMs = now - start;
    const days = Math.max(0, Math.floor(diffMs / 86400000));
    const runDays = document.getElementById('run-days');
    if (runDays) runDays.innerHTML = String(days) + '<em>天</em>';

    // 本年还剩（今天不算）
    const isLeap = (now.getFullYear() % 4 === 0 && now.getFullYear() % 100 !== 0) || now.getFullYear() % 400 === 0;
    const daysInYear = isLeap ? 366 : 365;
    const startOfYear = new Date(now.getFullYear(), 0, 1);
    const dayOfYear = Math.floor((now - startOfYear) / 86400000) + 1;
    const dlYear = document.getElementById('dl-year');
    if (dlYear) dlYear.textContent = String(Math.max(0, daysInYear - dayOfYear));
    const yBar = document.getElementById('dl-year-bar');
    if (yBar) yBar.style.width = Math.round((dayOfYear / daysInYear) * 100) + '%';

    // 本月还剩（今天不算）
    const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
    const dlMonth = document.getElementById('dl-month');
    if (dlMonth) dlMonth.textContent = String(Math.max(0, daysInMonth - now.getDate()));
    const mBar = document.getElementById('dl-month-bar');
    if (mBar) mBar.style.width = Math.round((now.getDate() / daysInMonth) * 100) + '%';

    // 本周还剩（到周日）
    const dow = now.getDay(); // 0=周日
    const daysToSunday = dow === 0 ? 0 : 7 - dow;
    const dlWeek = document.getElementById('dl-week');
    if (dlWeek) dlWeek.textContent = String(daysToSunday);
    const wBar = document.getElementById('dl-week-bar');
    if (wBar) wBar.style.width = Math.round(((dow === 0 ? 7 : dow) / 7) * 100) + '%';
  }

  calc();
  setInterval(calc, 60000); // 每分钟刷新一次
</script>

<style>
  .site-stats { display: flex; flex-direction: column; gap: 0.75rem; }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.45rem;
    text-align: center;
  }
  /* 没有「总字数」时只放两个 */
  .stats-grid:has(.stat-item:nth-child(2):last-child) { grid-template-columns: repeat(2, 1fr); }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    padding: 0.55rem 0.2rem;
    border-radius: var(--radius-md);
    background: var(--surface-2);
    border: 1px solid transparent;
    transition: transform 0.2s ease, border-color 0.2s ease, background 0.2s ease;
  }
  .stat-item:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--primary) 28%, transparent);
    background: var(--primary-soft);
  }
  .stat-num {
    font-size: 1.2rem;
    font-weight: 800;
    line-height: 1.15;
    font-variant-numeric: tabular-nums;
    background: var(--gradient-primary);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }
  .stat-label { font-size: 0.7rem; color: var(--text-faint); }

  /* 运行时长 / 访问量：一行一条，图标坐小色块 */
  .stat-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.5rem;
    border-radius: var(--radius-md);
    background: var(--surface-2);
    font-size: 0.78rem;
    color: var(--text-soft);
  }
  .stat-row-icon {
    width: 1.5rem;
    height: 1.5rem;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 0.45rem;
    color: var(--primary);
    background: var(--primary-soft);
  }
  :global([data-theme='dark'] .stat-row-icon) { color: var(--primary-light); }
  .stat-row-label { font-size: 0.78rem; }
  .stat-row-value {
    margin-left: auto;
    font-weight: 800;
    font-size: 0.92rem;
    color: var(--text);
    font-variant-numeric: tabular-nums;
  }
  .stat-row-value em { font-style: normal; font-size: 0.7rem; font-weight: 600; color: var(--text-faint); margin-left: 0.12rem; }

  /* 剩余天数 */
  .days-left {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    padding-top: 0.7rem;
    border-top: 1px dashed var(--border);
  }
  .dl-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.12rem;
  }
  .dl-num {
    font-size: 1.3rem;
    font-weight: 800;
    line-height: 1.15;
    color: var(--primary);
    font-variant-numeric: tabular-nums;
  }
  :global([data-theme='dark'] .dl-num) { color: var(--primary-light); }
  .dl-label { font-size: 0.68rem; color: var(--text-faint); }
  .dl-bar {
    display: block;
    width: 100%;
    height: 4px;
    margin-top: 0.25rem;
    border-radius: 999px;
    background: oklch(94.5% 0.014 158);
    overflow: hidden;
  }
  :global([data-theme='dark'] .dl-bar) { background: oklch(100% 0 0 / 0.08); }
  .dl-bar i {
    display: block;
    height: 100%;
    width: 0;
    border-radius: 999px;
    background: var(--gradient-primary);
    opacity: 0.9;
    transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1);
  }
</style>
